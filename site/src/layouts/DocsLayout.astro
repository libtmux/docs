---
import type { MarkdownHeading } from 'astro'
import Sidebar from '../components/docs/Sidebar.astro'
import DocumentationNavigationButtons from '../components/docs/DocumentationNavigationButtons.astro'
import MobileToC from '../components/MobileToC.astro'
import TableOfContents from '../components/TableOfContents/TableOfContents.astro'
import { PAGE_TITLE_ID } from '../constants'
import { buildTarget } from '../lib/versions'
import CodeTabs from '../components/CodeTabs.astro'
import { generateToC } from '../utils/generateToC'
import { DEFAULT_LOCALE, localeSourcePath, type Locale } from '../i18n/locales'
import type { LocaleStatus } from '../i18n/resolve'
import PageToolbar from '../components/PageToolbar.astro'
import DocumentationContext from '../components/docs/DocumentationContext.astro'
import { pageBreadcrumbs, type SidebarItem } from '../lib/sidebar'
import type { PagePortLink } from '../lib/page-port-links'
import ProseText from '../components/ProseText.astro'
import { pagePortsFor } from '../lib/page-ports-for'
import Aside from '../components/Aside.astro'
import BaseLayout from './BaseLayout.astro'
import type { PageSource } from '../lib/markdown-twins'
import { API_MODELS } from '../lib/api-models'
import { branding } from '../lib/branding'
import { withRoot } from '../lib/site-root'
import { DOC_PRODUCTS, PORT_BY_SLUG, portPageUrl, productAvailable, productDescription, productInDevelopment, workspaceOverviewNotice, type DocProduct } from '../lib/ports'

/**
 * The documentation reading shell: sidebar | content | table of contents.
 * Wraps BaseLayout rather than duplicating its <head>. `port` scopes the
 * sidebar to one language's nav; omit it (as [...slug].astro does for the
 * shared docs — concepts, guides, examples, which carry no `port`
 * frontmatter) to get the shell's own `sidebar.group` sectioning instead —
 * see lib/sidebar.ts.
 *
 * MobileSidebar.astro is deliberately NOT reused here: it imports a
 * `ProjectSidebar.astro` that does not exist in this repo and hardcodes
 * tony.sh nav links, so importing it turns any page that uses this layout
 * red. The mobile drawer below reimplements its exact mechanism — same ids,
 * same open/close classes, same AbortController + astro:after-swap script
 * shape as MobileToC.astro below it — with <Sidebar> as the content instead.
 * MobileToC.astro has no such problem and is reused verbatim.
 */
interface Props {
  title: string
  description?: string
  /** Which port's nav to scope the sidebar to. Omit for shell pages with no port. */
  port?: string
  product?: DocProduct
  version?: string
  /** Path within the current port+version, e.g. 'guides/panes'. Forwarded to BaseLayout for canonical/SEO. */
  pagePath?: string
  noindex?: boolean
  searchable?: boolean
  updated?: string
  headings?: MarkdownHeading[]
  /** Suppress the on-page table of contents (frontmatter `tableOfContents`). */
  tableOfContents?: boolean
  /** BCP-47 tag for this page. */
  locale?: Locale
  /** Locales this page genuinely exists in. */
  locales?: string[]
  /** This page's path with any locale prefix removed. */
  sourcePath?: string
  /** Overrides the computed canonical. A placeholder points at its English page. */
  canonicalOverride?: string
  /** Every locale's status for this page, for the locale switcher. */
  localeStatuses?: Record<string, LocaleStatus>
  /** Forwarded to BaseLayout's machine-readable footer. */
  pageSource?: PageSource
  markdownIndex?: boolean
  markdown?: 'source' | 'rendered' | { href: string }
  editHref?: string
  editLabel?: string
  /**
   * The page brings its own heading and layout.
   *
   * A port's version root (`/ts/latest/`) wants this shell — the sidebar, the
   * mobile drawer, the same three-column frame every page under it has — but
   * not the reading column: it is a landing page with a hero and a card grid,
   * not prose, and the `<article class="prose">` below would style the cards
   * as a document. It also carries its own `<h1>`, so the one this layout
   * renders would be a second.
   */
  bare?: boolean
  navigation?: SidebarItem[]
  breadcrumbs?: { name: string; url: string }[]
  pagePorts?: PagePortLink[]
}

const {
  title,
  description,
  port,
  product,
  version: requestedVersion,
  pagePath = '',
  noindex = false,
  searchable = true,
  updated,
  headings = [],
  tableOfContents = true,
  locale = DEFAULT_LOCALE,
  locales = [],
  sourcePath,
  canonicalOverride,
  localeStatuses,
  pageSource,
  markdownIndex,
  markdown,
  editHref,
  editLabel,
  bare = false,
  navigation,
  breadcrumbs: requestedBreadcrumbs,
  pagePorts: requestedPagePorts,
} = Astro.props as Props

// process.env, not import.meta.env: import.meta.env.LIBTMUX_DOCS_* goes
// stale across repeated astro builds in one tree (see BaseLayout.astro).
const version = requestedVersion ?? buildTarget(process.env).version

// Astro.url.pathname rather than `pagePath`: the sidebar only needs *a*
// consistent value to diff against the hrefs it built itself
// (lib/sidebar.ts's isActivePath trims base and slashes either way), and
// reading it directly means this layout doesn't have to trust that every
// caller formats `pagePath` the same way BaseLayout does.
const currentPath = Astro.url.pathname
const hasContext = Boolean(port) || /^(tmux|guides|topics|concepts|examples)(\/|$)/.test(pagePath)
const contextVersion = port ? version : pagePath.match(/^tmux\/([^/]+)\/(?:reference|manual)/)?.[1] ?? 'latest'

const tocItems =
  tableOfContents && headings.length > 0 ? generateToC(headings) : []
const pagePorts = requestedPagePorts ?? await pagePortsFor(sourcePath ?? pagePath, port, version)
const productBrand = port && product && pagePath === product && productAvailable(PORT_BY_SLUG[port], product)
  ? branding(port, pagePath) : undefined
const development = product && port && productInDevelopment(PORT_BY_SLUG[port], product)
const workspaceOverview = product === 'workspace' && pagePath === 'workspace' && port
  ? workspaceOverviewNotice(PORT_BY_SLUG[port]) : undefined
const workspaceInternals = product === 'workspace' && pagePath.startsWith('workspace/internals/')
const breadcrumbs = requestedBreadcrumbs ?? (product && port ? [
  { name: PORT_BY_SLUG[port].name, url: portPageUrl(PORT_BY_SLUG[port], version) },
  { name: DOC_PRODUCTS[product].label, url: portPageUrl(PORT_BY_SLUG[port], version, product) },
  ...(workspaceInternals ? [{ name: 'Internals', url: portPageUrl(PORT_BY_SLUG[port], version, 'workspace/internals') }] : []),
  ...(pagePath !== product ? [{ name: title, url: portPageUrl(PORT_BY_SLUG[port], version, pagePath) }] : []),
] : await pageBreadcrumbs(title, pagePath, version, port, locale))
---

<BaseLayout
  title={title}
  description={description}
  pagePath={pagePath}
  portSlug={port}
  documentationLayout={hasContext ? 'prose' : undefined}
  version={version}
  noindex={noindex}
  searchable={searchable}
  updated={updated}
  locale={locale}
  locales={locales}
  sourcePath={sourcePath}
  canonicalOverride={canonicalOverride}
  localeStatuses={localeStatuses}
  breadcrumbs={breadcrumbs}
  pageSource={pageSource}
  markdownIndex={markdownIndex}
  markdown={markdown}
  repository={product && port ? API_MODELS[port]?.sources?.find((source) => source.product === product)?.repo : undefined}
>
  {hasContext && <DocumentationContext slot="context" port={port} version={contextVersion} locale={locale}
    sourcePath={localeSourcePath(Astro.url.pathname, locale)} pagePorts={pagePorts} localeStatuses={localeStatuses}>
    <DocumentationNavigationButtons slot="navigation" tableOfContents={tocItems.length > 0} />
  </DocumentationContext>}
  <CodeTabs />
  {!hasContext && <div class="mobile-toolbar lg:hidden"><DocumentationNavigationButtons tableOfContents={tocItems.length > 0} /></div>}

  <noscript>
    <style is:inline>
      .mobile-toolbar, .documentation-context-navigation, #mobile-sidebar, #mobile-toc { display: none !important; }
    </style>
    <div class="mobile-fallback lg:hidden" data-pagefind-ignore="all">
      <details>
        <summary>Browse documentation</summary>
        <Sidebar locale={locale} port={port} product={product} version={version} currentPath={currentPath} navigation={navigation} />
      </details>
      {tocItems.length > 0 && <details>
        <summary>On this page</summary>
        <nav aria-label="On this page"><ul>
          {headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ul></nav>
      </details>}
    </div>
  </noscript>

  <!-- Mobile sidebar drawer -->
  <div id="mobile-sidebar-overlay" class="fixed inset-0 z-40 bg-black/50 opacity-0 invisible lg:hidden"></div>
  <aside id="mobile-sidebar" inert class="drawer-surface fixed left-0 top-0 z-50 h-full w-64 -translate-x-full overflow-y-auto lg:hidden">
    <div class="p-4">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Navigation</h2>
        <button
          id="mobile-sidebar-close"
          type="button"
          aria-label="Close navigation menu"
          class="flex h-8 w-8 items-center justify-center rounded-md hover:bg-surface-hover"
        >
          <svg class="h-5 w-5 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <Sidebar locale={locale} port={port} product={product} version={version} currentPath={currentPath} navigation={navigation} />
    </div>
  </aside>

  {tocItems.length > 0 && <MobileToC tocItems={tocItems} />}

  {/*
    Wider than 7xl, and the reading column is bounded by the prose measure
    rather than by the shell. At 1400px the old 80rem shell left the table of
    contents floating a long way short of the right edge with nothing beside
    it; the sidebars now sit near the edges and the middle grows.
  */}
  <div class="mx-auto flex max-w-[100rem] gap-5 px-4 py-6 lg:px-5">
    <aside class="hidden w-64 shrink-0 lg:block">
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto">
        <Sidebar locale={locale} port={port} product={product} version={version} currentPath={currentPath} navigation={navigation} />
      </div>
    </aside>

    <main class="min-w-0 flex-1">
      {(!port || pagePath) && <PageToolbar breadcrumbs={breadcrumbs} pagePorts={hasContext ? [] : pagePorts} port={port} editHref={editHref} editLabel={editLabel} />}
      {bare ? <slot /> : (
      <article class="prose max-w-none dark:prose-invert">
        {productBrand ? (
          <div class="product-hero">
            <img src={withRoot(productBrand.asset('logo.svg'))} width="88" height="88" alt="" class="not-prose" />
            <div class="min-w-0">
              <h1 id={PAGE_TITLE_ID} class="wrap-anywhere">{title}</h1>
              <slot name="hero-links" />
            </div>
          </div>
        ) : <h1 id={PAGE_TITLE_ID} class="wrap-anywhere">{title}</h1>}
        {/*
          The same caution the reference and the prose use, rather than a box
          of its own: a reader who has seen one development warning should
          recognise the next without reading it twice.
        */}
        {development && <Aside type="caution" title={workspaceOverview ? workspaceOverview.title : `${DOC_PRODUCTS[product!].label} is in development`}>
          {workspaceOverview
            ? <ProseText text={workspaceOverview.body} port={port} class="mb-0" />
            : <p class="mb-0">{product === 'workspace'
              ? productDescription(PORT_BY_SLUG[port!], 'workspace')
              : 'Server behavior and tool contracts may change. Tool availability depends on the server configuration.'}</p>}
        </Aside>}
        <slot />
      </article>
      )}
    </main>

    {
      tocItems.length > 0 && (
        <aside class="hidden w-56 shrink-0 xl:block">
          <TableOfContents items={tocItems} />
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .product-hero { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; }
  .product-hero img { width: 88px; height: 88px; flex: none; margin: 0; }
  .product-hero h1 { min-width: 0; margin: 0; }
  @media (max-width: 479px) {
    .product-hero { display: block; }
    .product-hero img { margin-bottom: 1rem; }
  }
  /*
   * The breakpoint is stated here, not left to `lg:hidden` on the element.
   *
   * Astro scopes this rule to `.mobile-toolbar[data-astro-cid-…]`, which is
   * specificity (0,2,0) against Tailwind's `.lg\:hidden` at (0,1,0) — so the
   * utility never won and the toolbar rendered at every width. A hamburger
   * and a contents button sat above the three-column desktop layout on all
   * 394 pages that use this shell.
   */
  .mobile-toolbar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-background-border);
    background: var(--background-color);
    color: var(--text-color);
    padding: 0.5rem 1rem;
  }
  @media (min-width: 1024px) {
    .mobile-toolbar {
      display: none;
    }
  }

  .mobile-fallback {
    border-bottom: 1px solid var(--color-background-border);
    background: var(--background-color);
    color: var(--text-color);
    padding: 0.5rem 1rem;
  }
  .mobile-fallback summary { cursor: pointer; padding-block: 0.375rem; }
  .mobile-fallback nav { padding-block: 0.5rem; }

</style>

<script>
  // Mobile sidebar drawer. Same mechanism as MobileToC.astro's script
  // (AbortController-scoped listeners, re-init on astro:after-swap so a
  // ClientRouter navigation replaces them instead of stacking duplicates) —
  // duplicated here rather than imported because MobileSidebar.astro, which
  // would otherwise own this, cannot currently be built (see the note atop
  // this file's frontmatter).
  let controller: AbortController | null = null

  function initMobileSidebar() {
    controller?.abort()
    controller = new AbortController()
    const { signal } = controller
    const toggleButton = document.getElementById('mobile-sidebar-toggle')
    const closeButton = document.getElementById('mobile-sidebar-close')
    const sidebar = document.getElementById('mobile-sidebar')
    const overlay = document.getElementById('mobile-sidebar-overlay')
    // Recover if a navigation happened while the drawer was open.
    document.body.style.overflow = ''

    /**
     * A closed drawer is off-screen, not absent — `-translate-x-full` moves
     * it out of view and leaves every link in it focusable. Tabbing from the
     * page walked into a menu nobody could see. `inert` removes it from the
     * tab order and the accessibility tree in one attribute, and is what
     * `visibility` would do if the drawer did not need to animate.
     */
    function setInert(on: boolean) {
      if (sidebar) sidebar.inert = on
    }
    setInert(true)

    function open() {
      if (!sidebar || !overlay) return
      // One drawer at a time: the contents panel listens for this and closes.
      document.dispatchEvent(new CustomEvent('libtmux:drawer-open', { detail: 'sidebar' }))
      sidebar.classList.remove('-translate-x-full')
      overlay.classList.remove('opacity-0', 'invisible')
      overlay.classList.add('opacity-100', 'visible')
      document.body.style.overflow = 'hidden'
      toggleButton?.setAttribute('aria-expanded', 'true')
      setInert(false)
      // Into the drawer, so the next Tab is a menu item rather than whatever
      // sits behind it; and back to the button on close, so the reader
      // returns to where they were rather than to the top of the document.
      ;(closeButton ?? sidebar.querySelector<HTMLElement>('a'))?.focus()
    }
    function close() {
      if (!sidebar || !overlay) return
      const hadFocus = sidebar.contains(document.activeElement)
      sidebar.classList.add('-translate-x-full')
      overlay.classList.remove('opacity-100', 'visible')
      overlay.classList.add('opacity-0', 'invisible')
      document.body.style.overflow = ''
      toggleButton?.setAttribute('aria-expanded', 'false')
      setInert(true)
      if (hadFocus) toggleButton?.focus()
    }

    toggleButton?.addEventListener('click', open, { signal })
    closeButton?.addEventListener('click', close, { signal })
    overlay?.addEventListener('click', close, { signal })
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && sidebar && !sidebar.classList.contains('-translate-x-full')) close()
      },
      { signal },
    )
    sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close, { signal }))

    // Another drawer opened.
    document.addEventListener(
      'libtmux:drawer-open',
      (e) => {
        if ((e as CustomEvent).detail !== 'sidebar') close()
      },
      { signal },
    )

    /*
     * Crossing to the desktop layout closes it.
     *
     * The drawer and its overlay are `lg:hidden`, so widening the window made
     * both vanish — but `body { overflow: hidden }` stayed, leaving a desktop
     * page that could not be scrolled and no visible control to release it.
     */
    const desktop = window.matchMedia('(min-width: 1024px)')
    desktop.addEventListener('change', (e) => e.matches && close(), { signal })
    if (desktop.matches) close()
  }

  initMobileSidebar()
  document.addEventListener('astro:after-swap', initMobileSidebar)
</script>
