---
import '../styles/global.css'
import { buildLocale } from '../i18n/resolve'
import { localeSourcePath } from '../i18n/locales'
import { Font } from 'astro:assets'
import BackToTop from '../components/BackToTop.astro'
import Seo from '../components/Seo.astro'
import SiteFooter from '../components/SiteFooter.astro'
import PrereleaseNotice from '../components/PrereleaseNotice.astro'
import SiteHeader from '../components/SiteHeader.astro'
import ThemeScript from '../components/ThemeScript.astro'
import SearchModal from '../components/SearchModal.astro'
import { pickerPaintRules } from '../lib/picker-paint'
import { buildTarget } from '../lib/versions'
import type { VersionEntry } from '../lib/versions'
import { withPortRoot, withRoot } from '../lib/site-root'
import { PORT_NAME } from '../lib/api-models'
import { PORT_BY_SLUG } from '../lib/ports'
import { markdownPath, type PageSource } from '../lib/markdown-twins'
import { CONTRIBUTE_BRANCH, CONTRIBUTE_REPO, repoPath } from '../i18n/contribute'
import type { Locale } from '../i18n/locales'
import type { LocaleStatus } from '../i18n/resolve'

/**
 * The one page shell. Everything the site renders goes through here —
 * landing, prose, and the three ports whose reference we render ourselves.
 *
 * Ports rendered by Sphinx or their own generator do not use this layout;
 * they receive the same header, footer and switchers as runtime-injected
 * artifacts instead. Keeping the markup here and the injected copy in sync
 * is what `scripts/build-site.sh` checks.
 */
interface Props {
  title: string
  description?: string
  /** Path within the current port+version, e.g. 'guides/panes'. */
  pagePath?: string
  /** Port slug when this page belongs to one. */
  portSlug?: string
  version?: string
  noindex?: boolean
  /** Include this page in the local search index. */
  searchable?: boolean
  updated?: string
  /** Suppress the site header, for embedded/preview renders. */
  bare?: boolean
  /** BCP-47 tag for this page. Drives <html lang> and the hreflang cluster. */
  locale?: string
  /** Locales this page genuinely exists in — never the full LOCALES list. */
  locales?: string[]
  /** This page's path with any locale prefix removed. Drives hreflang. */
  sourcePath?: string
  /** Overrides the computed canonical. A placeholder points at its English page. */
  canonicalOverride?: string
  /** Every locale's status for this page, for the locale switcher. */
  localeStatuses?: Record<string, string>
  breadcrumbs?: { name: string; url: string }[]
  /** The file this page is rendered from. Defaults to the route's own `.astro` file. */
  pageSource?: PageSource
  /** Whether this page's Markdown twin is `<page>/index.md` rather than `<page>.md`. */
  markdownIndex?: boolean
  /**
   * Who writes this page's Markdown twin: a `.md` route built from the page's
   * source, or the post-build conversion of the rendered page, the default. A
   * page whose twin another build writes, such as a placeholder's English
   * original, passes its `href`.
   */
  markdown?: 'source' | 'rendered' | { href: string }
  /** The repository behind the footer's GitHub icon, when it is not the page's source or port. */
  repository?: string
}

const {
  title,
  description,
  pagePath: requestedPagePath,
  portSlug,
  version: requestedVersion,
  noindex = false,
  searchable = true,
  updated,
  bare = false,
  locale = 'en',
  locales = [],
  sourcePath,
  canonicalOverride,
  localeStatuses,
  breadcrumbs,
  pageSource,
  markdownIndex,
  markdown = 'rendered',
  repository,
} = Astro.props as Props


const buildBase = process.env.LIBTMUX_DOCS_BASE ?? '/'
const routePath = (Astro.url.pathname.startsWith(buildBase)
  ? Astro.url.pathname.slice(buildBase.length)
  : Astro.url.pathname).replace(/^\/+|\/+$/g, '')
const pagePath = requestedPagePath ?? (routePath === portSlug ? '' : routePath)

const target = buildTarget(process.env)
if (requestedVersion) target.version = requestedVersion

// Until the manifest is fetched client-side, treat this build's own version
// as the entry we know about. The switcher replaces this at runtime.
const versionEntry: VersionEntry = {
  slug: target.version,
  label: target.version,
  kind: target.kind,
  supported: true,
}
/**
 * Which part of the site this page is in, as a search filter.
 *
 * The first path segment after any port and version: `topics`, `guides`,
 * `concepts`, `examples`, `reference`. A reader searching for `capture`
 * usually wants one of those, not all five.
 */
const section = (pagePath.split('/').filter(Boolean)[0] ?? 'home').toLowerCase()

const navPort = portSlug ?? (process.env.LIBTMUX_DOCS_PORT || undefined) ?? (pagePath.startsWith('reference/') ? pagePath.split('/')[1] : undefined)
let portDefaults: Record<string, string> = {}
try {
  portDefaults = JSON.parse(process.env.LIBTMUX_DOCS_PORT_DEFAULTS || '{}')
} catch { /* Unconfigured builds use each port's latest tree. */ }
const defaultVersion = portDefaults[portSlug ?? ''] ?? process.env.LIBTMUX_DOCS_DEFAULT_VERSION ?? 'latest'
const navVersion = process.env.LIBTMUX_DOCS_PORT ? target.version : (portDefaults[navPort ?? ''] ?? 'latest')
const localePagePath = localeSourcePath(Astro.url.pathname, buildLocale())

/*
 * The machine-readable footer: this page's source file, its Markdown twin,
 * and the docs.json and llms files of the narrowest tree it belongs to, its
 * port and version when it has one and otherwise this locale.
 *
 * A page that names no source is attributed to its route file. Resolving the
 * route pattern against the files that exist fails the build for a route this
 * cannot place, rather than printing a path that 404s.
 */
const routeFile = pageSource ? undefined : Object.keys(import.meta.glob('../pages/**/*.astro'))
  .map((file) => file.replace(/^\.\.\/pages\//, ''))
  .find((file) => file.replace(/\.astro$/, '').replace(/(^|\/)index$/, '') === Astro.routePattern.replace(/^\/|\/$/g, ''))
if (!pageSource && !routeFile) throw new Error(`BaseLayout: no source file for route ${Astro.routePattern}`)
const source: PageSource = pageSource ?? { repo: CONTRIBUTE_REPO, path: repoPath(`src/pages/${routeFile}`), ref: CONTRIBUTE_BRANCH }
const markdownHref = typeof markdown === 'object'
  ? markdown.href
  : markdownPath(Astro.url.pathname, markdownIndex ?? Astro.url.pathname === buildBase)
const versionRoot = portSlug ? withPortRoot(`/${portSlug}/${target.version}/`) : undefined
const llmsRoot = versionRoot && Astro.url.pathname.startsWith(versionRoot) ? versionRoot : withRoot('/')
// The repository the page documents: a product's own, else the one its source
// is in, else its port's. Python's MCP server and tmuxp are separate repos.
const githubRepo = repository
  ?? (source.repo !== CONTRIBUTE_REPO ? source.repo : undefined)
  ?? ((navPort && PORT_BY_SLUG[navPort]?.repo) || CONTRIBUTE_REPO)

---

<!doctype html>
<html lang={locale} data-theme="purple">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withRoot('/favicon.svg')} type="image/svg+xml" />
    {/*
      Preload faces used on initial pages, as measured by check-fonts.mjs.
      ThemeScript waits for document.fonts.ready; preloading starts those
      requests before CSS discovery. See notes/gp-sphinx-parity.md.
    */}
    <Font
      cssVariable="--font-ibm-plex-sans"
      preload={[
        { weight: 400, style: 'normal' },
        { weight: 500, style: 'normal' },
        { weight: 600, style: 'normal' },
        { weight: 700, style: 'normal' },
      ]}
    />
    <Font
      cssVariable="--font-ibm-plex-mono"
      preload={[
        { weight: 400, style: 'normal' },
        { weight: 400, style: 'italic' },
        { weight: 600, style: 'normal' },
        { weight: 700, style: 'normal' },
        { weight: 700, style: 'italic' },
      ]}
    />
    {/*
      The font gate's stylesheet, before anything it hides.

      Paired with `gateOnFonts()` in ThemeScript: the class is only ever added
      by that script, so a reader without JavaScript is never gated, and the
      script lifts it on `document.fonts.ready` or after 3s, whichever is
      first. `visibility` rather than `display` so the layout is computed and
      settled behind the gate — the page appears, it does not assemble.
    */}
    <style is:inline>html.fonts-pending body{visibility:hidden}</style>
    <ThemeScript />
    {/* Paints the picker in the saved language. Must precede the body. */}
    <style is:global set:html={pickerPaintRules()} />
    <Seo
      title={title}
      description={description}
      pagePath={pagePath}
      portSlug={portSlug}
      version={target.version}
      defaultVersion={defaultVersion}
      locale={locale}
      locales={locales}
      sourcePath={sourcePath}
      canonicalOverride={canonicalOverride}
      versionEntry={versionEntry}
      noindex={noindex}
      updated={updated}
      breadcrumbs={breadcrumbs}
    />
    {/* The switcher reads the live manifest, so a version published after
        this build still appears here. */}
    <link rel="preload" href={withRoot('/versions.json')} as="fetch" crossorigin="anonymous" />
    {/* Where an agent finds this page as Markdown without guessing the
        suffix. `data-twin` tells integrations/markdown-twins.ts who writes it. */}
    <link rel="alternate" type="text/markdown" href={markdownHref} data-twin={typeof markdown === 'object' ? 'elsewhere' : markdown} />
  </head>
  <!--
    No colour utilities on `body`.

    `bg-surface` sat in the utilities layer and outranked the
    `body` rule in the base layer, which already paints from
    `--background-color`. So the palette had two sources and the utility won —
    changing the token moved nothing, and the page stayed on slate-950 while
    every component around it followed the token.
  -->
  <body class="min-h-screen antialiased">
    {
      !bare && (
        <SiteHeader
          portSlug={navPort}
          version={navVersion}
          pagePath={sourcePath ?? pagePath}
          locale={locale as Locale}
          sourcePath={localePagePath}
          localeStatuses={(process.env.LIBTMUX_DOCS_PORT ? { en: 'translated' } : localeStatuses ?? { en: 'translated' }) as Record<string, LocaleStatus>}
        />
      )
    }
    {/* Under the header and inside the same `bare` guard: a page without the
        top bar is an embedded or vendored one, and a notice about this site's
        stability has no business appearing there. */}
    {!bare && <PrereleaseNotice />}
    <!-- `data-pagefind-body` scopes the index to the page's own content.
         Without it Pagefind indexed the header and footer on all 1,066
         pages, so every nav label outranked the prose that mentioned it
         once. The filters are what make a 1,000-symbol reference searchable
         at all: "sessions" is a different question in Go than in Swift. -->
    <div
      data-pagefind-body={searchable ? '' : undefined}
      data-pagefind-filter={`port:${portSlug ? (PORT_NAME[portSlug] ?? portSlug) : 'All languages'}`}
    >
      <div data-pagefind-filter={`section:${section}`} data-pagefind-ignore="all" hidden></div>
      <slot />
    </div>
    {!bare && <SiteFooter locale={locale as Locale} source={source} markdownHref={markdownHref} llmsRoot={llmsRoot} githubRepo={githubRepo} />}
    <BackToTop />
    <SearchModal />
  </body>
</html>
