  "go": {
    "watch": {
      "file": "examples/control-mode-subscribe/main.go",
      "lang": "go",
      "ci": {
        "workflow": ".github/workflows/tests.yml",
        "job": "test",
        "step": "Test ${{ matrix.module }}",
        "directory": "${{ matrix.module }}",
        "command": "\"$GITHUB_WORKSPACE/scripts/test-module.sh\" \"${{ matrix.module }}\" -race -count=1",
        "where": "examples"
      },
      "checkedBy": [
        {
          "file": "examples/control-mode-subscribe/output.txt",
          "contains": "heard the rename"
        },
        {
          "file": "examples/control-mode-subscribe/example_test.go",
          "contains": "exampletest.Server(t, func(ctx context.Context, server tmux.Server) error {"
        },
        {
          "file": ".github/workflows/tests.yml",
          "contains": "module: [\".\", \"examples\", \"workspace\""
        },
        {
          "file": "examples/internal/exampletest/exampletest.go",
          "contains": "t.Fatalf(\"run() error = %v; printed so far:\\n%s\", err, printed)"
        },
        {
          "file": "examples/internal/exampletest/exampletest.go",
          "contains": "MatchesFile(t, printed, \"output.txt\")"
        }
      ]
    },
