  "rs": {
    "create-windows": {
      "file": "crates/libtmux/examples/api_creation.rs",
      "lang": "rust",
      "ci": {
        "workflow": ".github/workflows/ci.yml",
        "job": "check",
        "command": "just check"
      },
      "checkedBy": [
        {
          "file": "crates/libtmux/examples/api_creation.rs",
          "contains": "\"expected four panes on server\""
        },
        {
          "file": "scripts/run-examples.sh",
          "contains": "libtmux  | api_creation | query | | | creation: 2 windows, 4 panes"
        },
        {
          "file": "justfile",
          "contains": "examples:\n    bash scripts/run-examples.sh"
        },
        {
          "file": "justfile",
          "contains": "doctest api-examples examples example-tables"
        },
        {
          "file": "scripts/run-examples.sh",
          "contains": "! grep -qF \"$expect\" \"$out\""
        },
        {
          "file": "scripts/run-examples.sh",
          "contains": "set -euo pipefail"
        }
      ]
    },
