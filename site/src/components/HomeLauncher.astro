---
import PagePortSwitcher from './PagePortSwitcher.astro'
import SurfacePicker from './docs/SurfacePicker.astro'
import type { DocumentationSurface } from '../lib/documentation-navigation'
import type { PagePortLink } from '../lib/page-port-links'
import type { Locale } from '../i18n/locales'

interface Props {
  entries: PagePortLink[]
  solutions: { port: string; version: string; surfaces: DocumentationSurface[] }[]
  locale: Locale
}
const { entries, solutions, locale } = Astro.props
const initial = entries[0].port
---

<nav class="home-launcher" aria-label="Choose language and solution" data-home-launcher data-default-port={initial}>
  <div class="clearable-picker home-language-control">
    <PagePortSwitcher entries={entries} portSlug={initial} label="Choose a programming language" homeLanguageIcons>
      <button slot="title-actions" class="home-launcher-reset" type="button" data-home-reset hidden aria-label="Reset language selection">Reset</button>
    </PagePortSwitcher>
    <button class="picker-clear" type="button" data-home-reset hidden aria-label="Clear language selection" title="Clear language selection">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8" /></svg>
    </button>
  </div>
  <span class="home-launcher-next" aria-hidden="true">→</span>
  {solutions.map(({ port, version, surfaces }) => <div class="home-launcher-solution" data-home-language={port} hidden={port !== initial}>
    <SurfacePicker surfaces={surfaces} currentPath="/" port={port} version={version} locale={locale} solutionsOnly />
  </div>)}
  <span class="sr-only" role="status" aria-live="polite" data-home-selection-status></span>
</nav>

<style>
  .home-launcher { --home-launcher-icon-size: 1.5rem; display: flex; align-items: center; gap: .5rem; min-width: 0; }
  .home-launcher [hidden] { display: none !important; }
  .home-launcher-next { color: var(--color-muted); font-size: .8125rem; }
  .home-launcher-solution { flex: none; }
  .home-launcher :global(.page-port-name),
  .home-launcher :global(.page-port-short-name) { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .home-launcher-reset { flex: none; padding: .2rem 0; color: var(--color-link); font-size: .75rem; font-weight: 400; text-decoration: underline; text-underline-offset: .15em; cursor: pointer; }
  .home-launcher-reset:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  .home-launcher :global([data-page-port-switcher] > summary),
  .home-launcher :global(.surface-picker > summary) { min-height: 2.25rem; padding: .25rem .55rem; }
  .home-launcher :global(.surface-current strong) { white-space: nowrap; font-size: .8125rem; font-weight: 400; }
  .home-launcher :global(.surface-artwork) { width: var(--home-launcher-icon-size); height: var(--home-launcher-icon-size); }
  :global(.site-header__bar:has(.home-launcher)) { flex-wrap: nowrap; }
  @media (max-width: 46rem) {
    .home-launcher :global(.doc-picker:not([data-enhanced]) > .doc-picker-panel) { position: fixed; top: auto; left: .5rem; width: min(var(--picker-width), calc(100% - 1rem)); }
    .home-launcher :global(.page-port-name),
    .home-launcher :global(.home-solution-name-full) { display: none; }
    .home-launcher :global(.page-port-short-name),
    .home-launcher :global(.home-solution-name-short) { display: inline; }
  }
  @media (max-width: 35rem) {
    :global(.site-header__bar:has(.home-launcher)) { flex-wrap: wrap; }
    .home-launcher { order: 5; flex-basis: 100%; padding-block: .25rem; }
  }
  @media (max-width: 24rem) {
    .home-launcher { gap: .3rem; }
    .home-launcher :global([data-page-port-switcher] > summary),
    .home-launcher :global(.surface-picker > summary) { gap: .3rem; padding-inline: .35rem; }
  }
</style>

<script>
  import { bindHomeHoverPreview, HOME_PORT_PREVIEW_EVENT, HOME_PREVIEW_FADE } from '../lib/home-hover-preview'

  let controller: AbortController | undefined
  const storageKey = 'libtmux-docs.package-install.port'
  const syncEvent = 'lm-pkg-install:change'
  function initHomeLauncher() {
    controller?.abort()
    controller = new AbortController()
    const root = document.querySelector<HTMLElement>('[data-home-launcher]')
    if (!root) return
    const homepagePath = window.location.pathname
    const picker = root.querySelector<HTMLDetailsElement>('[data-page-port-switcher]')!
    const links = [...picker.querySelectorAll<HTMLAnchorElement>('a[data-port]')]
    const brands: Record<string, string> = JSON.parse(document.documentElement.getAttribute('data-home-brands') || '{}')
    let selected: string | null = null
    let preview: ReturnType<typeof bindHomeHoverPreview>
    const animations = new Set<Animation>()
    const paint = (selection: string | null, fade = false) => {
      const chosen = links.find((link) => link.dataset.port === selection)
      const port = chosen?.dataset.port ?? root.dataset.defaultPort!
      for (const animation of animations) animation.cancel()
      animations.clear()
      for (const panel of document.querySelectorAll<HTMLElement>('[data-home-language]')) {
        panel.hidden = panel.dataset.homeLanguage !== port
        if (!panel.hidden && fade && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const animation = panel.animate([{ opacity: .65 }, { opacity: 1 }], {
            duration: HOME_PREVIEW_FADE, easing: 'ease-out',
          })
          animations.add(animation)
          animation.onfinish = () => animations.delete(animation)
        }
      }
      const name = chosen?.dataset.portName ?? 'Choose a language'
      picker.querySelector('.page-port-name')!.textContent = name
      picker.querySelector('.page-port-short-name')!.textContent = chosen?.dataset.portName ?? 'Port'
      picker.querySelector('summary')!.setAttribute('aria-label', chosen ? `${name}: choose a programming language` : 'Choose a programming language')
      document.documentElement.setAttribute('data-pkg-port', port)
      if (brands[port]) {
        document.documentElement.setAttribute('data-brand', brands[port])
        document.documentElement.setAttribute('data-theme', brands[port])
      }
      if (chosen) document.documentElement.setAttribute('data-home-selected-port', port)
      else document.documentElement.removeAttribute('data-home-selected-port')
      // Widgets render the current task and package without saving a hover.
      window.dispatchEvent(new CustomEvent(HOME_PORT_PREVIEW_EVENT, { detail: { slug: port } }))
    }
    const select = (selection: string | null, moveFocus = false, notify = false) => {
      const chosen = links.find((link) => link.dataset.port === selection)
      if (selection && !chosen) return
      preview.commit()
      selected = selection
      paint(selection)
      const port = chosen?.dataset.port ?? root.dataset.defaultPort!
      for (const link of links) {
        link.removeAttribute('aria-current')
        link.querySelector('.doc-picker-check')?.remove()
      }
      if (chosen) {
        chosen.setAttribute('aria-current', 'true')
        const check = document.createElement('span')
        check.className = 'doc-picker-check'
        check.setAttribute('aria-hidden', 'true')
        check.textContent = '✓'
        chosen.append(check)
      }
      const name = chosen?.dataset.portName ?? 'Choose a language'
      picker.open = false
      try {
        if (chosen) localStorage.setItem(storageKey, port)
        else localStorage.removeItem(storageKey)
      } catch { /* The URL still carries the selection without storage. */ }
      const url = new URL(window.location.href)
      if (chosen) url.searchParams.set('port', port)
      else url.searchParams.delete('port')
      if (url.href !== window.location.href) history.replaceState(history.state, '', url)
      for (const reset of root.querySelectorAll<HTMLButtonElement>('[data-home-reset]')) reset.hidden = !chosen
      root.querySelector('[data-home-selection-status]')!.textContent = chosen
        ? `${name} selected. Choose a solution to open its documentation.`
        : 'Language selection cleared. Showing the default example.'
      if (moveFocus) {
        const target = chosen ? root.querySelector<HTMLElement>(`[data-home-language="${port}"] > details > summary`) : picker.querySelector('summary')
        target?.focus()
      }
      if (notify) window.dispatchEvent(new CustomEvent(syncEvent, { detail: { origin: root, slug: port } }))
    }
    preview = bindHomeHoverPreview({
      options: links,
      show: (link) => { if (picker.open) paint(link.dataset.port!, true) },
      restore: () => paint(selected, true),
      signal: controller.signal,
    })
    picker.addEventListener('toggle', () => { if (!picker.open) preview.cancel() }, { signal: controller.signal })
    controller.signal.addEventListener('abort', () => {
      for (const animation of animations) animation.cancel()
    }, { once: true })
    root.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      if (event.target instanceof Element && event.target.closest('[data-home-reset]')) {
        event.preventDefault()
        select(null, true, true)
        return
      }
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('[data-page-port-switcher] a[data-port]') : null
      if (!link) return
      event.preventDefault()
      select(link.dataset.port!, true, true)
    }, { signal: controller.signal })
    window.addEventListener(syncEvent, ((event: CustomEvent<{ origin: HTMLElement; slug: string }>) => {
      if (event.detail.origin !== root) select(event.detail.slug)
    }) as EventListener, { signal: controller.signal })
    const restore = () => {
      if (window.location.pathname !== homepagePath) return
      const shared = new URL(window.location.href).searchParams.get('port')
      let saved: string | null = null
      try { saved = localStorage.getItem(storageKey) } catch { /* Storage may be disabled. */ }
      const port = [shared, saved].find((value) => links.some((link) => link.dataset.port === value))
      select(port ?? null, false, true)
    }
    restore()
    window.addEventListener('popstate', restore, { signal: controller.signal })
  }
  initHomeLauncher()
  document.addEventListener('astro:after-swap', initHomeLauncher)
</script>
