---
import RegistryIcon from './icons/RegistryIcon.astro'
import { branding } from '../lib/branding'
import { PICKER_GROUPS, PICKER_GROUP_LABEL, PICKER_GROUP_SUMMARY, type Port, type PortPicker } from '../lib/ports'
import { withRoot } from '../lib/site-root'
import '../styles/documentation-picker.css'

/**
 * A top-bar menu of a port's external destinations, built on the documentation
 * picker: a native disclosure, a searchable list of ordinary links and the
 * shared initializer's Escape, outside-click and positioning behavior. Every
 * row is an external link, so the shared link hint draws its one glyph.
 */
interface Props {
  port: Port
  picker: PortPicker
  /**
   * The bar holds the menus from 48rem; below that the Menu panel holds a
   * second copy, and CSS leaves one of them visible.
   */
  placement: 'bar' | 'menu'
}
const { port, picker, placement } = Astro.props

const copy = picker.kind === 'github' ? {
  trigger: 'GitHub: choose a repository', title: 'Source on GitHub', search: 'Find a repository',
  placeholder: 'Find a repository…', empty: 'No matching repositories.',
} : picker.kind === 'packages' ? {
  trigger: 'Packages: choose a package', title: `Packages on ${picker.context}`, search: 'Find a package',
  placeholder: 'Find a package…', empty: 'No matching packages.',
} : {
  trigger: 'Docs: choose an API reference', title: 'API reference', search: 'Find an API reference',
  placeholder: 'Find an API reference…', empty: 'No matching references.',
}
const groups = PICKER_GROUPS.map((group) => ({ group, rows: picker.rows.filter((row) => row.group === group) }))
  .filter((entry) => entry.rows.length > 0)
const artwork = (group: string) => withRoot(branding(port.slug, group === 'core' ? '' : group).asset('logo.svg'))
// A single destination needs no search.
const searchable = picker.rows.length > 1
---
<details class="doc-picker header-picker" data-doc-picker data-header-picker={picker.kind} data-placement={placement} data-pagefind-ignore="all">
  <summary class="topnav-chip header-picker__trigger" aria-label={copy.trigger}>
    <RegistryIcon icon={picker.icon} decorative />
    <span class="header-picker__label">{picker.label}</span>
    <svg class="doc-picker-caret" width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
  </summary>
  <div class="doc-picker-panel header-picker__panel" data-picker-panel>
    <p class="doc-picker-title">{copy.title} <span class="doc-picker-count">{picker.rows.length}</span></p>
    {searchable && <label class="doc-picker-search" hidden data-picker-search-label>
      <span class="sr-only">{copy.search}</span>
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3.5 3.5"/></svg>
      <input type="search" placeholder={copy.placeholder} autocomplete="off" data-picker-search />
    </label>}
    {groups.map(({ group, rows }) => <div class="header-picker__group" role="group" aria-label={PICKER_GROUP_LABEL[group]} data-picker-group>
      <p class="header-picker__group-title">
        <img src={artwork(group)} width="24" height="24" alt="" loading="lazy" decoding="async" />
        <span><strong>{PICKER_GROUP_LABEL[group]}</strong><small>{PICKER_GROUP_SUMMARY[group]}</small></span>
      </p>
      {rows.map((row) => <a class="doc-picker-option header-picker__option" href={row.url} rel="noopener" data-picker-option data-match={row.match}>
        <span class="header-picker__icon"><RegistryIcon icon={row.icon} decorative /></span>
        <span class="header-picker__text"><span class="header-picker__name">{row.label}</span><small>{row.detail}</small></span>
      </a>)}
    </div>)}
    {searchable && <>
      <p class="doc-picker-empty" data-picker-empty hidden>{copy.empty}</p>
      <p class="sr-only" role="status" data-picker-status></p>
    </>}
    <div class="header-picker__footer"><span>{port.name}</span>{' · '}<span>{picker.context}</span></div>
  </div>
</details>
