---
import { cva, type VariantProps } from '../lib/cva'

const dottedDividerVariants = cva('flex items-center justify-center', {
  variants: {
    spacing: {
      sm: 'my-8 md:my-10 lg:my-12',
      md: 'my-12 md:my-16 lg:my-20',
      lg: 'my-16 md:my-20 lg:my-24',
    },
  },
  defaultVariants: {
    spacing: 'md',
  },
})

interface Props extends VariantProps<typeof dottedDividerVariants> {
  className?: string
}

const { spacing, className = '' } = Astro.props
---

<div class={dottedDividerVariants({ spacing, class: className })}>
  <div class="flex gap-2">
    <div class="w-2 h-2 bg-theme-primary rounded-full opacity-40"></div>
    <div class="w-2 h-2 bg-theme-primary rounded-full opacity-70"></div>
    <div class="w-2 h-2 bg-theme-primary rounded-full"></div>
    <div class="w-2 h-2 bg-theme-primary rounded-full opacity-70"></div>
    <div class="w-2 h-2 bg-theme-primary rounded-full opacity-40"></div>
  </div>
</div>