---
/**
 * The search UI, used by the /search/ page and by the Cmd-K modal.
 *
 * Pagefind's own default UI renders a title and an excerpt and nothing else,
 * which on a reference of twelve thousand symbols is not enough to choose
 * between two hits: `test.scaled` and `tmux.MaximumTestedVersion` look alike
 * until you can see the package and the file. This renders Pagefind's results
 * itself so a hit can show where it lives.
 *
 * Vanilla, like the rest of this site. The shape is borrowed from
 * social-embed's search (debounced query, sub-results, arrow-key selection);
 * that one is React and this site has no UI framework, and adding one to
 * render a list would be a poor trade.
 */
import { PORTS } from '../lib/ports'
import type { SubResultsDisplay } from '../lib/search-panel'
import { withRoot } from '../lib/site-root'

interface Props {
  /** The modal autofocuses and closes on Escape; the page does neither. */
  modal?: boolean
  /** How a page's matching sections show under it. Omitted, they do not. */
  subResults?: SubResultsDisplay
  /** A query to run as soon as the panel mounts. */
  initialQuery?: string
  /** Current port's Pagefind filter value. */
  initialPort?: string
  /** Search a small built-in index instead of Pagefind's, for the demo. */
  mock?: boolean
  /** Keep the query, scope and facets in the address: the search page does, the dialog does not. */
  url?: boolean
  /** Where the index-failure message points: the API index and the guides. */
  fallbackLinks?: { label: string; href: string }[]
}

const { modal = false, subResults, initialQuery, initialPort, mock = false, url = false, fallbackLinks } = Astro.props as Props
// A breadcrumb names a port as the site does, not by its slug.
const segmentNames =
  subResults === 'breadcrumbs' ? JSON.stringify(Object.fromEntries(PORTS.map((port) => [port.slug, port.name]))) : undefined
---

<div
  class="search-panel"
  data-modal={modal ? 'true' : undefined}
  data-search-bundle={withRoot('/pagefind/')}
  data-sub-results={subResults}
  data-initial-query={initialQuery}
  data-initial-port={initialPort}
  data-url={url ? '' : undefined}
  data-fallback-links={fallbackLinks?.length ? JSON.stringify(fallbackLinks) : undefined}
  data-mock={mock ? '' : undefined}
  data-segment-names={segmentNames}
>
  <div class="search-panel__bar">
    <div class="search-panel__field">
      <svg class="search-panel__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="2"></circle>
        <path d="m14 14 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <input
        class="search-panel__input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder={initialPort ? `Search ${initialPort} docs and API` : 'Search the documentation'}
        aria-label="Search"
      />
      <button type="button" class="search-panel__clear-field" aria-label="Clear search" hidden>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
      {modal && <kbd class="search-panel__hint">Esc</kbd>}
    </div>
    {modal && <button type="button" class="search-panel__close" aria-label="Close search">Close</button>}
  </div>

  {initialPort && (
    <div class="search-panel__scope" role="group" aria-label="Search scope">
      <span class="search-panel__scope-label">Search in</span>
      <div class="search-panel__seg">
        <button type="button" data-scope="port" aria-pressed="true">{initialPort} docs and API</button>
        <button type="button" data-scope="reference" aria-pressed="false">{initialPort} API only</button>
        <button type="button" data-scope="all" aria-pressed="false">All languages</button>
      </div>
    </div>
  )}

  <div class="search-panel__body">
    <aside class="search-panel__filters" aria-label="Filters" hidden>
      {/* Open and without its summary from bp-phone up; below it the script closes it, and the summary says how many filters are on (record 0076). */}
      <details class="search-panel__fold" open>
        <summary class="search-panel__fold-summary">Filters</summary>
        <div class="search-panel__fold-body">
          <div class="search-panel__facet search-panel__facet--section" hidden>
            <p class="search-panel__filters-title">Section</p>
            <div class="search-panel__filter-list search-panel__section-list"></div>
          </div>
          <div class="search-panel__facet search-panel__facet--kind" hidden>
            <p class="search-panel__filters-title">Kind</p>
            <div class="search-panel__filter-list search-panel__kind-list"></div>
          </div>
          <div class="search-panel__facet search-panel__facet--port">
            <p class="search-panel__filters-title">Port</p>
            <div class="search-panel__filter-list"></div>
          </div>
        </div>
      </details>
    </aside>
    <div class="search-panel__results" role="listbox" aria-label="Search results">
      <p class="search-panel__status">Type to search.</p>
    </div>
  </div>
</div>

<style is:global>
  /*
   * Global, not scoped.
   *
   * Astro scopes a component's CSS with a `data-astro-cid-*` attribute it
   * stamps on the elements it renders. The results, the filters and the
   * "show more" button are built by `lib/search-panel.ts` at runtime, so they
   * carry no such attribute and scoped rules miss every one of them — the
   * panel rendered completely unstyled. The class names are namespaced
   * instead.
   */
  .search-panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .search-panel__bar {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
  }

  .search-panel__field {
    display: flex;
    flex: 1;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--control-border);
    border-radius: var(--radius-md, 0.375rem);
    background: var(--color-background-secondary);
  }

  .search-panel__icon {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    color: var(--color-foreground-muted);
  }

  /* The input draws no ring of its own: the field around it does, with the 2px ring every control takes. */
  .search-panel__field:focus-within {
    outline: 2px solid var(--focus-ring-color, var(--theme-primary));
    outline-offset: 2px;
  }

  .search-panel__input {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--text-color);
    font: inherit;
    outline: none;
  }

  .search-panel[data-modal='true'] .search-panel__input {
    min-width: 0;
  }

  /* The field's own clear button replaces the browser's, which sits where the
     hint goes. */
  .search-panel__input::-webkit-search-cancel-button {
    display: none;
  }

  /* Clearing the query is its own control: Escape closes the dialog. */
  .search-panel__clear-field {
    position: relative;
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    border-radius: 0.25rem;
    background: none;
    color: var(--color-foreground-muted);
    cursor: pointer;
  }

  .search-panel__clear-field[hidden] {
    display: none;
  }

  .search-panel__clear-field svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .search-panel__clear-field:hover {
    color: var(--text-color);
  }

  .search-panel__clear-field:focus-visible,
  .search-panel__close:focus-visible {
    outline: 2px solid var(--focus-ring-color, var(--theme-primary));
    outline-offset: 2px;
  }

  /* The dialog's close control shows where it fills the screen: no backdrop to click and no Escape key to count on.
     The media query is SearchModal.astro's full-screen one, since the panel cannot see its dialog's size. */
  .search-panel__close {
    display: none;
    flex: none;
    align-items: center;
    justify-content: center;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    padding: 0 0.75rem;
    border: 1px solid var(--control-border);
    border-radius: var(--radius-md, 0.375rem);
    background: var(--color-background-secondary);
    color: var(--text-color);
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 29.999rem), (max-height: 29.999rem) and (orientation: landscape) {
    .search-panel__close {
      display: inline-flex;
    }

    .search-panel__hint {
      display: none;
    }
  }

  @media (pointer: coarse) {
    .search-panel__clear-field::after {
      content: '';
      position: absolute;
      inset: calc((100% - var(--touch-target)) / 2) -0.5rem;
    }
  }

  .search-panel__hint {
    flex: none;
    padding: 0.1rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-foreground-muted);
    border: 1px solid var(--control-border);
    border-radius: 0.25rem;
  }

  .search-panel__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 1rem;
    min-height: 0;
  }

  /* Keep the stacked filters from taking the modal's entire results area. */
  .search-panel[data-modal='true'] .search-panel__body:not(:has(> .search-panel__filters[hidden])) {
    grid-template-rows: minmax(0, 1fr) minmax(0, 2fr);
  }

  .search-panel[data-modal='true'] .search-panel__filters {
    min-height: 0;
    overflow-y: auto;
    padding: 0.125rem;
    scroll-padding-block: 0.5rem;
  }

  /* The filter column only when there are filters: an index without them,
     such as the demo's, would otherwise squeeze results into 14rem. */
  @media (min-width: 56rem) {
    .search-panel__body:not(:has(> .search-panel__filters[hidden])) {
      grid-template-columns: 14rem minmax(0, 1fr);
    }

    .search-panel[data-modal='true'] .search-panel__body:not(:has(> .search-panel__filters[hidden])) {
      grid-template-rows: minmax(0, 1fr);
    }
  }

  .search-panel__filters-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .search-panel__filter-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.6rem;
  }

  .search-panel__filter {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
  }

  /* 13px, so a count is as legible as the label beside it. */
  .search-panel__filter-count {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--color-foreground-muted);
  }

  .search-panel__facet + .search-panel__facet {
    margin-top: 1rem;
  }

  .search-panel__facet[hidden] {
    display: none;
  }

  /* The filters fold into one disclosure below bp-phone (30rem), between the field and the results (record 0076).
     From there up the column shows as it did and the summary is not drawn. */
  .search-panel__fold-summary {
    display: none;
  }

  @media (max-width: 29.999rem) {
    .search-panel__fold-summary {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-height: var(--touch-target);
      padding: 0 0.8rem;
      border: 1px solid var(--control-border);
      border-radius: var(--radius-md, 0.375rem);
      background: var(--color-background-secondary);
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
    }

    .search-panel__fold-summary::marker {
      content: '';
    }

    .search-panel__fold-summary::after {
      content: '';
      width: 0.5rem;
      height: 0.5rem;
      margin-inline-start: auto;
      border-inline-end: 2px solid currentColor;
      border-block-end: 2px solid currentColor;
      transform: rotate(45deg);
    }

    .search-panel__fold[open] > .search-panel__fold-summary::after {
      transform: rotate(-135deg);
    }

    .search-panel__fold-summary:focus-visible {
      outline: 2px solid var(--focus-ring-color, var(--theme-primary));
      outline-offset: 2px;
    }

    .search-panel__fold-body {
      padding-top: 0.5rem;
    }

    /* Rows reach the touch target with their counts kept; the whole row is the label's hit area. */
    .search-panel__filter-list {
      gap: 0;
      margin-top: 0;
    }

    .search-panel__filter {
      min-height: var(--touch-target);
    }

    .search-panel__filter input {
      width: 1.125rem;
      height: 1.125rem;
    }

    /* In the full-screen dialog the open filters scroll inside their own band and leave the results the rest. */
    .search-panel[data-modal='true'] .search-panel__body:not(:has(> .search-panel__filters[hidden])) {
      grid-template-rows: auto minmax(0, 1fr);
    }

    .search-panel[data-modal='true'] .search-panel__fold-body {
      max-height: min(50dvh, 24rem);
      overflow-y: auto;
    }
  }

  /* The scope is the first decision, so it sits under the field. */
  .search-panel__scope {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-foreground-muted);
  }

  .search-panel__seg {
    display: inline-flex;
    flex-wrap: wrap;
    border: 1px solid var(--control-border, var(--color-background-border));
    border-radius: var(--radius-md, 0.375rem);
    overflow: hidden;
  }

  .search-panel__seg button {
    min-height: 1.75rem;
    padding: 0 0.75rem;
    border: 0;
    background: transparent;
    color: var(--text-color);
    font: inherit;
    cursor: pointer;
  }

  .search-panel__seg button + button {
    border-left: 1px solid var(--color-background-border);
  }

  .search-panel__seg button[aria-pressed='true'] {
    background: color-mix(in oklab, var(--theme-primary) 10%, transparent);
    color: var(--theme-primary);
    font-weight: 600;
  }

  .search-panel__seg button:focus-visible,
  .search-panel__clear:focus-visible,
  .search-panel__widen:focus-visible,
  .search-panel__failure button:focus-visible {
    outline: 2px solid var(--focus-ring-color, var(--theme-primary));
    outline-offset: 2px;
  }

  /* The segments run to the control's edge, which clips a ring drawn outside them. */
  .search-panel__seg button:focus-visible {
    outline-offset: -2px;
  }

  .search-panel__clear,
  .search-panel__widen,
  .search-panel__failure button {
    margin-left: 0.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-link);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .search-panel__widen {
    display: block;
    margin: 0.25rem 0 0;
  }

  .search-panel__failure {
    padding: 1rem;
    border: 1px solid var(--color-background-border);
    border-radius: var(--radius-md, 0.375rem);
    background: var(--color-background-secondary);
  }

  .search-panel__failure p {
    margin: 0.25rem 0 0.75rem;
    color: var(--color-foreground-muted);
  }

  .search-panel__failure-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .search-panel__failure-actions button {
    margin: 0;
  }

  .search-panel__failure-actions a {
    color: var(--color-link);
  }

  .search-panel__owner {
    font-weight: 400;
    color: var(--color-foreground-muted);
  }

  .search-panel__results {
    min-width: 0;
    overflow-y: auto;
  }

  .search-panel[data-modal='true'] .search-panel__results {
    padding-block: 0.125rem;
    scroll-padding-block: 0.125rem;
  }

  .search-panel__status {
    font-size: 0.875rem;
    color: var(--color-foreground-muted);
  }

  .search-panel__result {
    display: block;
    padding: 0.7rem 0.8rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md, 0.375rem);
    color: inherit;
  }

  .search-panel__result:hover,
  .search-panel__result[aria-selected='true'] {
    background: var(--color-api-background-hover);
    border-color: var(--color-background-border);
  }

  .search-panel__result-title {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-link);
  }

  .search-panel__result-excerpt {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    color: var(--color-foreground-muted);
  }

  /* Pagefind returns its own <mark> around the matched terms. */
  .search-panel__result-excerpt mark,
  .search-panel__sub-excerpt mark {
    background: var(--color-highlight-on-target);
    color: inherit;
    border-radius: 0.15rem;
  }

  /*
   * Where the hit lives: the URL, the file it was extracted from, the
   * package. This is the part Pagefind's default UI has no place for, and the
   * reason a list of twelve thousand symbols was hard to choose from.
   */
  .search-panel__result-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.85rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.125rem;
    color: var(--color-foreground-muted);
  }

  .search-panel__result-meta span {
    overflow-wrap: anywhere;
  }

  /* `breadcrumbs`: the page's path above its title. */
  .search-panel__breadcrumb {
    margin-bottom: 0.15rem;
    font-size: 0.7rem;
    color: var(--color-foreground-muted);
  }

  /* `inline` and `toggle`: a page's matching sections under it. */
  .search-panel__subs {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0 0 0.4rem;
    padding: 0 0 0 0.8rem;
    list-style: none;
  }

  .search-panel__subs[hidden] {
    display: none;
  }

  .search-panel__sub {
    display: flex;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md, 0.375rem);
    color: inherit;
    font-size: 0.8125rem;
  }

  .search-panel__sub:hover,
  .search-panel__sub[aria-selected='true'] {
    background: var(--color-api-background-hover);
    border-color: var(--color-background-border);
  }

  .search-panel__sub-arrow {
    flex: none;
    color: var(--color-foreground-muted);
  }

  .search-panel__sub-body {
    min-width: 0;
  }

  .search-panel__sub-title {
    font-weight: 600;
  }

  .search-panel__sub-excerpt {
    display: block;
    overflow: hidden;
    color: var(--color-foreground-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-panel__more-subs {
    padding: 0 0.6rem;
    font-size: 0.75rem;
    color: var(--color-foreground-muted);
  }

  .search-panel__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0 0 0.4rem 0.8rem;
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.75rem;
    color: var(--color-foreground-muted);
    cursor: pointer;
  }

  .search-panel__toggle svg {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 150ms;
  }

  .search-panel__toggle[aria-expanded='true'] svg {
    transform: rotate(90deg);
  }

  .search-panel__more {
    width: 100%;
    margin-top: 0.75rem;
    padding: 0.55rem;
    font-size: 0.875rem;
    border: 1px solid var(--control-border);
    border-radius: var(--radius-md, 0.375rem);
    background: var(--color-background-secondary);
    color: var(--color-link);
    cursor: pointer;
  }
</style>

<script>
  import { mountSearchPanel, type SubResultsDisplay } from '../lib/search-panel'
  import { waitForAppearance } from '../lib/page-readiness'

  async function mount(root: HTMLElement) {
    if (root.dataset.mounted) return
    root.dataset.mounted = 'true'
    const bundle = root.dataset.searchBundle!
    const mock = root.dataset.mock === undefined ? undefined : (await import('../lib/search-mock')).mockPagefind(bundle)
    if (!root.isConnected) return
    const handle = mountSearchPanel(root, bundle, {
      subResults: root.dataset.subResults as SubResultsDisplay | undefined,
      initialQuery: root.dataset.initialQuery,
      initialPort: root.dataset.initialPort,
      url: root.dataset.url !== undefined,
      fallbackLinks: root.dataset.fallbackLinks ? (JSON.parse(root.dataset.fallbackLinks) as { label: string; href: string }[]) : undefined,
      mock,
      segmentNames: root.dataset.segmentNames ? (JSON.parse(root.dataset.segmentNames) as Record<string, string>) : undefined,
    })
    const dialog = root.closest('dialog')
    if (dialog) {
      handle.focus()
      // Closing keeps the query: reopening finds it where it was, and it goes
      // only when the page changes and a new dialog arrives with it.
      dialog.addEventListener('search-modal:open', () => handle.focus())
    }
    await handle.ready
  }

  // A swap brings its own panels, so each page's are mounted when it arrives.
  function mountPanels() {
    for (const root of document.querySelectorAll<HTMLElement>('.search-panel')) {
      const dialog = root.closest('dialog')
      if (dialog) dialog.addEventListener('search-modal:open', () => { void mount(root) }, { once: true })
      else waitForAppearance(mount(root))
    }
  }
  mountPanels()
  document.addEventListener('astro:after-swap', mountPanels)
</script>
