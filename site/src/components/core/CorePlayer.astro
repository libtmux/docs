---
/**
 * A port's landing-page program, played: stepping through it marks each API
 * call in the source, draws the tmux that call left, and shows what it
 * returned and the tmux commands it sent.
 *
 * Everything shown was recorded by running the displayed program
 * (`scripts/gen-core-recording.mjs`, `data/core-recordings/<port>.json`). The
 * drawing and the controls are the MCP replay's own (`replay/TmuxScreen.astro`,
 * `replay/ReplayControls.astro`, `lib/replay-player.ts`); the code and the
 * Error handling and Cleanup choices are `HomeExample.astro`'s, so each choice
 * plays the steps its view of the program holds (`lib/core-player.ts`).
 *
 * The page is drawn at the step the script first shows, the state before the
 * first call, so binding the script changes nothing on screen. Without script,
 * and until the script binds for a reader who asked for less motion (whose
 * player starts finished), the final tmux and every step's result show
 * instead; `core-player.css` swaps the two.
 *
 * The caller decides whether the recording may be played at all
 * (`playableCapability`); with none, it keeps `HomeExample` on its own.
 */
import { Code } from 'astro-expressive-code/components'
import HomeExample from '../HomeExample.astro'
import ReplayControls from '../replay/ReplayControls.astro'
import TmuxScreen from '../replay/TmuxScreen.astro'
import { coreFrames, replyText, returnedText, stepChanges, stepNote, viewSteps, visibleCommands } from '../../lib/core-player'
import type { CoreCapability, CoreRecording } from '../../lib/core-recording'
import { callHref, typeText } from '../../lib/core-apis'
import { buildTarget } from '../../lib/versions'
import { HOME_VIEWS, homeProgram, type HomeExample as Example } from '../../lib/quickstarts'
import '../../styles/mcp-replay.css'
import '../../styles/core-player.css'

interface Props {
  port: string
  language: string
  example: Example
  recording: CoreRecording
  capability: CoreCapability
  /** Which capability of the port this is; it keeps the ids of two players on one page apart. */
  capabilityId?: string
  /** A program with no Error handling and Cleanup views plays one view and shows no toggles. */
  options?: boolean
  /** Show the example's own "Run this example" section. */
  run?: boolean
}
const { port, language, example, capability, capabilityId = 'typed-graph', options = true, run = true } = Astro.props as Props
const shownViews = options ? HOME_VIEWS : (['concise'] as const)
const steps = capability.steps
const total = steps.length
const frames = coreFrames(capability)
// Where each call is in each view of the program: the views differ in the lines they add.
const views = Object.fromEntries(shownViews.map((view) => [view, viewSteps(capability, homeProgram(example, view).replace(/\n$/, ''))]))
const before = (index: number) => (index === 0 ? capability.tmuxBefore : steps[index - 1]!.tmux)
const beforeText = capability.tmuxBefore.sessions.length === 0 ? 'No tmux server is running yet.' : 'tmux is running.'
// A call's name and its returned type link to the API reference: this build's version on the port's own site, its default version elsewhere.
const links = { version: process.env.LIBTMUX_DOCS_PORT === port ? buildTarget(process.env).version : undefined, code: shownViews.map((view) => homeProgram(example, view)).join('\n') }
const callLinks = new Map(steps.map((step) => [step.label, callHref(port, step.label, links)]))
// The note under the drawing starts with the call it follows; that name links too.
const noteParts = (index: number) => {
  const step = steps[index]!
  const note = stepNote(step, before(index))
  const head = `tmux after ${step.label}`
  return note.startsWith(head) ? { label: step.label, href: callLinks.get(step.label), rest: note.slice(head.length) } : { rest: note }
}
// What each call's dot names in its tooltip: the call, and what the note says it did.
const tips = steps.map((step, index) => ({ call: step.label, text: noteParts(index).rest.replace(/^: /, '').replace(/\.$/, '') }))
---
<HomeExample port={port} language={language} example={example} heading={false} options={options} run={run} views={shownViews}>
  <div slot="beside" class="core-player__side" data-core-plan={JSON.stringify(views)} data-core-tips={JSON.stringify(tips)}>
    <div class="core-player__tmux" data-tmux role="group" aria-label="tmux state after the call shown">
      {frames.map((frame) => (
        <div class="mcp-frame" data-frame={frame.done} data-off={frame.done === 0 ? undefined : ''}>
          <TmuxScreen frame={frame} client marks={frame.done === 0 ? undefined : stepChanges(steps[frame.done - 1]!, before(frame.done - 1)).marks} idPrefix={`cp-${port}-${capabilityId}`} hadSessions={frames.some((earlier) => earlier.done < frame.done && earlier.sessions.length > 0)} />
          <p class="mcp-frame__note">{frame.done === 0 ? 'tmux before the first call: no server is running.' : (() => {
            const note = noteParts(frame.done - 1)
            return <>{note.label && <>tmux after {note.href ? <a href={note.href}><code>{note.label}</code></a> : <code>{note.label}</code>}</>}{note.rest}</>
          })()}</p>
        </div>
      ))}
    </div>
    <div class="core-player__results" data-results>
      <section class="core-result" data-result="0">
        <h3 class="core-result__title">Before the first call</h3>
        <p class="core-result__plain">{beforeText}</p>
      </section>
      {steps.map((step, index) => {
        const { commands, probes } = visibleCommands(step)
        const changes = commands.filter((command) => command.mutates).length
        return (
          <section class="core-result" data-result={index + 1} data-off>
            <h3 class="core-result__title">
              <span>{callLinks.get(step.label) ? <a href={callLinks.get(step.label)}><code>{step.label}</code></a> : <code>{step.label}</code>} returned <code>{typeText(port, step.type, links).map((part) => part.href ? <a href={part.href}>{part.text}</a> : part.text)}</code></span>
              <button type="button" class="core-result__pin" data-pin aria-pressed="false" hidden aria-label={`Pin the tmux state after ${step.label}`}><svg class="mcp-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2.5h6v11L8 11l-3 2.5z" /></svg></button>
            </h3>
            <div class="core-result__value"><Code code={returnedText(step)} lang="json" frame="none" wrap /></div>
            {commands.length === 0
              ? <p class="core-result__plain">The call sent no tmux command.</p>
              : (
                <details class="core-result__tmux">
                  <summary>{commands.length} tmux command{commands.length === 1 ? '' : 's'}{changes > 0 && <>, {changes} that change{changes === 1 ? 's' : ''} tmux</>}</summary>
                  <ol class="core-commands">
                    {commands.map((command) => (
                      <li class={command.mutates ? 'is-change' : undefined}>
                        <code class="core-commands__sent" title={command.tmux}>{command.tmux}</code>
                        <span class={`core-commands__reply${command.exit === 0 ? '' : ' is-refused'}`}>{replyText(command)}</span>
                      </li>
                    ))}
                  </ol>
                  {probes > 0 && <p class="core-commands__note">Before these, the library asked tmux about itself {probes} time{probes === 1 ? '' : 's'} (its version, its daemon, how a control client reads escapes).</p>}
                </details>
              )}
            {step.notifications && step.notifications.length > 0 && (
              <details class="core-result__tmux">
                <summary>{step.notifications.length} notification{step.notifications.length === 1 ? '' : 's'} from tmux while the call ran</summary>
                <ol class="core-commands">
                  {step.notifications.map((line) => <li><code class="core-commands__sent" title={line}>{line}</code></li>)}
                </ol>
              </details>
            )}
          </section>
        )
      })}
    </div>
  </div>
  <ReplayControls slot="controls" start="Show tmux before the first call" playable={views.concise!.length} marks={steps.map((step) => `Show the state after ${step.label}`)} />
</HomeExample>

<script>
  import { bindClientViews, bindReplay } from '../../lib/replay-player'

  /** A call's place in a view: the step it is in the recording, and its lines in that view's code. */
  type Placed = { index: number; lines: [number, number] }

  function bindCore(side: HTMLElement) {
    const root = side.closest<HTMLElement>('[data-home-example]')!
    const body = root.querySelector<HTMLElement>('[data-body]')!
    const plan = JSON.parse(side.dataset.corePlan!) as Record<string, Placed[]>
    // A program with one view has no toggles.
    const errors = root.querySelector<HTMLInputElement>('[data-example-errors]')
    const cleanup = root.querySelector<HTMLInputElement>('[data-example-cleanup]')
    const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')]
    const results = [...root.querySelectorAll<HTMLElement>('[data-result]')]
    const pins = [...root.querySelectorAll<HTMLButtonElement>('[data-pin]')]
    const tips = JSON.parse(side.dataset.coreTips!) as { call: string; text: string }[]
    const marks = [...root.querySelectorAll<HTMLElement>('[data-mark]')]
    // A label in a frame's status line shows its window there; moving to another call shows the client's window again.
    const clientViews = bindClientViews(root.querySelector<HTMLElement>('[data-tmux]')!)
    let drawnFrame = -1
    // A touch screen fires mouseenter on a tap and never mouseleave, so only a pointer that can hover previews.
    const canHover = window.matchMedia?.('(hover: hover)').matches ?? true
    // The program the reader sees depends on the two choices above it, which another script owns; read them whenever they matter.
    const viewName = () => (errors?.checked ? (cleanup?.checked ? 'full' : 'errors') : (cleanup?.checked ? 'cleanup' : 'concise'))
    const placed = () => plan[viewName()]!
    const codeLines = (view: string) => [...root.querySelectorAll<HTMLElement>(`[data-home-view="${view}"] .ec-line`)]
    // The call a code line belongs to, as its position in the view's steps (1 is the first call).
    const callAt = (line: HTMLElement) => {
      const lines = codeLines(viewName())
      const number = lines.indexOf(line) + 1
      return number === 0 ? 0 : placed().findIndex((call) => number >= call.lines[0] && number <= call.lines[1]) + 1
    }

    // The program is longer than its box: bring the call into the middle of it when the call changes, without moving the page.
    let revealed: Placed | undefined
    const reveal = (call: Placed) => {
      const lines = codeLines(viewName())
      const first = lines[call.lines[0] - 1]
      const last = lines[call.lines[1] - 1]
      const pre = first?.closest('pre')
      if (!first || !last || !pre) return
      const origin = pre.getBoundingClientRect().top - pre.scrollTop
      const top = first.getBoundingClientRect().top - origin
      const bottom = last.getBoundingClientRect().bottom - origin
      if (top >= pre.scrollTop && bottom <= pre.scrollTop + pre.clientHeight) return
      pre.scrollTo({ top: Math.max(0, top - (pre.clientHeight - (bottom - top)) / 2), behavior: window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
    }

    // Full screen takes the frame that holds the program, the tmux and the controls, not the choices above it or the setup below.
    // The program's size follows the width of its own column and its longest line, which a returned value beside it cannot see; it takes the size the program was given.
    const matchProgramSize = () => {
      const program = root.querySelector<HTMLElement>(`.home-example-view[data-home-view="${viewName()}"] pre code`)
      if (program) side.style.setProperty('--core-program-size', getComputedStyle(program).fontSize)
    }
    const player = bindReplay(root.querySelector<HTMLElement>('.home-example-player')!, {
      body,
      total: () => placed().length,
      render({ shown, pinned }) {
        matchProgramSize()
        const call = shown === 0 ? undefined : placed()[shown - 1]
        const frame = call ? call.index + 1 : 0
        if (frame !== drawnFrame) clientViews.reset()
        drawnFrame = frame
        frames.forEach((element) => { element.toggleAttribute('data-off', Number(element.dataset.frame) !== frame) })
        results.forEach((element) => { element.toggleAttribute('data-off', Number(element.dataset.result) !== frame) })
        pins.forEach((pin) => { pin.setAttribute('aria-pressed', String(pinned !== null && shown === pinned)) })
        // A dot names the call it shows in this view of the program, which the choices above it change.
        marks.forEach((mark) => {
          const position = Number(mark.dataset.mark)
          const at = position === 0 ? undefined : placed()[position - 1]
          if (at) mark.setAttribute('aria-label', `Show the state after ${tips[at.index]!.call}`)
        })
        for (const view of Object.keys(plan)) {
          codeLines(view).forEach((line, position) => {
            const mine = view === viewName() && call !== undefined && position + 1 >= call.lines[0] && position + 1 <= call.lines[1]
            line.classList.toggle('is-current', mine)
            line.classList.toggle('is-pinned', mine && pinned !== null)
          })
        }
        if (call && call !== revealed) reveal(call)
        revealed = call
      },
      ownsKey: (target) => target.hasAttribute('data-pin'),
      tip: (position) => {
        if (position === 0) return { text: 'tmux before the first call' }
        const at = placed()[position - 1]
        return at ? tips[at.index] : undefined
      },
    })
    if (!player) return

    // Every line of a call answers to it: hovering previews, clicking pins.
    for (const [view, calls] of Object.entries(plan)) {
      codeLines(view).forEach((line, position) => {
        if (calls.some((call) => position + 1 >= call.lines[0] && position + 1 <= call.lines[1])) line.classList.add('is-call')
      })
    }
    const code = root.querySelector<HTMLElement>('.home-example-stage')!
    new ResizeObserver(matchProgramSize).observe(code)
    if (canHover) {
      code.addEventListener('mouseover', (event) => {
        const line = (event.target as HTMLElement).closest<HTMLElement>('.ec-line.is-call')
        if (line) player.hover(callAt(line))
      })
      code.addEventListener('mouseout', (event) => {
        if ((event.target as HTMLElement).closest('.ec-line.is-call')) player.hover(null)
      })
    }
    code.addEventListener('click', (event) => {
      const line = (event.target as HTMLElement).closest<HTMLElement>('.ec-line.is-call')
      if (line) player.togglePin(callAt(line))
    })
    pins.forEach((pin) => {
      pin.hidden = false
      pin.addEventListener('click', () => player.togglePin(player.state().shown))
    })
    // The choices change which calls the program has, and another script restores them after this one has bound.
    root.addEventListener('change', () => player.refresh())
    window.addEventListener('popstate', () => setTimeout(() => player.refresh(), 0))
    requestAnimationFrame(() => player.refresh())
  }

  const bindAll = () => document.querySelectorAll<HTMLElement>('[data-core-plan]:not([data-live])').forEach((side) => {
    side.setAttribute('data-live', '')
    bindCore(side)
  })
  bindAll()
  document.addEventListener('astro:after-swap', bindAll)
</script>
