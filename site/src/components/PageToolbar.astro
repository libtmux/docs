---
import PageActions from './PageActions.astro'
import PagePortSwitcher from './PagePortSwitcher.astro'
import SymbolName from './api/SymbolName.astro'
import type { PagePortLink } from '../lib/page-port-links'
import type { BreadcrumbItem } from '../lib/sidebar'

interface Props {
  breadcrumbs: BreadcrumbItem[]
  pagePorts?: PagePortLink[]
  port?: string
  editHref?: string
  editLabel?: string
}
const { breadcrumbs, pagePorts = [], port, editHref, editLabel } = Astro.props
---

<div class="not-prose mb-4 flex items-center gap-x-4" data-page-toolbar data-pagefind-ignore="all">
  <nav aria-label="Breadcrumb" class="min-w-0 flex-1 text-sm text-muted">
    <ol class="flex flex-wrap gap-x-2 gap-y-1">
      {breadcrumbs.map((item, i) => <li class="min-w-0 max-w-full wrap-anywhere">
        {i > 0 && <span aria-hidden="true" class="me-2">/</span>}
        {i === breadcrumbs.length - 1
          ? <span data-breadcrumb-item aria-current="page">{item.symbol ? <SymbolName name={item.name} /> : item.name}</span>
          : item.url ? <a data-breadcrumb-item class="hover:underline" href={item.url}>{item.symbol ? <SymbolName name={item.name} /> : item.name}</a>
          : <span data-breadcrumb-item>{item.symbol ? <SymbolName name={item.name} /> : item.name}</span>}
      </li>)}
    </ol>
  </nav>
  <div class="page-toolbar-controls ml-auto flex shrink-0 items-center gap-2">
    {pagePorts.length > 0 && <div class="page-ports">
      <PagePortSwitcher entries={pagePorts} portSlug={port} />
    </div>}
    <PageActions editHref={editHref} editLabel={editLabel} />
  </div>
</div>
