---
import { CONCEPT_SUMMARY } from '../lib/ports'
---
<span class="concept-badge" title={CONCEPT_SUMMARY} aria-label={`Concept: ${CONCEPT_SUMMARY.toLowerCase()}`}>concept</span>
<style>
  .concept-badge {
    display: inline-block;
    padding: 0 .35rem;
    border: 1px solid var(--color-edge);
    border-radius: .25rem;
    color: var(--text-color);
    background: var(--color-surface);
    font-size: .625rem;
    font-weight: 500;
    line-height: 1.4;
    vertical-align: middle;
    white-space: nowrap;
  }
</style>
