---
import { Code } from 'astro-expressive-code/components'
import HomeExample from './HomeExample.astro'
import { CAPABILITIES, portCapabilities, type CapabilityTable } from '../lib/core-capabilities'
import { QUICKSTARTS } from '../lib/quickstarts'
import { PORT_BY_SLUG } from '../lib/ports'
import TABLE from '../data/core-capabilities.json'
import SOURCES from '../data/example-sources.json'
import type { CachedSource } from '../lib/port-landing'
import { homeCodeColumns } from '../lib/quickstarts'

/**
 * What the library does, one tested example per capability.
 *
 * A vertical list of capabilities on the left and the selected example on the
 * right. Narrow pages fold the list into a dropdown. The list is plain links, so Tab and Enter reach every capability.
 * The selection is the `capability` query parameter and leaves `product` and
 * the example toggles alone. Every example is an excerpt of a program or test
 * the port's CI runs; see `lib/core-capabilities.ts`.
 *
 * Returns nothing when the port has no such example, so the caller can fall
 * back to the quickstart.
 */
interface Props {
  port: string
}
const { port } = Astro.props as Props
const programs = portCapabilities(port, TABLE as CapabilityTable, SOURCES as Record<string, CachedSource>)
const quickstart = QUICKSTARTS[port]?.complete
// The first capability is the port's homepage quickstart, which already walks server, session, window and pane.
const shown = [
  ...(quickstart ? [{ id: 'typed-graph', label: CAPABILITIES[0].label, quickstart: true as const }] : []),
  ...programs.map((item) => ({ ...item, quickstart: false as const })),
]
---
{programs.length > 0 && <div class="core-showcase" data-core-showcase={port}>
  <details class="core-showcase__picker" open>
    <summary><span class="sr-only">Capability: </span><span data-capability-current>{shown[0]!.label}</span>
      <svg class="doc-picker-caret" width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
    </summary>
    <div class="core-showcase__panel-list">
      <nav aria-label="Capabilities">
        {shown.map((item, index) => <a class="core-showcase__option" href={`?capability=${item.id}`} data-capability-option={item.id}
          aria-current={index === 0 ? 'true' : undefined}>
          <span>{item.label}{item.tmux && <small class="core-showcase__tmux">tmux {item.tmux}</small>}</span>
        </a>)}
      </nav>
    </div>
  </details>
  <div class="core-showcase__panels">
    {shown.map((item, index) => item.quickstart ? <section class="core-showcase__panel" data-capability-panel={item.id} data-default={index === 0 ? '' : undefined}>
      <HomeExample port={port} language={PORT_BY_SLUG[port]!.name} example={quickstart!} heading={false} />
    </section> : <section class="core-showcase__panel" data-capability-panel={item.id} data-default={index === 0 ? '' : undefined}
      style={`--home-code-columns: ${homeCodeColumns(item.code)}`}>
      <Code code={item.code} lang={item.lang} title={item.file} frame="code" />
      <p class="core-showcase__source">
        {item.tmux && <small class="core-showcase__tmux">tmux {item.tmux}</small>}
        The whole program, <a href={item.sourceUrl}><code>{item.file}</code></a>. The port's CI runs it in <code>{item.ci.workflow}</code>{(item.ci.where ?? item.ci.directory) && <> from <code>{item.ci.where ?? item.ci.directory}/</code></>}: <code>{item.ci.command}</code>.
      </p>
    </section>)}
  </div>
</div>}

<script>
  let controller: AbortController | undefined

  function bindShowcase() {
    controller?.abort()
    const root = document.querySelector<HTMLElement>('[data-core-showcase]')
    if (!root) return
    controller = new AbortController()
    const { signal } = controller
    const options = [...root.querySelectorAll<HTMLAnchorElement>('[data-capability-option]')]
    const ids = options.map((option) => option.dataset.capabilityOption!)
    const picker = root.querySelector<HTMLDetailsElement>('details')!
    const wide = matchMedia('(min-width: 56rem)')
    // Every option keeps the page's other parameters, so a new tab opened from a link lands on the same product once the script has run.
    const hrefFor = (id: string) => {
      const url = new URL(location.href)
      if (id === ids[0]) url.searchParams.delete('capability'); else url.searchParams.set('capability', id)
      return `${url.search}${url.hash}` || location.pathname
    }
    const select = (id: string) => {
      for (const option of options) option.setAttribute('href', hrefFor(option.dataset.capabilityOption!))
      root.dataset.selected = id
      for (const panel of root.querySelectorAll<HTMLElement>('[data-capability-panel]')) panel.classList.toggle('is-selected', panel.dataset.capabilityPanel === id)
      for (const option of options) {
        const on = option.dataset.capabilityOption === id
        if (on) option.setAttribute('aria-current', 'true'); else option.removeAttribute('aria-current')
      }
      root.querySelector('[data-capability-current]')!.textContent = options.find((option) => option.dataset.capabilityOption === id)!.querySelector('span')!.firstChild!.textContent
    }
    const fromUrl = () => {
      const id = new URL(location.href).searchParams.get('capability')
      select(id && ids.includes(id) ? id : ids[0]!)
    }
    // The list is always open beside the example on a wide page, and a dropdown on a narrow one.
    const layout = () => { picker.open = wide.matches }
    root.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('[data-capability-option]')
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return
      event.preventDefault()
      const id = link.dataset.capabilityOption!
      select(id)
      const url = new URL(location.href)
      if (id === ids[0]) url.searchParams.delete('capability'); else url.searchParams.set('capability', id)
      history.replaceState(history.state, '', url)
      if (!wide.matches) picker.open = false
    }, { signal })
    picker.addEventListener('toggle', () => { if (wide.matches && !picker.open) picker.open = true }, { signal })
    wide.addEventListener('change', layout, { signal })
    window.addEventListener('popstate', fromUrl, { signal })
    layout()
    fromUrl()
  }

  bindShowcase()
  document.addEventListener('astro:after-swap', bindShowcase)
</script>

<style>
  .core-showcase { display: grid; gap: 1rem; container-type: inline-size; }
  .core-showcase__panels, .core-showcase__panel, .core-showcase__picker { min-width: 0; max-width: 100%; }
  .core-showcase :global(.expressive-code) { max-width: 100%; }
  .core-showcase__picker > summary { display: flex; justify-content: space-between; align-items: center; min-height: 2.5rem; padding: .25rem .75rem; cursor: pointer; border: 1px solid var(--color-edge); border-radius: .4rem; list-style: none; }
  .core-showcase__picker > summary::-webkit-details-marker { display: none; }
  .core-showcase__option { display: block; padding: .45rem .75rem; border-radius: .35rem; font-size: .875rem; color: inherit; text-decoration: none; }
  .core-showcase__option:hover { background: var(--color-surface-hover); }
  .core-showcase__option[aria-current='true'] { font-weight: 600; background: var(--color-surface-hover); }
  .core-showcase__panel { display: none; }
  .core-showcase:not([data-selected]) .core-showcase__panel[data-default], .core-showcase :global(.core-showcase__panel.is-selected) { display: block; }
  .core-showcase__panel h3 { margin: 0 0 .6rem; font-size: 1rem; }
  .core-showcase__tmux {
    margin-inline-start: .5rem; padding: .05rem .4rem; border: 1px solid var(--color-edge); border-radius: .75rem;
    font-size: .6875rem; font-weight: 500; color: var(--color-muted);
  }
  .core-showcase__source { margin-top: .6rem; font-size: .8125rem; color: var(--color-muted); }
  .core-showcase__source code { white-space: normal; overflow-wrap: anywhere; }
  .core-showcase :global(.expressive-code pre) { overflow: auto; tab-size: 8; }
  @media (min-width: 56rem) {
    .core-showcase { grid-template-columns: 14rem minmax(0, 1fr); align-items: start; column-gap: 1rem; }
    .core-showcase__picker > summary { display: none !important; }

  }
</style>
