---
import '../styles/global.css'
import { Font } from 'astro:assets'
import ThemeScript from './ThemeScript.astro'
import { pickerPaintRules } from '../lib/picker-paint'
import { initializePageReadiness } from '../lib/page-readiness'
import { initializeWebAnalytics } from '../lib/web-analytics'
import { withRoot } from '../lib/site-root'
import { installExternalLinks } from '../../public/_shell/external-links.js'
import externalLink from '../../public/_shell/external-link.svg?raw'
import externalLinksCss from '../../public/_shell/external-links.css?raw'
import anchorsCss from '../../public/_shell/anchors.css?raw'
import { createLinkPreviewPolicy, initializeLinkPreviewPaint } from '../lib/link-preview-paint'

interface Props { preloadSansItalic?: boolean }
const { preloadSansItalic = false } = Astro.props
const mask = `data:image/svg+xml,${encodeURIComponent(externalLink)}`
const hintsCss = externalLinksCss.replace('url("./external-link.svg")', `url("${mask}")`)
  + anchorsCss.replace("@import url('./external-links.css');", '')
---
{/* Preload the faces used at first paint before the font gate starts. */}
<Font cssVariable="--font-ibm-plex-sans" preload={[
  { weight: 400, style: 'normal' }, { weight: 500, style: 'normal' },
  { weight: 600, style: 'normal' }, { weight: 700, style: 'normal' },
  ...(preloadSansItalic ? [{ weight: 400, style: 'italic' as const }] : []),
]} />
<Font cssVariable="--font-ibm-plex-mono" preload={[
  { weight: 400, style: 'normal' }, { weight: 400, style: 'italic' },
  { weight: 500, style: 'normal' },
  { weight: 600, style: 'normal' }, { weight: 700, style: 'normal' },
  { weight: 700, style: 'italic' },
]} />
<style is:inline>
  html.fonts-pending body, html.link-hints-pending body { visibility: hidden; }
  #page-load-status { visibility: visible; position: fixed; inset: 0; display: grid; place-content: center; gap: 1rem; padding: 2rem; background: var(--background-color, white); color: var(--text-color, black); font: 1rem system-ui; }
  #page-load-status button { font: inherit; cursor: pointer; }
</style>
<ThemeScript />
<style is:inline set:html={hintsCss} />
<script is:inline set:html={`(${initializePageReadiness.toString()})(${installExternalLinks.toString()},${JSON.stringify(mask)});`} />
<script is:inline set:html={`(${initializeWebAnalytics.toString()})(${JSON.stringify(withRoot('/_shell/web-analytics.json'))});`} />
<script is:inline set:html={`(${initializeLinkPreviewPaint.toString()})((${createLinkPreviewPolicy.toString()})());`} />
<script>
  import '../../public/_shell/anchors.js'
</script>
<style is:global set:html={pickerPaintRules()} />
