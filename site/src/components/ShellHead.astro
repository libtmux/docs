---
import '../styles/global.css'
import { Font } from 'astro:assets'
import ThemeScript from './ThemeScript.astro'
import { pickerPaintRules } from '../lib/picker-paint'
import { withRoot } from '../lib/site-root'
import { initializeLinkHintReadiness } from '../lib/link-hint-readiness'
import { createLinkPreviewPolicy, initializeLinkPreviewPaint } from '../lib/link-preview-paint'

interface Props { preloadSansItalic?: boolean }
const { preloadSansItalic = false } = Astro.props
---
{/* Preload the faces used at first paint before the font gate starts. */}
<Font cssVariable="--font-ibm-plex-sans" preload={[
  { weight: 400, style: 'normal' }, { weight: 500, style: 'normal' },
  { weight: 600, style: 'normal' }, { weight: 700, style: 'normal' },
  ...(preloadSansItalic ? [{ weight: 400, style: 'italic' as const }] : []),
]} />
<Font cssVariable="--font-ibm-plex-mono" preload={[
  { weight: 400, style: 'normal' },
  { weight: 600, style: 'normal' }, { weight: 700, style: 'normal' },
  { weight: 700, style: 'italic' },
]} />
{/* ThemeScript lifts this gate on document.fonts.ready or after three seconds. */}
<style is:inline>html.fonts-pending body,html.link-hints-pending body{visibility:hidden}html.link-hints-suppressed a[data-external-link]::after{display:none}</style>
<script is:inline data-anchor-startup>
  // Capture unowned fragments before the deferred router seeds scroll state.
  if (location.hash && history.state === null && performance.getEntriesByType('navigation')[0]?.type !== 'back_forward') {
    document.documentElement.setAttribute('data-anchor-startup', location.href);
  }
</script>
<ThemeScript />
<link rel="preload" as="image" crossorigin="anonymous" href={withRoot('/_shell/external-link.svg')} data-link-hints-mask />
<script is:inline set:html={`(${initializeLinkHintReadiness.toString()})();`} />
<script is:inline set:html={`(${initializeLinkPreviewPaint.toString()})((${createLinkPreviewPolicy.toString()})());`} />
<link rel="stylesheet" href={withRoot('/_shell/anchors.css')} />
<script is:inline type="module" data-link-hints-module src={withRoot('/_shell/anchors.js')}></script>
<style is:global set:html={pickerPaintRules()} />
<link rel="preload" href={withRoot('/versions.json')} as="fetch" crossorigin="anonymous" />
