---
import { Code } from 'astro-expressive-code/components'
import { highlightInline, highlightWithCooldownSlots } from '../../lib/highlight'
import { DEFAULT_COOLDOWN_DAYS } from '../../lib/install-matrix'
import { PORTS, portHomeUrl, referenceUrl, type PortPackageId } from '../../lib/ports'
import type { Quickstart } from '../../lib/quickstarts'
import { defaultVersionFor } from '../../lib/versions'

/**
 * Package-manager picker for the ten libtmux ports' own install commands
 * (`port.installs` from ports.ts — see that file for why each entry is what
 * it is). Same visual language and copy-to-clipboard behaviour as
 * ./McpInstall.astro — everything lives in this component, with no separate
 * data module or asset files.
 *
 * Two axes, not one: which port, and then which of that port's tools. A
 * Python reader is on pip or uv, a TypeScript reader on one of five, and
 * Java, C++ and Swift cannot be installed from a command line at all — one
 * line per language chose for all of them and was wrong for most. The second
 * strip only renders where there is a choice to make, so Rust and Go still
 * show their one command with nothing above it.
 *
 * No literal source to port: McpInstall.astro's sibling in
 * ~/work/python/libtmux-mcp/docs only ever installed one package, so there
 * was nothing there shaped like an eight-way tab picker. sphinx-copybutton
 * isn't available here either (see McpInstall.astro's note on the same
 * gap), so the copy button is this component's own, duplicated rather than
 * imported from mcp-install.js because that file is McpInstall's alone —
 * this widget must stand on its own with no cross-file dependency.
 *
 * `ports` restricts the tab set (e.g. a guide about one language); omit it
 * for the full eight. The active port persists across every PackageInstall
 * instance on the site via one shared localStorage key — a restricted
 * instance simply ignores a saved value outside its own subset and falls
 * back to its own default, rather than rendering blank.
 */
interface Props {
  /** Port slugs to show; omit for all ten. */
  ports?: readonly string[]
  /**
   * A code example to show under each port's install line, keyed by slug.
   *
   * The home page's picker used to switch the install command while the
   * example below it stayed Python, so seven of the eight tabs showed a
   * Java or Swift install above Python code. Putting the example in the
   * panel makes one picker drive both, which is what a reader already
   * expects it to do.
   *
   * Omit it and the widget is exactly what it was: install lines only. A
   * port with no entry shows its install line alone rather than an empty
   * block.
   */
  snippets?: Partial<Record<string, Quickstart>>
  /** Active tab when nothing is saved yet; defaults to the first shown port. */
  defaultPort?: string
  variant?: 'full' | 'compact'
  /**
   * Where each block's copy button sits. `gutter` gives it a column beside the
   * code, so a long command cannot scroll under it; `overlay` floats it over
   * the block's corner. `auto`, the default, chooses per block: a one-line
   * command gets a gutter, and a fragment of several lines, which a whole
   * column beside it would only narrow, gets the overlay.
   */
  copyButton?: 'auto' | 'gutter' | 'overlay'
  /** Install a companion package instead of the core library. */
  packageId?: PortPackageId
}
const { ports, defaultPort, snippets, variant = 'full', copyButton = 'auto', packageId = 'core' } = Astro.props as Props
const copyLayout = (code: string) => (copyButton === 'auto' ? (code.includes('\n') ? 'overlay' : 'gutter') : copyButton)

const selected = ports && ports.length > 0 ? PORTS.filter((p) => ports.includes(p.slug)) : PORTS
const items = selected.map((port) => {
  if (packageId === 'core') return port
  const companion = port.packages?.find((entry) => entry.id === packageId)
  if (!companion?.installs) throw new Error(`PackageInstall: ${port.slug} has no install forms for ${packageId}`)
  return { ...port, packageName: companion.name, installs: companion.installs }
})
if (items.length === 0) {
  throw new Error('PackageInstall: `ports` matched none of the ten port slugs in ports.ts')
}
const initialSlug = defaultPort && items.some((p) => p.slug === defaultPort) ? defaultPort : items[0]!.slug

/*
 * What a saved manager belongs to. A port's library and its companion package
 * offer different lists — TypeScript's library has five managers and its
 * workspace CLI seven — so one key per port had a choice in one widget select
 * an unrelated line in the other. `picker-paint.ts` builds the same scopes.
 */
const managerScope = (slug: string) => (packageId === 'core' ? slug : `${slug}-${packageId}`)

// Which panel to show once `data-active-port` is set is data-driven (one
// rule per port actually rendered in *this* instance), not hand-typed —
// ports.ts stays the only place a port's slug is spelled out. See the
// is:global block below for the static rules this pairs with.
const activePortRules = items
  .map((p) => `.lm-pkg-install[data-active-port="${p.slug}"] .lm-pkg-install__panel[data-port="${p.slug}"]{visibility:inherit}`)
  .join('')

/*
 * One rule per manager position, generated the same way and for the same
 * reason: the widths of these lists differ per port (one command for Rust,
 * five for TypeScript), so the rules are generated to the longest list
 * rendered here rather than to a number typed in a stylesheet.
 */
const managerRules = Array.from(
  { length: Math.max(...items.map((p) => p.installs.length)) },
  (_, i) =>
    `.lm-pkg-install__panel[data-active-manager="${i}"] .lm-pkg-install__cmd[data-manager="${i}"]{display:block}`,
).join('')

/*
 * Highlighted once, here rather than in the template: `await` is not allowed
 * inside a map callback in Astro's markup.
 *
 * A console command is shown with its prompt and copied without it — the copy
 * handler below strips `$ ` when `data-language` says console. Everything else
 * is a file fragment and is shown exactly as it goes into the file.
 */
const installHtml = new Map(
  await Promise.all(
    items.flatMap((p) =>
      p.installs.map(async (cmd, i) => [
        `${p.slug}/${i}`,
        await highlightInline(cmd.lang === 'console' ? `$ ${cmd.code}` : cmd.code, cmd.lang),
      ] as const),
    ),
  ),
)

/*
 * A command's cooldown and bypass forms, with the day count in slots the
 * script below rewrites. A form the tool cannot express is absent, and its
 * variant keeps the plain command with the tool's note beside it.
 */
const cooldownHtml = new Map(
  await Promise.all(
    items.flatMap((p) =>
      p.installs.flatMap((cmd, i) =>
        (['code', 'bypass'] as const)
          .filter((form) => cmd.cooldown?.[form])
          .map(async (form) => [
            `${p.slug}/${i}/${form}`,
            await highlightWithCooldownSlots(`$ ${cmd.cooldown![form]!}`, cmd.lang, DEFAULT_COOLDOWN_DAYS),
          ] as const),
      ),
    ),
  ),
)
const hasCooldown = (p: (typeof items)[number]) => p.installs.some((cmd) => cmd.cooldown)
// One radio group per picker and port, so a group never spans two pickers;
// the shared state keeps every group showing the same choice.
const cooldownGroup = (slug: string) => `cooldown-mode-${packageId}-${slug}`
---

<div class={`lm-pkg-install lm-pkg-install--${variant}${snippets ? ' lm-pkg-install--examples' : ''}`} data-ports={items.map((p) => p.slug).join(' ')}>
  {/*
    One language is not a choice of language.

    A port page renders this restricted to its own port, where the strip was a
    single tab that could not be switched away from — a control that answers
    nothing, above the control that answers something.
  */}
  {items.length > 1 && <div class="lm-pkg-install__tabs" role="tablist" aria-label="Package manager">
    {
      items.map((p) => (
        <button
          type="button"
          class="lm-pkg-install__tab"
          role="tab"
          data-tab-value={p.slug}
          aria-selected={p.slug === initialSlug ? 'true' : 'false'}
          tabindex={p.slug === initialSlug ? '0' : '-1'}
        >
          {p.name}
        </button>
      ))
    }
  </div>}
  <div class="lm-pkg-install__body">
    {
      items.map((p) => (
        <div
          class="lm-pkg-install__panel"
          role="tabpanel"
          data-port={p.slug}
          data-manager-scope={managerScope(p.slug)}
          data-default={p.slug === initialSlug ? true : undefined}
          tabindex="0"
        >
          {(p.installs.length > 1 || hasCooldown(p)) && <div class="lm-pkg-install__bar">
          {p.installs.length > 1 && (
            <div class="lm-pkg-install__managers" role="tablist" aria-label={`${p.name} package manager`}>
              {p.installs.map((cmd, i) => (
                <button
                  type="button"
                  class="lm-pkg-install__manager"
                  role="tab"
                  data-manager-value={i}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? '0' : '-1'}
                >
                  {cmd.label}
                </button>
              ))}
            </div>
          )}
          {hasCooldown(p) && (
            <div class="lm-pkg-install__cooldown">
              <input type="checkbox" class="lm-pkg-install__cooldown-toggle" data-pkg-cooldown="toggle" aria-label="Apply a dependency cooldown" />
              <button type="button" class="lm-pkg-install__cooldown-configure" data-pkg-cooldown="configure" aria-expanded="false">
                Configure cooldowns
              </button>
              <button type="button" class="lm-pkg-install__cooldown-help" data-pkg-cooldown="help" aria-label="What are cooldowns?" title="What are cooldowns?">?</button>
            </div>
          )}
          </div>}
          {hasCooldown(p) && (
            <div class="lm-pkg-install__cooldown-settings" role="group" aria-label="Cooldown settings" data-open="false">
              <p class="lm-pkg-install__cooldown-title">Dependency cooldowns</p>
              <p class="lm-pkg-install__cooldown-help-text">
                The checkbox turns a cooldown on and off for every picker on the site. It applies to what an install pulls
                in; the package itself, and the libtmux it pins, stay current.
              </p>
              <fieldset class="lm-pkg-install__cooldown-modes">
                <legend class="sr-only">Cooldown type</legend>
                <label>
                  <input type="radio" name={cooldownGroup(p.slug)} value="days" data-pkg-cooldown="mode" checked />
                  <span>
                    Apply a cooldown of
                    <input type="number" min="1" max="365" value={DEFAULT_COOLDOWN_DAYS} class="lm-pkg-install__cooldown-days" data-pkg-cooldown="days" aria-label="Cooldown in days" />
                    days
                  </span>
                </label>
                <label>
                  <input type="radio" name={cooldownGroup(p.slug)} value="bypass" data-pkg-cooldown="mode" />
                  <span>Bypass any global cooldown</span>
                </label>
              </fieldset>
              <details class="lm-pkg-install__cooldown-explainer">
                <summary>What are cooldowns?</summary>
                <p>
                  Cooldowns delay picking up newly uploaded packages so the community has time to spot supply-chain
                  attacks before you install. Most package managers don't apply one by default; you opt in through a
                  global setting in your tool's configuration.
                </p>
                <p>
                  Learn more at <a href="https://cooldowns.dev/" target="_blank" rel="noopener">cooldowns.dev</a> &middot;{' '}
                  <a href="https://securitylabs.datadoghq.com/articles/dependency-cooldowns/" target="_blank" rel="noopener">Datadog Security Labs writeup</a>.
                </p>
              </details>
            </div>
          )}
          {p.installs.map((cmd, i) => (
            <div
              class="lm-pkg-install__cmd"
              data-manager={i}
              data-default={i === 0 ? true : undefined}
              role={p.installs.length > 1 ? 'tabpanel' : undefined}
              tabindex={p.installs.length > 1 ? '0' : undefined}
            >
              {!cmd.cooldown && <div class={`lm-pkg-install__code lm-pkg-install__code--${copyLayout(cmd.code)}`} data-language={cmd.lang}><pre><code set:html={installHtml.get(`${p.slug}/${i}`)} /></pre><button type="button" class="lm-pkg-install__copy" data-action="copy" aria-label="Copy to clipboard">Copy</button></div>}
              {cmd.cooldown && (['off', 'days', 'bypass'] as const).map((mode) => {
                const form = mode === 'days' ? 'code' : mode === 'bypass' ? 'bypass' : undefined
                const code = form ? cmd.cooldown![form] : undefined
                const html = form && code ? cooldownHtml.get(`${p.slug}/${i}/${form}`) : installHtml.get(`${p.slug}/${i}`)
                return (
                  <div class="lm-pkg-install__variant" data-cooldown-variant={mode}>
                    <div class={`lm-pkg-install__code lm-pkg-install__code--${copyLayout(code ?? cmd.code)}`} data-language={cmd.lang}><pre><code set:html={html} /></pre><button type="button" class="lm-pkg-install__copy" data-action="copy" aria-label="Copy to clipboard">Copy</button></div>
                    {mode !== 'off' && !code && cmd.cooldown!.note && <p class="lm-pkg-install__note lm-pkg-install__note--cooldown">{cmd.cooldown!.note}</p>}
                  </div>
                )
              })}
              {cmd.note && <p class="lm-pkg-install__note">{cmd.note}</p>}
            </div>
          ))}
          {snippets && (
            <p class="lm-pkg-install__links">
              <a href={portHomeUrl(p, defaultVersionFor(p.slug))}>{p.name} documentation</a>
              <a href={referenceUrl(p, defaultVersionFor(p.slug))}>{p.name} API reference</a>
            </p>
          )}
          {snippets?.[p.slug] && (
            <div class="lm-pkg-install__snippet">
              <Code code={snippets[p.slug]!.code} lang={snippets[p.slug]!.lang} />
            </div>
          )}
        </div>
      ))
    }
  </div>
  <span class="sr-only" data-copy-status role="status" aria-live="polite" aria-atomic="true" />
</div>

<style is:global>
  /* Unlayered on purpose — see mcp-install.css's file-level comment for why
   * that matters against Tailwind v4's `[hidden]` preflight rule. This
   * widget never uses the `hidden` attribute either, so the point is moot
   * here, but the two widgets stay consistent about it. */
  .lm-pkg-install {
    --lm-pkg-install-bg: var(--background-color);
    --lm-pkg-install-bg-tabs: #f1f5f9; /* slate-100 */
    --lm-pkg-install-border: #e2e8f0; /* slate-200 */
    --lm-pkg-install-fg: var(--text-color);
    --lm-pkg-install-fg-secondary: #475569; /* slate-600 */
    --lm-pkg-install-fg-muted: #64748b; /* slate-500 */
    --lm-pkg-install-accent: var(--theme-primary);
    --lm-pkg-install-hover: rgb(0 0 0 / 4%);
    --lm-pkg-install-code-bg: #f1f5f9;
    /* slate-300 / slate-400, the agent prompt's scrollbar, so the site has one. */
    --lm-pkg-install-scroll: rgb(203 213 225);
    --lm-pkg-install-scroll-hover: rgb(148 163 184);
    --lm-pkg-install-mono: var(--font-ibm-plex-mono, ui-monospace, SFMono-Regular, Menlo, monospace);

    border: 1px solid var(--lm-pkg-install-border);
    border-radius: 0.375rem;
    background: var(--lm-pkg-install-bg);
    color: var(--lm-pkg-install-fg);
    overflow: hidden;
    margin: 1rem 0;
    font-size: 0.95em;
  }

  html[data-theme-mode='dark'] .lm-pkg-install {
    --lm-pkg-install-bg-tabs: #1e293b; /* slate-800 */
    --lm-pkg-install-border: #1e293b;
    --lm-pkg-install-fg-secondary: #94a3b8; /* slate-400 */
    --lm-pkg-install-fg-muted: #94a3b8;
    --lm-pkg-install-hover: rgb(255 255 255 / 6%);
    --lm-pkg-install-code-bg: #1e293b;
    --lm-pkg-install-scroll: rgb(71 85 105);
    --lm-pkg-install-scroll-hover: rgb(100 116 139);
  }

  .lm-pkg-install__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    background: var(--lm-pkg-install-bg-tabs);
    border-bottom: 1px solid var(--lm-pkg-install-border);
  }

  .lm-pkg-install__tab {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--lm-pkg-install-fg-muted);
    cursor: pointer;
    font: inherit;
    padding: 0.45rem 0.9rem;
    margin: 0;
    white-space: nowrap;
  }

  .lm-pkg-install__tab:hover {
    color: var(--lm-pkg-install-fg);
    background: var(--lm-pkg-install-hover);
  }

  .lm-pkg-install__tab:focus-visible {
    outline: 2px solid var(--lm-pkg-install-accent);
    outline-offset: -2px;
  }

  /* Server-rendered active tab (no JS) and JS-selected tab both key off
   * `aria-selected` — the deferred script below is the only thing that
   * ever changes it, so there is no separate prehydrate override needed
   * here (unlike McpInstall, whose tabs must repaint before mcp-install.js
   * has even downloaded). This widget's *panel* visibility needs one,
   * hence the document-level rules generated below — and the tab colour now
   * needs one too, which is what `preloadedPortRules` adds. */
  .lm-pkg-install__tab[aria-selected='true'] {
    color: var(--lm-pkg-install-accent);
    border-bottom-color: var(--lm-pkg-install-accent);
    background: var(--lm-pkg-install-bg);
  }

  /* Every panel shares one grid cell, so the body is as tall as the tallest
   * panel and a language change never changes the page height. On the home
   * page the prompt below follows this picker's language, and a Quickstart
   * that resized would move the page under a reader clicking the prompt.
   * `minmax(0, 1fr)` keeps a long install line scrolling inside its `pre`
   * instead of widening the grid. */
  .lm-pkg-install__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0.9rem 1rem;
  }

  /* SSR/no-JS default: exactly one panel visible, no script required. The
   * `html[data-pkg-port]` rules (set in <head> before any of this markup is
   * parsed, when a saved choice exists and this instance carries that port)
   * override it by specificity, so they need no `!important` or source-order
   * care. Panels hide with `visibility`, not `display`, so a hidden panel
   * still holds its height in the grid. */
  .lm-pkg-install__panel {
    display: flex;
    flex-direction: column;
    grid-area: 1 / 1;
    visibility: hidden;
  }

  /* `inherit`, not `visible`: a visible child paints through a hidden
   * ancestor, and the fonts gate hides <body> while web fonts load, so a shown
   * panel painted alone before the rest of the page. */
  .lm-pkg-install__panel[data-default] {
    visibility: inherit;
  }

  /* Once JS has picked an active port (a click, or a restored session),
   * every panel defaults to hidden; the per-port rule injected below (see
   * `activePortRules`) is more specific ([data-active-port="X"] vs the bare
   * [data-active-port] here) and wins regardless of source order — same
   * reasoning as mcp-install.css's default-override rule. */
  .lm-pkg-install[data-active-port] .lm-pkg-install__panel {
    visibility: hidden;
  }

  .lm-pkg-install__panel:focus-visible {
    outline: 2px solid var(--lm-pkg-install-accent);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  /* The second strip: which of this port's tools. Underlined rather than
   * tabbed, so it reads as subordinate to the language strip above the body
   * instead of competing with it. */
  .lm-pkg-install__managers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.6rem;
  }

  .lm-pkg-install__manager {
    appearance: none;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.25rem;
    color: var(--lm-pkg-install-fg-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.8em;
    line-height: 1.3;
    padding: 0.2rem 0.5rem;
  }

  .lm-pkg-install__manager:hover {
    color: var(--lm-pkg-install-fg);
    background: var(--lm-pkg-install-hover);
  }

  .lm-pkg-install__manager[aria-selected='true'] {
    color: var(--lm-pkg-install-accent);
    border-color: var(--lm-pkg-install-accent);
  }

  .lm-pkg-install__manager:focus-visible {
    outline: 2px solid var(--lm-pkg-install-accent);
    outline-offset: 1px;
  }

  /* SSR/no-JS default: the first command of each port, no script required.
   * Once a manager is chosen the `[data-active-manager="N"]` rules generated
   * above win by specificity, exactly as the port panels do. */
  .lm-pkg-install__cmd {
    display: none;
  }

  .lm-pkg-install__cmd[data-default] {
    display: block;
  }

  .lm-pkg-install__panel[data-active-manager] .lm-pkg-install__cmd {
    display: none;
  }

  .lm-pkg-install__note {
    margin: 0.5rem 0 0;
    font-size: 0.8em;
    line-height: 1.5;
    color: var(--lm-pkg-install-fg-secondary);
  }

  /* Where to go after installing: the port's own documentation and its API
   * reference. Only the Quickstart renders these; a port's page already is
   * the first, and links the second. */
  .lm-pkg-install__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.6rem 0 0;
    font-size: 0.85em;
  }

  .lm-pkg-install__links a {
    color: var(--lm-pkg-install-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Where each block's copy button sits, set per block from the `copyButton`
   * prop. `gutter` gives it a column beside the code, so a one-line command
   * cannot scroll under it however far it scrolls. `overlay` floats it over
   * the block's corner and pads the code's end to clear it, for a fragment of
   * several lines that a whole column would only narrow. `auto`, the default,
   * gives one-line blocks the first and longer ones the second. The background
   * is on the holder, so a gutter reads as part of the block. */
  .lm-pkg-install__code {
    border-radius: 0.25rem;
    background: var(--lm-pkg-install-code-bg);
  }

  .lm-pkg-install__code--gutter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
  }

  .lm-pkg-install__code--overlay {
    position: relative;
  }

  /* The example under the install line. Expressive Code brings its own
   * frame, so this only supplies the gap between the two. */
  .lm-pkg-install__snippet {
    margin-top: 0.75rem;
  }

  .lm-pkg-install__snippet .expressive-code {
    margin: 0;
  }

  /* The example fills whatever height its panel has left. Its `pre` starts
   * from 14rem stacked, or 23rem side by side, so the longest example
   * reserves no more than that, and grows into the space a shorter panel
   * leaves. Expressive Code positions its copy button on `.frame`, so the
   * button stays put while the code scrolls. */
  .lm-pkg-install__snippet,
  .lm-pkg-install__snippet .expressive-code,
  .lm-pkg-install__snippet .expressive-code .frame {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
  }

  .lm-pkg-install__snippet .expressive-code .frame pre {
    flex: 1 1 14rem;
    min-height: 0;
    overflow: auto;
  }

  /* Expressive Code's own offset, moved clear of the example's 4px scrollbar. */
  .lm-pkg-install__snippet .expressive-code .frame .copy {
    inset-inline-end: calc(var(--ec-brdWd) + var(--ec-uiPadInl) / 2 + 4px);
  }

  /* Beside an example, a long install block such as Maven's POM would set the
   * height every panel reserves, so it scrolls. Stacked, it scrolls past 10rem,
   * under the example's 14rem, so the dependency never takes more room than
   * the code it is for. Copy takes the whole block. */
  .lm-pkg-install--examples .lm-pkg-install__code pre {
    max-height: 10rem;
    overflow: auto;
  }

  /*
   * Side by side once the widget is wide enough, as social-embed's playground
   * sets its preview beside its code: the install on the left, the example on
   * the right with the larger share of the width. Narrower, they stack.
   *
   * A container query, so the switch follows the widget's own width rather
   * than the window's. Side by side, the example starts from 23rem and an
   * install block scrolls past 14rem, so the example sets the height every
   * panel reserves, a long POM scrolls inside its column, and switching
   * package manager leaves the page where it was. vcpkg's column is the
   * tallest: its manager row, block, note and the documentation links came
   * to 365px against a 352px example at 15rem and 22rem.
   */
  .lm-pkg-install--examples {
    container-type: inline-size;
  }

  @container (min-width: 48rem) {
    .lm-pkg-install__panel:has(> .lm-pkg-install__snippet) {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: auto auto 1fr;
      column-gap: 1rem;
    }

    .lm-pkg-install__panel:has(> .lm-pkg-install__snippet) > .lm-pkg-install__managers {
      grid-column: 1;
      grid-row: 1;
    }

    .lm-pkg-install__panel:has(> .lm-pkg-install__snippet) > .lm-pkg-install__cmd {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }

    /* Straight under the install; the last row takes whatever height the
     * example leaves. */
    .lm-pkg-install__panel:has(> .lm-pkg-install__snippet) > .lm-pkg-install__links {
      grid-column: 1;
      grid-row: 3;
      align-self: start;
    }

    .lm-pkg-install__panel > .lm-pkg-install__snippet {
      grid-column: 2;
      grid-row: 1 / span 3;
      margin-top: 0;
    }

    .lm-pkg-install--examples .lm-pkg-install__code pre {
      max-height: 14rem;
    }

    .lm-pkg-install__snippet .expressive-code .frame pre {
      flex-basis: 23rem;
    }
  }

  .lm-pkg-install__code pre {
    margin: 0;
    overflow-x: auto;
    color: var(--lm-pkg-install-fg);
    padding: 0.75rem 0.5rem 0.75rem 0.9rem;
  }

  .lm-pkg-install__code--overlay pre {
    padding-right: 3.25rem;
  }

  /* Chrome ignores the WebKit rules below on an element that sets the
   * standard properties, and draws a 10px scrollbar instead, which the copy
   * buttons could only be measured clear of after load. So the standard
   * properties apply only where the WebKit ones do not, and a 4px scrollbar
   * leaves room for a button at a fixed inset from the first paint. */
  @supports not selector(::-webkit-scrollbar) {
    .lm-pkg-install__code pre,
    .lm-pkg-install__snippet .expressive-code .frame pre {
      scrollbar-width: thin;
      scrollbar-color: var(--lm-pkg-install-scroll) transparent;
    }
  }

  .lm-pkg-install__code pre::-webkit-scrollbar,
  .lm-pkg-install__snippet .expressive-code .frame pre::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }

  .lm-pkg-install__code pre::-webkit-scrollbar-track,
  .lm-pkg-install__snippet .expressive-code .frame pre::-webkit-scrollbar-track {
    background: transparent;
  }

  .lm-pkg-install__code pre::-webkit-scrollbar-thumb,
  .lm-pkg-install__snippet .expressive-code .frame pre::-webkit-scrollbar-thumb {
    background: var(--lm-pkg-install-scroll);
    border-radius: 2px;
  }

  .lm-pkg-install__code pre::-webkit-scrollbar-thumb:hover,
  .lm-pkg-install__snippet .expressive-code .frame pre::-webkit-scrollbar-thumb:hover {
    background: var(--lm-pkg-install-scroll-hover);
  }

  .lm-pkg-install__code code {
    font-family: var(--lm-pkg-install-mono);
    font-size: 0.85em;
    white-space: pre;
  }

  /* Shiki writes both schemes as custom properties; something has to read
   * them. Without this a highlighted install command rendered in the
   * inherited foreground colour — every token one flat grey — which is what
   * the reference example panels had too. */
  .lm-pkg-install__code .shiki span,
  .lm-pkg-install__code span {
    color: var(--shiki-light);
  }

  html[data-theme-mode='dark'] .lm-pkg-install__code .shiki span,
  html[data-theme-mode='dark'] .lm-pkg-install__code span {
    color: var(--shiki-dark);
  }

  /* In a gutter, level with the first line, with space on both sides: a line
   * cut off at the gutter's edge would otherwise touch the button and read as
   * running under it. A vertical scrollbar belongs to the `pre`, so it sits
   * beside the gutter rather than under the button. */
  .lm-pkg-install__code--gutter .lm-pkg-install__copy {
    margin: 0.45rem 0.45rem 0;
  }

  /* Over the corner, clear of the 4px vertical scrollbar a scrolling block
   * draws. Fixed rather than measured, so the button is where it stays from
   * the first paint. */
  .lm-pkg-install__code--overlay .lm-pkg-install__copy {
    position: absolute;
    top: 0.45rem;
    right: calc(0.45rem + 4px);
  }

  .lm-pkg-install__copy {
    appearance: none;
    border: 1px solid var(--lm-pkg-install-border);
    border-radius: 0.25rem;
    background: var(--lm-pkg-install-bg);
    color: var(--lm-pkg-install-fg-secondary);
    cursor: pointer;
    font: inherit;
    font-size: 0.75em;
    line-height: 1;
    padding: 0.3rem 0.5rem;
  }

  .lm-pkg-install__copy:hover {
    color: var(--lm-pkg-install-fg);
    border-color: var(--lm-pkg-install-fg-muted);
  }

  .lm-pkg-install__copy:focus-visible {
    outline: 2px solid var(--lm-pkg-install-accent);
    outline-offset: 2px;
  }

  .lm-pkg-install__copy--done {
    color: var(--lm-pkg-install-accent);
    border-color: var(--lm-pkg-install-accent);
  }

  /* Compact variant: tighter padding, smaller type — mirrors
   * .lm-mcp-install--compact. */
  .lm-pkg-install--compact .lm-pkg-install__tab {
    padding: 0.3rem 0.7rem;
    font-size: 0.9em;
  }

  .lm-pkg-install--compact .lm-pkg-install__body {
    padding: 0.7rem 0.8rem;
  }

  /* Cooldowns. The toolbar holds the manager tabs and, at its right edge, the
   * same checkbox / "Configure cooldowns" / "?" trio as the MCP picker. */
  .lm-pkg-install__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.6rem;
  }

  .lm-pkg-install__bar .lm-pkg-install__managers {
    margin-bottom: 0;
  }

  .lm-pkg-install__cooldown {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-inline-start: auto;
    color: var(--lm-pkg-install-fg-secondary);
    font-size: 0.8em;
  }

  .lm-pkg-install__cooldown-toggle {
    margin: 0;
    accent-color: var(--lm-pkg-install-accent);
    cursor: pointer;
  }

  .lm-pkg-install__cooldown-configure,
  .lm-pkg-install__cooldown-help {
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
  }

  .lm-pkg-install__cooldown-configure:hover {
    color: var(--lm-pkg-install-fg);
    text-decoration: underline;
  }

  .lm-pkg-install__cooldown-help {
    width: 1.2em;
    height: 1.2em;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.85em;
    line-height: 1;
  }

  .lm-pkg-install__cooldown-configure:focus-visible,
  .lm-pkg-install__cooldown-help:focus-visible,
  .lm-pkg-install__cooldown-toggle:focus-visible {
    outline: 2px solid var(--lm-pkg-install-accent);
    outline-offset: 1px;
  }

  .lm-pkg-install__cooldown-settings {
    display: none;
    margin-bottom: 0.6rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--lm-pkg-install-border);
    border-radius: 0.375rem;
    font-size: 0.85em;
  }

  .lm-pkg-install__cooldown-settings[data-open='true'] {
    display: block;
  }

  .lm-pkg-install__cooldown-title {
    margin: 0 0 0.25rem;
    font-weight: 600;
  }

  .lm-pkg-install__cooldown-help-text {
    margin: 0 0 0.5rem;
    color: var(--lm-pkg-install-fg-secondary);
  }

  .lm-pkg-install__cooldown-modes {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 0.5rem;
    padding: 0;
    border: 0;
  }

  .lm-pkg-install__cooldown-modes label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
  }

  .lm-pkg-install__cooldown-days {
    width: 3.5em;
    padding: 0.05rem 0.25rem;
    border: 1px solid var(--lm-pkg-install-border);
    border-radius: 0.25rem;
    background: var(--lm-pkg-install-bg);
    color: inherit;
    font: inherit;
  }

  .lm-pkg-install__cooldown-explainer summary {
    cursor: pointer;
    color: var(--lm-pkg-install-fg-secondary);
  }

  .lm-pkg-install__cooldown-explainer p {
    margin: 0.4rem 0 0;
  }

  .lm-pkg-install__note--cooldown {
    font-style: italic;
  }

  /* One variant of a cooldown-aware command shows at a time, chosen by the
   * site-wide state on <html> — which ThemeScript sets before first paint, so
   * a saved cooldown paints the right command from the start. A missing type
   * means "days", the default. */
  .lm-pkg-install__variant[data-cooldown-variant='days'],
  .lm-pkg-install__variant[data-cooldown-variant='bypass'] {
    display: none;
  }

  html[data-mcp-install-cooldown-enabled='1'] .lm-pkg-install__variant[data-cooldown-variant='off'] {
    display: none;
  }

  html[data-mcp-install-cooldown-enabled='1']:not([data-mcp-install-cooldown-type='bypass'])
    .lm-pkg-install__variant[data-cooldown-variant='days'],
  html[data-mcp-install-cooldown-enabled='1'][data-mcp-install-cooldown-type='bypass']
    .lm-pkg-install__variant[data-cooldown-variant='bypass'] {
    display: block;
  }
</style>

{/* Generated from `items`, not hand-typed — see `activePortRules` above. */}
<style is:global set:html={activePortRules + managerRules} />

<script>
  // Deferred interactivity: tab switching, cross-instance sync, and
  // copy-to-clipboard. Event delegation on document so this survives an
  // Astro ClientRouter swap the same way McpInstall's mcp-install.js does
  // (see that file's header) — this site doesn't run ClientRouter yet, but
  // every other interactive component here already defends against it.
  const STORAGE_KEY = 'libtmux-docs.package-install.port'
  // Per port, because a choice of pnpm says nothing about a choice of uv.
  const MANAGER_KEY = 'libtmux-docs.package-install.manager'
  const SYNC_EVENT = 'lm-pkg-install:change'
  const MANAGER_SYNC_EVENT = 'lm-pkg-install:manager'

  function read(key: string): string | null {
    try {
      return localStorage.getItem(key)
    } catch {
      // Private windows and blocked site data throw here. The widget still
      // works for this page; only the memory is lost.
      return null
    }
  }

  function write(key: string, value: string) {
    try {
      localStorage.setItem(key, value)
    } catch {
      // As above.
    }
  }

  function applySavedState() {
    if (document.querySelector('[data-pkg-cooldown]')) paintCooldown()
    const saved = read(STORAGE_KEY)
    if (saved) {
      document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => selectPort(widget, saved, false))
    }
    document.querySelectorAll<HTMLElement>('.lm-pkg-install__panel').forEach((panel) => {
      const scope = panel.dataset.managerScope
      const savedManager = scope && read(`${MANAGER_KEY}.${scope}`)
      if (savedManager) selectManager(panel, savedManager, false)
    })
  }

  function selectManager(panel: HTMLElement, index: string, persist: boolean) {
    const tabs = panel.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__manager')
    // Decided before anything is written, for the same reason selectPort
    // does: a saved index outside this port's list would otherwise clear
    // every tab and show no command at all.
    if (![...tabs].some((tab) => tab.dataset.managerValue === index)) return
    tabs.forEach((tab) => {
      const isMatch = tab.dataset.managerValue === index
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false')
      tab.setAttribute('tabindex', isMatch ? '0' : '-1')
    })
    panel.setAttribute('data-active-manager', index)
    if (persist && panel.dataset.managerScope) {
      // As selectPort does for the language: <head> puts the saved manager on
      // the document before first paint, and the rules keyed on it outrank
      // this panel's, so a click has to move the document attribute too.
      document.documentElement.setAttribute(`data-pkg-manager-${panel.dataset.managerScope}`, index)
      write(`${MANAGER_KEY}.${panel.dataset.managerScope}`, index)
    }
  }

  function selectPort(widget: HTMLElement, slug: string, persist: boolean) {
    const tabs = widget.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__tab')
    // Decided before anything is written. This used to clear `aria-selected`
    // on every tab and *then* return when none matched, so a picker
    // restricted to one language — the port pages render one — was left with
    // no tab selected at all whenever the shared saved value named a
    // different language. The panel was right and the tab above it was blank.
    const matched = [...tabs].some((tab) => tab.dataset.tabValue === slug)
    // A restricted-subset instance that doesn't carry this port keeps its
    // own current selection rather than going blank — see this file's top
    // comment on why the storage key is shared but instances aren't forced
    // to honor a value outside their own `ports` prop.
    if (!matched) return
    tabs.forEach((tab) => {
      const isMatch = tab.dataset.tabValue === slug
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false')
      tab.setAttribute('tabindex', isMatch ? '0' : '-1')
    })
    widget.setAttribute('data-active-port', slug)
    // The document-level attribute is what <head> sets before first paint and
    // what the no-flicker rules key on, and those rules outrank the
    // per-widget ones. Leaving it behind would mean a click that changes the
    // panel back on the next paint.
    if (persist) {
      document.documentElement.setAttribute('data-pkg-port', slug)
      write(STORAGE_KEY, slug)
    }
  }

  function copyPanelCode(button: HTMLElement) {
    const wrap = button.closest('.lm-pkg-install__code')
    const codeEl = wrap?.querySelector('code')
    if (!codeEl) return
    let text = codeEl.textContent ?? ''
    if (wrap?.getAttribute('data-language') === 'console') {
      text = text.replace(/^\$ /gm, '')
    }
    writeClipboardText(text, button)
  }

  function writeClipboardText(text: string, button: HTMLElement) {
    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(
        () => announceCopyResult(button, true),
        () => fallbackCopy(text, button),
      )
    } else {
      fallbackCopy(text, button)
    }
  }

  function fallbackCopy(text: string, button: HTMLElement) {
    const focused = document.activeElement
    const textarea = document.createElement('textarea')
    textarea.value = text
    textarea.style.position = 'fixed'
    textarea.style.opacity = '0'
    document.body.appendChild(textarea)
    textarea.focus()
    textarea.select()
    let copied = false
    try {
      copied = document.execCommand('copy')
    } catch {
      copied = false
    } finally {
      textarea.remove()
      if (focused instanceof HTMLElement) focused.focus({ preventScroll: true })
    }
    announceCopyResult(button, copied)
  }

  function announceCopyResult(button: HTMLElement, copied: boolean) {
    const status = button.closest('.lm-pkg-install')?.querySelector('[data-copy-status]')
    status?.replaceChildren(document.createTextNode(copied ? 'Copied to clipboard.' : 'Copy failed. Select and copy the text manually.'))
    const original = button.getAttribute('data-copy-label') ?? button.textContent ?? 'Copy'
    button.setAttribute('data-copy-label', original)
    button.textContent = copied ? 'Copied' : 'Copy failed'
    button.classList.toggle('lm-pkg-install__copy--done', copied)
    const win = button as HTMLElement & { _lmCopyResetTimer?: number }
    window.clearTimeout(win._lmCopyResetTimer)
    win._lmCopyResetTimer = window.setTimeout(() => {
      button.textContent = original
      button.classList.remove('lm-pkg-install__copy--done')
    }, 1500)
  }

  /**
   * Arrow keys along a tab strip.
   *
   * `role="tablist"` is a promise that Left and Right move between the tabs;
   * without it a keyboard reader Tabs through every tab in the strip to reach
   * the content, which is what the roles exist to avoid. Shared by both strips
   * because the mechanism is the same either way — only the selector and what
   * a selection means differ.
   */
  function arrowNav(
    event: KeyboardEvent,
    tabs: HTMLButtonElement[],
    current: HTMLButtonElement,
    select: (tab: HTMLButtonElement) => void,
  ) {
    const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0
    if (!delta || tabs.length < 2) return
    event.preventDefault()
    const next = tabs[(tabs.indexOf(current) + delta + tabs.length) % tabs.length]!
    select(next)
    next.focus()
  }

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement
    const manager = target.closest<HTMLButtonElement>('.lm-pkg-install__manager')
    const panel = manager?.closest<HTMLElement>('.lm-pkg-install__panel')
    if (manager && panel) {
      const tabs = [...panel.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__manager')]
      arrowNav(e, tabs, manager, (tab) => {
        selectManager(panel, tab.dataset.managerValue ?? '0', true)
        window.dispatchEvent(
          new CustomEvent(MANAGER_SYNC_EVENT, {
            detail: { origin: panel, scope: panel.dataset.managerScope, index: tab.dataset.managerValue },
          }),
        )
      })
      return
    }
    const tab = target.closest<HTMLButtonElement>('.lm-pkg-install__tab')
    const widget = tab?.closest<HTMLElement>('.lm-pkg-install')
    if (!tab || !widget) return
    const tabs = [...widget.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__tab')]
    arrowNav(e, tabs, tab, (next) => {
      const slug = next.dataset.tabValue
      if (!slug) return
      selectPort(widget, slug, true)
      window.dispatchEvent(new CustomEvent(SYNC_EVENT, { detail: { origin: widget, slug } }))
    })
  })

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement
    const copyButton = target.closest<HTMLElement>('[data-action="copy"]')
    if (copyButton?.closest('.lm-pkg-install')) {
      e.preventDefault()
      copyPanelCode(copyButton)
      return
    }
    const manager = target.closest<HTMLButtonElement>('.lm-pkg-install__manager')
    const panel = manager?.closest<HTMLElement>('.lm-pkg-install__panel')
    if (manager && panel && manager.dataset.managerValue !== undefined) {
      selectManager(panel, manager.dataset.managerValue, true)
      window.dispatchEvent(
        new CustomEvent(MANAGER_SYNC_EVENT, {
          detail: { origin: panel, scope: panel.dataset.managerScope, index: manager.dataset.managerValue },
        }),
      )
      return
    }
    const tab = target.closest<HTMLButtonElement>('.lm-pkg-install__tab')
    const widget = tab?.closest<HTMLElement>('.lm-pkg-install')
    if (!tab || !widget || !tab.dataset.tabValue) return
    selectPort(widget, tab.dataset.tabValue, true)
    window.dispatchEvent(new CustomEvent(SYNC_EVENT, { detail: { origin: widget, slug: tab.dataset.tabValue } }))
  })

  window.addEventListener(SYNC_EVENT, ((e: CustomEvent<{ origin: HTMLElement; slug: string }>) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => {
      if (widget === e.detail.origin) return
      selectPort(widget, e.detail.slug, false)
    })
  }) as EventListener)

  // Two widgets on one page — the home page has one and a guide below it may
  // have another — agree on the manager for a given port, the same way they
  // already agree on the port.
  window.addEventListener(MANAGER_SYNC_EVENT, ((
    e: CustomEvent<{ origin: HTMLElement; scope?: string; index: string }>,
  ) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install__panel').forEach((panel) => {
      if (panel === e.detail.origin || panel.dataset.managerScope !== e.detail.scope) return
      selectManager(panel, e.detail.index, false)
    })
  }) as EventListener)

  // Dependency cooldowns. One setting for the whole site, kept under the MCP
  // picker's keys and mirrored onto the same <html> attributes, so turning a
  // cooldown on here turns it on in the MCP picker too and the reverse. Both
  // scripts announce a change on the MCP picker's event and repaint from the
  // saved state when they hear one.
  const COOLDOWN = {
    enabled: 'libtmux-docs.mcp-install.cooldown.enabled',
    type: 'libtmux-docs.mcp-install.cooldown.type',
    days: 'libtmux-docs.mcp-install.cooldown.days',
  }
  const COOLDOWN_EVENT = 'lm-mcp-install:change'
  const DEFAULT_DAYS = 7

  function clampDays(value: number): number {
    return Number.isFinite(value) ? Math.min(365, Math.max(1, Math.round(value))) : DEFAULT_DAYS
  }

  function cooldownState() {
    return {
      enabled: read(COOLDOWN.enabled) === '1',
      type: read(COOLDOWN.type) === 'bypass' ? 'bypass' : 'days',
      days: clampDays(parseInt(read(COOLDOWN.days) ?? '', 10)),
    }
  }

  // Every slot says how to spell the day count; see COOLDOWN_FORMATS in
  // lib/cooldown.ts. The MCP picker's ISO duration slots are its own.
  function writeCooldownSlots(days: number) {
    document.querySelectorAll<HTMLElement>('[data-cooldown-scale]').forEach((slot) => {
      const scale = parseInt(slot.dataset.cooldownScale ?? '1', 10) || 1
      slot.textContent = (slot.dataset.cooldownTemplate ?? '{}').replace('{}', String(days * scale))
    })
    document.querySelectorAll<HTMLElement>('[data-cooldown-duration-slot]').forEach((slot) => {
      slot.textContent = `P${days}D`
    })
  }

  function paintCooldown() {
    const { enabled, type, days } = cooldownState()
    const root = document.documentElement
    root.setAttribute('data-mcp-install-cooldown-enabled', enabled ? '1' : '0')
    root.setAttribute('data-mcp-install-cooldown-type', type)
    root.setAttribute('data-mcp-install-cooldown-days', String(days))
    document.querySelectorAll<HTMLInputElement>('[data-pkg-cooldown="toggle"]').forEach((box) => {
      box.checked = enabled
    })
    document.querySelectorAll<HTMLInputElement>('[data-pkg-cooldown="mode"]').forEach((radio) => {
      radio.checked = radio.value === type
    })
    document.querySelectorAll<HTMLInputElement>('[data-pkg-cooldown="days"]').forEach((input) => {
      if (document.activeElement !== input) input.value = String(days)
    })
    writeCooldownSlots(days)
  }

  function setCooldown(change: Partial<{ enabled: boolean; type: string; days: number }>) {
    if (change.enabled !== undefined) write(COOLDOWN.enabled, change.enabled ? '1' : '0')
    if (change.type !== undefined) write(COOLDOWN.type, change.type)
    if (change.days !== undefined) write(COOLDOWN.days, String(clampDays(change.days)))
    paintCooldown()
    for (const kind of ['enabled', 'type', 'days'] as const) {
      if (change[kind] === undefined) continue
      window.dispatchEvent(
        new CustomEvent(COOLDOWN_EVENT, { detail: { origin: null, kind: `cooldown-${kind}`, value: change[kind] } }),
      )
    }
  }

  document.addEventListener('change', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLInputElement>('[data-pkg-cooldown]')
    if (!el) return
    const action = el.dataset.pkgCooldown
    if (action === 'toggle') setCooldown({ enabled: el.checked })
    // Choosing how a cooldown behaves implies wanting one.
    if (action === 'mode') setCooldown({ type: el.value, enabled: true })
    if (action === 'days') setCooldown({ days: parseInt(el.value, 10), type: 'days', enabled: true })
  })

  // Typing a day count rewrites every command at once; it is saved on change.
  document.addEventListener('input', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLInputElement>('[data-pkg-cooldown="days"]')
    if (!el) return
    const days = parseInt(el.value, 10)
    if (Number.isFinite(days)) writeCooldownSlots(clampDays(days))
  })

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-pkg-cooldown="configure"], [data-pkg-cooldown="help"]')
    const panel = el?.closest<HTMLElement>('.lm-pkg-install__panel')
    const settings = panel?.querySelector<HTMLElement>('.lm-pkg-install__cooldown-settings')
    if (!el || !settings) return
    const open = el.dataset.pkgCooldown === 'help' || settings.dataset.open !== 'true'
    settings.dataset.open = String(open)
    panel!.querySelector('[data-pkg-cooldown="configure"]')?.setAttribute('aria-expanded', String(open))
    if (el.dataset.pkgCooldown === 'help') {
      settings.querySelector('details')?.setAttribute('open', '')
    }
  })

  window.addEventListener(COOLDOWN_EVENT, ((e: CustomEvent<{ kind?: string }>) => {
    if (e.detail?.kind?.startsWith('cooldown-')) paintCooldown()
  }) as EventListener)

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applySavedState)
  } else {
    applySavedState()
  }
  document.addEventListener('astro:after-swap', applySavedState)
</script>
