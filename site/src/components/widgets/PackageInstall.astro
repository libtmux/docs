---
import InstallCode from './InstallCode.astro'
import './package-install.css'
import { installsFor } from '../../lib/registry'
import { Code } from 'astro-expressive-code/components'
import { highlightInline, highlightWithCooldownSlots } from '../../lib/highlight'
import { DEFAULT_COOLDOWN_DAYS } from '../../lib/install-matrix'
import { PORTS, portHomeUrl, referenceUrl, type PortPackageId } from '../../lib/ports'
import type { Quickstart } from '../../lib/quickstarts'
import { defaultVersionFor } from '../../lib/versions'

/** Package-manager choices for core libraries and companion packages. */
interface Props {
  /** Port slugs to show; omit for all ten. */
  ports?: readonly string[]
  /**
   * A code example to show under each port's install line, keyed by slug.
   *
   * The home page's picker used to switch the install command while the
   * example below it stayed Python, so seven of the eight tabs showed a
   * Java or Swift install above Python code. Putting the example in the
   * panel makes one picker drive both, which is what a reader already
   * expects it to do.
   *
   * Omit it and the widget is exactly what it was: install lines only. A
   * port with no entry shows its install line alone rather than an empty
   * block.
   */
  snippets?: Partial<Record<string, Quickstart>>
  /** Active tab when nothing is saved yet; defaults to the first shown port. */
  defaultPort?: string
  variant?: 'full' | 'compact'
  /**
   * Where each block's copy button sits. `gutter` gives it a column beside the
   * code, so a long command cannot scroll under it; `overlay` floats it over
   * the block's corner. `auto`, the default, chooses per block: a one-line
   * command gets a gutter, and a fragment of several lines, which a whole
   * column beside it would only narrow, gets the overlay.
   */
  copyButton?: 'auto' | 'gutter' | 'overlay'
  /** Install a companion package instead of the core library. */
  packageId?: PortPackageId
}
const { ports, defaultPort, snippets, variant = 'full', copyButton = 'auto', packageId = 'core' } = Astro.props as Props
const copyLayout = (code: string) => (copyButton === 'auto' ? (code.includes('\n') ? 'overlay' : 'gutter') : copyButton)

const selected = ports && ports.length > 0 ? PORTS.filter((p) => ports.includes(p.slug)) : PORTS
const items = selected.map((port) => {
  if (packageId === 'core') return { ...port, installs: installsFor(port) }
  const companion = port.packages?.find((entry) => entry.id === packageId)
  if (!companion?.installs) throw new Error(`PackageInstall: ${port.slug} has no install forms for ${packageId}`)
  return { ...port, packageName: companion.name, installs: companion.installs }
})
if (items.length === 0) {
  throw new Error('PackageInstall: `ports` matched none of the ten port slugs in ports.ts')
}
const initialSlug = defaultPort && items.some((p) => p.slug === defaultPort) ? defaultPort : items[0]!.slug

/*
 * What a saved manager belongs to. A port's library and its companion package
 * offer different lists — TypeScript's library has five managers and its
 * workspace CLI seven — so one key per port had a choice in one widget select
 * an unrelated line in the other. `picker-paint.ts` builds the same scopes.
 */
const managerScope = (slug: string) => (packageId === 'core' ? slug : `${slug}-${packageId}`)

// Which panel to show once `data-active-port` is set is data-driven (one
// rule per port actually rendered in *this* instance), not hand-typed —
// ports.ts stays the only place a port's slug is spelled out. See the
// is:global block below for the static rules this pairs with.
const activePortRules = items
  .map((p) => `.lm-pkg-install[data-active-port="${p.slug}"] .lm-pkg-install__panel[data-port="${p.slug}"]{visibility:inherit}`)
  .join('')

/*
 * One rule per manager position, generated the same way and for the same
 * reason: the widths of these lists differ per port (one command for Rust,
 * five for TypeScript), so the rules are generated to the longest list
 * rendered here rather than to a number typed in a stylesheet.
 */
const managerRules = Array.from(
  { length: Math.max(...items.map((p) => p.installs.length)) },
  (_, i) =>
    `.lm-pkg-install__panel[data-active-manager="${i}"] .lm-pkg-install__cmd[data-manager="${i}"]{display:block}`,
).join('')

/*
 * Highlighted once, here rather than in the template: `await` is not allowed
 * inside a map callback in Astro's markup.
 *
 * A console command is shown with its prompt and copied without it — the copy
 * control strips `$ ` when `data-language` says console. Everything else
 * is a file fragment and is shown exactly as it goes into the file.
 */
const installHtml = new Map(
  await Promise.all(
    items.flatMap((p) =>
      p.installs.map(async (cmd, i) => [
        `${p.slug}/${i}`,
        await highlightInline(cmd.lang === 'console' ? `$ ${cmd.code}` : cmd.code, cmd.lang),
      ] as const),
    ),
  ),
)

/*
 * A command's cooldown and bypass forms, with the day count in slots the
 * script below rewrites. A form the tool cannot express is absent, and its
 * variant keeps the plain command with the tool's note beside it.
 */
const cooldownHtml = new Map(
  await Promise.all(
    items.flatMap((p) =>
      p.installs.flatMap((cmd, i) =>
        (['code', 'bypass'] as const)
          .filter((form) => cmd.cooldown?.[form])
          .map(async (form) => [
            `${p.slug}/${i}/${form}`,
            await highlightWithCooldownSlots(`$ ${cmd.cooldown![form]!}`, cmd.lang, DEFAULT_COOLDOWN_DAYS),
          ] as const),
      ),
    ),
  ),
)
const hasCooldown = (p: (typeof items)[number]) => p.installs.some((cmd) => cmd.cooldown)
// One radio group per picker and port, so a group never spans two pickers;
// the shared state keeps every group showing the same choice.
const cooldownGroup = (slug: string) => `cooldown-mode-${packageId}-${slug}`
---

<div class={`lm-pkg-install lm-pkg-install--${variant}${snippets ? ' lm-pkg-install--examples' : ''}`} data-ports={items.map((p) => p.slug).join(' ')}>
  {/*
    One language is not a choice of language.

    A port page renders this restricted to its own port, where the strip was a
    single tab that could not be switched away from — a control that answers
    nothing, above the control that answers something.
  */}
  {items.length > 1 && <div class="lm-pkg-install__tabs" role="tablist" aria-label="Package manager">
    {
      items.map((p) => (
        <button
          type="button"
          class="lm-pkg-install__tab"
          role="tab"
          data-tab-value={p.slug}
          aria-selected={p.slug === initialSlug ? 'true' : 'false'}
          tabindex={p.slug === initialSlug ? '0' : '-1'}
        >
          {p.name}
        </button>
      ))
    }
  </div>}
  <div class="lm-pkg-install__body">
    {
      items.map((p) => (
        <div
          class="lm-pkg-install__panel"
          role="tabpanel"
          data-port={p.slug}
          data-manager-scope={managerScope(p.slug)}
          data-default={p.slug === initialSlug ? true : undefined}
          tabindex="0"
        >
          {(p.installs.length > 1 || hasCooldown(p)) && <div class="lm-pkg-install__bar">
          {p.installs.length > 1 && (
            <div class="lm-pkg-install__managers" role="tablist" aria-label={`${p.name} package manager`}>
              {p.installs.map((cmd, i) => (
                <button
                  type="button"
                  class="lm-pkg-install__manager"
                  role="tab"
                  data-manager-value={i}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? '0' : '-1'}
                >
                  {cmd.label}
                </button>
              ))}
            </div>
          )}
          {hasCooldown(p) && (
            <div class="lm-pkg-install__cooldown">
              <input type="checkbox" class="lm-pkg-install__cooldown-toggle" data-pkg-cooldown="toggle" aria-label="Apply a dependency cooldown" />
              <button type="button" class="lm-pkg-install__cooldown-configure" data-pkg-cooldown="configure" aria-expanded="false">
                Configure cooldowns
              </button>
              <button type="button" class="lm-pkg-install__cooldown-help" data-pkg-cooldown="help" aria-label="What are cooldowns?" title="What are cooldowns?">?</button>
            </div>
          )}
          </div>}
          {hasCooldown(p) && (
            <div class="lm-pkg-install__cooldown-settings" role="group" aria-label="Cooldown settings" data-open="false">
              <p class="lm-pkg-install__cooldown-title">Dependency cooldowns</p>
              <p class="lm-pkg-install__cooldown-help-text">
                The checkbox turns a cooldown on and off for every picker on the site. It applies to what an install pulls
                in; the package itself, and the libtmux it pins, stay current.
              </p>
              <fieldset class="lm-pkg-install__cooldown-modes">
                <legend class="sr-only">Cooldown type</legend>
                <label>
                  <input type="radio" name={cooldownGroup(p.slug)} value="days" data-pkg-cooldown="mode" checked />
                  <span>
                    Apply a cooldown of
                    <input type="number" min="1" max="365" value={DEFAULT_COOLDOWN_DAYS} class="lm-pkg-install__cooldown-days" data-pkg-cooldown="days" aria-label="Cooldown in days" />
                    days
                  </span>
                </label>
                <label>
                  <input type="radio" name={cooldownGroup(p.slug)} value="bypass" data-pkg-cooldown="mode" />
                  <span>Bypass any global cooldown</span>
                </label>
              </fieldset>
              <details class="lm-pkg-install__cooldown-explainer">
                <summary>What are cooldowns?</summary>
                <p>
                  Cooldowns delay picking up newly uploaded packages so the community has time to spot supply-chain
                  attacks before you install. Most package managers don't apply one by default; you opt in through a
                  global setting in your tool's configuration.
                </p>
                <p>
                  Learn more at <a href="https://cooldowns.dev/" target="_blank" rel="noopener">cooldowns.dev</a> &middot;{' '}
                  <a href="https://securitylabs.datadoghq.com/articles/dependency-cooldowns/" target="_blank" rel="noopener">Datadog Security Labs writeup</a>.
                </p>
              </details>
            </div>
          )}
          {p.installs.map((cmd, i) => (
            <div
              class="lm-pkg-install__cmd"
              data-manager={i}
              data-default={i === 0 ? true : undefined}
              role={p.installs.length > 1 ? 'tabpanel' : undefined}
              tabindex={p.installs.length > 1 ? '0' : undefined}
            >
              {!cmd.cooldown && <InstallCode html={installHtml.get(`${p.slug}/${i}`)!} language={cmd.lang} layout={copyLayout(cmd.code)} />}
              {cmd.cooldown && (['off', 'days', 'bypass'] as const).map((mode) => {
                const form = mode === 'days' ? 'code' : mode === 'bypass' ? 'bypass' : undefined
                const code = form ? cmd.cooldown![form] : undefined
                const html = form && code ? cooldownHtml.get(`${p.slug}/${i}/${form}`) : installHtml.get(`${p.slug}/${i}`)
                return (
                  <div class="lm-pkg-install__variant" data-cooldown-variant={mode}>
                    <InstallCode html={html!} language={cmd.lang} layout={copyLayout(code ?? cmd.code)} />
                    {mode !== 'off' && !code && cmd.cooldown!.note && <p class="lm-pkg-install__note lm-pkg-install__note--cooldown">{cmd.cooldown!.note}</p>}
                  </div>
                )
              })}
              {cmd.note && <p class="lm-pkg-install__note">{cmd.note}</p>}
            </div>
          ))}
          {snippets && (
            <p class="lm-pkg-install__links">
              <a href={portHomeUrl(p, defaultVersionFor(p.slug))}>{p.name} documentation</a>
              <a href={referenceUrl(p, defaultVersionFor(p.slug))}>{p.name} API reference</a>
            </p>
          )}
          {snippets?.[p.slug] && (
            <div class="lm-pkg-install__snippet">
              <Code code={snippets[p.slug]!.code} lang={snippets[p.slug]!.lang} />
            </div>
          )}
        </div>
      ))
    }
  </div>
  <span class="sr-only" data-copy-status role="status" aria-live="polite" aria-atomic="true" />
</div>



{/* Generated from `items`, not hand-typed — see `activePortRules` above. */}
<style is:global set:html={activePortRules + managerRules} />

<script>
  // Deferred interactivity: tab switching, cross-instance sync, and
  // copy-to-clipboard. Event delegation on document so this survives an
  // Astro ClientRouter swap the same way McpInstall's mcp-install.js does
  // (see that file's header) — this site doesn't run ClientRouter yet, but
  // every other interactive component here already defends against it.
  const STORAGE_KEY = 'libtmux-docs.package-install.port'
  // Per port, because a choice of pnpm says nothing about a choice of uv.
  const MANAGER_KEY = 'libtmux-docs.package-install.manager'
  import { HOME_PORT_PREVIEW_EVENT } from '../../lib/home-hover-preview'

  const SYNC_EVENT = 'lm-pkg-install:change'
  const MANAGER_SYNC_EVENT = 'lm-pkg-install:manager'

  function read(key: string): string | null {
    try {
      return localStorage.getItem(key)
    } catch {
      // Private windows and blocked site data throw here. The widget still
      // works for this page; only the memory is lost.
      return null
    }
  }

  function write(key: string, value: string) {
    try {
      localStorage.setItem(key, value)
    } catch {
      // As above.
    }
  }

  function applySavedState() {
    if (document.querySelector('[data-pkg-cooldown]')) paintCooldown()
    const saved = document.documentElement.getAttribute('data-pkg-port') ?? read(STORAGE_KEY)
    if (saved) {
      document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => selectPort(widget, saved, false))
    }
    document.querySelectorAll<HTMLElement>('.lm-pkg-install__panel').forEach((panel) => {
      const scope = panel.dataset.managerScope
      const savedManager = scope && read(`${MANAGER_KEY}.${scope}`)
      if (savedManager) selectManager(panel, savedManager, false)
    })
  }

  function selectManager(panel: HTMLElement, index: string, persist: boolean) {
    const tabs = panel.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__manager')
    // Decided before anything is written, for the same reason selectPort
    // does: a saved index outside this port's list would otherwise clear
    // every tab and show no command at all.
    if (![...tabs].some((tab) => tab.dataset.managerValue === index)) return
    tabs.forEach((tab) => {
      const isMatch = tab.dataset.managerValue === index
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false')
      tab.setAttribute('tabindex', isMatch ? '0' : '-1')
    })
    panel.setAttribute('data-active-manager', index)
    if (persist && panel.dataset.managerScope) {
      // As selectPort does for the language: <head> puts the saved manager on
      // the document before first paint, and the rules keyed on it outrank
      // this panel's, so a click has to move the document attribute too.
      document.documentElement.setAttribute(`data-pkg-manager-${panel.dataset.managerScope}`, index)
      write(`${MANAGER_KEY}.${panel.dataset.managerScope}`, index)
    }
  }

  function selectPort(widget: HTMLElement, slug: string, persist: boolean) {
    const tabs = widget.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__tab')
    // Decided before anything is written. This used to clear `aria-selected`
    // on every tab and *then* return when none matched, so a picker
    // restricted to one language — the port pages render one — was left with
    // no tab selected at all whenever the shared saved value named a
    // different language. The panel was right and the tab above it was blank.
    const matched = [...tabs].some((tab) => tab.dataset.tabValue === slug)
    // A restricted-subset instance that doesn't carry this port keeps its
    // own current selection rather than going blank — see this file's top
    // comment on why the storage key is shared but instances aren't forced
    // to honor a value outside their own `ports` prop.
    if (!matched) return
    tabs.forEach((tab) => {
      const isMatch = tab.dataset.tabValue === slug
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false')
      tab.setAttribute('tabindex', isMatch ? '0' : '-1')
    })
    widget.setAttribute('data-active-port', slug)
    // The document-level attribute is what <head> sets before first paint and
    // what the no-flicker rules key on, and those rules outrank the
    // per-widget ones. Leaving it behind would mean a click that changes the
    // panel back on the next paint.
    if (persist) {
      document.documentElement.setAttribute('data-pkg-port', slug)
      write(STORAGE_KEY, slug)
    }
  }

  /**
   * Arrow keys along a tab strip.
   *
   * `role="tablist"` is a promise that Left and Right move between the tabs;
   * without it a keyboard reader Tabs through every tab in the strip to reach
   * the content, which is what the roles exist to avoid. Shared by both strips
   * because the mechanism is the same either way — only the selector and what
   * a selection means differ.
   */
  function arrowNav(
    event: KeyboardEvent,
    tabs: HTMLButtonElement[],
    current: HTMLButtonElement,
    select: (tab: HTMLButtonElement) => void,
  ) {
    const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0
    if (!delta || tabs.length < 2) return
    event.preventDefault()
    const next = tabs[(tabs.indexOf(current) + delta + tabs.length) % tabs.length]!
    select(next)
    next.focus()
  }

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement
    const manager = target.closest<HTMLButtonElement>('.lm-pkg-install__manager')
    const panel = manager?.closest<HTMLElement>('.lm-pkg-install__panel')
    if (manager && panel) {
      const tabs = [...panel.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__manager')]
      arrowNav(e, tabs, manager, (tab) => {
        selectManager(panel, tab.dataset.managerValue ?? '0', true)
        window.dispatchEvent(
          new CustomEvent(MANAGER_SYNC_EVENT, {
            detail: { origin: panel, scope: panel.dataset.managerScope, index: tab.dataset.managerValue },
          }),
        )
      })
      return
    }
    const tab = target.closest<HTMLButtonElement>('.lm-pkg-install__tab')
    const widget = tab?.closest<HTMLElement>('.lm-pkg-install')
    if (!tab || !widget) return
    const tabs = [...widget.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__tab')]
    arrowNav(e, tabs, tab, (next) => {
      const slug = next.dataset.tabValue
      if (!slug) return
      selectPort(widget, slug, true)
      window.dispatchEvent(new CustomEvent(SYNC_EVENT, { detail: { origin: widget, slug } }))
    })
  })

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement
    const manager = target.closest<HTMLButtonElement>('.lm-pkg-install__manager')
    const panel = manager?.closest<HTMLElement>('.lm-pkg-install__panel')
    if (manager && panel && manager.dataset.managerValue !== undefined) {
      selectManager(panel, manager.dataset.managerValue, true)
      window.dispatchEvent(
        new CustomEvent(MANAGER_SYNC_EVENT, {
          detail: { origin: panel, scope: panel.dataset.managerScope, index: manager.dataset.managerValue },
        }),
      )
      return
    }
    const tab = target.closest<HTMLButtonElement>('.lm-pkg-install__tab')
    const widget = tab?.closest<HTMLElement>('.lm-pkg-install')
    if (!tab || !widget || !tab.dataset.tabValue) return
    selectPort(widget, tab.dataset.tabValue, true)
    window.dispatchEvent(new CustomEvent(SYNC_EVENT, { detail: { origin: widget, slug: tab.dataset.tabValue } }))
  })

  window.addEventListener(HOME_PORT_PREVIEW_EVENT, ((event: CustomEvent<{ slug: string }>) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => {
      selectPort(widget, event.detail.slug, false)
    })
  }) as EventListener)

  window.addEventListener(SYNC_EVENT, ((e: CustomEvent<{ origin: HTMLElement; slug: string }>) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => {
      if (widget === e.detail.origin) return
      selectPort(widget, e.detail.slug, false)
    })
  }) as EventListener)

  // Two widgets on one page — the home page has one and a guide below it may
  // have another — agree on the manager for a given port, the same way they
  // already agree on the port.
  window.addEventListener(MANAGER_SYNC_EVENT, ((
    e: CustomEvent<{ origin: HTMLElement; scope?: string; index: string }>,
  ) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install__panel').forEach((panel) => {
      if (panel === e.detail.origin || panel.dataset.managerScope !== e.detail.scope) return
      selectManager(panel, e.detail.index, false)
    })
  }) as EventListener)

  // Dependency cooldowns. One setting for the whole site, kept under the MCP
  // picker's keys and mirrored onto the same <html> attributes, so turning a
  // cooldown on here turns it on in the MCP picker too and the reverse. Both
  // scripts announce a change on the MCP picker's event and repaint from the
  // saved state when they hear one.
  const COOLDOWN = {
    enabled: 'libtmux-docs.mcp-install.cooldown.enabled',
    type: 'libtmux-docs.mcp-install.cooldown.type',
    days: 'libtmux-docs.mcp-install.cooldown.days',
  }
  const COOLDOWN_EVENT = 'lm-mcp-install:change'
  const DEFAULT_DAYS = 7

  function clampDays(value: number): number {
    return Number.isFinite(value) ? Math.min(365, Math.max(1, Math.round(value))) : DEFAULT_DAYS
  }

  function cooldownState() {
    return {
      enabled: read(COOLDOWN.enabled) === '1',
      type: read(COOLDOWN.type) === 'bypass' ? 'bypass' : 'days',
      days: clampDays(parseInt(read(COOLDOWN.days) ?? '', 10)),
    }
  }

  // Every slot says how to spell the day count; see COOLDOWN_FORMATS in
  // lib/cooldown.ts. The MCP picker's ISO duration slots are its own.
  function writeCooldownSlots(days: number) {
    document.querySelectorAll<HTMLElement>('[data-cooldown-scale]').forEach((slot) => {
      const scale = parseInt(slot.dataset.cooldownScale ?? '1', 10) || 1
      slot.textContent = (slot.dataset.cooldownTemplate ?? '{}').replace('{}', String(days * scale))
    })
    document.querySelectorAll<HTMLElement>('[data-cooldown-duration-slot]').forEach((slot) => {
      slot.textContent = `P${days}D`
    })
  }

  function paintCooldown() {
    const { enabled, type, days } = cooldownState()
    const root = document.documentElement
    root.setAttribute('data-mcp-install-cooldown-enabled', enabled ? '1' : '0')
    root.setAttribute('data-mcp-install-cooldown-type', type)
    root.setAttribute('data-mcp-install-cooldown-days', String(days))
    document.querySelectorAll<HTMLInputElement>('[data-pkg-cooldown="toggle"]').forEach((box) => {
      box.checked = enabled
    })
    document.querySelectorAll<HTMLInputElement>('[data-pkg-cooldown="mode"]').forEach((radio) => {
      radio.checked = radio.value === type
    })
    document.querySelectorAll<HTMLInputElement>('[data-pkg-cooldown="days"]').forEach((input) => {
      if (document.activeElement !== input) input.value = String(days)
    })
    writeCooldownSlots(days)
  }

  function setCooldown(change: Partial<{ enabled: boolean; type: string; days: number }>) {
    if (change.enabled !== undefined) write(COOLDOWN.enabled, change.enabled ? '1' : '0')
    if (change.type !== undefined) write(COOLDOWN.type, change.type)
    if (change.days !== undefined) write(COOLDOWN.days, String(clampDays(change.days)))
    paintCooldown()
    for (const kind of ['enabled', 'type', 'days'] as const) {
      if (change[kind] === undefined) continue
      window.dispatchEvent(
        new CustomEvent(COOLDOWN_EVENT, { detail: { origin: null, kind: `cooldown-${kind}`, value: change[kind] } }),
      )
    }
  }

  document.addEventListener('change', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLInputElement>('[data-pkg-cooldown]')
    if (!el) return
    const action = el.dataset.pkgCooldown
    if (action === 'toggle') setCooldown({ enabled: el.checked })
    // Choosing how a cooldown behaves implies wanting one.
    if (action === 'mode') setCooldown({ type: el.value, enabled: true })
    if (action === 'days') setCooldown({ days: parseInt(el.value, 10), type: 'days', enabled: true })
  })

  // Typing a day count rewrites every command at once; it is saved on change.
  document.addEventListener('input', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLInputElement>('[data-pkg-cooldown="days"]')
    if (!el) return
    const days = parseInt(el.value, 10)
    if (Number.isFinite(days)) writeCooldownSlots(clampDays(days))
  })

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-pkg-cooldown="configure"], [data-pkg-cooldown="help"]')
    const panel = el?.closest<HTMLElement>('.lm-pkg-install__panel')
    const settings = panel?.querySelector<HTMLElement>('.lm-pkg-install__cooldown-settings')
    if (!el || !settings) return
    const open = el.dataset.pkgCooldown === 'help' || settings.dataset.open !== 'true'
    settings.dataset.open = String(open)
    panel!.querySelector('[data-pkg-cooldown="configure"]')?.setAttribute('aria-expanded', String(open))
    if (el.dataset.pkgCooldown === 'help') {
      settings.querySelector('details')?.setAttribute('open', '')
    }
  })

  window.addEventListener(COOLDOWN_EVENT, ((e: CustomEvent<{ kind?: string }>) => {
    if (e.detail?.kind?.startsWith('cooldown-')) paintCooldown()
  }) as EventListener)

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applySavedState)
  } else {
    applySavedState()
  }
  document.addEventListener('astro:after-swap', applySavedState)
</script>
