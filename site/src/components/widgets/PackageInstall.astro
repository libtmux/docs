---
import InstallCode from './InstallCode.astro'
import InstallCooldown from './InstallCooldown.astro'
import InstallFacts from './InstallFacts.astro'
import InstallTabRow from './InstallTabRow.astro'
import InstallWhere from './InstallWhere.astro'
import './install-surface.css'
import './package-install.css'
import { installsFor, installSelection, REGISTRY, registryFor } from '../../lib/registry'
import { API_MODELS } from '../../lib/api-models'
import { Code } from 'astro-expressive-code/components'
import { highlightInline, highlightWithCooldownSlots } from '../../lib/highlight'
import { DEFAULT_COOLDOWN_DAYS, markPlaceholders, wrapShell } from '../../lib/install-matrix'
import { addedLines, channelForms, markAddedLines, promptFor, withPrompt } from '../../lib/install-surface'
import { PORTS, portHomeUrl, productStatus, referenceUrl, type PortPackageId } from '../../lib/ports'
import type { Quickstart } from '../../lib/quickstarts'
import { defaultVersionFor } from '../../lib/versions'

/** Package-manager choices for core libraries and companion packages. */
interface Props {
  /** Port slugs to show; omit for all ten. */
  ports?: readonly string[]
  /**
   * A code example to show under each port's install line, keyed by slug.
   *
   * The home page's picker used to switch the install command while the
   * example below it stayed Python, so seven of the eight tabs showed a
   * Java or Swift install above Python code. Putting the example in the
   * panel makes one picker drive both, which is what a reader already
   * expects it to do.
   *
   * Omit it and the widget is exactly what it was: install lines only. A
   * port with no entry shows its install line alone rather than an empty
   * block.
   */
  snippets?: Partial<Record<string, Quickstart>>
  /** Active tab when nothing is saved yet; defaults to the first shown port. */
  defaultPort?: string
  variant?: 'full' | 'compact'
  /** Install a companion package instead of the core library. */
  packageId?: PortPackageId
}
const { ports, defaultPort, snippets, variant = 'full', packageId = 'core' } = Astro.props as Props

const selected = ports && ports.length > 0 ? PORTS.filter((p) => ports.includes(p.slug)) : PORTS
const items = selected.map((port) => {
  const selection = installSelection(port, API_MODELS[port.slug]?.sources, process.env)
  const entry = registryFor(port)
  if (packageId === 'core') {
    return {
      ...port,
      installs: installsFor(port, selection),
      channels: channelForms(port, entry),
      facts: {
        name: port.packageName,
        version: entry.version,
        status: productStatus(port, 'core', REGISTRY),
        registry: port.registry,
        unpublished: entry.status === 'unpublished',
      },
    }
  }
  const companion = port.packages?.find((item) => item.id === packageId)
  if (!companion?.installs) throw new Error(`PackageInstall: ${port.slug} has no install forms for ${packageId}`)
  const product = { ...port, packageName: companion.name, installs: companion.installs }
  const found = entry.packages?.[companion.name]
  return {
    ...product,
    installs: port.slug === 'julia' ? installsFor(product, selection) : companion.installs,
    channels: [],
    facts: {
      name: companion.name,
      version: found?.version ?? null,
      status: packageId === 'workspace' || packageId === 'mcp' ? productStatus(port, packageId, REGISTRY) : undefined,
      registry: companion.registry ? { url: companion.registry } : undefined,
      unpublished: found ? found.status === 'unpublished' : !companion.registry,
    },
  }
})
if (items.length === 0) {
  throw new Error('PackageInstall: `ports` matched none of the ten port slugs in ports.ts')
}
const initialSlug = defaultPort && items.some((p) => p.slug === defaultPort) ? defaultPort : items[0]!.slug

/*
 * What a saved manager belongs to. A port's library and its companion package
 * offer different lists — TypeScript's library has five managers and its
 * workspace CLI seven — so one key per port had a choice in one widget select
 * an unrelated line in the other. `picker-paint.ts` builds the same scopes.
 */
const managerScope = (slug: string) => (packageId === 'core' ? slug : `${slug}-${packageId}`)

/** Ids that pair each tab with what it controls, for the language tabs and the package-manager tabs (08 Responsive and accessible). */
const tabId = (slug: string) => `pkg-install-tab-${managerScope(slug)}`
const panelId = (slug: string) => `pkg-install-panel-${managerScope(slug)}`
const managerTabId = (slug: string, i: number) => `pkg-install-manager-${managerScope(slug)}-${i}`
const commandId = (slug: string, i: number) => `pkg-install-command-${managerScope(slug)}-${i}`

// Which panel to show once `data-active-port` is set is data-driven (one
// rule per port actually rendered in *this* instance), not hand-typed —
// ports.ts stays the only place a port's slug is spelled out. See the
// is:global block below for the static rules this pairs with.
const activePortRules = items
  .map((p) => `.lm-pkg-install[data-active-port="${p.slug}"] .lm-pkg-install__panel[data-port="${p.slug}"]{visibility:inherit}`)
  .join('')

/*
 * One rule per manager position, generated the same way and for the same
 * reason: the widths of these lists differ per port (one command for Rust,
 * five for TypeScript), so the rules are generated to the longest list
 * rendered here rather than to a number typed in a stylesheet.
 */
const managerRules = Array.from(
  { length: Math.max(...items.map((p) => p.installs.length)) },
  (_, i) =>
    `.lm-pkg-install__panel[data-active-manager="${i}"] .lm-pkg-install__cmd[data-manager="${i}"]{display:block}`,
).join('')

/*
 * Highlighted once, here rather than in the template: `await` is not allowed
 * inside a map callback in Astro's markup.
 *
 * A shell command is drawn with its prompt and copied without it, and so is a
 * PowerShell or Package Manager Console command; Copy takes the prompt off by
 * the `data-prompt` the block carries. Everything else is a file fragment and
 * is shown exactly as it goes into the file. A command wider than the line is
 * split by the long-command rule.
 */
type Placed = { lang: string; target: string }
async function drawn(code: string, at: Placed, options: { slots?: boolean; against?: string } = {}): Promise<string> {
  const text = at.lang === 'console' ? wrapShell(code) : code
  const source = at.lang === 'console' ? `$ ${text}` : text
  let html = options.slots
    ? await highlightWithCooldownSlots(source, at.lang, DEFAULT_COOLDOWN_DAYS)
    : await highlightInline(source, at.lang)
  const prompt = promptFor(at.target, at.lang)
  if (prompt && at.lang !== 'console') html = withPrompt(html, prompt)
  // The lines a cooldown adds to the plain command are marked, as a diff marks an insertion.
  if (options.against !== undefined) html = markAddedLines(html, addedLines(options.against, text))
  return markPlaceholders(html)
}
const plainText = (cmd: Placed & { code: string }) => (cmd.lang === 'console' ? wrapShell(cmd.code) : cmd.code)

const installHtml = new Map(
  await Promise.all(items.flatMap((p) => p.installs.map(async (cmd, i) => [`${p.slug}/${i}`, await drawn(cmd.code, cmd)] as const))),
)

const additionalHtml = new Map(
  await Promise.all(items.flatMap((p) => p.installs.flatMap((cmd, i) =>
    (cmd.additionalBlocks ?? []).map(async (block, j) => [
      `${p.slug}/${i}/${j}`, await drawn(block.code, { lang: block.lang, target: block.filename ?? cmd.target }),
    ] as const),
  ))),
)

/*
 * A command's cooldown and bypass forms, with the day count in slots the
 * script below rewrites, and the lines each adds marked. A form the tool
 * cannot express is absent, and its variant keeps the plain command with the
 * tool's reason in the strip above it.
 */
const cooldownHtml = new Map(
  await Promise.all(
    items.flatMap((p) =>
      p.installs.flatMap((cmd, i) =>
        (['code', 'bypass'] as const)
          .filter((form) => cmd.cooldown?.[form])
          .map(async (form) => [
            `${p.slug}/${i}/${form}`,
            await drawn(cmd.cooldown![form]!, cmd, { slots: true, against: plainText(cmd) }),
          ] as const),
      ),
    ),
  ),
)

// A release channel's code, drawn like any other.
const channelHtml = new Map(
  await Promise.all(items.flatMap((p) => p.channels.map(async (channel) => [`${p.slug}/${channel.id}`, await drawn(channel.code, channel)] as const))),
)

// A workspace manager's follow-up is loading a workspace, unless the command only runs it once.
const loadCommand = (p: (typeof items)[number], cmd: (typeof items)[number]['installs'][number]) =>
  packageId === 'workspace' && p.workspaceCli && !/--help\s*$/.test(cmd.code) ? `${p.workspaceCli} ./workspace.yaml` : undefined
const loadHtml = new Map(
  await Promise.all(items.flatMap((p) => p.installs.flatMap((cmd, i) => {
    const load = loadCommand(p, cmd)
    return load ? [(async () => [`${p.slug}/${i}`, await drawn(load, { lang: 'console', target: 'Terminal' })] as const)()] : []
  }))),
)

const hasCooldown = (p: (typeof items)[number]) => p.installs.some((cmd) => cmd.cooldown)
/** The first tool that takes a cooldown, which a tool that cannot offers as the way forward. */
const cooldownAlt = (p: (typeof items)[number]) => p.installs.findIndex((cmd) => cmd.cooldown?.code)
const exemptClause = (p: (typeof items)[number]) =>
  packageId === 'core' ? 'libtmux itself stays current' : `${p.packageName} and libtmux stay current`
const MODES = ['off', 'days', 'bypass'] as const
const CHANNEL_NOTES = {
  prerelease: 'Pins this pre-release by version; release builds are the default.',
  git: 'Pins the tagged source; the registry release is the default.',
} as const
---

<div class={`lm-pkg-install lm-pkg-install--surface lm-pkg-install--${variant}${snippets ? ' lm-pkg-install--examples' : ''}`} data-ports={items.map((p) => p.slug).join(' ')}>
  {/*
    One language is not a choice of language.

    A port page renders this restricted to its own port, where the strip was a
    single tab that could not be switched away from — a control that answers
    nothing, above the control that answers something.
  */}
  {items.length > 1 && <div class="lm-pkg-install__tabs" role="tablist" aria-label="Programming language">
    {
      items.map((p) => (
        <button
          type="button"
          class="lm-pkg-install__tab"
          role="tab"
          id={tabId(p.slug)}
          aria-controls={panelId(p.slug)}
          data-tab-value={p.slug}
          aria-selected={p.slug === initialSlug ? 'true' : 'false'}
          tabindex={p.slug === initialSlug ? '0' : '-1'}
        >
          {p.name}
        </button>
      ))
    }
  </div>}
  <div class="lm-pkg-install__body">
    {
      items.map((p) => (
        <div
          class="lm-pkg-install__panel"
          role="tabpanel"
          id={panelId(p.slug)}
          aria-labelledby={items.length > 1 ? tabId(p.slug) : undefined}
          data-port={p.slug}
          data-manager-scope={managerScope(p.slug)}
          data-active-channel="release"
          data-copy-scope
          data-default={p.slug === initialSlug ? true : undefined}
        >
          <div class="lm-install">
            <div class="lm-install__head">
              <InstallTabRow noun="tools">
                {p.installs.length > 1 ? (
                  <div class="lm-pkg-install__managers" role="tablist" aria-label={`${p.name} package manager`}>
                    {p.installs.map((cmd, i) => (
                      <button
                        type="button"
                        class="lm-pkg-install__manager"
                        role="tab"
                        id={managerTabId(p.slug, i)}
                        aria-controls={commandId(p.slug, i)}
                        data-manager-value={i}
                        data-no-days={hasCooldown(p) && !cmd.cooldown?.code ? '' : undefined}
                        data-no-bypass={hasCooldown(p) && !cmd.cooldown?.bypass ? '' : undefined}
                        aria-selected={i === 0 ? 'true' : 'false'}
                        tabindex={i === 0 ? '0' : '-1'}
                      >
                        {cmd.label}{hasCooldown(p) && <span class="lm-install__dot" title={`The cooldown does not reach ${cmd.label}`}><span class="sr-only"> (no cooldown)</span></span>}
                      </button>
                    ))}
                  </div>
                ) : (
                  <span class="lm-install__sole lm-pkg-install__label" data-channel="release">{p.installs[0]!.label}</span>
                )}
                {p.channels.map((channel) => <span class="lm-install__sole lm-pkg-install__label" data-channel={channel.id}>{channel.label}</span>)}
              </InstallTabRow>
              <div class="lm-install__headend">
                <div class="lm-pkg-install__chan" data-channel="release">
                  {p.installs.map((cmd, i) => (
                    <div class="lm-pkg-install__cmd" data-manager={i} data-default={i === 0 ? true : undefined}>
                      {cmd.cooldown
                        ? MODES.map((mode) => <div class="lm-pkg-install__variant" data-cooldown-variant={mode}><InstallWhere family="pkg" target={cmd.target} lang={cmd.lang} copyKey={`${i}/${mode}`} /></div>)
                        : <InstallWhere family="pkg" target={cmd.target} lang={cmd.lang} copyKey={String(i)} />}
                    </div>
                  ))}
                </div>
                {p.channels.map((channel) => (
                  <div class="lm-pkg-install__chan" data-channel={channel.id}>
                    <InstallWhere family="pkg" target={channel.target} lang={channel.lang} copyKey={channel.id} />
                  </div>
                ))}
              </div>
            </div>
            <div class="lm-install__bar">
              <InstallFacts {...p.facts} />
              {p.channels.length > 0 && (
                <span class="lm-install__opts">
                  <span class="lm-install__seg" role="group" aria-label="Release channel">
                    <button type="button" data-pkg-channel="release" aria-pressed="true">Release</button>
                    {p.channels.map((channel) => <button type="button" data-pkg-channel={channel.id} aria-pressed="false">{channel.label}</button>)}
                  </span>
                </span>
              )}
              {hasCooldown(p) && (
                <span class="lm-install__cd">
                  <button type="button" class="lm-install__cdtoggle" data-pkg-cooldown="toggle" aria-pressed="false" title="Applies to every installer on libtmux.org">
                    <span class="lm-install__glyph" aria-hidden="true"></span>Cooldown
                  </button>
                </span>
              )}
            </div>
            <div class="lm-install__body">
              <div class="lm-pkg-install__chan" data-channel="release">
                {p.installs.map((cmd, i) => (
                  <div class="lm-pkg-install__cmd" id={p.installs.length > 1 ? commandId(p.slug, i) : undefined} data-manager={i} data-default={i === 0 ? true : undefined}>
                    {cmd.cooldown ? MODES.map((mode) => {
                      const form = mode === 'days' ? 'code' : mode === 'bypass' ? 'bypass' : undefined
                      const refused = form && !cmd.cooldown![form]
                      const html = form && !refused ? cooldownHtml.get(`${p.slug}/${i}/${form}`) : installHtml.get(`${p.slug}/${i}`)
                      const alt = cooldownAlt(p)
                      return (
                        <div class="lm-pkg-install__variant" data-cooldown-variant={mode}>
                          {mode !== 'off' && <InstallCooldown
                            family="pkg"
                            mode={mode}
                            tool={cmd.label}
                            exempt={exemptClause(p)}
                            reason={refused ? (mode === 'days' ? cmd.cooldown!.note ?? `${cmd.label} cannot take a cooldown, so this command runs without one.` : `${cmd.label} has no flag to bypass a cooldown set in its configuration, so this command is unchanged.`) : undefined}
                            alt={refused && mode === 'days' && alt >= 0 && alt !== i ? { id: alt, label: p.installs[alt]!.label } : undefined}
                          />}
                          <InstallCode html={html!} language={cmd.lang} layout="plain" prompt={promptFor(cmd.target, cmd.lang)} codeKey={`${i}/${mode}`} />
                        </div>
                      )
                    }) : <InstallCode html={installHtml.get(`${p.slug}/${i}`)!} language={cmd.lang} layout="plain" prompt={promptFor(cmd.target, cmd.lang)} codeKey={String(i)} />}
                    {cmd.additionalBlocks?.map((block, j) => (
                      <InstallCode html={additionalHtml.get(`${p.slug}/${i}/${j}`)!} language={block.lang} layout="strip" after strip={block.filename ?? 'Then'} prompt={promptFor(block.filename ?? cmd.target, block.lang)} label={block.filename} />
                    ))}
                    {loadHtml.has(`${p.slug}/${i}`) && <InstallCode html={loadHtml.get(`${p.slug}/${i}`)!} language="console" layout="strip" after strip="Then" prompt="$" label="load command" />}
                  </div>
                ))}
              </div>
              {p.channels.map((channel) => (
                <div class="lm-pkg-install__chan" data-channel={channel.id}>
                  <InstallCode html={channelHtml.get(`${p.slug}/${channel.id}`)!} language={channel.lang} layout="plain" prompt={promptFor(channel.target, channel.lang)} codeKey={channel.id} />
                </div>
              ))}
            </div>
          </div>
          <div class="lm-install__notes">
            <div class="lm-pkg-install__chan" data-channel="release">
              {p.installs.map((cmd, i) => cmd.note && (
                <div class="lm-pkg-install__cmd" data-manager={i} data-default={i === 0 ? true : undefined}>
                  <p class="lm-pkg-install__note">{cmd.note}</p>
                </div>
              ))}
            </div>
            {p.channels.map((channel) => (
              <div class="lm-pkg-install__chan" data-channel={channel.id}>
                <p class="lm-pkg-install__note">{CHANNEL_NOTES[channel.id]}</p>
              </div>
            ))}
          </div>
          {snippets && (
            <p class="lm-pkg-install__links">
              <a href={portHomeUrl(p, defaultVersionFor(p.slug))}>{p.name} documentation</a>
              <a href={referenceUrl(p, defaultVersionFor(p.slug))}>{p.name} API reference</a>
            </p>
          )}
          {snippets?.[p.slug] && (
            <div class="lm-pkg-install__snippet">
              <Code code={snippets[p.slug]!.code} lang={snippets[p.slug]!.lang} />
            </div>
          )}
        </div>
      ))
    }
  </div>
  <span class="sr-only" data-copy-status role="status" aria-live="polite" aria-atomic="true" />
</div>

{/* Generated from `items`, not hand-typed — see `activePortRules` above. */}
<style is:global set:html={activePortRules + managerRules} />

<script>
  // Deferred interactivity: tab switching, cross-instance sync, and
  // copy-to-clipboard. Event delegation on document so this survives an
  // Astro ClientRouter swap the same way McpInstall's mcp-install.js does
  // (see that file's header) — this site doesn't run ClientRouter yet, but
  // every other interactive component here already defends against it.
  const STORAGE_KEY = 'libtmux-docs.package-install.port'
  // Per port, because a choice of pnpm says nothing about a choice of uv.
  const MANAGER_KEY = 'libtmux-docs.package-install.manager'
  import { HOME_PORT_PREVIEW_EVENT } from '../../lib/home-hover-preview'
  import { revealSelected, watchTabRows } from './install-tabs'

  const SYNC_EVENT = 'lm-pkg-install:change'
  const MANAGER_SYNC_EVENT = 'lm-pkg-install:manager'

  function read(key: string): string | null {
    try {
      return localStorage.getItem(key)
    } catch {
      // Private windows and blocked site data throw here. The widget still
      // works for this page; only the memory is lost.
      return null
    }
  }

  function write(key: string, value: string) {
    try {
      localStorage.setItem(key, value)
    } catch {
      // As above.
    }
  }

  /**
   * Which release channel a panel shows: its package managers (Release), or one form of its own. The
   * cooldown applies to a release only, so it stays where it is, disabled, in the others.
   */
  const COOLDOWN_TITLE = 'Applies to every installer on libtmux.org'
  const RELEASE_ONLY = 'Cooldowns apply to the Release channel.'

  function setChannel(panel: HTMLElement, channel: string) {
    panel.dataset.activeChannel = channel
    panel.querySelectorAll<HTMLElement>('[data-pkg-channel]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.pkgChannel === channel))
    })
    panel.querySelectorAll<HTMLButtonElement>('[data-pkg-cooldown="toggle"]').forEach((toggle) => {
      toggle.disabled = channel !== 'release'
      toggle.title = channel === 'release' ? COOLDOWN_TITLE : RELEASE_ONLY
      toggle.setAttribute('aria-pressed', String(channel === 'release' && cooldownState().enabled))
    })
    // The tabs come and go with the channel, and the row's own size does not change when they do.
    const row = panel.querySelector<HTMLElement>('[data-install-scroll]')
    if (row) revealSelected(row, 'center')
  }

  function applySavedState() {
    if (document.querySelector('[data-pkg-cooldown]')) paintCooldown()
    const saved = document.documentElement.getAttribute('data-pkg-port') ?? read(STORAGE_KEY)
    if (saved) {
      document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => selectPort(widget, saved, false))
    }
    document.querySelectorAll<HTMLElement>('.lm-pkg-install__panel').forEach((panel) => {
      const scope = panel.dataset.managerScope
      const savedManager = scope && read(`${MANAGER_KEY}.${scope}`)
      if (savedManager) selectManager(panel, savedManager, false)
    })
    watchTabRows()
  }

  function selectManager(panel: HTMLElement, index: string, persist: boolean) {
    const tabs = panel.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__manager')
    // Decided before anything is written, for the same reason selectPort
    // does: a saved index outside this port's list would otherwise clear
    // every tab and show no command at all.
    if (![...tabs].some((tab) => tab.dataset.managerValue === index)) return
    tabs.forEach((tab) => {
      const isMatch = tab.dataset.managerValue === index
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false')
      tab.setAttribute('tabindex', isMatch ? '0' : '-1')
    })
    panel.setAttribute('data-active-manager', index)
    const row = panel.querySelector<HTMLElement>('[data-install-scroll]')
    if (row) revealSelected(row)
    if (persist && panel.dataset.managerScope) {
      // As selectPort does for the language: <head> puts the saved manager on
      // the document before first paint, and the rules keyed on it outrank
      // this panel's, so a click has to move the document attribute too.
      document.documentElement.setAttribute(`data-pkg-manager-${panel.dataset.managerScope}`, index)
      write(`${MANAGER_KEY}.${panel.dataset.managerScope}`, index)
    }
  }

  function selectPort(widget: HTMLElement, slug: string, persist: boolean) {
    const tabs = widget.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__tab')
    // Decided before anything is written. This used to clear `aria-selected`
    // on every tab and *then* return when none matched, so a picker
    // restricted to one language — the port pages render one — was left with
    // no tab selected at all whenever the shared saved value named a
    // different language. The panel was right and the tab above it was blank.
    const matched = [...tabs].some((tab) => tab.dataset.tabValue === slug)
    // A restricted-subset instance that doesn't carry this port keeps its
    // own current selection rather than going blank — see this file's top
    // comment on why the storage key is shared but instances aren't forced
    // to honor a value outside their own `ports` prop.
    if (!matched) return
    tabs.forEach((tab) => {
      const isMatch = tab.dataset.tabValue === slug
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false')
      tab.setAttribute('tabindex', isMatch ? '0' : '-1')
    })
    widget.setAttribute('data-active-port', slug)
    // The document-level attribute is what <head> sets before first paint and
    // what the no-flicker rules key on, and those rules outrank the
    // per-widget ones. Leaving it behind would mean a click that changes the
    // panel back on the next paint.
    if (persist) {
      document.documentElement.setAttribute('data-pkg-port', slug)
      write(STORAGE_KEY, slug)
    }
  }

  /**
   * Keyboard navigation along a tab strip.
   *
   * `role="tablist"` is a promise that Left and Right move between the tabs;
   * without it a keyboard reader Tabs through every tab in the strip to reach
   * the content, which is what the roles exist to avoid. Home and End select
   * the first and last tabs. Shared by both strips
   * because the mechanism is the same either way — only the selector and what
   * a selection means differ.
   */
  function arrowNav(
    event: KeyboardEvent,
    tabs: HTMLButtonElement[],
    current: HTMLButtonElement,
    select: (tab: HTMLButtonElement) => void,
  ) {
    const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0
    if ((!delta && event.key !== 'Home' && event.key !== 'End') || tabs.length < 2) return
    event.preventDefault()
    const index = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1
      : (tabs.indexOf(current) + delta + tabs.length) % tabs.length
    const next = tabs[index]!
    select(next)
    next.focus()
  }

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement
    const manager = target.closest<HTMLButtonElement>('.lm-pkg-install__manager')
    const panel = manager?.closest<HTMLElement>('.lm-pkg-install__panel')
    if (manager && panel) {
      const tabs = [...panel.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__manager')]
      arrowNav(e, tabs, manager, (tab) => {
        selectManager(panel, tab.dataset.managerValue ?? '0', true)
        window.dispatchEvent(
          new CustomEvent(MANAGER_SYNC_EVENT, {
            detail: { origin: panel, scope: panel.dataset.managerScope, index: tab.dataset.managerValue },
          }),
        )
      })
      return
    }
    const tab = target.closest<HTMLButtonElement>('.lm-pkg-install__tab')
    const widget = tab?.closest<HTMLElement>('.lm-pkg-install')
    if (!tab || !widget) return
    const tabs = [...widget.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__tab')]
    arrowNav(e, tabs, tab, (next) => {
      const slug = next.dataset.tabValue
      if (!slug) return
      selectPort(widget, slug, true)
      window.dispatchEvent(new CustomEvent(SYNC_EVENT, { detail: { origin: widget, slug } }))
    })
  })

  /** The control the reader just used keeps the focus, or the one that takes its place when it leaves. */
  function focusVisible(scope: ParentNode, selector: string) {
    const next = [...scope.querySelectorAll<HTMLElement>(selector)].find((el) => el.getClientRects().length > 0)
    next?.focus({ preventScroll: true })
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement
    const manager = target.closest<HTMLButtonElement>('.lm-pkg-install__manager')
    const panel = manager?.closest<HTMLElement>('.lm-pkg-install__panel')
    if (manager && panel && manager.dataset.managerValue !== undefined) {
      selectManager(panel, manager.dataset.managerValue, true)
      window.dispatchEvent(
        new CustomEvent(MANAGER_SYNC_EVENT, {
          detail: { origin: panel, scope: panel.dataset.managerScope, index: manager.dataset.managerValue },
        }),
      )
      return
    }
    const channel = target.closest<HTMLElement>('[data-pkg-channel]')
    if (channel?.dataset.pkgChannel) {
      const owner = channel.closest<HTMLElement>('.lm-pkg-install__panel')
      if (owner) setChannel(owner, channel.dataset.pkgChannel)
      return
    }
    const toggle = target.closest<HTMLButtonElement>('[data-pkg-cooldown="toggle"]')
    if (toggle) {
      if (!toggle.disabled) setCooldown({ enabled: !cooldownState().enabled })
      return
    }
    const action = target.closest<HTMLElement>('[data-cooldown-family="pkg"] [data-cooldown-action]')
    const owner = action?.closest<HTMLElement>('.lm-pkg-install__panel')
    if (action && owner) {
      const kind = action.dataset.cooldownAction
      if (kind === 'bypass') {
        setCooldown({ type: 'bypass', enabled: true })
        focusVisible(owner, '[data-cooldown-action="days-mode"]')
      } else if (kind === 'days-mode') {
        setCooldown({ type: 'days', enabled: true })
        focusVisible(owner, '[data-cooldown-action="bypass"]')
      } else if (kind === 'remove') {
        setCooldown({ enabled: false })
        owner.querySelector<HTMLElement>('[data-pkg-cooldown="toggle"]')?.focus({ preventScroll: true })
      } else if (kind === 'alt' && action.dataset.cooldownAlt !== undefined) {
        selectManager(owner, action.dataset.cooldownAlt, true)
        window.dispatchEvent(
          new CustomEvent(MANAGER_SYNC_EVENT, {
            detail: { origin: owner, scope: owner.dataset.managerScope, index: action.dataset.cooldownAlt },
          }),
        )
        owner.querySelector<HTMLElement>('.lm-pkg-install__manager[aria-selected="true"]')?.focus({ preventScroll: true })
      }
      return
    }
    const tab = target.closest<HTMLButtonElement>('.lm-pkg-install__tab')
    const widget = tab?.closest<HTMLElement>('.lm-pkg-install')
    if (!tab || !widget || !tab.dataset.tabValue) return
    selectPort(widget, tab.dataset.tabValue, true)
    window.dispatchEvent(new CustomEvent(SYNC_EVENT, { detail: { origin: widget, slug: tab.dataset.tabValue } }))
  })

  window.addEventListener(HOME_PORT_PREVIEW_EVENT, ((event: CustomEvent<{ slug: string }>) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => {
      selectPort(widget, event.detail.slug, false)
    })
  }) as EventListener)

  window.addEventListener(SYNC_EVENT, ((e: CustomEvent<{ origin: HTMLElement; slug: string }>) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => {
      if (widget === e.detail.origin) return
      selectPort(widget, e.detail.slug, false)
    })
  }) as EventListener)

  // Two widgets on one page — the home page has one and a guide below it may
  // have another — agree on the manager for a given port, the same way they
  // already agree on the port.
  window.addEventListener(MANAGER_SYNC_EVENT, ((
    e: CustomEvent<{ origin: HTMLElement; scope?: string; index: string }>,
  ) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install__panel').forEach((panel) => {
      if (panel === e.detail.origin || panel.dataset.managerScope !== e.detail.scope) return
      selectManager(panel, e.detail.index, false)
    })
  }) as EventListener)

  // Dependency cooldowns. One setting for the whole site, kept under the MCP
  // picker's keys and mirrored onto the same <html> attributes, so turning a
  // cooldown on here turns it on in the MCP picker too and the reverse. Both
  // scripts announce a change on the MCP picker's event and repaint from the
  // saved state when they hear one.
  const COOLDOWN = {
    enabled: 'libtmux-docs.mcp-install.cooldown.enabled',
    type: 'libtmux-docs.mcp-install.cooldown.type',
    days: 'libtmux-docs.mcp-install.cooldown.days',
  }
  const COOLDOWN_EVENT = 'lm-mcp-install:change'
  const DEFAULT_DAYS = 7

  function clampDays(value: number): number {
    return Number.isFinite(value) ? Math.min(365, Math.max(1, Math.round(value))) : DEFAULT_DAYS
  }

  function cooldownState() {
    return {
      enabled: read(COOLDOWN.enabled) === '1',
      type: read(COOLDOWN.type) === 'bypass' ? 'bypass' : 'days',
      days: clampDays(parseInt(read(COOLDOWN.days) ?? '', 10)),
    }
  }

  // Every slot says how to spell the day count; see COOLDOWN_FORMATS in
  // lib/cooldown.ts. The MCP picker's ISO duration slots are its own.
  function writeCooldownSlots(days: number) {
    document.querySelectorAll<HTMLElement>('[data-cooldown-scale]').forEach((slot) => {
      const scale = parseInt(slot.dataset.cooldownScale ?? '1', 10) || 1
      slot.textContent = (slot.dataset.cooldownTemplate ?? '{}').replace('{}', String(days * scale))
    })
    document.querySelectorAll<HTMLElement>('[data-cooldown-duration-slot]').forEach((slot) => {
      slot.textContent = `P${days}D`
    })
  }

  function paintCooldown() {
    const { enabled, type, days } = cooldownState()
    const root = document.documentElement
    root.setAttribute('data-mcp-install-cooldown-enabled', enabled ? '1' : '0')
    root.setAttribute('data-mcp-install-cooldown-type', type)
    root.setAttribute('data-mcp-install-cooldown-days', String(days))
    document.querySelectorAll<HTMLElement>('[data-pkg-cooldown="toggle"]').forEach((toggle) => {
      toggle.setAttribute('aria-pressed', String(enabled && !(toggle as HTMLButtonElement).disabled))
    })
    document.querySelectorAll<HTMLInputElement>('[data-cooldown-family="pkg"] [data-cooldown-action="days"]').forEach((input) => {
      if (document.activeElement !== input) input.value = String(days)
    })
    writeCooldownSlots(days)
  }

  function setCooldown(change: Partial<{ enabled: boolean; type: string; days: number }>) {
    if (change.enabled !== undefined) write(COOLDOWN.enabled, change.enabled ? '1' : '0')
    if (change.type !== undefined) write(COOLDOWN.type, change.type)
    if (change.days !== undefined) write(COOLDOWN.days, String(clampDays(change.days)))
    paintCooldown()
    for (const kind of ['enabled', 'type', 'days'] as const) {
      if (change[kind] === undefined) continue
      window.dispatchEvent(
        new CustomEvent(COOLDOWN_EVENT, { detail: { origin: null, kind: `cooldown-${kind}`, value: change[kind] } }),
      )
    }
  }

  // Typing a day count rewrites every command at once; it is saved on change.
  document.addEventListener('input', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLInputElement>('[data-cooldown-family="pkg"] [data-cooldown-action="days"]')
    if (!el) return
    const days = parseInt(el.value, 10)
    if (Number.isFinite(days)) writeCooldownSlots(clampDays(days))
  })

  // Choosing a length implies wanting a cooldown.
  document.addEventListener('change', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLInputElement>('[data-cooldown-family="pkg"] [data-cooldown-action="days"]')
    if (el) setCooldown({ days: parseInt(el.value, 10), type: 'days', enabled: true })
  })

  window.addEventListener(COOLDOWN_EVENT, ((e: CustomEvent<{ kind?: string }>) => {
    if (e.detail?.kind?.startsWith('cooldown-')) paintCooldown()
  }) as EventListener)

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applySavedState)
  } else {
    applySavedState()
  }
  document.addEventListener('astro:after-swap', applySavedState)
</script>
