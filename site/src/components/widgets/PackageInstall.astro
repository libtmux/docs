---
import { Code } from 'astro-expressive-code/components'
import { highlightInline } from '../../lib/highlight'
import { PORTS } from '../../lib/ports'
import type { Quickstart } from '../../lib/quickstarts'

/**
 * Package-manager picker for the eight libtmux ports' own install commands
 * (`port.installs` from ports.ts — see that file for why each entry is what
 * it is). Same visual language and copy-to-clipboard behaviour as
 * ./McpInstall.astro — everything lives in this component, with no separate
 * data module or asset files.
 *
 * Two axes, not one: which port, and then which of that port's tools. A
 * Python reader is on pip or uv, a TypeScript reader on one of five, and
 * Java, C++ and Swift cannot be installed from a command line at all — one
 * line per language chose for all of them and was wrong for most. The second
 * strip only renders where there is a choice to make, so Rust and Go still
 * show their one command with nothing above it.
 *
 * No literal source to port: McpInstall.astro's sibling in
 * ~/work/python/libtmux-mcp/docs only ever installed one package, so there
 * was nothing there shaped like an eight-way tab picker. sphinx-copybutton
 * isn't available here either (see McpInstall.astro's note on the same
 * gap), so the copy button is this component's own, duplicated rather than
 * imported from mcp-install.js because that file is McpInstall's alone —
 * this widget must stand on its own with no cross-file dependency.
 *
 * `ports` restricts the tab set (e.g. a guide about one language); omit it
 * for the full eight. The active port persists across every PackageInstall
 * instance on the site via one shared localStorage key — a restricted
 * instance simply ignores a saved value outside its own subset and falls
 * back to its own default, rather than rendering blank.
 */
interface Props {
  /** Port slugs to show; omit for all eight. */
  ports?: readonly string[]
  /**
   * A code example to show under each port's install line, keyed by slug.
   *
   * The home page's picker used to switch the install command while the
   * example below it stayed Python, so seven of the eight tabs showed a
   * Java or Swift install above Python code. Putting the example in the
   * panel makes one picker drive both, which is what a reader already
   * expects it to do.
   *
   * Omit it and the widget is exactly what it was: install lines only. A
   * port with no entry shows its install line alone rather than an empty
   * block.
   */
  snippets?: Partial<Record<string, Quickstart>>
  /** Active tab when nothing is saved yet; defaults to the first shown port. */
  defaultPort?: string
  variant?: 'full' | 'compact'
}
const { ports, defaultPort, snippets, variant = 'full' } = Astro.props as Props

const items = ports && ports.length > 0 ? PORTS.filter((p) => ports.includes(p.slug)) : PORTS
if (items.length === 0) {
  throw new Error('PackageInstall: `ports` matched none of the eight port slugs in ports.ts')
}
const initialSlug = defaultPort && items.some((p) => p.slug === defaultPort) ? defaultPort : items[0]!.slug

// Which panel to show once `data-active-port` is set is data-driven (one
// rule per port actually rendered in *this* instance), not hand-typed —
// ports.ts stays the only place a port's slug is spelled out. See the
// is:global block below for the static rules this pairs with.
const activePortRules = items
  .map((p) => `.lm-pkg-install[data-active-port="${p.slug}"] .lm-pkg-install__panel[data-port="${p.slug}"]{visibility:visible}`)
  .join('')

/*
 * One rule per manager position, generated the same way and for the same
 * reason: the widths of these lists differ per port (one command for Rust,
 * five for TypeScript), so the rules are generated to the longest list
 * rendered here rather than to a number typed in a stylesheet.
 */
const managerRules = Array.from(
  { length: Math.max(...items.map((p) => p.installs.length)) },
  (_, i) =>
    `.lm-pkg-install__panel[data-active-manager="${i}"] .lm-pkg-install__cmd[data-manager="${i}"]{display:block}`,
).join('')

/*
 * Highlighted once, here rather than in the template: `await` is not allowed
 * inside a map callback in Astro's markup.
 *
 * A console command is shown with its prompt and copied without it — the copy
 * handler below strips `$ ` when `data-language` says console. Everything else
 * is a file fragment and is shown exactly as it goes into the file.
 */
const installHtml = new Map(
  await Promise.all(
    items.flatMap((p) =>
      p.installs.map(async (cmd, i) => [
        `${p.slug}/${i}`,
        await highlightInline(cmd.lang === 'console' ? `$ ${cmd.code}` : cmd.code, cmd.lang),
      ] as const),
    ),
  ),
)
---

<div class={`lm-pkg-install lm-pkg-install--${variant}${snippets ? ' lm-pkg-install--examples' : ''}`} data-ports={items.map((p) => p.slug).join(' ')}>
  {/*
    One language is not a choice of language.

    A port page renders this restricted to its own port, where the strip was a
    single tab that could not be switched away from — a control that answers
    nothing, above the control that answers something.
  */}
  {items.length > 1 && <div class="lm-pkg-install__tabs" role="tablist" aria-label="Package manager">
    {
      items.map((p) => (
        <button
          type="button"
          class="lm-pkg-install__tab"
          role="tab"
          data-tab-value={p.slug}
          aria-selected={p.slug === initialSlug ? 'true' : 'false'}
          tabindex={p.slug === initialSlug ? '0' : '-1'}
        >
          {p.name}
        </button>
      ))
    }
  </div>}
  <div class="lm-pkg-install__body">
    {
      items.map((p) => (
        <div
          class="lm-pkg-install__panel"
          role="tabpanel"
          data-port={p.slug}
          data-default={p.slug === initialSlug ? true : undefined}
          tabindex="0"
        >
          {p.installs.length > 1 && (
            <div class="lm-pkg-install__managers" role="tablist" aria-label={`${p.name} package manager`}>
              {p.installs.map((cmd, i) => (
                <button
                  type="button"
                  class="lm-pkg-install__manager"
                  role="tab"
                  data-manager-value={i}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? '0' : '-1'}
                >
                  {cmd.label}
                </button>
              ))}
            </div>
          )}
          {p.installs.map((cmd, i) => (
            <div
              class="lm-pkg-install__cmd"
              data-manager={i}
              data-default={i === 0 ? true : undefined}
              role={p.installs.length > 1 ? 'tabpanel' : undefined}
              tabindex={p.installs.length > 1 ? '0' : undefined}
            >
              <div class="lm-pkg-install__code" data-language={cmd.lang}><pre><code set:html={installHtml.get(`${p.slug}/${i}`)} /></pre><button type="button" class="lm-pkg-install__copy" data-action="copy" aria-label="Copy to clipboard">Copy</button></div>
              {cmd.note && <p class="lm-pkg-install__note">{cmd.note}</p>}
            </div>
          ))}
          {snippets?.[p.slug] && (
            <div class="lm-pkg-install__snippet">
              <Code code={snippets[p.slug]!.code} lang={snippets[p.slug]!.lang} />
            </div>
          )}
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  /* Unlayered on purpose — see mcp-install.css's file-level comment for why
   * that matters against Tailwind v4's `[hidden]` preflight rule. This
   * widget never uses the `hidden` attribute either, so the point is moot
   * here, but the two widgets stay consistent about it. */
  .lm-pkg-install {
    --lm-pkg-install-bg: var(--background-color);
    --lm-pkg-install-bg-tabs: #f1f5f9; /* slate-100 */
    --lm-pkg-install-border: #e2e8f0; /* slate-200 */
    --lm-pkg-install-fg: var(--text-color);
    --lm-pkg-install-fg-secondary: #475569; /* slate-600 */
    --lm-pkg-install-fg-muted: #64748b; /* slate-500 */
    --lm-pkg-install-accent: var(--theme-primary);
    --lm-pkg-install-hover: rgb(0 0 0 / 4%);
    --lm-pkg-install-code-bg: #f1f5f9;
    --lm-pkg-install-mono: var(--font-ibm-plex-mono, ui-monospace, SFMono-Regular, Menlo, monospace);

    border: 1px solid var(--lm-pkg-install-border);
    border-radius: 0.375rem;
    background: var(--lm-pkg-install-bg);
    color: var(--lm-pkg-install-fg);
    overflow: hidden;
    margin: 1rem 0;
    font-size: 0.95em;
  }

  html[data-theme-mode='dark'] .lm-pkg-install {
    --lm-pkg-install-bg-tabs: #1e293b; /* slate-800 */
    --lm-pkg-install-border: #1e293b;
    --lm-pkg-install-fg-secondary: #94a3b8; /* slate-400 */
    --lm-pkg-install-fg-muted: #94a3b8;
    --lm-pkg-install-hover: rgb(255 255 255 / 6%);
    --lm-pkg-install-code-bg: #1e293b;
  }

  .lm-pkg-install__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    background: var(--lm-pkg-install-bg-tabs);
    border-bottom: 1px solid var(--lm-pkg-install-border);
  }

  .lm-pkg-install__tab {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--lm-pkg-install-fg-muted);
    cursor: pointer;
    font: inherit;
    padding: 0.45rem 0.9rem;
    margin: 0;
    white-space: nowrap;
  }

  .lm-pkg-install__tab:hover {
    color: var(--lm-pkg-install-fg);
    background: var(--lm-pkg-install-hover);
  }

  .lm-pkg-install__tab:focus-visible {
    outline: 2px solid var(--lm-pkg-install-accent);
    outline-offset: -2px;
  }

  /* Server-rendered active tab (no JS) and JS-selected tab both key off
   * `aria-selected` — the deferred script below is the only thing that
   * ever changes it, so there is no separate prehydrate override needed
   * here (unlike McpInstall, whose tabs must repaint before mcp-install.js
   * has even downloaded). This widget's *panel* visibility needs one,
   * hence the document-level rules generated below — and the tab colour now
   * needs one too, which is what `preloadedPortRules` adds. */
  .lm-pkg-install__tab[aria-selected='true'] {
    color: var(--lm-pkg-install-accent);
    border-bottom-color: var(--lm-pkg-install-accent);
    background: var(--lm-pkg-install-bg);
  }

  /* Every panel shares one grid cell, so the body is as tall as the tallest
   * panel and a language change never changes the page height. On the home
   * page the prompt below follows this picker's language, and a Quickstart
   * that resized would move the page under a reader clicking the prompt.
   * `minmax(0, 1fr)` keeps a long install line scrolling inside its `pre`
   * instead of widening the grid. */
  .lm-pkg-install__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0.9rem 1rem;
  }

  /* SSR/no-JS default: exactly one panel visible, no script required. The
   * `html[data-pkg-port]` rules (set in <head> before any of this markup is
   * parsed, when a saved choice exists and this instance carries that port)
   * override it by specificity, so they need no `!important` or source-order
   * care. Panels hide with `visibility`, not `display`, so a hidden panel
   * still holds its height in the grid. */
  .lm-pkg-install__panel {
    display: flex;
    flex-direction: column;
    grid-area: 1 / 1;
    visibility: hidden;
  }

  .lm-pkg-install__panel[data-default] {
    visibility: visible;
  }

  /* Once JS has picked an active port (a click, or a restored session),
   * every panel defaults to hidden; the per-port rule injected below (see
   * `activePortRules`) is more specific ([data-active-port="X"] vs the bare
   * [data-active-port] here) and wins regardless of source order — same
   * reasoning as mcp-install.css's default-override rule. */
  .lm-pkg-install[data-active-port] .lm-pkg-install__panel {
    visibility: hidden;
  }

  .lm-pkg-install__panel:focus-visible {
    outline: 2px solid var(--lm-pkg-install-accent);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  /* The second strip: which of this port's tools. Underlined rather than
   * tabbed, so it reads as subordinate to the language strip above the body
   * instead of competing with it. */
  .lm-pkg-install__managers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.6rem;
  }

  .lm-pkg-install__manager {
    appearance: none;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.25rem;
    color: var(--lm-pkg-install-fg-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.8em;
    line-height: 1.3;
    padding: 0.2rem 0.5rem;
  }

  .lm-pkg-install__manager:hover {
    color: var(--lm-pkg-install-fg);
    background: var(--lm-pkg-install-hover);
  }

  .lm-pkg-install__manager[aria-selected='true'] {
    color: var(--lm-pkg-install-accent);
    border-color: var(--lm-pkg-install-accent);
  }

  .lm-pkg-install__manager:focus-visible {
    outline: 2px solid var(--lm-pkg-install-accent);
    outline-offset: 1px;
  }

  /* SSR/no-JS default: the first command of each port, no script required.
   * Once a manager is chosen the `[data-active-manager="N"]` rules generated
   * above win by specificity, exactly as the port panels do. */
  .lm-pkg-install__cmd {
    display: none;
  }

  .lm-pkg-install__cmd[data-default] {
    display: block;
  }

  .lm-pkg-install__panel[data-active-manager] .lm-pkg-install__cmd {
    display: none;
  }

  .lm-pkg-install__note {
    margin: 0.5rem 0 0;
    font-size: 0.8em;
    line-height: 1.5;
    color: var(--lm-pkg-install-fg-secondary);
  }

  .lm-pkg-install__code {
    position: relative;
  }

  /* The example under the install line. Expressive Code brings its own
   * frame, so this only supplies the gap between the two. */
  .lm-pkg-install__snippet {
    margin-top: 0.75rem;
  }

  .lm-pkg-install__snippet :global(.expressive-code) {
    margin: 0;
  }

  /* The example fills whatever height its panel has left. Its `pre` starts
   * from 11rem, so the longest example reserves no more than that, and grows
   * into the space a shorter panel leaves. Expressive Code positions its copy
   * button on `.frame`, so the button stays put while the code scrolls. */
  .lm-pkg-install__snippet,
  .lm-pkg-install__snippet .expressive-code,
  .lm-pkg-install__snippet .expressive-code .frame {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
  }

  .lm-pkg-install__snippet .expressive-code .frame pre {
    flex: 1 1 11rem;
    min-height: 0;
    overflow: auto;
  }

  /* Beside an example, a long install block such as Gradle's or CMake's would
   * set the height every panel reserves, so it scrolls past 7rem. Copy still
   * takes the whole block. */
  .lm-pkg-install--examples .lm-pkg-install__code pre {
    max-height: 7rem;
    overflow: auto;
  }

  .lm-pkg-install__code pre {
    margin: 0;
    overflow-x: auto;
    border-radius: 0.25rem;
    background: var(--lm-pkg-install-code-bg);
    color: var(--lm-pkg-install-fg);
    padding: 0.75rem 3.25rem 0.75rem 0.9rem;
  }

  .lm-pkg-install__code code {
    font-family: var(--lm-pkg-install-mono);
    font-size: 0.85em;
    white-space: pre;
  }

  /* Shiki writes both schemes as custom properties; something has to read
   * them. Without this a highlighted install command rendered in the
   * inherited foreground colour — every token one flat grey — which is what
   * the reference example panels had too. */
  .lm-pkg-install__code .shiki span,
  .lm-pkg-install__code span {
    color: var(--shiki-light);
  }

  html[data-theme-mode='dark'] .lm-pkg-install__code .shiki span,
  html[data-theme-mode='dark'] .lm-pkg-install__code span {
    color: var(--shiki-dark);
  }

  .lm-pkg-install__copy {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    appearance: none;
    border: 1px solid var(--lm-pkg-install-border);
    border-radius: 0.25rem;
    background: var(--lm-pkg-install-bg);
    color: var(--lm-pkg-install-fg-secondary);
    cursor: pointer;
    font: inherit;
    font-size: 0.75em;
    line-height: 1;
    padding: 0.3rem 0.5rem;
  }

  .lm-pkg-install__copy:hover {
    color: var(--lm-pkg-install-fg);
    border-color: var(--lm-pkg-install-fg-muted);
  }

  .lm-pkg-install__copy:focus-visible {
    outline: 2px solid var(--lm-pkg-install-accent);
    outline-offset: 2px;
  }

  .lm-pkg-install__copy--done {
    color: var(--lm-pkg-install-accent);
    border-color: var(--lm-pkg-install-accent);
  }

  /* Compact variant: tighter padding, smaller type — mirrors
   * .lm-mcp-install--compact. */
  .lm-pkg-install--compact .lm-pkg-install__tab {
    padding: 0.3rem 0.7rem;
    font-size: 0.9em;
  }

  .lm-pkg-install--compact .lm-pkg-install__body {
    padding: 0.7rem 0.8rem;
  }
</style>

{/* Generated from `items`, not hand-typed — see `activePortRules` above. */}
<style is:global set:html={activePortRules + managerRules} />

<script>
  // Deferred interactivity: tab switching, cross-instance sync, and
  // copy-to-clipboard. Event delegation on document so this survives an
  // Astro ClientRouter swap the same way McpInstall's mcp-install.js does
  // (see that file's header) — this site doesn't run ClientRouter yet, but
  // every other interactive component here already defends against it.
  const STORAGE_KEY = 'libtmux-docs.package-install.port'
  // Per port, because a choice of pnpm says nothing about a choice of uv.
  const MANAGER_KEY = 'libtmux-docs.package-install.manager'
  const SYNC_EVENT = 'lm-pkg-install:change'
  const MANAGER_SYNC_EVENT = 'lm-pkg-install:manager'

  function read(key: string): string | null {
    try {
      return localStorage.getItem(key)
    } catch {
      // Private windows and blocked site data throw here. The widget still
      // works for this page; only the memory is lost.
      return null
    }
  }

  function write(key: string, value: string) {
    try {
      localStorage.setItem(key, value)
    } catch {
      // As above.
    }
  }

  function applySavedState() {
    const saved = read(STORAGE_KEY)
    if (saved) {
      document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => selectPort(widget, saved, false))
    }
    document.querySelectorAll<HTMLElement>('.lm-pkg-install__panel').forEach((panel) => {
      const port = panel.dataset.port
      const savedManager = port && read(`${MANAGER_KEY}.${port}`)
      if (savedManager) selectManager(panel, savedManager, false)
    })
  }

  function selectManager(panel: HTMLElement, index: string, persist: boolean) {
    const tabs = panel.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__manager')
    // Decided before anything is written, for the same reason selectPort
    // does: a saved index outside this port's list would otherwise clear
    // every tab and show no command at all.
    if (![...tabs].some((tab) => tab.dataset.managerValue === index)) return
    tabs.forEach((tab) => {
      const isMatch = tab.dataset.managerValue === index
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false')
      tab.setAttribute('tabindex', isMatch ? '0' : '-1')
    })
    panel.setAttribute('data-active-manager', index)
    if (persist && panel.dataset.port) write(`${MANAGER_KEY}.${panel.dataset.port}`, index)
  }

  function selectPort(widget: HTMLElement, slug: string, persist: boolean) {
    const tabs = widget.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__tab')
    // Decided before anything is written. This used to clear `aria-selected`
    // on every tab and *then* return when none matched, so a picker
    // restricted to one language — the port pages render one — was left with
    // no tab selected at all whenever the shared saved value named a
    // different language. The panel was right and the tab above it was blank.
    const matched = [...tabs].some((tab) => tab.dataset.tabValue === slug)
    // A restricted-subset instance that doesn't carry this port keeps its
    // own current selection rather than going blank — see this file's top
    // comment on why the storage key is shared but instances aren't forced
    // to honor a value outside their own `ports` prop.
    if (!matched) return
    tabs.forEach((tab) => {
      const isMatch = tab.dataset.tabValue === slug
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false')
      tab.setAttribute('tabindex', isMatch ? '0' : '-1')
    })
    widget.setAttribute('data-active-port', slug)
    // The document-level attribute is what <head> sets before first paint and
    // what the no-flicker rules key on, and those rules outrank the
    // per-widget ones. Leaving it behind would mean a click that changes the
    // panel back on the next paint.
    if (persist) {
      document.documentElement.setAttribute('data-pkg-port', slug)
      write(STORAGE_KEY, slug)
    }
  }

  function copyPanelCode(button: HTMLElement) {
    const wrap = button.closest('.lm-pkg-install__code')
    const codeEl = wrap?.querySelector('code')
    if (!codeEl) return
    let text = codeEl.textContent ?? ''
    if (wrap?.getAttribute('data-language') === 'console') {
      text = text.replace(/^\$ /gm, '')
    }
    writeClipboardText(text, button)
  }

  function writeClipboardText(text: string, button: HTMLElement) {
    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(
        () => announceCopied(button),
        () => fallbackCopy(text, button),
      )
    } else {
      fallbackCopy(text, button)
    }
  }

  function fallbackCopy(text: string, button: HTMLElement) {
    const textarea = document.createElement('textarea')
    textarea.value = text
    textarea.style.position = 'fixed'
    textarea.style.opacity = '0'
    document.body.appendChild(textarea)
    textarea.focus()
    textarea.select()
    try {
      document.execCommand('copy')
    } catch {
      // Nothing more to do — the button simply won't confirm.
    }
    document.body.removeChild(textarea)
    announceCopied(button)
  }

  function announceCopied(button: HTMLElement) {
    const original = button.getAttribute('data-copy-label') ?? button.textContent ?? 'Copy'
    button.setAttribute('data-copy-label', original)
    button.textContent = 'Copied'
    button.classList.add('lm-pkg-install__copy--done')
    const win = button as HTMLElement & { _lmCopyResetTimer?: number }
    window.clearTimeout(win._lmCopyResetTimer)
    win._lmCopyResetTimer = window.setTimeout(() => {
      button.textContent = original
      button.classList.remove('lm-pkg-install__copy--done')
    }, 1500)
  }

  /**
   * Arrow keys along a tab strip.
   *
   * `role="tablist"` is a promise that Left and Right move between the tabs;
   * without it a keyboard reader Tabs through every tab in the strip to reach
   * the content, which is what the roles exist to avoid. Shared by both strips
   * because the mechanism is the same either way — only the selector and what
   * a selection means differ.
   */
  function arrowNav(
    event: KeyboardEvent,
    tabs: HTMLButtonElement[],
    current: HTMLButtonElement,
    select: (tab: HTMLButtonElement) => void,
  ) {
    const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0
    if (!delta || tabs.length < 2) return
    event.preventDefault()
    const next = tabs[(tabs.indexOf(current) + delta + tabs.length) % tabs.length]!
    select(next)
    next.focus()
  }

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement
    const manager = target.closest<HTMLButtonElement>('.lm-pkg-install__manager')
    const panel = manager?.closest<HTMLElement>('.lm-pkg-install__panel')
    if (manager && panel) {
      const tabs = [...panel.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__manager')]
      arrowNav(e, tabs, manager, (tab) => {
        selectManager(panel, tab.dataset.managerValue ?? '0', true)
        window.dispatchEvent(
          new CustomEvent(MANAGER_SYNC_EVENT, {
            detail: { origin: panel, port: panel.dataset.port, index: tab.dataset.managerValue },
          }),
        )
      })
      return
    }
    const tab = target.closest<HTMLButtonElement>('.lm-pkg-install__tab')
    const widget = tab?.closest<HTMLElement>('.lm-pkg-install')
    if (!tab || !widget) return
    const tabs = [...widget.querySelectorAll<HTMLButtonElement>('.lm-pkg-install__tab')]
    arrowNav(e, tabs, tab, (next) => {
      const slug = next.dataset.tabValue
      if (!slug) return
      selectPort(widget, slug, true)
      window.dispatchEvent(new CustomEvent(SYNC_EVENT, { detail: { origin: widget, slug } }))
    })
  })

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement
    const copyButton = target.closest<HTMLElement>('[data-action="copy"]')
    if (copyButton?.closest('.lm-pkg-install')) {
      e.preventDefault()
      copyPanelCode(copyButton)
      return
    }
    const manager = target.closest<HTMLButtonElement>('.lm-pkg-install__manager')
    const panel = manager?.closest<HTMLElement>('.lm-pkg-install__panel')
    if (manager && panel && manager.dataset.managerValue !== undefined) {
      selectManager(panel, manager.dataset.managerValue, true)
      window.dispatchEvent(
        new CustomEvent(MANAGER_SYNC_EVENT, {
          detail: { origin: panel, port: panel.dataset.port, index: manager.dataset.managerValue },
        }),
      )
      return
    }
    const tab = target.closest<HTMLButtonElement>('.lm-pkg-install__tab')
    const widget = tab?.closest<HTMLElement>('.lm-pkg-install')
    if (!tab || !widget || !tab.dataset.tabValue) return
    selectPort(widget, tab.dataset.tabValue, true)
    window.dispatchEvent(new CustomEvent(SYNC_EVENT, { detail: { origin: widget, slug: tab.dataset.tabValue } }))
  })

  window.addEventListener(SYNC_EVENT, ((e: CustomEvent<{ origin: HTMLElement; slug: string }>) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install').forEach((widget) => {
      if (widget === e.detail.origin) return
      selectPort(widget, e.detail.slug, false)
    })
  }) as EventListener)

  // Two widgets on one page — the home page has one and a guide below it may
  // have another — agree on the manager for a given port, the same way they
  // already agree on the port.
  window.addEventListener(MANAGER_SYNC_EVENT, ((
    e: CustomEvent<{ origin: HTMLElement; port?: string; index: string }>,
  ) => {
    document.querySelectorAll<HTMLElement>('.lm-pkg-install__panel').forEach((panel) => {
      if (panel === e.detail.origin || panel.dataset.port !== e.detail.port) return
      selectManager(panel, e.detail.index, false)
    })
  }) as EventListener)

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applySavedState)
  } else {
    applySavedState()
  }
  document.addEventListener('astro:after-swap', applySavedState)
</script>
