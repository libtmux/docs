---
import InstallCode from './InstallCode.astro'
import InstallCooldown from './InstallCooldown.astro'
import InstallFacts from './InstallFacts.astro'
import InstallTabRow from './InstallTabRow.astro'
import InstallWhere from './InstallWhere.astro'
import './install-surface.css'
import './mcp-install.css'
import {
  buildMcpInstallPrehydrateSnippet,
  buildPanels,
  CLIENTS,
  DEFAULT_COOLDOWN_DAYS,
  DEFAULT_COOLDOWN_ENABLED,
  DEFAULT_COOLDOWN_TYPE,
  DEFAULT_SCOPES,
  defaultCooldownDate,
  markPlaceholders,
  serverSpec,
  wrapShell,
  COOLDOWN_DURATION_SENTINEL,
  COOLDOWN_DATE_SENTINEL,
} from '../../lib/install-matrix'
import { highlightWithCooldownSlots } from '../../lib/highlight'
import { addedLines, markAddedLines } from '../../lib/install-surface'
import { installSelection, REGISTRY } from '../../lib/registry'
import { PORT_BY_SLUG, productStatus } from '../../lib/ports'

/**
 * Client x install-method x config-scope x dependency-cooldown picker for
 * the libtmux MCP server, drawn as the installer's one code surface (design
 * records 0063 and 0064). Ported from
 * ~/work/python/libtmux-mcp/docs/_widgets/mcp-install/widget.html (Jinja)
 * — see install-matrix.ts for the data/body-building port and
 * mcp-install.{css,js} for the near-verbatim behavioural port. This file
 * only turns the Jinja template's loops into Astro's.
 *
 * Every (client, method, scope, cooldown) combination is server-rendered —
 * 8 clients / 14 scopes / 3 methods / 3 cooldowns = 126 panels — so the
 * widget is fully usable with JavaScript disabled: exactly one panel
 * (`data-default`) is visible via mcp-install.css's plain CSS rule, tabs
 * render but don't switch (no-JS parity with the source, not an
 * improvement on it — see mcp-install.js's own header for why no-JS tab
 * *switching* was never in scope). With JavaScript enabled, the prehydrate
 * snippet below picks the reader's last selection before first paint, and
 * mcp-install.js keeps it in sync afterward.
 *
 * What a panel shows is split across the surface: where the code goes and
 * Copy in its header, the First strip, the cooldown strip and the command in
 * its body, and the caveats under it. The three are the same panel three
 * times, and one set of prehydrate rules shows the matching one of each.
 */
interface Props {
  variant?: 'full' | 'compact'
  /**
   * Which port's server to install. Defaults to Python, the reference
   * implementation.
   *
   * The client and scope axes are the same whatever the answer — `claude mcp
   * add tmux -- <thing>` does not care what `<thing>` is — so a port changes
   * only the command inside, and the method strip above it. See
   * `lib/install-matrix.ts` for each port's spec.
   */
  port?: string
}
const { variant = 'full', port = 'py' } = Astro.props as Props

const spec = serverSpec(port)
const panels = buildPanels(spec, installSelection(PORT_BY_SLUG[port]!, [], process.env).revision)

/*
 * The config body, highlighted, with its live slots intact.
 *
 * The block is JSON (or a shell line) and rendered as plain text, so it sat
 * unhighlighted beside code the rest of the page highlights. It cannot take
 * Shiki's `<pre>` wrapper — the widget brings a copy button — and it cannot
 * simply be highlighted as a string either, because two spans inside it are
 * rewritten at runtime when the reader changes the cooldown.
 *
 * So: substitute the sentinels for the values they default to, highlight
 * that, then wrap those values back up in the slot elements
 * `mcp-install.js` looks for. Both are plain ASCII inside a JSON string,
 * which Shiki emits as one token, so neither is split across spans or
 * escaped.
 */
const panelKey = (panel: (typeof panels)[number]) =>
  `${panel.client.id}/${panel.method.id}/${panel.scope.id}/${panel.cooldown.id}`

const DURATION_VALUE = `P${DEFAULT_COOLDOWN_DAYS}D`
const DATE_VALUE = defaultCooldownDate(DEFAULT_COOLDOWN_DAYS)

const slot = (attr: string, value: string) =>
  `<span class="lm-mcp-install__cooldown-days" ${attr}>${value}</span>`

/** The panel with the cooldown off: what the lines a cooldown adds are measured against. */
const plainOf = new Map(
  panels.filter((panel) => panel.cooldown.id === 'off').map((panel) => [`${panel.client.id}/${panel.method.id}/${panel.scope.id}`, panel] as const),
)
const plainFor = (panel: (typeof panels)[number]) => plainOf.get(`${panel.client.id}/${panel.method.id}/${panel.scope.id}`)!

/** Where the code goes: the terminal for a command, else the scope's file, without its gloss. */
const targetOf = (panel: (typeof panels)[number]) =>
  panel.language === 'console' ? 'Terminal' : panel.scope.configFile.replace(/\s*\(.*\)$/, '')

const bodyHtml = new Map(
  await Promise.all(
    panels.map(async (panel) => {
      // The data carries no prompt; a console command is shown with one, and Copy takes it off.
      const text = (panel.language === 'console' ? `$ ${panel.body}` : panel.body)
        .replaceAll(COOLDOWN_DURATION_SENTINEL, DURATION_VALUE)
        .replaceAll(COOLDOWN_DATE_SENTINEL, DATE_VALUE)
      let html = await highlightWithCooldownSlots(text, panel.language, DEFAULT_COOLDOWN_DAYS)
      if (panel.body.includes(COOLDOWN_DURATION_SENTINEL)) {
        html = html.replace(DURATION_VALUE, slot('data-cooldown-duration-slot', DURATION_VALUE))
      }
      if (panel.body.includes(COOLDOWN_DATE_SENTINEL)) {
        html = html.replace(DATE_VALUE, slot('data-cooldown-date-slot', DATE_VALUE))
      }
      if (panel.cooldown.id !== 'off') html = markAddedLines(html, addedLines(plainFor(panel).body, panel.body))
      return [panelKey(panel), markPlaceholders(html)] as const
    }),
  ),
)

const prereqHtml = new Map(
  await Promise.all(
    panels
      .filter((panel) => panel.pipPrereq)
      .map(async (panel) => {
        const text = wrapShell(panel.pipPrereq!)
        let html = await highlightWithCooldownSlots(`$ ${text}`, 'console', DEFAULT_COOLDOWN_DAYS)
        // A cooldown that rewrites the install marks its lines in the strip that carries it.
        if (panel.cooldown.id !== 'off') html = markAddedLines(html, addedLines(wrapShell(plainFor(panel).pipPrereq ?? ''), text))
        return [panelKey(panel), markPlaceholders(html)] as const
      }),
  ),
)
const prehydrateSnippet = buildMcpInstallPrehydrateSnippet(spec)
const scopedClients = CLIENTS.filter((c) => c.scopes.length > 1)
// Python's and TypeScript's. The other ports' toolchains have no release-age
// gate, so a control that could only ever say "off" is not a control.
const hasCooldowns = spec.cooldowns.length > 1

/** The package the server is, as its registry knows it: the MCP package of the port, else what the spec names. */
const porter = PORT_BY_SLUG[port]!
const mcpPackage = porter.packages?.find((entry) => entry.id === 'mcp')
const found = mcpPackage && REGISTRY.ports[port]?.packages?.[mcpPackage.name]
const facts = {
  name: mcpPackage?.name ?? spec.package,
  version: found?.version ?? null,
  status: mcpPackage ? productStatus(porter, 'mcp', REGISTRY) : undefined,
  registry: mcpPackage?.registry ? { url: mcpPackage.registry } : undefined,
  unpublished: found ? found.status === 'unpublished' : !mcpPackage?.registry,
}

/** A method the cooldown cannot reach, in a mode: the same for every client and scope. */
const refuses = (method: string, mode: 'days' | 'bypass') =>
  panels.some((panel) => panel.method.id === method && panel.cooldown.id === mode && panel.cooldownReason)
/** The method that can take a cooldown, which one that cannot offers as the way forward. */
const alternative = (panel: (typeof panels)[number]) =>
  panels.find((other) => other.client.id === panel.client.id && other.scope.id === panel.scope.id
    && other.cooldown.id === 'days' && !other.cooldownReason)?.method
const exemptClause = (panel: (typeof panels)[number]) =>
  /exclude=libtmux(?:\s|\\|$)/.test(panel.pipPrereq ?? '') ? `${spec.package} and libtmux stay current` : `${spec.package} itself stays current`

/** The caveats under a panel: where it writes, what the scope asks, what the method needs, and the panel's own. */
const notesOf = (panel: (typeof panels)[number]) => [
  panel.language === 'console' ? `Writes ${panel.scope.configFile}.` : '',
  panel.scope.note ?? '',
  panel.method.docUrl && !panel.pipPrereq ? 'doc' : '',
  panel.note ?? '',
].filter(Boolean)

/** One panel's attributes, shared by the three places it is drawn. */
const panelAttrs = (panel: (typeof panels)[number]) => ({
  'data-client': panel.client.id,
  'data-method': panel.method.id,
  'data-scope': panel.scope.id,
  'data-cooldown': panel.cooldown.id,
  'data-default': panel.isDefault ? true : undefined,
})
---

<Fragment set:html={prehydrateSnippet} />
<div
  class={`lm-mcp-install lm-mcp-install--${variant}`}
  data-port={spec.port}
  data-copy-scope
  data-default-scopes={JSON.stringify(DEFAULT_SCOPES)}
  data-default-cooldown-enabled={DEFAULT_COOLDOWN_ENABLED ? '1' : '0'}
  data-default-cooldown-type={DEFAULT_COOLDOWN_TYPE}
  data-default-cooldown-days={DEFAULT_COOLDOWN_DAYS}
>
  <div class="lm-install">
    <div class="lm-install__head">
      <InstallTabRow noun="clients">
        <div class="lm-mcp-install__tabs lm-mcp-install__tabs--clients" role="tablist" aria-label="MCP client">
          {
            CLIENTS.map((client, i) => (
              <button
                type="button"
                class="lm-mcp-install__tab"
                role="tab"
                data-tab-kind="client"
                data-tab-value={client.id}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? '0' : '-1'}
              >
                {client.label}
              </button>
            ))
          }
        </div>
      </InstallTabRow>
      <div class="lm-install__headend">
        {panels.map((panel) => (
          <div class="lm-mcp-install__panel" {...panelAttrs(panel)}>
            <InstallWhere family="mcp" target={targetOf(panel)} lang={panel.language} copyKey={panelKey(panel)} />
          </div>
        ))}
      </div>
    </div>

    <div class="lm-install__bar">
      <InstallFacts {...facts} />
      <span class="lm-install__opts">
        {spec.methods.length > 1 && (
          <div class="lm-mcp-install__tabs lm-mcp-install__tabs--methods lm-install__seg" role="tablist" aria-label="Run with">
            {
              spec.methods.map((method, i) => (
                <button
                  type="button"
                  class="lm-mcp-install__tab"
                  role="tab"
                  data-tab-kind="method"
                  data-tab-value={method.id}
                  data-no-days={hasCooldowns && refuses(method.id, 'days') ? '' : undefined}
                  data-no-bypass={hasCooldowns && refuses(method.id, 'bypass') ? '' : undefined}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? '0' : '-1'}
                >
                  {method.label}{hasCooldowns && <span class="lm-install__dot" title={`The cooldown does not reach ${method.label}`}><span class="sr-only"> (no cooldown)</span></span>}
                </button>
              ))
            }
          </div>
        )}
        {
          scopedClients.map((client) => (
            <div class="lm-mcp-install__scopes-group lm-install__seg" role="tablist" aria-label={`${client.label} scope`} data-scope-client={client.id}>
              {client.scopes.map((scope, i) => (
                <button
                  type="button"
                  class="lm-mcp-install__tab"
                  role="tab"
                  data-tab-kind="scope"
                  data-tab-client={client.id}
                  data-tab-value={scope.id}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? '0' : '-1'}
                >
                  {scope.label}
                </button>
              ))}
            </div>
          ))
        }
      </span>
      {hasCooldowns && (
        <span class="lm-install__cd">
          <button type="button" class="lm-install__cdtoggle" data-mcp-cooldown="toggle" aria-pressed="false" title="Applies to every installer on libtmux.org">
            <span class="lm-install__glyph" aria-hidden="true"></span>Cooldown
          </button>
        </span>
      )}
    </div>

    <div class="lm-install__body">
      {panels.map((panel) => {
        const key = panelKey(panel)
        const alt = panel.cooldown.id === 'days' && panel.cooldownReason ? alternative(panel) : undefined
        return (
          <div class="lm-mcp-install__panel" role="tabpanel" {...panelAttrs(panel)}>
            {panel.pipPrereq && <InstallCode family="mcp" html={prereqHtml.get(key)!} language="console" layout="strip" strip="First" prompt="$" label="server install" />}
            {panel.cooldown.id !== 'off' && hasCooldowns && <InstallCooldown
              family="mcp"
              mode={panel.cooldown.id === 'bypass' ? 'bypass' : 'days'}
              tool={panel.method.label}
              exempt={exemptClause(panel)}
              reason={panel.cooldownReason ?? undefined}
              alt={alt ? { id: alt.id, label: alt.label } : undefined}
            />}
            <InstallCode family="mcp" html={bodyHtml.get(key)!} language={panel.language} layout="plain" prompt={panel.language === 'console' ? '$' : undefined} codeKey={key} />
          </div>
        )
      })}
    </div>
  </div>

  <div class="lm-install__notes">
    {panels.map((panel) => {
      const notes = notesOf(panel)
      return notes.length > 0 && (
        <div class="lm-mcp-install__panel" {...panelAttrs(panel)}>
          {notes.map((note) => note === 'doc'
            ? <p class="lm-mcp-install__note">With <a href={panel.method.docUrl!} target="_blank" rel="noopener">{panel.method.label}</a> installed.</p>
            : <p class="lm-mcp-install__note">{note.split(/`([^`]+)`/).map((part, i) => (i % 2 ? <code>{part}</code> : part))}</p>)}
        </div>
      )
    })}
  </div>
  <span class="sr-only" data-copy-status role="status" aria-live="polite" aria-atomic="true" />
</div>

<script>
  import './mcp-install.js'
</script>
