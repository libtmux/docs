---
/**
 * What a port's Workspace Manager or MCP server is, as a dismissible bar.
 *
 * The same kind of notice as `PrereleaseNotice`, and it shares that bar's
 * styles: a status is a sentence a reader needs once, not an admonition that
 * opens every page and cannot be closed. `DocsLayout` fills `BaseLayout`'s
 * `status` slot with this bar, so it sits under the release bar and outside
 * the article, the search index and the page's Markdown.
 *
 * The id names the product and its status, and it is the storage key's
 * suffix: dismissing the concept note on one port's Workspace Manager hides it
 * on every port's, and says nothing about the MCP server's. `ThemeScript`
 * reads the keys in <head> and sets `data-product-notice-dismissed` on the
 * root before any body markup is parsed, and `global.css` hides the bar from
 * that attribute, so a dismissed bar is never painted. A status needs a hide
 * rule in `global.css`; `product-notice.test.ts` fails for one that has none.
 *
 * No-JS readers keep the bar, as they keep the release bar.
 */
import { DOC_PRODUCTS, PORT_BY_SLUG, PRODUCT_STATUS_GUIDE, productConceptNotice, productDescription, productInDevelopment, type DocProduct } from '../lib/ports'
import { withRoot } from '../lib/site-root'

interface Props { port: string; product: DocProduct }
const { port, product } = Astro.props
const info = PORT_BY_SLUG[port]
const concept = productConceptNotice(info, product)
const status = concept ? { name: 'concept', badge: 'Concept example', text: concept.body }
  : productInDevelopment(info, product) ? {
    name: 'in-development',
    badge: 'In development',
    text: product === 'workspace' ? productDescription(info, product)
      : 'Server behavior and tool contracts may change. Tool availability depends on the server configuration.',
  } : undefined
const id = `${product}-${status?.name}`
---
{status && <div class="prerelease-notice product-notice" data-product-notice={id}>
  <div class="prerelease-notice__inner">
    <p class="prerelease-notice__text">
      <strong class="prerelease-notice__badge">{status.badge}</strong>
      <span>
        {status.text}
        {concept && <a href={withRoot(PRODUCT_STATUS_GUIDE)}>What concept means</a>}
      </span>
    </p>
    <button
      class="prerelease-notice__dismiss"
      type="button"
      data-product-notice-dismiss={id}
      aria-label={`Dismiss the ${DOC_PRODUCTS[product].label} ${status.badge.toLowerCase()} notice`}
    >
      <span class="prerelease-notice__dismiss-label">Dismiss</span>
      <svg class="prerelease-notice__dismiss-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 4 8 8M4 12l8-8" /></svg>
    </button>
  </div>
</div>}

<script>
  const STORAGE_PREFIX = 'libtmux-docs.product-notice.'

  /**
   * Hide the bar for good, through the attribute <head> reads on the next page.
   *
   * Several bars can be dismissed on one page, so the attribute is a list and
   * a click adds to it.
   */
  function dismiss(event: Event) {
    const id = (event.currentTarget as HTMLElement).dataset.productNoticeDismiss
    if (!id) return
    try {
      localStorage.setItem(STORAGE_PREFIX + id, 'dismissed')
    } catch {
      // A reader with storage blocked still gets the dismissal for this page.
    }
    const root = document.documentElement
    const dismissed = new Set(root.getAttribute('data-product-notice-dismissed')?.split(' ').filter(Boolean))
    root.setAttribute('data-product-notice-dismissed', [...dismissed.add(id)].join(' '))
  }

  function bind() {
    for (const button of document.querySelectorAll<HTMLElement>('[data-product-notice-dismiss]')) {
      if (button.dataset.bound) continue
      button.dataset.bound = 'yes'
      button.addEventListener('click', dismiss)
    }
  }

  bind()
  document.addEventListener('astro:after-swap', bind)
</script>
