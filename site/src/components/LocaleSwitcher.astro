---
import { LOCALE_LABEL, localeRoot, type Locale } from '../i18n/locales'
import type { LocaleStatus } from '../i18n/resolve'
import { withRoot } from '../lib/site-root'
import { t } from '../i18n/ui'

/**
 * Locale switcher — the third axis, beside the port and version controls.
 *
 * Links, inside a native <details>, rather than the <select> the other two
 * switchers use. Those fetch their options at runtime (a tag build published
 * months ago must still list versions released after it), so they need script
 * either way; the locale list is known at build time, so this works with
 * scripting disabled and needs no custom element.
 *
 * Each target composes through `localeRoot`, never `withRoot`: another locale
 * is a sibling tree, not a child of this build, so `/ja/…` is right whatever
 * prefix the current build carries. Composing through the site root is what
 * produced `/ja/ja/concepts/`.
 *
 * Renders nothing below two locales — a control offering only the page you
 * are already on is furniture. That also suppresses it on port pages: a port
 * build sets LIBTMUX_DOCS_PORT, `localesEnabled()` goes false, and the map
 * arrives with the single default entry, which is honest — the port trees and
 * the reference are built in English only.
 */
interface Props {
  locale: Locale
  /** This page's path with any locale prefix removed. */
  sourcePath: string
  localeStatuses: Record<string, LocaleStatus>
}
const { locale, sourcePath, localeStatuses } = Astro.props as Props

const STATUS_KEY = {
  translated: 'i18n.statusTranslated',
  stale: 'i18n.statusStale',
  placeholder: 'i18n.statusPlaceholder',
} as const satisfies Record<LocaleStatus, string>

const path = sourcePath.replace(/^\/+|\/+$/g, '')
const href = (l: string) => `${localeRoot(l)}${path}${path ? '/' : ''}`
const entries = Object.entries(localeStatuses) as [Locale, LocaleStatus][]
---

{
  entries.length > 1 && (
    <details class="relative">
      <summary
        class="topnav-chip cursor-pointer list-none px-2 py-1 text-sm"
        aria-label={t(locale, 'i18n.available')}
      >
        {/* The current language in its own name, so a reader who cannot read
            the interface language can still find the control. */}
        <span lang={locale}>{LOCALE_LABEL[locale]}</span>
      </summary>
      <ul class="absolute right-0 z-50 mt-1 min-w-48 rounded border border-edge bg-surface py-1 shadow-lg">
        {entries.map(([l, status]) => (
          <li>
            <a
              class="flex items-baseline justify-between gap-3 px-3 py-1.5 text-sm hover:bg-edge/30"
              href={href(l)}
              hreflang={l}
              lang={l}
              aria-current={l === locale ? 'true' : undefined}
            >
              <span class:list={[l === locale && 'font-semibold']}>{LOCALE_LABEL[l]}</span>
              {/* Status in the language being read, not the one offered: it
                  describes the destination to the person choosing it. */}
              <span class="text-xs text-muted" lang={locale}>
                {t(locale, STATUS_KEY[status])}
              </span>
            </a>
          </li>
        ))}
        <li class="mt-1 border-t border-edge pt-1">
          <a class="block px-3 py-1.5 text-sm underline" href={withRoot('/translations/')} lang={locale}>
            {t(locale, 'i18n.coverage')}
          </a>
        </li>
      </ul>
    </details>
  )
}
