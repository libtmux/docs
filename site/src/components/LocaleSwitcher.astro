---
import { LOCALE_LABEL, localePageHref, type Locale } from '../i18n/locales'
import type { LocaleStatus } from '../i18n/resolve'
import { withRoot } from '../lib/site-root'
import { t } from '../i18n/ui'
import PickerSearch from './docs/PickerSearch.astro'
import '../styles/documentation-picker.css'

interface Props {
  locale: Locale
  /** This page's path with any locale prefix removed. */
  sourcePath: string
  localeStatuses: Record<string, LocaleStatus>
}
const { locale, sourcePath, localeStatuses } = Astro.props as Props

const STATUS_KEY = {
  translated: 'i18n.statusTranslated',
  stale: 'i18n.statusStale',
  placeholder: 'i18n.statusPlaceholder',
} as const satisfies Record<LocaleStatus, string>

const href = (locale: string) => localePageHref(locale, sourcePath)
const entries = Object.entries(localeStatuses) as [Locale, LocaleStatus][]
---

{
  entries.length > 0 && (
    <details class="doc-picker" data-doc-picker data-locale-picker>
      <summary aria-label={`${LOCALE_LABEL[locale]}: ${t(locale, 'i18n.available')}`}>
        {/* The current language in its own name, so a reader who cannot read
            the interface language can still find the control. */}
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="8" r="6" /><path d="M2 6h12M2 10h12M8 2c3 3 3 9 0 12-3-3-3-9 0-12Z" /></svg>
        <span lang={locale}>{LOCALE_LABEL[locale]}</span>
        <svg class="doc-picker-caret" viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
      </summary>
      <div class="doc-picker-panel locale-picker-panel" data-picker-panel>
        <PickerSearch label={t(locale, 'i18n.available')} placeholder={t(locale, 'i18n.findLanguage')} emptyMessage={t(locale, 'i18n.noMatchingLanguages')} />
        <ul>
        {entries.map(([l, status]) => (
          <li>
            <a
              class="doc-picker-option" data-picker-option data-preserve-fragment
              data-match={`${l} ${LOCALE_LABEL[l]}`}
              href={href(l)}
              hreflang={l}
              lang={l}
              aria-current={l === locale ? 'page' : undefined}
            >
              <span class:list={[l === locale && 'font-semibold']}>{LOCALE_LABEL[l]}</span>
              {/* Status in the language being read, not the one offered: it
                  describes the destination to the person choosing it. */}
              {l === locale ? <span class="doc-picker-check" aria-hidden="true">✓</span> : status !== 'translated' && <small lang={locale}>{t(locale, STATUS_KEY[status])}</small>}
            </a>
          </li>
        ))}
        <li class="mt-1 border-t border-edge pt-1">
          <a class="doc-picker-option" data-picker-option data-match={t(locale, 'i18n.coverage')} href={withRoot('/translations/')} lang={locale}>
            {t(locale, 'i18n.coverage')}
          </a>
        </li>
      </ul></div>
    </details>
  )
}

<style>
  .locale-picker-panel { --picker-width: 14rem; max-height: min(28rem, calc(100dvh - 8rem)); overflow-y: auto; overscroll-behavior: contain; }
  .locale-picker-panel li:has(> a[hidden]) { display: none; }
</style>
