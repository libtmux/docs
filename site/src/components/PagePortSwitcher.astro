---
import type { PagePortLink } from '../lib/page-port-links'
import { PORT_BY_SLUG } from '../lib/ports'
import { branding } from '../lib/branding'
import { withRoot, withPortRoot } from '../lib/site-root'
import TmuxLogo from './tmux/Logo.astro'
import '../styles/documentation-picker.css'

interface Props {
  entries: PagePortLink[]
  portSlug?: string
  label?: string
  tmux?: boolean
  /** The homepage changes its selected artwork without navigating. */
  homeLanguageIcons?: boolean
  /** Reserve the widest label so changing the selection does not resize it. */
  reserveLabelWidth?: boolean
}
const { entries, portSlug, label, tmux = false, homeLanguageIcons = false, reserveLabelWidth = false } = Astro.props
const current = entries.find((entry) => entry.port === portSlug)
const name = tmux ? 'tmux CLI' : current?.name ?? PORT_BY_SLUG[portSlug ?? '']?.name ?? 'In other ports'
const shortName = tmux ? 'tmux' : PORT_BY_SLUG[portSlug ?? '']?.shortName ?? name
const families = [
  { label: 'Scripting & web', ports: ['py', 'ruby', 'lua', 'ts'] },
  { label: 'Compiled & native', ports: ['rs', 'go', 'cxx', 'swift'] },
  { label: 'JVM', ports: ['java', 'kotlin', 'scala'] },
  { label: '.NET', ports: ['csharp', 'fsharp'] },
]
const known = new Set(families.flatMap((family) => family.ports))
families.push({ label: 'Other languages', ports: entries.filter((entry) => !known.has(entry.port)).map((entry) => entry.port) })
---
<details class="doc-picker" data-page-port-switcher data-doc-picker>
  <summary aria-label={label ?? `${name}: choose a language or tmux documentation`} data-reserve-label-width={reserveLabelWidth || undefined}>
    <span class:list={['page-port-icon', { 'home-language-icon': homeLanguageIcons }]} aria-hidden="true">
      {tmux ? <span class="page-port-terminal">$</span> : !homeLanguageIcons && portSlug && PORT_BY_SLUG[portSlug] ? <img
        data-language-icon={portSlug}
        src={withRoot(`/brand/languages/${portSlug}/icon.svg`)}
        width="24" height="24" alt="" /> : <svg data-home-default-icon={homeLanguageIcons || undefined} viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m5 4-4 4 4 4m6-8 4 4-4 4M9.5 2l-3 12" stroke-linecap="round" stroke-linejoin="round" /></svg>}
      {homeLanguageIcons && entries.map((entry) => <img
        data-language-icon={entry.port}
        data-home-language-icon={entry.port}
        src={withRoot(`/brand/languages/${entry.port}/icon.svg`)}
        width="24" height="24" alt="" loading="eager" decoding="sync" />)}
    </span>
    <span class="page-port-name">{homeLanguageIcons ? 'Language' : name}</span><span class="page-port-short-name" aria-hidden="true">{homeLanguageIcons ? 'Port' : shortName}</span>
    {reserveLabelWidth && <span class="page-port-label-sizer" aria-hidden="true" style="visibility: hidden; height: 0; overflow: hidden;">
      <span class="page-port-sizer-default">{homeLanguageIcons ? 'Language' : name}</span>
      {entries.map((entry) => <span>{entry.name}</span>)}
    </span>}
    <svg class="doc-picker-caret" viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
  </summary>
  <div class="doc-picker-panel port-picker-panel" data-picker-panel>
    <p class="doc-picker-title">Choose a port <span class="doc-picker-title-actions"><slot name="title-actions" /><span class="doc-picker-count">{entries.length}</span></span></p>
    <label class="doc-picker-search" data-picker-search-label hidden>
      <span class="sr-only">Find a port</span>
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3.5 3.5"/></svg>
      <input type="search" placeholder="Find a port…" autocomplete="off" data-picker-search />
    </label>
    {families.map((family) => {
      const ports = family.ports.flatMap((slug) => entries.filter((entry) => entry.port === slug))
      return ports.length > 0 && <section class="port-family" data-picker-group>
        <h3>{family.label}</h3>
        <div class="doc-picker-options">
          {ports.map((entry) => entry.links.length ? entry.links.map((link) => <a class="doc-picker-option" href={link.href}
            data-port={entry.port} data-port-name={entry.name} data-port-short-name={PORT_BY_SLUG[entry.port]?.shortName ?? entry.name}
            data-picker-option data-match={`${entry.port} ${entry.name} ${PORT_BY_SLUG[entry.port]?.shortName ?? ''} ${link.label ?? ''}`}
            aria-current={entry.port === portSlug ? 'page' : undefined}>
            <img class="port-artwork" src={withRoot(branding(entry.port).asset('logo.svg'))} width="26" height="26" alt="" />
            <span>{entry.name}{entry.links.length > 1 && <small>{link.label}</small>}</span>
            {entry.port === portSlug && <span class="doc-picker-check" aria-hidden="true">✓</span>}
          </a>) : <span class="doc-picker-option" aria-disabled="true" data-port={entry.port} data-port-name={entry.name}
            data-picker-option data-match={`${entry.port} ${entry.name}`}>
            <img class="port-artwork" src={withRoot(branding(entry.port).asset('logo.svg'))} width="26" height="26" alt="" />
            <span>{entry.name}<small>Unavailable</small></span>
          </span>)}
        </div>
      </section>
    })}
    <section class="tmux-area" data-picker-group>
      <h3 class="doc-picker-title">tmux</h3>
      <a class="doc-picker-option" href={withPortRoot('/tmux/')} data-picker-option
        data-match="just tmux cli terminal manual commands guides topics reference"
        aria-current={tmux ? 'location' : undefined}>
        <TmuxLogo size={26} /><span>tmux CLI</span>
        <span class="tmux-destination" aria-hidden="true">
          {tmux && <span class="doc-picker-check">✓</span>}<span>→</span>
        </span>
      </a>
    </section>
    <p class="doc-picker-empty" data-picker-empty hidden>No matching ports.</p>
    <p class="sr-only" role="status" data-picker-status></p>
  </div>
</details>
<style>
  summary[data-reserve-label-width] { display: grid; grid-template-columns: max-content minmax(0, max-content) max-content; }
  summary[data-reserve-label-width] :is(.page-port-name, .page-port-short-name, .page-port-label-sizer) { grid-area: 1 / 2; }
  summary[data-reserve-label-width] .doc-picker-caret { grid-area: 1 / 3; }
  .page-port-label-sizer { display: grid; visibility: hidden; height: 0; overflow: hidden; white-space: nowrap; pointer-events: none; }
  .page-port-label-sizer > span { grid-area: 1 / 1; }
  .page-port-icon { display: grid; place-items: center; flex: none; }
  .page-port-terminal { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; font: 1.25rem/1 var(--font-mono); }
  .page-port-icon > img { width: 1.5rem; height: 1.5rem; object-fit: contain; }
  /* The Python SVG reserves space below the snakes for a shadow. */
  .page-port-icon > img[data-language-icon="py"] { transform: translateY(8.333%); }
  .page-port-short-name { display: none; }
  .port-family + .port-family { margin-top: .65rem; }
  .port-family h3 { margin: .75rem .4rem .25rem; font-size: .6875rem; font-weight: 400; text-transform: uppercase; letter-spacing: .025em; color: var(--color-muted); }
  .port-artwork { flex: none; width: 1.625rem; height: 1.625rem; object-fit: contain; }
  .tmux-area { margin-top: .75rem; padding-top: .5rem; border-top: 1px solid var(--color-edge); }
  .tmux-destination { display: inline-flex; align-items: center; gap: .5rem; margin-left: auto; }
</style>
