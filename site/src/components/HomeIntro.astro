---
import { Code } from 'astro-expressive-code/components'
import PackageInstall from './widgets/PackageInstall.astro'
import { PORTS, portHomeUrl, portPageUrl, referenceUrl } from '../lib/ports'
import { QUICKSTARTS } from '../lib/quickstarts'
import type { DocumentationSurface } from '../lib/documentation-navigation'
import { defaultVersionFor } from '../lib/versions'
import { branding } from '../lib/branding'
import { withRoot } from '../lib/site-root'

interface Props {
  solutions: { port: string; version: string; surfaces: DocumentationSurface[] }[]
}
const { solutions } = Astro.props
const descriptions: Record<string, string> = {
  core: 'Control tmux from your code.',
  mcp: 'Give your assistant tmux tools.',
  workspace: 'Launch a repeatable workspace.',
}
---
<section class="home-preview" aria-label="Explore libtmux">
    <section class="home-intro">
      <p class="home-eyebrow">tmux, in your language</p>
      <h1>Control tmux from your application.</h1>
      <p class="home-lede">Create sessions, arrange panes, send input, and capture output.</p>
      {PORTS.map((port, index) => <div data-home-language={port.slug} hidden={index !== 0}>
        <div class="home-actions">
          <a class="brand-action" href={portHomeUrl(port, defaultVersionFor(port.slug))}>Explore {port.name} →</a>
          <a href={referenceUrl(port, defaultVersionFor(port.slug))}>API reference</a>
        </div>
        <div class="home-solutions" aria-label={`${port.name} solutions`}>
          {solutions[index].surfaces.map((surface) => <a href={surface.href}>
            <img src={withRoot(branding(port.slug, surface.id === 'core' ? '' : surface.id).asset('logo.svg'))} alt="" width="30" height="30" />
            <span><strong>{surface.label}</strong><small>{descriptions[surface.id]}</small></span>
            <span class="home-solution-arrow" aria-hidden="true">→</span>
          </a>)}
        </div>
      </div>)}
    </section>
    <section class="home-examples" aria-label="Language quickstart">
      {PORTS.map((port, index) => {
        const snippet = QUICKSTARTS[port.slug]
        const columns = snippet ? Math.min(88, Math.max(...snippet.code.split('\n')
          .map((line) => line.replace(/\t/g, '    ').length))) : 88
        return <div data-home-language={port.slug} hidden={index !== 0} style={`--home-code-columns: ${columns}`}>
        <h2>Start with {port.name}</h2>
        {snippet && <Code code={snippet.code} lang={snippet.lang} frame="none" />}
        {snippet?.note && <p class="home-example-note">{snippet.note}</p>}
        {snippet?.complete ? <>
          <details class="home-example-run">
            <summary>Run this example</summary>
            <p>{snippet.complete.prerequisites}</p>
            <p>Save these files in a new directory, keeping the paths shown. The program uses its own tmux socket and includes cleanup.</p>
            {snippet.complete.files.map((file) => <details class="home-example-file" open={file.name === snippet.complete!.program} data-home-file={file.name}>
              <summary>{file.name}</summary>
              <Code code={file.code.replace(/\n$/, '')} lang={file.lang} frame="none" />
            </details>)}
            <h3>Setup and run</h3>
            {snippet.complete.commands.map((command, index) => <div data-home-command={index}><Code code={command} lang="bash" frame="none" /></div>)}
            <h3>Expected output</h3>
            <Code code={snippet.complete.expectedOutput.replace(/\n$/, '')} lang="text" />
            <p>Library revision: <a href={`https://github.com/${snippet.complete.sourceRepository}/tree/${snippet.complete.sourceRevision}`}>{snippet.complete.sourceRevision.slice(0, 12)}</a>.</p>
          </details>
        </> : snippet && <details class="home-example-source"><summary>Example source</summary><p>{snippet.source}</p></details>}
        <p class="home-example-link"><a href={portPageUrl(port, defaultVersionFor(port.slug), 'examples')}>More {port.name} examples →</a></p>
        <PackageInstall ports={[port.slug]} />
      </div>})}
    </section>
</section>

<style>
  .home-preview { display: grid; grid-template-columns: minmax(0, min(20rem, 32%)) minmax(0, 1fr); gap: 2rem; }
  .home-preview [hidden] { display: none !important; }
  .home-preview > * { min-width: 0; }
  .home-eyebrow { margin-bottom: .85rem; font-family: var(--font-ibm-plex-mono); font-size: .8125rem; color: var(--color-muted); }
  h1 { max-width: 13ch; font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; line-height: 1.15; letter-spacing: -.025em; }
  .home-lede { max-width: 36ch; margin-top: 1.25rem; color: var(--color-muted); line-height: 1.65; }
  .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-block: 1.5rem 2rem; font-size: .875rem; }
  .home-actions .brand-action { padding: .65rem .9rem; border-radius: .35rem; }
  .home-solutions { display: grid; gap: .65rem; }
  .home-solutions > a { display: flex; align-items: center; gap: .75rem; padding: .85rem; border: 1px solid var(--color-edge); border-radius: .5rem; }
  .home-solutions > a:hover { background: var(--color-surface-hover); }
  .home-solutions img { flex: none; }
  .home-solutions strong, .home-solutions small { display: block; }
  .home-solutions strong { font-size: .875rem; font-weight: 600; }
  .home-solutions small { margin-top: .2rem; font-size: .8125rem; color: var(--color-muted); }
  .home-solution-arrow { margin-left: auto; color: var(--color-link); }
  .home-examples { container-type: inline-size; }
  .home-examples > [data-home-language] > :global(.expressive-code) {
    /* Allow for rounded glyph advances; rem bounds preserve readable zoom. */
    --ec-codeFontSize: clamp(.8125rem, calc((100cqi - 2rem) / (var(--home-code-columns) * .625)), .9375rem);
  }
  .home-examples h2 { margin-bottom: .85rem; font-size: 1rem; font-weight: 600; }
  .home-example-link { margin-block: .8rem 1.2rem; font-size: .8125rem; color: var(--color-muted); }
  .home-example-link a { color: var(--color-link); }
  /* Reserve the vertical scrollbar before sizing text to the code container. */
  .home-examples :global(.expressive-code pre) { max-height: 34rem; overflow: auto; tab-size: 4; container-type: inline-size; scrollbar-gutter: stable; }
  @media (max-width: 48rem) {
    .home-preview { grid-template-columns: 1fr; }
    h1 { max-width: 18ch; }
    .home-solutions { margin-top: 1rem; }
  }
  .home-example-note, .home-example-source, .home-example-run { margin-top: .8rem; font-size: .8125rem; color: var(--color-muted); }
  .home-examples summary { cursor: pointer; }
  .home-example-source p, .home-example-run p { margin-top: .75rem; }
  .home-example-file, .home-example-run h3 { margin-top: 1rem; }
  .home-example-file > summary { margin-bottom: .5rem; font-family: var(--font-ibm-plex-mono); }
  .home-example-run h3 { margin-bottom: .5rem; font-weight: 600; }
  .home-example-run [data-home-command] + [data-home-command] { margin-top: .75rem; }
</style>
