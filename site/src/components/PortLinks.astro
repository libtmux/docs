---
import RegistryIcon from './icons/RegistryIcon.astro'
import type { DocProduct, Port } from '../lib/ports'

interface Props {
  port: Port
  product?: DocProduct
  version?: string
  revision?: string
  class?: string
}

const { port, product, version = 'latest', revision, class: className = '' } = Astro.props as Props
const pkg = product ? port.packages?.find((entry) => entry.id === product) : undefined
const source = pkg?.source
const repo = source?.repo ?? port.repo
// An app in a separate repository has its own release history.
const taggedVersion = /^v?\d/.test(version) && repo === port.repo
  ? `${port.tagPrefix ?? ''}${version}` : undefined
const ref = version === 'latest' ? source?.ref : taggedVersion ?? revision ?? source?.ref
const sourceUrl = source ? `https://github.com/${repo}/tree/${ref}/${source.path}` : `https://github.com/${repo}`
const registry = product
  ? pkg?.registry && port.registry ? { ...port.registry, url: pkg.registry } : undefined
  : port.registry

// Go's registry and reference host are the same destination.
const ecosystem =
  !product && port.ecosystemHost && port.ecosystemHost.url !== registry?.url
    ? port.ecosystemHost
    : undefined
---

<nav class:list={['port-links', className]} aria-label={`${port.name} package and source`}>
  <a class="port-link" href={sourceUrl} title={source ? `${repo}/${source.path} (${ref})` : undefined} rel="noopener">
    <RegistryIcon icon="github" decorative />
    <span>{product ? 'GitHub' : port.repo}</span>
  </a>
  {
    registry && (
      <a class="port-link" href={registry.url} rel="noopener">
        <RegistryIcon icon={registry.icon} decorative />
        <span>{registry.name}</span>
      </a>
    )
  }
  {
    ecosystem && (
      <a class="port-link" href={ecosystem.url} rel="noopener">
        <span>{ecosystem.name}</span>
      </a>
    )
  }
</nav>

<style>
  .port-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .port-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--color-background-border);
    border-radius: 999px;
    color: var(--color-foreground-muted);
    font-size: 0.8125rem;
    line-height: 1.2;
    text-decoration: none;
  }

  /*
   * The brand colour, on the whole chip rather than on the mark alone.
   *
   * `--icon-brand` is declared on the icon by RegistryIcon, and the icon is a
   * child of this link, so the value cannot be read from here — a custom
   * property inherits down, not up. `:has()` moves the rule to the child
   * instead, which is also what lets one selector serve seven marks.
   */
  .port-link:hover,
  .port-link:focus-visible {
    border-color: currentColor;
  }

  .port-link:hover :global(.registry-icon),
  .port-link:focus-visible :global(.registry-icon) {
    color: var(--icon-brand);
  }

  :global([data-theme-mode='dark']) .port-link:hover :global(.registry-icon),
  :global([data-theme-mode='dark']) .port-link:focus-visible :global(.registry-icon) {
    color: var(--icon-brand-dark);
  }

  .port-link:hover span,
  .port-link:focus-visible span {
    color: var(--color-foreground-primary);
  }

  .port-link:focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 2px;
  }
</style>
