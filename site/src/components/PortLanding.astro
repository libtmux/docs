---
import { Code } from 'astro-expressive-code/components'
import CoreShowcase from './CoreShowcase.astro'
import LandingInstall from './landing/LandingInstall.astro'
import McpReplay from './mcp/McpReplay.astro'
import WorkspaceConfig from './workspace/WorkspaceConfig.astro'
import WorkspaceEvidence from './workspace/WorkspaceEvidence.astro'
import WorkspacePicker from './workspace/WorkspacePicker.astro'
import WorkspaceWindows from './workspace/WorkspaceWindows.astro'
import { PORT_BY_SLUG, portPageUrl, type Port } from '../lib/ports'
import { landingPanels, type CachedSource, type LandingTable } from '../lib/port-landing'
import { mcpShowcase, toolHeadings } from '../lib/mcp-showcase'
import { loadCommand } from '../lib/workspace-links'
import { landingExample, offersPicker, previewWindows, TOPICS, workspaceShowcase } from '../lib/workspace-showcase'
import { QUICKSTARTS, homeCodeColumns } from '../lib/quickstarts'
import LANDING from '../data/landing-examples.json'
import SOURCES from '../data/example-sources.json'

/**
 * What each product a port ships looks like in use, with its install widget.
 *
 * Core API is the homepage's example block, fixed to the port's language.
 * MCP opens with one sentence, the install picker, then the MCP overview's
 * worked example: a prompt and the schema-checked calls an agent makes. A
 * port with no worked example, or one served by another port's package,
 * shows the picker and the links, never invented calls. Workspace Manager
 * shows a workspace file one of the port's tests loads, the command that
 * loads it and the panes it builds, from the showcase the workspace overview
 * uses. A port with several files offers that overview's preset picker, opening
 * on the file `landingExample` chooses; a port with one shows it alone. Both
 * panels keep the excerpt of a program the port's CI runs behind a
 * disclosure, read from the revision-bound example cache by the `from` and
 * `to` anchors in `landing-examples.json`. A port that ships only the
 * library shows its panel without a selector, since there is nothing to choose.
 */
interface Props {
  port: Port
  version: string
}
const { port, version } = Astro.props as Props
const panels = landingPanels(port, version, PORT_BY_SLUG, LANDING as LandingTable, SOURCES as Record<string, CachedSource>)
// The MCP overview's showcase, for the port whose server the panel installs. A port served by another port's package gets no worked example.
const showcases = new Map(await Promise.all(panels.filter((panel) => panel.product === 'mcp' && panel.install)
  .map(async (panel) => [panel.product, await mcpShowcase(panel.install!.port, version)] as const)))
const workspace = workspaceShowcase(port.slug)
const workspaceExample = workspace && landingExample(workspace)
const workspaceTopic = workspaceExample && TOPICS.find((topic) => topic.id === workspaceExample.topic)!
// Only the single-file view draws here; the picker draws every preset itself.
const workspaceWindows = workspace && workspaceExample && !offersPicker(workspace)
  ? previewWindows(JSON.parse(workspaceExample.json), `landing-${port.slug}`, workspace.support.defaultLayout?.layout) : []
const workspaceProgram = loadCommand(port.slug)
const complete = QUICKSTARTS[port.slug]?.complete
if (!complete) throw new Error(`PortLanding: ${port.slug} has no complete homepage example; add it to home-examples.json`)
const coreLinks = [
  { href: portPageUrl(port, version, 'core'), label: 'Core Library documentation →' },
  { href: portPageUrl(port, version, 'examples'), label: `More ${port.name} examples →` },
]
const panelId = (product: string) => `landing-panel-${product}`
---
<section class="port-landing mt-10" aria-label={`Start with ${port.name}`} data-port-landing={port.slug}>
  {panels.length > 1 && <fieldset class="landing-products">
    <legend class="sr-only">Product</legend>
    {panels.map((panel, index) => <label>
      <input type="radio" name="landing-product" value={panel.product} checked={index === 0} aria-controls={panelId(panel.product)} data-landing-product />
      <span>{panel.label}</span>
    </label>)}
  </fieldset>}
  {panels.map((panel) => {
    const showcase = showcases.get(panel.product)
    const excerpt = panel.excerpt && <details class="landing-excerpt" data-landing-excerpt={panel.product}
      style={`--home-code-columns: ${homeCodeColumns(panel.excerpt.code)}`}>
      <summary>{panel.product === 'mcp' ? 'Embed the server in a program' : 'Build the workspace from a program'}</summary>
      <Code code={panel.excerpt.code} lang={panel.excerpt.lang} title={panel.excerpt.file} frame="code" />
      <p class="landing-source">
        Excerpt of <a href={panel.excerpt.sourceUrl}><code>{panel.excerpt.file}</code></a>,
        which <code>{panel.excerpt.ci.command}</code> runs in the repository's CI
        (<code>{panel.excerpt.ci.workflow}</code>).
      </p>
    </details>
    return <div class="landing-panel" id={panelId(panel.product)} data-landing-panel={panel.product}>
    {panel.product === 'core' ? <>
      <CoreShowcase port={port.slug} links={coreLinks} />
      <LandingInstall panel={panel} port={port.slug} />
    </> : panel.product === 'mcp' ? <>
      <h2 class="sr-only">{panel.label}</h2>
      {panel.servedBy && <p class="landing-note">
        {port.name} has no {panel.label} package of its own. It uses the {panel.servedBy} port's <code>{panel.packageName}</code>.
      </p>}
      {showcase?.example && !panel.servedBy && <div class="landing-example" data-landing-example="mcp">
        <McpReplay example={showcase.example} portName={port.name} level={3} />
      </div>}
      <LandingInstall panel={panel} port={port.slug} />
      <ul class="landing-links">
        {showcase && !panel.servedBy && <li><a href={`${panel.href}#${toolHeadings(showcase)[0]!.slug}`}>All tools{showcase.groups.some((group) => group.tier) ? ' by tier' : ''} →</a></li>}
        {showcase && <li><a href={showcase.toolsHref}>Every tool, with its arguments and result →</a></li>}
        <li><a href={panel.href}>{panel.label} documentation →</a></li>
      </ul>
      {excerpt}
    </> : <>
      <h2 class="sr-only">{panel.label}</h2>
      {workspace && workspaceExample && workspaceTopic && <div class="landing-example" data-landing-example="workspace">
        {offersPicker(workspace)
          ? <WorkspacePicker showcase={workspace} landing={{ first: workspaceExample.topic, program: workspaceProgram?.program }} />
          : <>
            <h3>{workspaceTopic.title}</h3>
            <p>{workspaceTopic.summary}</p>
            <div class="ws-body">
              <WorkspaceConfig id={`landing-${port.slug}-${workspaceExample.topic}`} yaml={workspaceExample.yaml} json={workspaceExample.json} note />
              <WorkspaceWindows windows={workspaceWindows} />
            </div>
            <WorkspaceEvidence showcase={workspace} example={workspaceExample} program={workspaceProgram?.program} />
          </>}
      </div>}
      <LandingInstall panel={panel} port={port.slug} />
      <ul class="landing-links">
        {workspace && <li><a href={`${panel.href}#example-workspaces`}>Example workspaces →</a></li>}
        {workspaceProgram && <li><a href={portPageUrl(port, version, workspaceProgram.path)}>The <code>{workspaceProgram.program} load</code> command →</a></li>}
        <li><a href={panel.href}>{panel.label} documentation →</a></li>
      </ul>
      {excerpt}
    </>}
  </div>})}
</section>

<script>
  import { productFromSearch, searchWithProduct } from '../lib/landing-selection'

  let controller: AbortController | undefined

  function bindLandingSelector() {
    controller?.abort()
    const inputs = [...document.querySelectorAll<HTMLInputElement>('[data-landing-product]')]
    if (!inputs.length) return
    controller = new AbortController()
    const { signal } = controller
    const path = location.pathname
    const select = (product: string) => {
      const target = inputs.find((input) => input.value === product)
      if (target) target.checked = true
    }
    // An address that names no product is the page's first.
    const restore = () => {
      if (location.pathname !== path) return
      select(productFromSearch(location.search, inputs.map((input) => input.value)) ?? inputs[0]!.value)
    }
    document.addEventListener('change', (event) => {
      const input = event.target
      if (!(input instanceof HTMLInputElement) || !inputs.includes(input)) return
      const search = searchWithProduct(location.search, input.value, inputs[0]!.value)
      if (search !== location.search) history.replaceState(history.state, '', `${location.pathname}${search}${location.hash}`)
    }, { signal })
    window.addEventListener('popstate', restore, { signal })
    restore()
  }

  bindLandingSelector()
  document.addEventListener('astro:after-swap', bindLandingSelector)
</script>

<style>
  .port-landing { container-type: inline-size; max-width: 56rem; }
  .landing-products {
    display: flex; flex-wrap: wrap; gap: .125rem; margin: 0 0 1.25rem; padding: 0;
    border: 0; border-bottom: 1px solid var(--color-edge);
  }
  .landing-products label {
    position: relative; display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 .9rem;
    border: 1px solid transparent; border-bottom: 0; border-radius: .35rem .35rem 0 0;
    font-size: .875rem; color: var(--color-muted); cursor: pointer;
  }
  .landing-products label:hover { color: inherit; }
  .landing-products label:has(:checked) {
    border-color: var(--color-edge); background: var(--color-surface-hover); color: inherit; font-weight: 600;
  }
  .landing-products label:has(:focus-visible) { outline: 2px solid var(--focus-ring-color, currentColor); outline-offset: -2px; }
  /* The input covers its label, so a click anywhere on the tab selects it. */
  .landing-products input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }

  .landing-panel { display: none; }
  .port-landing:not(:has([data-landing-product])) .landing-panel,
  .port-landing:has([data-landing-product][value="core"]:checked) .landing-panel[data-landing-panel="core"],
  .port-landing:has([data-landing-product][value="mcp"]:checked) .landing-panel[data-landing-panel="mcp"],
  .port-landing:has([data-landing-product][value="workspace"]:checked) .landing-panel[data-landing-panel="workspace"] { display: block; }

  .landing-excerpt :global(.expressive-code) {
    --ec-codeFontSize: clamp(.8125rem, calc((100cqi - 2rem) / (var(--home-code-columns) * .625)), .9375rem);
  }
  /* An excerpt is short by construction, so it shows whole; a complete program scrolls past the homepage's height. */
  .landing-note { font-size: .875rem; color: var(--color-muted); }
  .landing-excerpt :global(.expressive-code pre) { overflow: auto; tab-size: 8; }
  .landing-panel :global(.home-example .expressive-code pre) { max-height: 34rem; overflow: auto; tab-size: 8; scrollbar-gutter: stable; }
  .landing-source { margin-top: .8rem; font-size: .8125rem; color: var(--color-muted); }
  .landing-source a { color: var(--color-link); }
  /* A long command or path wraps instead of widening the page. */
  .landing-source code { white-space: normal; overflow-wrap: anywhere; }
  /* One gap, 1rem, between a panel's blocks; half of it from a title to what it introduces. The tab row's own margin is the only space above the first block. */
  .landing-example { margin: 0; }
  .landing-example :global(h3) { margin: 0 0 .5rem; font-weight: 600; line-height: 1.4; }
  .landing-example > :global(p:not(.mcp-replay-note)) { margin: 0 0 1rem; }
  .landing-note { margin: 0 0 1rem; }
  .landing-links { margin: 1.25rem 0 0; padding: 0; list-style: none; display: grid; gap: .35rem; font-size: .875rem; }
  .landing-links a { color: var(--color-link); }
  .landing-excerpt { margin-top: 1.25rem; }
  .landing-excerpt > summary { cursor: pointer; font-size: .875rem; color: var(--color-link); }
  .landing-excerpt[open] > summary { margin-bottom: .75rem; }
</style>
