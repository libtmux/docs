---
import SearchPanel from './SearchPanel.astro'
import { withPortRoot, withRoot } from '../lib/site-root'
import { PORT_BY_SLUG } from '../lib/ports'

interface Props {
  port?: string
  version: string
}
const { port, version } = Astro.props

/**
 * Search without leaving the page.
 *
 * A native `<dialog>`, so the backdrop, the focus trap and Escape are the
 * browser's rather than ours. The header's Search link stays a real link to
 * /search/, and this intercepts the click — with no JavaScript the link still
 * works, which is why it is a link and not a button.
 */
const searchHref = port ? withPortRoot(`/${port}/${version}/search/`) : withRoot('/search/')
---

<dialog id="search-modal" class="search-modal" aria-label="Search" data-search-href={searchHref}>
  <SearchPanel modal initialPort={port ? PORT_BY_SLUG[port]?.name : undefined} />
</dialog>

<style>
  .search-modal {
    display: flex;
    flex-direction: column;
    width: min(48rem, calc(100vw - 2rem));
    max-height: min(34rem, calc(100vh - 6rem));
    margin: 4rem auto auto;
    padding: 1rem;
    border: 1px solid var(--color-background-border);
    border-radius: var(--radius-lg, 0.5rem);
    background: var(--background-color);
    color: var(--text-color);
    overflow: hidden;
  }

  .search-modal::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .search-modal:not([open]) {
    display: none;
  }
</style>

<script>
  let controller: AbortController | undefined
  function bindSearchModal() {
    controller?.abort()
    controller = new AbortController()
    const { signal } = controller
    const dialog = document.querySelector<HTMLDialogElement>('#search-modal')
    if (!dialog) return
    const searchHref = dialog.dataset.searchHref
    const open = (event?: MouseEvent) => {
      // A modal cannot be opened in a second tab or shared, so a modified
      // click keeps its ordinary meaning and navigates to /search/.
      if (event && (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0)) return
      event?.preventDefault()
      if (!dialog.open) dialog.showModal()
      dialog.dispatchEvent(new CustomEvent('search-modal:open'))
    }

    // Matched by reading the attribute, not by an attribute selector.
    // `scripts/check-links.mjs` reads the built HTML as text, so an inline
    // script that spells out an anchor-with-attribute selector is
    // indistinguishable from a real link and gets reported as broken on every
    // page. That goes for prose about it too, which is why this comment
    // describes the selector instead of showing one.
    for (const link of document.querySelectorAll('a')) {
      const target = link.getAttribute('href')
      if (target === searchHref || target === `${searchHref}#`) {
        link.addEventListener('click', open, { signal })
      }
    }

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault()
        open()
      }
    }, { signal })

    // Clicking the backdrop is a click on the dialog itself: anything inside
    // stops at a child.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close()
    }, { signal })
  }
  bindSearchModal()
  document.addEventListener('astro:after-swap', bindSearchModal)
</script>
