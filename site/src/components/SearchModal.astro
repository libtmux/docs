---
import SearchPanel from './SearchPanel.astro'
import { withPortRoot, withRoot } from '../lib/site-root'
import { PORT_BY_SLUG, portPageUrl, referenceUrl } from '../lib/ports'

interface Props {
  port?: string
  version: string
}
const { port, version } = Astro.props

/**
 * Search without leaving the page.
 *
 * A native `<dialog>`, so the backdrop, the focus trap and Escape are the
 * browser's rather than ours. The header's Search link stays a real link to
 * /search/, and this intercepts the click — with no JavaScript the link still
 * works, which is why it is a link and not a button.
 */
const searchHref = port ? withPortRoot(`/${port}/${version}/search/`) : withRoot('/search/')
const meta = port ? PORT_BY_SLUG[port] : undefined
// When the index does not load, the reader can still browse the port.
const fallbackLinks = meta ? [{ label: `${meta.name} API index`, href: referenceUrl(meta, version) }, { label: `${meta.name} guides`, href: portPageUrl(meta, version, 'guides') }] : undefined
---

<dialog id="search-modal" class="search-modal" aria-label="Search" data-search-href={searchHref}>
  <SearchPanel modal initialPort={meta?.name} fallbackLinks={fallbackLinks} />
</dialog>

<style>
  .search-modal {
    display: flex;
    flex-direction: column;
    width: min(48rem, calc(100vw - 2rem));
    max-height: min(34rem, calc(100vh - 6rem));
    margin: 4rem auto auto;
    padding: 1rem;
    border: 1px solid var(--color-background-border);
    border-radius: var(--radius-lg, 0.5rem);
    background: var(--background-color);
    color: var(--text-color);
    overflow: hidden;
  }

  .search-modal::backdrop {
    background: var(--scrim);
  }

  /* Phones in portrait and short landscape screens give search the whole screen (record 0071). */
  @media (max-width: 29.999rem), (max-height: 29.999rem) and (orientation: landscape) {
    .search-modal {
      width: 100vw;
      max-width: none;
      height: 100dvh;
      max-height: none;
      margin: 0;
      padding: max(1rem, env(safe-area-inset-top)) 1rem max(1rem, env(safe-area-inset-bottom));
      border: 0;
      border-radius: 0;
    }
  }

  .search-modal:not([open]) {
    display: none;
  }
</style>

<script>
  import { SEARCH_STATE_EVENT } from '../lib/search-panel'
  import { readSnapshot } from '../lib/search-state'

  let controller: AbortController | undefined
  function bindSearchModal() {
    controller?.abort()
    controller = new AbortController()
    const { signal } = controller
    const dialog = document.querySelector<HTMLDialogElement>('#search-modal')
    if (!dialog) return
    const searchHref = dialog.dataset.searchHref
    const open = (event?: MouseEvent) => {
      // A modal cannot be opened in a second tab or shared, so a modified
      // click keeps its ordinary meaning and navigates to /search/.
      if (event && (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0)) return
      event?.preventDefault()
      if (!dialog.open) dialog.showModal()
      dialog.dispatchEvent(new CustomEvent('search-modal:open'))
    }

    // Matched by reading the attribute, not by an attribute selector.
    // `scripts/check-links.mjs` reads the built HTML as text, so an inline
    // script that spells out an anchor-with-attribute selector is
    // indistinguishable from a real link and gets reported as broken on every
    // page. That goes for prose about it too, which is why this comment
    // describes the selector instead of showing one.
    const searchLinks: HTMLAnchorElement[] = []
    for (const link of document.querySelectorAll('a')) {
      const target = link.getAttribute('href')
      if (target === searchHref || target === `${searchHref}#`) {
        link.addEventListener('click', open, { signal })
        searchLinks.push(link)
      }
    }

    // A modified click opens the search page, which should open on this query.
    dialog.addEventListener(SEARCH_STATE_EVENT, (event) => {
      const query = (event as CustomEvent<{ query: string }>).detail.query
      for (const link of searchLinks) link.href = `${searchHref}${query}`
    }, { signal })

    // Back from a result returns to the dialog as it was left.
    if (readSnapshot(history.state)?.open) open()

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault()
        open()
      }
    }, { signal })

    // Clicking the backdrop is a click on the dialog itself: anything inside
    // stops at a child.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close()
    }, { signal })
  }
  bindSearchModal()
  document.addEventListener('astro:after-swap', bindSearchModal)
</script>
