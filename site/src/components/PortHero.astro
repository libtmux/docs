---
import { branding } from '../lib/branding'
import { withRoot } from '../lib/site-root'
import { buildTarget, defaultVersionFor } from '../lib/versions'
import PortLinks from './PortLinks.astro'
import DocumentationHero from './DocumentationHero.astro'
import { hasReference, PORT_BY_SLUG, portPageUrl, type Port } from '../lib/ports'

/**
 * The banner atop one port's home page (/py/, /rs/, ...) — this port's
 * name and package, and where its API reference actually lives.
 *
 * That last part is the reason this is its own component rather than inline
 * markup: both `/go/` and `/go/stable/` render it, so the hand-off is stated
 * once.
 *
 * It used to carry the reference hand-off itself, and said that Rust, Go and
 * Java had no reference of ours to link to. That was true when written and is
 * not now — this site extracts a reference for all eight ports — so the
 * hand-off moved to `ApiReferences.astro`, which offers ours and the
 * ecosystem host as two cards rather than choosing between them.
 *
 * What stays here is the one state that is not a link: a port wired up with
 * nothing published. A reader should see that before clicking rather than
 * discover it as a dead link.
 */
interface Props {
  port: Port
}

const { port } = Astro.props as Props
const brand = branding(port.slug)
const { version } = buildTarget(process.env)
const revision = process.env.LIBTMUX_DOCS_PORT === port.slug ? process.env.LIBTMUX_DOCS_SOURCE_SHA : undefined
---

<DocumentationHero name={port.name} tagline={`Drive a real tmux from ${port.language}.`} logo={withRoot(brand.asset('logo.svg'))}>
  {port.parentLibrary && <p class="mt-3 text-sm">
    Built on the <a class="underline" href={portPageUrl(PORT_BY_SLUG[port.parentLibrary.slug], defaultVersionFor(port.parentLibrary.slug))}>{PORT_BY_SLUG[port.parentLibrary.slug].name} library</a>
    {' '}for {port.parentLibrary.runtime}. The packages share their source repository and releases.
  </p>}
  <p class="mt-3 font-mono text-sm opacity-70">{port.packageName}</p>

  {/*
    Where the package and the code actually are. The hero named the package
    and then offered no way to reach it — the repository was only in the site
    footer, pointing at the organisation rather than at this language, and the
    registry was nowhere.
  */}
  <PortLinks port={port} version={version} revision={revision} class="mt-3" />

  {
    hasReference(port) ? null : (
      <aside class="port-hero__notice">
        <p class="font-semibold">The {port.name} reference is not published yet</p>
        <p class="mt-2 opacity-90">
          It is generated with {port.generator}, which is wired into the
          docs pipeline but has not produced a build to publish. This page
          will link straight to it once one lands.
        </p>
      </aside>
    )
  }
</DocumentationHero>

<style>
  .port-hero__notice {
    margin-top: 1.5rem;
    padding: 1rem;
    font-size: 0.875rem;
    border: 1px solid var(--color-background-border);
    border-radius: var(--radius-md, 0.375rem);
    background: var(--color-background-secondary);
  }
</style>
