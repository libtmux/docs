---
// This script runs immediately on page load to prevent flash of wrong theme
---

<script is:inline>
  // CRITICAL: This script must be inline and run immediately to prevent FOUC (Flash of Unstyled Content)
  // Using is:inline ensures it's not bundled/deferred and runs before first paint
  
  const COLOR_SCHEMES = ['light', 'dark', 'system'];

  // The route supplies the palette. Only the light/dark preference is saved.
  function readPreference(key) {
    try { return localStorage.getItem(key); } catch (_) { return null; }
  }
  function applyTheme() {
    const stored = readPreference('color-scheme') || document.documentElement.getAttribute('data-color-scheme');
    const colorScheme = COLOR_SCHEMES.includes(stored) ? stored : 'system';

    // Apply color scheme attribute for CSS targeting
    document.documentElement.setAttribute('data-color-scheme', colorScheme);
    
    // Apply color scheme mode
    if (colorScheme === 'system') {
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme-mode', systemPrefersDark ? 'dark' : 'light');
    } else {
      document.documentElement.setAttribute('data-theme-mode', colorScheme);
    }
  }
  
  /**
   * The language the package picker is showing, resolved here in <head>.
   *
   * The picker used to fix itself from a script beside its own markup. That
   * is late: under a throttled CPU the widget painted twice before settling,
   * once with no saved value applied at all and once with the panel switched
   * but the tab still highlighting the server-rendered default. Both are
   * frames a reader sees.
   *
   * Resolved before any body markup is parsed, it is a value the first paint
   * already has. The CSS in PackageInstall.astro keys off this attribute, so
   * the correct tab and panel are painted rather than repainted — the same
   * shape as the theme above, and as gp-sphinx's own no-flicker gate.
   *
   * A widget that does not carry the saved port ignores it (see
   * `data-ports`), which is why this can be a single document-level value
   * even though a page may hold pickers with different subsets.
   */
  function applyPackagePort() {
    const port = localStorage.getItem('libtmux-docs.package-install.port');
    if (port && /^[a-z]+$/.test(port)) {
      document.documentElement.setAttribute('data-pkg-port', port);
    }
    // And each port's package manager, one level down. Without this a panel
    // painted its first manager, npm, and the widget's script switched it to
    // the saved one, bun, a frame later. `picker-paint.ts` keys its rules on
    // these attributes.
    const prefix = 'libtmux-docs.package-install.manager.';
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (!key || !key.startsWith(prefix)) continue;
      const slug = key.slice(prefix.length);
      const index = localStorage.getItem(key);
      if (/^[a-z]+(?:-[a-z]+)?$/.test(slug) && index && /^\d+$/.test(index)) {
        document.documentElement.setAttribute(`data-pkg-manager-${slug}`, index);
      }
    }
  }

  /**
   * Whether the prerelease bar has been dismissed, resolved in <head>.
   *
   * Same reason as the picker above: read beside the bar's own markup, a
   * reader who dismissed it last visit would watch it paint and vanish. Read
   * here it is an attribute the first paint already carries, and `global.css`
   * keys the bar's `display` off it, so the bar is never drawn at all.
   */
  /**
   * The reader's dependency cooldown, resolved before first paint.
   *
   * The package pickers show one variant of each command per cooldown mode
   * and key which on these attributes; set here, a saved cooldown paints the
   * right command at once rather than swapping when the widget script runs.
   * The MCP picker's own head snippet sets the same attributes on its pages.
   */
  function applyCooldown() {
    const prefix = 'libtmux-docs.mcp-install.cooldown.';
    const enabled = localStorage.getItem(prefix + 'enabled');
    if (enabled !== '1' && enabled !== '0') return;
    const root = document.documentElement;
    root.setAttribute('data-mcp-install-cooldown-enabled', enabled);
    root.setAttribute('data-mcp-install-cooldown-type', localStorage.getItem(prefix + 'type') === 'bypass' ? 'bypass' : 'days');
  }

  function applyPrereleaseNotice() {
    if (localStorage.getItem('libtmux-docs.prerelease-notice') === 'dismissed') {
      document.documentElement.setAttribute('data-prerelease', 'dismissed');
    }
  }

  const apiSourceKey = 'libtmux-docs.api-source-details';
  const apiSourceStates = new WeakMap();
  function initApiSourceDetails(root) {
    let open = true;
    try { open = localStorage.getItem(apiSourceKey) !== 'closed'; } catch (_) {}
    for (const details of root.querySelectorAll('details.api-source-details')) {
      details.open = open;
      apiSourceStates.set(details, open);
    }
  }
  window.__initApiSourceDetails = initApiSourceDetails;
  document.addEventListener('toggle', (event) => {
    const details = event.target;
    if (!apiSourceStates.has(details) || apiSourceStates.get(details) === details.open) return;
    apiSourceStates.set(details, details.open);
    try { localStorage.setItem(apiSourceKey, details.open ? 'open' : 'closed'); } catch (_) {}
  }, true);
  // Set native disclosure state before a client-routed page reaches the DOM.
  document.addEventListener('astro:before-swap', (event) => initApiSourceDetails(event.newDocument));
  window.addEventListener('storage', (event) => {
    if (event.key === apiSourceKey || event.key === null) initApiSourceDetails(document);
  });

  /**
   * Hold the page until the real faces are in, then show it once.
   *
   * `font-display: block` is not enough on its own, and the reason is the
   * font stack rather than the descriptor. Astro's `optimizedFallbacks`
   * appends a metric-matched family backed by `local("Courier New")` with
   * `font-display: swap`, so while IBM Plex Mono is still in its block
   * period the browser has a perfectly good next family to draw with — and
   * it does. Captured with the fonts delayed 1.2s, the wordmark paints in
   * Courier at 300ms and becomes Plex when the woff2 lands. That swap is
   * what "the Mono fonts load delayed" is.
   *
   * So the page is gated instead: hidden until `document.fonts.ready`, which
   * resolves when every face the document uses has loaded or failed. With all
   * twenty faces preloaded beside the critical CSS, that is a short wait, and
   * what follows it is one paint in the right type rather than two.
   *
   * The timeout is the part that matters for safety. A font that never
   * arrives must not leave a blank page, so the gate lifts after 3s
   * regardless — the same ceiling `font-display: block` uses before it gives
   * up and swaps.
   *
   * No-JS readers never get the class, so they never get the gate.
   */
  function gateOnFonts() {
    const root = document.documentElement;
    if (!document.fonts) return;
    root.classList.add('fonts-pending');
    const show = () => root.classList.remove('fonts-pending');
    setTimeout(show, 3000);

    // Waited for *after* parsing, not here. `document.fonts.ready` reports on
    // the loads the document currently has pending, and in <head> it has
    // none — the stylesheet naming the faces has not been read yet. Asking
    // now resolves it immediately and lifts the gate before a single font is
    // requested, which is what the first version of this did: the class was
    // gone by 400ms with the woff2 still 1.1s away.
    const wait = () => document.fonts.ready.then(show).catch(show);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wait);
    } else {
      wait();
    }
  }

  // Apply theme immediately on load
  applyTheme();
  try { applyPackagePort(); applyCooldown(); applyPrereleaseNotice(); } catch (_) { /* Storage may be disabled. */ }
  gateOnFonts();

  // Expose for the bundled astro:after-swap handler below so the logic isn't
  // duplicated (inline scripts can't be imported from).
  window.__applyTheme = applyTheme;
  window.__applyPackagePort = applyPackagePort;
  window.__applyCooldown = applyCooldown;
  window.__applyPrereleaseNotice = applyPrereleaseNotice;

  // Listen for system preference changes
  const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
  mediaQuery.addEventListener('change', (e) => {
    // Absent counts as `system`, which is what `applyTheme` above decides for
    // the first paint. Requiring the literal string meant a reader who had
    // never touched the control — everyone, on a first visit — kept whichever
    // scheme the page opened in when they changed their OS setting, while a
    // reader who had chosen `system` explicitly tracked it correctly.
    const stored = document.documentElement.getAttribute('data-color-scheme');
    if (!stored || stored === 'system') {
      document.documentElement.setAttribute('data-theme-mode', e.matches ? 'dark' : 'light');
    }
  });
</script>

<script>
  // Carry the current choice when storage is blocked, then resolve saved
  // preferences against the new page's attributes before its first paint.
  document.addEventListener('astro:before-swap', (event) => {
    event.newDocument.documentElement.setAttribute('data-color-scheme', document.documentElement.getAttribute('data-color-scheme') ?? 'system')
  })
  document.addEventListener('astro:after-swap', () => {
    window.__applyTheme?.()
    try {
      window.__applyPackagePort?.()
      window.__applyCooldown?.()
      window.__applyPrereleaseNotice?.()
    } catch { /* Storage may be disabled. */ }
  })
</script>
