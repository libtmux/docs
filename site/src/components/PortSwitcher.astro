---
import { PORTS, portHomeUrl } from '../lib/ports'
import { withPortRoot } from '../lib/site-root'

interface Props {
  portSlug?: string
  version: string
}
const { portSlug, version } = Astro.props as Props
const tmuxActive = /\/tmux\/[^/]+\/reference(?:\/|$)/.test(Astro.url.pathname)

const PORT_DEFAULTS: Record<string, string> = (() => {
  try {
    return JSON.parse(process.env.LIBTMUX_DOCS_PORT_DEFAULTS || '{}')
  } catch {
    return {}
  }
})()
const defaultFor = (slug: string) => PORT_DEFAULTS[slug] ?? 'latest'
---

<nav aria-label="Documentation destinations" class="flex flex-wrap gap-1">
  <a
    href={withPortRoot('/tmux/latest/reference/')}
    class="topnav-chip rounded px-2 py-1 text-sm transition-colors"
    aria-label="tmux CLI reference"
    aria-current={tmuxActive ? 'page' : undefined}
  >tmux</a>
  {
    PORTS.map((p) => {
      const active = p.slug === portSlug
      return (
        <a
          href={portHomeUrl(p, active ? version : defaultFor(p.slug))}
          class:list={[
            'rounded px-2 py-1 text-sm transition-colors',
            'topnav-chip',
          ]}
          aria-label={p.name}
          title={p.name}
          aria-current={active ? 'page' : undefined}
        >
          <span class="port-name">{p.name}</span>
          <span class="port-abbreviation" aria-hidden="true">{p.shortName}</span>
        </a>
      )
    })
  }
</nav>
