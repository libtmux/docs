---
import type { ApiSymbol, SymbolIndex } from '@libtmux/api-model'
import ApiDoc from './ApiDoc.astro'
import ApiType from './ApiType.astro'

interface Props {
  owner: ApiSymbol
  members: ApiSymbol[]
  index: SymbolIndex
  hrefFor: (symbol: ApiSymbol) => string
  /** `fields` swaps the Value column for a linked Type column. */
  columns?: 'value' | 'fields'
}
const { owner, members, index, hrefFor, columns = 'value' } = Astro.props
const fields = columns === 'fields'
---
<table class="api-scalar-members">
  <caption class="sr-only">{owner.name} {fields ? 'fields' : 'constant object properties'}</caption>
  <thead><tr><th scope="col">Name</th><th scope="col">{fields ? 'Type' : 'Value'}</th><th scope="col">Description</th></tr></thead>
  <tbody>
    {members.map((member) => <tr id={`member-${member.publicId ?? member.id}`}>
      <th scope="row"><a class="api-member-link" href={hrefFor(member)}>{member.name}</a></th>
      <td>{fields ? <code class="api-literal"><ApiType type={member.type!} index={index} context={member} /></code> : <code class="api-literal">{member.value}</code>}</td>
      <td>{member.doc?.summary && <ApiDoc text={member.doc.summary} index={index} context={member} citations={false} />}</td>
    </tr>)}
  </tbody>
</table>
