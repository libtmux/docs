---
import type { ApiSymbol, SymbolIndex } from '@libtmux/api-model'
import type { VariantPayload } from '../../lib/api-sections'
import ApiDoc from './ApiDoc.astro'
import ApiType from './ApiType.astro'

interface Props {
  owner: ApiSymbol
  members: ApiSymbol[]
  index: SymbolIndex
  hrefFor: (symbol: ApiSymbol) => string
  /** `fields` swaps the Value column for a linked Type column, `variants` for the Payload a variant carries. */
  columns?: 'value' | 'fields' | 'variants'
  /** The heading's word for the `fields` and `variants` rows, in the port's language. */
  label?: string
  /** What each variant carries by variant id, see `variantPayloads`. */
  payloads?: ReadonlyMap<string, VariantPayload>
  /** A page of its own, or an entry on this page, draws each member's types in full, so these are second drawings. */
  repeated?: boolean
}
const { owner, members, index, hrefFor, columns = 'value', label = 'Fields', payloads, repeated = false } = Astro.props
const fields = columns === 'fields'
const variants = columns === 'variants'
const heads = variants ? ['Case', 'Payload'] : ['Name', fields ? 'Type' : 'Value']
---
<div class="api-scalar-box">
<table class="api-scalar-members table">
  <caption class="sr-only">{owner.name} {fields || variants ? label.toLowerCase() : 'constant object properties'}</caption>
  <thead><tr><th scope="col">{heads[0]}</th><th scope="col">{heads[1]}</th><th scope="col">Description</th></tr></thead>
  <tbody>
    {members.map((member) => {
      const payload = variants ? payloads?.get(member.id) : undefined
      return <tr id={`member-${member.publicId ?? member.id}`}>
        <th scope="row"><a class="api-member-link" href={hrefFor(member)}>{member.name}</a></th>
        <td class={payload?.kind === 'none' ? 'api-payload-none' : undefined}>{variants
          ? payload?.kind === 'fields' ? <code class="api-literal"><span class="api-punct" data-api-role="syntax">{payload.open}</span>{payload.fields.map((field, position) => <>{position > 0 && <span class="api-punct" data-api-role="syntax">, </span>}{payload.named && <>{field.name}<span class="api-punct" data-api-role="syntax">: </span></>}<ApiType type={field.type!} index={index} context={field} repeated={repeated} /></>)}<span class="api-punct" data-api-role="syntax">{payload.close}</span></code>
            : payload?.kind === 'none' ? <span class="sr-only">{payload.label}</span>
            : payload?.kind === 'unknown' ? <span class="api-payload-unknown">{payload.label}</span> : undefined
          : fields ? <code class="api-literal"><ApiType type={member.type!} index={index} context={member} repeated={repeated} /></code> : <code class="api-literal">{member.value}</code>}</td>
        <td>{member.doc?.summary && <ApiDoc text={member.doc.summary} index={index} context={member} citations={false} />}</td>
      </tr>
    })}
  </tbody>
</table>
</div>
