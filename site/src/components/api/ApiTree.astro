---
/**
 * The reference's left column: the port's documentation menu, folded, and the
 * symbol tree as its own scroll area.
 *
 * The page renders its own branch open, every other bucket closed, and the
 * types with members closed over nothing: their children arrive from
 * `tree.json` the first time a reader opens one. So the markup a page carries
 * stays its own branch rather than twelve thousand symbols, and every bucket
 * still opens in place. A list longer than a window keeps the rows around the
 * page and folds the rest into "N more" rows, which open like any other branch.
 *
 * Desktop: a sticky column whose tree scrolls on its own, opened at the page
 * being read before first paint. Phone: the same markup as a drawer docked on
 * the left, as Microsoft Learn's table of contents is, rather than two screens
 * of links above the title. Without JavaScript it stays an inline column, and
 * every closed row is still a link; a folded "N more" row leads to the first
 * page it holds.
 */
import ApiTreeItems, { type TreeNode } from './ApiTreeItems.astro'
import ApiBadge from './ApiBadge.astro'
import { bucketTotal, firstEntry, type TreeBucket } from '../../lib/api-tree'
import { apiTreeHref, type ApiTreeJson } from '../../lib/api-search'
import { SIDEBAR_PRESENTATIONS, sidebarCatalog, sidebarNodes, quietSidebarKinds, type SidebarPresentation } from '../../lib/api-sidebar'
import { initializeApiTree } from './api-tree-state'
import '../../styles/api-tree.css'

interface Props {
  /** A shared reference presentation, with the reader's saved choice applied on arrival. */
  presentation?: SidebarPresentation
  inventory?: ApiTreeJson
  /** Rows a reference supplies itself, such as a Sphinx global toctree; they replace the generated tree and its layouts. */
  navigation?: TreeNode[]
  inventorySrc?: string
  selectedSymbol?: string
  /** A containing preview supplies client selection through setApiSidebar. */
  controlled?: boolean
  referenceBase: string
  portName: string
  tree: TreeBucket[]
  hrefs?: Record<string, string>
  /** Top-level bucket holding the page. */
  currentRoot?: string
  /** Bucket holding the page's type, which may be a child of `currentRoot`. */
  currentBucket?: string
  /** Nav id of the type the page is about or is a member of. */
  currentTypeId?: string
  /** Nav id of the page's own symbol, when it is a type. */
  ownerNavId?: string
  /** Declaration id of the page's own symbol, when it is a member. */
  ownerId?: string
  members: { id: string; name: string; kind: string; href: string }[]
  /** Members for each owner on the current page's ancestry, opened on first paint. */
  ancestorMembers?: Map<string, Props['members']>
  /** Nav ids of the types that have members, which open into them. */
  withMembers: Set<string>
  currentPath: string
  version: string
  /** Protocol references reuse this browser with their own object vocabulary. */
  indexLabel?: string
  treeLabel?: string
  searchLabel?: string
  searchPlaceholder?: string
  filters?: { id: string; label: string; disabled?: boolean }[]
  currentIndex?: string
  glossaryHref?: string
  glossaryLabel?: string
  /**
   * Where a row shows its kind mark. The API tree keeps a fixed gutter of marks
   * so a reader can scan down it. A tree whose groups already name their kind
   * (MCP tools, prompts, resources) shows an inline mark only in a group that
   * mixes kinds, where it tells siblings apart; the kind stays on the row for
   * assistive technology either way.
   */
  marks?: 'gutter' | 'mixed'
}

const {
  presentation, inventory, navigation, inventorySrc, selectedSymbol = '', controlled = false,
  referenceBase, portName, tree, hrefs, currentRoot, currentBucket, currentTypeId, ownerNavId, ownerId,
  members, ancestorMembers, withMembers, currentPath, version,
  indexLabel = 'Reference overview', treeLabel = `${portName} API`,
  searchLabel = 'Find a type or member', searchPlaceholder = 'Find symbol',
  filters = [{ id: 'all', label: 'All' }, { id: 'types', label: 'Types' }, { id: 'members', label: 'Members' }],
  currentIndex,
  glossaryHref, glossaryLabel = 'API glossary', marks = 'gutter',
} = Astro.props as Props
// The port's own reference root. `withRoot` would give the locale root:
// Astro's `base` prefixes routes, not strings a component builds.
const base = referenceBase
const href = (entry: { id: string; slug: string }) => apiTreeHref(base, entry, hrefs)

let seq = 0
const nextId = () => `api-nav-${++seq}`

const symbolNode = (symbol: { id: string; name: string; kind: string; href: string; shortcut?: boolean }, level: number): TreeNode => {
  const current = !symbol.shortcut && (symbol.id === ownerNavId || symbol.id === ownerId)
  const children = ancestorMembers?.get(symbol.id) ?? (symbol.id === currentTypeId ? members : undefined)
  if (children?.length) {
    return {
      id: nextId(), label: symbol.name, kind: symbol.kind, href: symbol.href, shortcut: symbol.shortcut, level, current, expanded: true,
      lazy: `type:${symbol.id}`, children: children.map((member) => symbolNode(member, level + 1)),
    }
  }
  return {
    id: nextId(), label: symbol.name, kind: symbol.kind, href: symbol.href, shortcut: symbol.shortcut, level, current,
    ...(withMembers.has(symbol.id) ? { expanded: false, lazy: `type:${symbol.id}` } : {}),
  }
}

const bucketNode = (b: TreeBucket, level: number, child: boolean): TreeNode => {
  const target = firstEntry(b)
  const head = { id: nextId(), label: b.label, href: target ? href(target) : undefined, count: bucketTotal(b), level, lazy: `bucket:${b.id}`, current: currentIndex === b.id }
  if (head.count === 0) return { ...head, href: undefined, lazy: undefined, disabled: true }
  const open = child ? b.id === currentBucket : b.id === currentRoot
  if (!open) return { ...head, expanded: false, lazy: `bucket:${b.id}` }
  return {
    ...head,
    expanded: true,
    children: [...b.entries.map((t) => symbolNode({ ...t, href: href(t) }, level + 1)), ...b.children.map((c) => bucketNode(c, level + 1, true))],
  }
}

/**
 * The port index, as the tree's first row and a sibling of the buckets.
 *
 * Every other row is a bucket or a symbol, so the page that lists them all —
 * the one a reader lands on from the port picker — had no row of its own. A
 * leaf: the buckets below it are its contents, and no count, because the
 * page's own first line is the symbol total.
 */
const indexNode: TreeNode = {
  id: nextId(),
  label: indexLabel,
  href: base,
  level: 1,
  current: currentPath.replace(/\/?$/, '/') === base,
}

const glossaryNode: TreeNode[] = glossaryHref ? [{
  id: nextId(), label: glossaryLabel, href: glossaryHref, level: 1,
  current: currentPath.replace(/\/?$/, '/') === glossaryHref,
}] : []
const catalog = inventory ? sidebarCatalog(inventory) : undefined
const selectedOwner = catalog?.ownerOf(selectedSymbol)
const selectedParent = catalog?.symbols.get(catalog.parent.get(selectedSymbol) ?? '')
const ownerLabel = catalog?.ownerLabel ?? 'type'
const ownerPlural = catalog?.ownerPlural ?? 'types'
const nodes = navigation ? navigation : presentation && inventory ? sidebarNodes(inventory, base, presentation, selectedSymbol)
  : [...(indexLabel ? [indexNode] : []), ...glossaryNode, ...tree.map((b) => bucketNode(b, 1, false))]

if (marks === 'mixed') quietSidebarKinds(nodes)

/** The one Tab stop: the page's own row, or the first row on a page with none. */
const mark = (list: TreeNode[]): boolean =>
  list.some((n) => (n.current ? ((n.tab = true), true) : n.children ? mark(n.children) : false))
if (!mark(nodes)) {
  const first = nodes.find((node) => !node.section && !node.heading)
  if (first) first.tab = true
}
---

<!-- One element: the scripts sit inside the column, so the page's grid has the
     column and the text column as its only children. -->
<div class="api-nav-column">
  <script is:inline>
    // Before the tree is parsed, so the drawer's rules apply at first paint.
    // Without JavaScript the column stays inline and closed rows stay links.
    document.documentElement.setAttribute('data-api-nav', '')
  </script>
  <div class="api-nav-overlay" data-api-nav-overlay></div>
  <div id="api-nav" class="api-nav" data-src={inventorySrc ?? `${base}tree.json`} data-base={base} data-version={presentation ? `3:${version}` : version} data-marks={marks === 'mixed' ? 'mixed' : undefined}
    data-presentation={presentation} data-symbol={presentation ? selectedSymbol : undefined}
    data-controlled={controlled || undefined}
    data-state-scope={presentation === 'outline' ? presentation : presentation ? `${presentation}:${selectedOwner?.id ?? ''}` : undefined} aria-labelledby="api-nav-title">
    <div class="api-nav__head">
      <p class="api-nav__title" id="api-nav-title">{treeLabel}</p>
      <button type="button" class="api-nav__close" data-api-nav-close aria-label={`Close ${treeLabel} contents`}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="api-nav__search">
      <label for="api-symbol-search" class="sr-only">{searchLabel}</label>
      <div class="api-nav__search-field">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="6.75" cy="6.75" r="4.5" /><path d="m10.25 10.25 3.5 3.5" /></svg>
        <input id="api-symbol-search" type="search" autocomplete="off" placeholder={searchPlaceholder} aria-keyshortcuts="/" disabled />
        <kbd aria-hidden="true">/</kbd>
      </div>
      <div class="api-nav__filters" role="group" aria-label={`${treeLabel} search category`}>
        {filters.map((filter) => <button type="button" data-api-search-kind={filter.id} data-api-search-empty={filter.disabled || undefined} aria-pressed={filter.id === 'all' ? 'true' : 'false'} disabled>{filter.label}</button>)}
      </div>
    </div>
    {presentation && catalog && <div class="api-nav__presentation">
      <div class="api-nav__picker-row">
      <div class="api-nav__owner-picker" data-api-owner-picker>
        <button type="button" id="api-owner" class="api-nav__owner-field" disabled data-api-owner data-symbol={selectedOwner?.id}
          aria-expanded="false" aria-controls="api-owner-popup" aria-haspopup="listbox" aria-label={`Choose ${ownerLabel}`}>
          <span data-api-owner-mark>{selectedOwner && <ApiBadge label={selectedOwner.kind} variant="kind" value={selectedOwner.kind} compact />}</span>
          <span data-api-owner-label>{selectedOwner?.shortName ?? selectedOwner?.symbolName ?? `Choose ${ownerLabel}`}</span>
          <span class="api-nav__chevron" aria-hidden="true" />
        </button>
        <div id="api-owner-popup" class="api-nav__owner-popup" data-api-owner-popup hidden>
          <input class="api-nav__owner-search" data-api-owner-search role="combobox" aria-expanded="false" aria-controls="api-owner-options"
            aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder={`Filter ${ownerPlural}…`} aria-label={`Filter ${ownerPlural}`} />
          <div id="api-owner-options" role="listbox" aria-label={ownerPlural} tabindex="-1">

          </div>
          <p data-api-owner-empty role="status" hidden>No {ownerPlural} found.</p>
        </div>
      </div>
      <details class="api-nav__more" data-api-actions>
      <summary aria-label="Sidebar actions" title="Sidebar actions"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.5" /><circle cx="12" cy="12" r="1.5" /><circle cx="19" cy="12" r="1.5" /></svg></summary>
      <div class="api-nav__actions">
        <button type="button" data-api-owner-all hidden={presentation === 'outline'}>All {ownerPlural}</button>
        <button type="button" data-api-reveal aria-label="Reveal current" title="Reveal current">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /><path d="M12 2v4m0 12v4M2 12h4m12 0h4" /></svg>
          <span>Reveal current</span>
        </button>
        <button type="button" data-api-collapse aria-label="Collapse all" title="Collapse all">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m8 4 4 4 4-4M8 20l4-4 4 4M5 12h14" /></svg>
          <span>Collapse all</span>
        </button>
        <div class="api-nav__layouts" role="radiogroup" aria-label="Sidebar layout">
          {SIDEBAR_PRESENTATIONS.map((mode) => <button type="button" role="radio" data-api-presentation={mode}
            aria-checked={mode === presentation ? 'true' : 'false'} tabindex={mode === presentation ? 0 : -1}>
            <span class="api-nav__choice" aria-hidden="true" />{mode[0].toUpperCase() + mode.slice(1)}
          </button>)}
        </div>
        <div class="api-nav__destinations" role="group" aria-label="Reference navigation">
          <a data-api-owner-back data-symbol={selectedParent?.id} hidden={!selectedParent && indexNode.current}
            href={selectedParent ? apiTreeHref(base, selectedParent, inventory?.hrefs) : base} target={controlled ? '_top' : undefined}
            aria-label={selectedParent ? `Up to ${selectedParent.name}` : 'Up to reference root'}
            title={selectedParent ? `Up to ${selectedParent.name}` : 'Up to reference root'}>
            <span>Up</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 10 5-5 5 5M12 5v14" /></svg>
          </a>
          <a data-api-root href={base} target={controlled ? '_top' : undefined} aria-current={indexNode.current ? 'page' : undefined} title="Reference root">
            <span>Root</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 5h14M12 19V9m-4 4 4-4 4 4" /></svg>
          </a>
        </div>
      </div>
      </details>
      </div>
    </div>}
    {presentation && glossaryHref && <a class="api-nav__reference-link" href={glossaryHref}
      aria-current={currentPath.replace(/\/?$/, '/') === glossaryHref ? 'page' : undefined}
      target={controlled ? '_top' : undefined}>{glossaryLabel}</a>}
    <nav class="api-nav__nav" aria-label={treeLabel} data-pagefind-ignore="all">
      <p class="api-nav__search-status" role="status" data-api-search-status></p>
      <button type="button" class="api-nav__retry" data-api-search-retry hidden>Retry search</button>
      <ul class="api-nav__results" data-api-search-results hidden></ul>
      <ul class="api-nav__tree" role="tree" aria-label={treeLabel}>
        <ApiTreeItems nodes={nodes} />
      </ul>
    </nav>
  </div>
  <noscript><style>.api-nav__search, .api-nav__item[data-lazy^='more:'] > .api-nav__row > span.api-nav__label { display: none; }</style></noscript>
  <script is:inline data-astro-rerun set:html={`((nav) => (${initializeApiTree.toString()})(nav, !nav.dataset.apiTreeInitialized))(document.currentScript.closest('.api-nav-column').querySelector('.api-nav'));`} />
  <script>
    import { initApiTree, saveApiTreeState } from './api-tree'

    initApiTree()
    document.addEventListener('astro:before-swap', saveApiTreeState)
    document.addEventListener('astro:after-swap', initApiTree)
    window.addEventListener('pagehide', saveApiTreeState)
  </script>
</div>
