---
import type { ApiSymbol, SymbolIndex } from '@libtmux/api-model'
import { Code } from 'astro-expressive-code/components'
import { parseApiProse, type ProseBlock, type ProseItem } from '../../lib/api-prose'
import { codeLang } from '../../lib/highlight'
import { firstMention, type First } from '../../lib/mention-badge'
import ApiDoc from './ApiDoc.astro'

/** Normalized docstring blocks; inline spans still use the native API resolver. */
interface Props {
  text?: string
  items?: ProseItem[]
  index: SymbolIndex
  context?: ApiSymbol
  /** The mentions already marked in the entry; a docstring's paragraphs share them, so each name is marked once. */
  first?: First
}
const { text, items, index, context, first = firstMention() } = Astro.props as Props
const blocks: ProseBlock[] = items ? [{ kind: 'ul', items }] : parseApiProse(text ?? '')
const { self: ApiProse } = Astro
---

{
  blocks.map((block) => {
    const List = block.kind === 'ol' ? 'ol' : 'ul'
    return block.kind === 'code' ? (
      <div class="api-prose-code"><Code code={block.code} lang={codeLang(block.lang)} title="" /></div>
    ) : block.kind === 'rubric' ? (
      <p class="rubric">{block.text}</p>
    ) : block.kind === 'p' ? (
      <p>
        <ApiDoc text={block.text} index={index} context={context} first={first} />
      </p>
    ) : (
      <List start={block.kind === 'ol' ? block.start : undefined}>
        {block.items.map((item) => (
          <li>
            <ApiDoc text={item.text} index={index} context={context} first={first} />
            {item.children.length > 0 && (
              <ApiProse items={item.children} index={index} context={context} first={first} />
            )}
          </li>
        ))}
      </List>
    )
  })
}
