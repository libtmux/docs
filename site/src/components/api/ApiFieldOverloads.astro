---
interface Props { labels: string[]; targets?: Map<string, string> }
const { labels, targets } = Astro.props
---
{labels.length > 0 && (
  <span class="api-field-overloads">
    {/* A label is itself a call, so parentheses around it would double up. */}
    {' for '}{labels.map((label, i) => <>{i > 0 && '; '}{targets?.has(label)
      ? <a href={`#${targets.get(label)}`}><code>{label}</code></a>
      : <code>{label}</code>}</>)}
  </span>
)}
<style>
  .api-field-overloads { font-size: 0.875em; }
  .api-field-overloads code { white-space: normal; overflow-wrap: anywhere; }
</style>
