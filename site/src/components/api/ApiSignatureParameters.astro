---
import { parameterId, type ApiSymbol, type Signature, type SymbolIndex } from '@libtmux/api-model/reference'
import { signatureMultiline } from '../../lib/api-sections'
import type { PythonLayout } from '../../lib/python-code-layout'
import ApiType from './ApiType.astro'

interface Props {
  signature: Signature
  symbol: ApiSymbol
  index: SymbolIndex
  language?: string
  /**
   * An overload stub repeats a family of flags, each `= ...`, that its implementation and the Parameters list show one by one.
   * Where the layout puts a parameter on each line, a run of four or more of one type collapses to a single line.
   */
  summarise?: boolean
  /** A prepared layout fixes the line breaks, indentation and trailing comma. */
  layout?: PythonLayout
}
const { signature, symbol, index, language, layout, summarise = false } = Astro.props as Props
const multiline = layout ? layout.mode !== 'flat' : signatureMultiline(symbol, signature, language)
const explode = layout ? layout.mode === 'explode' : multiline
const lead = layout ? '    ' : '  '
const typeOf = (i: number, type?: string) => layout?.parameters[i]?.type ?? type
const indentType = (text: string) => multiline && !layout ? text.replaceAll('\n', '\n  ') : text

/** Runs of repeated stub flags: the first index of each run, and every index inside one. */
type Param = Signature['params'][number]
const RUN = 4
const repeated = (param: Param) => summarise && explode && param.default === '...' && param.type !== undefined
const runAt = new Map<number, Param[]>()
const skipped = new Set<number>()
for (let i = 0; i < signature.params.length;) {
  let end = i
  while (end < signature.params.length && repeated(signature.params[end]!) && signature.params[end]!.type === signature.params[i]!.type) end++
  if (end - i >= RUN) {
    runAt.set(i, signature.params.slice(i, end))
    for (let at = i; at < end; at++) skipped.add(at)
    i = end
  } else i++
}
const noun = (run: Param[]) => run[0]!.type === 'bool' ? (run.every((param) => param.keywordOnly) ? 'keyword flags' : 'flags') : 'parameters'
---
<span class:list={['api-signature-parameters', multiline && 'api-signature-parameters--multiline']}><span class="sig-paren">(</span>{multiline && '\n'}{layout?.mode === 'hug' && lead}{signature.params.map((param, i) => runAt.has(i) ? <Fragment>{lead}<span class="api-signature-summary">… {runAt.get(i)!.length} more {noun(runAt.get(i)!)}, all {param.type} = ... (listed under Parameters)</span>{'\n'}</Fragment> : skipped.has(i) ? null : <Fragment>{explode && lead}<span class="sig-param">{param.variadic && <span class="o">{param.variadic === 'keyword' ? '**' : language === 'ts' ? '...' : '*'}</span>}{i === 0 && !param.doc && (param.name === 'self' || (language === 'py' && param.name === 'cls')) ? <span class="n">{param.name}</span> : <a class="api-parameter-name" href={`#${encodeURIComponent(parameterId(symbol, param.name))}`}>{param.name}</a>}{param.optional && <span class="o">?</span>}{typeOf(i, param.type) && <Fragment><span class="p">: </span><ApiType type={indentType(typeOf(i, param.type)!)} index={index} context={symbol} signature={signature} /></Fragment>}{param.default !== undefined && <Fragment><span class="o"> = </span><span class="default_value">{indentType(param.default)}</span></Fragment>}</span>{(i < signature.params.length - 1 || (layout && explode)) && <span class="sig-paren">,</span>}{explode ? '\n' : i < signature.params.length - 1 ? ' ' : layout?.mode === 'hug' ? '\n' : ''}</Fragment>)}<span class="sig-paren">)</span></span>
