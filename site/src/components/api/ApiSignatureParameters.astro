---
import { parameterId, type ApiSymbol, type Signature, type SymbolIndex } from '@libtmux/api-model'
import { signatureMultiline } from '../../lib/api-sections'
import ApiType from './ApiType.astro'

interface Props {
  signature: Signature
  symbol: ApiSymbol
  index: SymbolIndex
  language?: string
}
const { signature, symbol, index, language } = Astro.props as Props
const multiline = signatureMultiline(symbol, signature, language)
const indentType = (text: string) => multiline ? text.replaceAll('\n', '\n  ') : text
---
<span class:list={['api-signature-parameters', multiline && 'api-signature-parameters--multiline']}><span class="sig-paren">(</span>{multiline && '\n'}{signature.params.map((param, i) => <Fragment>{multiline && '  '}<span class="sig-param">{param.variadic && <span class="o">{param.variadic === 'keyword' ? '**' : language === 'ts' ? '...' : '*'}</span>}{(param.doc || language === 'ts') ? <a class="api-parameter-name" href={`#${encodeURIComponent(parameterId(symbol, param.name))}`}>{param.name}</a> : <span class="n">{param.name}</span>}{param.optional && <span class="o">?</span>}{param.type && <Fragment><span class="p">: </span><ApiType type={indentType(param.type)} index={index} context={symbol} signature={signature} /></Fragment>}{param.default !== undefined && <Fragment><span class="o"> = </span><span class="default_value">{indentType(param.default)}</span></Fragment>}</span>{i < signature.params.length - 1 && <span class="sig-paren">,</span>}{multiline ? '\n' : i < signature.params.length - 1 ? ' ' : ''}</Fragment>)}<span class="sig-paren">)</span></span>
