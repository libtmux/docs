---
import { API_GLOSSARY_DESCRIPTION, API_GLOSSARY_GROUPS, API_GLOSSARY_PATH, MCP_GLOSSARY_DESCRIPTION, MCP_GLOSSARY_GROUPS } from '../../lib/api-glossary'
interface Props { mcp?: boolean; shared?: boolean }
const { mcp = false, shared = false } = Astro.props
const groups = mcp ? [...MCP_GLOSSARY_GROUPS, ...API_GLOSSARY_GROUPS] : [...API_GLOSSARY_GROUPS, ...(shared ? MCP_GLOSSARY_GROUPS : [])]
const jsonHref = `${API_GLOSSARY_PATH.slice(0, -1)}.json`
---
  <p>{mcp ? MCP_GLOSSARY_DESCRIPTION : API_GLOSSARY_DESCRIPTION} Select an annotation or full API badge to open its definition here.</p>
  <p>The signature and entry documentation describe the API’s behavior. A shared label does not imply identical calling conventions, storage, or runtime checks across languages.</p>
  {groups.map((group) => <section aria-labelledby={group.id}>
    <h2 id={group.id}>{group.title}</h2>
    <p>{group.description}</p>
    {group.terms.map((term) => <section aria-labelledby={term.id}>
      <h3 id={term.id}><code>{term.id}</code></h3>
      <p>{term.definition}</p>
      {term.detail && <p>{term.detail}</p>}
      <p>References: {term.references.map((reference, index) => <>
        {index > 0 && '; '}<a href={reference.url}>{reference.title}</a>
      </>)}.</p>
    </section>)}
  </section>)}
  <p><a href={jsonHref}>Glossary JSON</a></p>
