---
import type { ApiSection } from '../../lib/api-sections'
import ApiBadge from './ApiBadge.astro'
import SymbolName from './SymbolName.astro'

interface Props {
  sections: ApiSection[]
  related: { name: string; qualified?: boolean; identity: string; kind: string; href: string }[]
}
const { sections, related } = Astro.props as Props
---
<api-page-contents class="api-page-contents" data-pagefind-ignore="all">
  <aside aria-label="Reference page navigation">
    <nav aria-label="On this page">
      <h2>On this page</h2>
      <ul>
        {sections.map((section, i) => <li class:list={[section.nested && 'api-contents-nested']}>
          <a href={`#${section.id}`} data-api-section-link aria-current={i === 0 ? 'location' : undefined}>{section.label}</a>
        </li>)}
      </ul>
    </nav>
    {related.length > 0 && <nav class="api-related" aria-label="Related APIs">
      <h2>Related APIs</h2>
      <ul>{related.map((symbol) => <li>
        <a href={symbol.href} title={symbol.identity} aria-label={symbol.identity}>
          <ApiBadge label={symbol.kind} variant="kind" value={symbol.kind} compact /><code>{symbol.qualified ? <SymbolName name={symbol.name} /> : symbol.name}</code>
        </a>
      </li>)}</ul>
    </nav>}
  </aside>
</api-page-contents>
<script is:inline data-astro-rerun>
(() => {
  class ApiPageContents extends HTMLElement {
    controller
    observer
    resetMembers
    frame = 0
    arrivalFrame = 0

    connectedCallback() {
      this.controller = new AbortController()
      const { signal } = this.controller
      const layout = this.closest('.api-reference-layout')
      const header = document.querySelector('.site-header')
      const row = layout?.querySelector('.api-section-links')
      const root = document.documentElement
      const members = layout?.querySelector('.api-members')
      const memberHeading = members?.querySelector(':scope > h2')
      const groups = [...(members?.querySelectorAll(':scope > .api-member-group') ?? [])]
      const groupHeadings = groups.flatMap((group) => {
        const heading = group.querySelector(':scope > h3')
        return heading ? [{ group, heading, height: 0 }] : []
      })
      let memberHeight = 0
      let stickyMembers = false
      const setLength = (element, name, value) => element?.style.setProperty(name, `${value}px`)
      const boundary = (target) => target === memberHeading ? members
        : groupHeadings.find(({ heading }) => heading === target)?.group ?? target
      const topFor = (target) => boundary(target).getBoundingClientRect().top
      const readingTopFor = (target, readingTop) => {
        if (!stickyMembers || !target || !members?.contains(target) || target === memberHeading) return readingTop
        const group = groupHeadings.find((entry) => entry.group.contains(target))
        return readingTop + memberHeight + (group && target !== group.heading ? group.height : 0)
      }
      const stickyHeadings = [memberHeading, ...groupHeadings.map(({ heading }) => heading)].filter(Boolean)
      let arriving
      const endArrival = () => {
        cancelAnimationFrame(this.arrivalFrame)
        arriving?.removeAttribute('data-api-arriving')
        arriving = undefined
      }
      // The browser and the anchor handler align a sticky heading where it is stuck, which for a group
      // above the viewport is the end of its box. The target stays in flow while they scroll, so they
      // align its source box. Frames end the hold, and every navigation signal restarts it, because
      // some browsers update the URL after a frame.
      const settleArrival = () => {
        cancelAnimationFrame(this.arrivalFrame)
        this.arrivalFrame = requestAnimationFrame(() => {
          this.arrivalFrame = requestAnimationFrame(() => { endArrival(); update() })
        })
      }
      const beginArrival = (fragment) => {
        const heading = stickyMembers ? stickyHeadings.find((candidate) => candidate.id === fragment) : undefined
        if (!heading) return
        if (arriving !== heading) {
          endArrival()
          heading.setAttribute('data-api-arriving', '')
          arriving = heading
        }
        settleArrival()
      }
      const measureMembers = (readingTop) => {
        if (!memberHeading || !members) return
        memberHeight = Math.ceil(memberHeading.getBoundingClientRect().height)
        for (const entry of groupHeadings) entry.height = Math.ceil(entry.heading.getBoundingClientRect().height)
        const groupHeight = Math.max(0, ...groupHeadings.map((entry) => entry.height))
        const fontSize = Number.parseFloat(getComputedStyle(root).fontSize) || 16
        // Keep a reading area beside the stacked bars, scaled to text size and viewport.
        stickyMembers = memberHeight > 0 &&
          innerHeight - readingTop - memberHeight - groupHeight >= Math.max(fontSize * 6, innerHeight / 3)
        members.toggleAttribute('data-api-sticky-members', stickyMembers)
        setLength(members, '--api-member-heading-height', memberHeight)
        const last = groupHeadings.at(-1)
        // Release the owner and final group bars together before their content ends.
        const release = last ? Math.min(0, last.group.getBoundingClientRect().bottom - readingTop - memberHeight - last.height) : 0
        setLength(members, '--api-member-heading-top', readingTop + release)
        const ownerBounds = memberHeading.getBoundingClientRect()
        setLength(members, '--api-member-heading-clip', Math.min(memberHeight, Math.max(0, readingTop - ownerBounds.top)))
        let groupStuck = false
        for (const entry of groupHeadings) {
          setLength(entry.group, '--api-group-heading-height', entry.height)
          setLength(entry.group, '--api-group-heading-top', readingTop + memberHeight + release)
          const bounds = entry.heading.getBoundingClientRect()
          setLength(entry.group, '--api-group-heading-clip', Math.min(entry.height, Math.max(0, Math.max(readingTop, ownerBounds.bottom) - bounds.top)))
          // A group bar resting against the owner bar joins it: one rule between them, square corners where they meet.
          const stuck = stickyMembers && Math.abs(bounds.top - ownerBounds.bottom) < 1
          entry.heading.toggleAttribute('data-api-stuck', stuck)
          groupStuck ||= stuck
        }
        memberHeading.toggleAttribute('data-api-joined', groupStuck)
      }
      this.resetMembers = () => {
        endArrival()
        members?.removeAttribute('data-api-sticky-members')
        memberHeading?.removeAttribute('data-api-joined')
        for (const entry of groupHeadings) entry.heading.removeAttribute('data-api-stuck')
        for (const name of ['height', 'top', 'clip']) {
          members?.style.removeProperty(`--api-member-heading-${name}`)
          for (const entry of groupHeadings) entry.group.style.removeProperty(`--api-group-heading-${name}`)
        }
      }
      let previousReadingTop
      let previousSection
      let previousWidth
      let previousArrival
      let requestedFragment
      const measure = () => {
        const headerHeight = Math.ceil(header?.getBoundingClientRect().height ?? 0)
        const rowHeight = Math.ceil(row?.getBoundingClientRect().height ?? 0)
        root.style.setProperty('--api-header-height', `${headerHeight}px`)
        root.style.setProperty('--api-sections-height', `${rowHeight}px`)
        root.setAttribute('data-api-sections-measured', '')
        return headerHeight + rowHeight + (Number.parseFloat(getComputedStyle(root).fontSize) || 16) * 0.75
      }
      const decode = (hash) => { try { return decodeURIComponent(hash.slice(1)) } catch { return hash.slice(1) } }
      const update = (initial = false) => {
        const readingTop = measure()
        measureMembers(readingTop)
        const links = [...(layout?.querySelectorAll('[data-api-section-link]') ?? [])]
        const targets = [...new Set(links.map((link) => decode(link.hash)))]
          .map((id) => document.getElementById(id)).filter(Boolean)
          .sort((a, b) => topFor(a) - topFor(b))
        // A short page cannot scroll its final section up to the sticky header.
        // Keep an explicitly selected section active while it remains visible.
        const fragment = decode(location.hash)
        const destination = document.getElementById(fragment)
        const display = destination?.querySelector(':scope > :is(h1, h2, h3, h4, h5, h6)') ?? destination
        const arrivalTop = readingTopFor(display, readingTop)
        // Only a link activation is a request. The anchor handler and the browser own
        // startup arrival and history traversal, using the clearance measured here.
        const requested = requestedFragment === fragment
        // Some browsers update the URL after the next frame; keep the request until it arrives.
        if (requested) requestedFragment = undefined
        if (destination && requested && boundary(display) !== display && Math.abs(topFor(display) - arrivalTop) > 1) {
          // Sticky boxes can already be aligned while their section starts above the viewport.
          window.scrollBy({ top: topFor(display) - arrivalTop, behavior: 'instant' })
        } else if (previousReadingTop !== undefined && destination) {
          const top = topFor(display)
          const reflowed = arrivalTop !== previousReadingTop || innerWidth !== previousWidth
          const wasPinned = previousArrival?.id === fragment &&
            Math.abs(previousArrival.top - previousReadingTop) <= 1 &&
            Math.abs(window.scrollY - previousArrival.scrollY) <= 1
          // Preserve an anchor at the reading edge, not a hash the reader left behind.
          if ((reflowed && wasPinned && Math.abs(top - arrivalTop) > 1) ||
              (arrivalTop > previousReadingTop && top >= previousReadingTop - 1 && top < arrivalTop)) {
            window.scrollBy({ top: top - arrivalTop, behavior: 'instant' })
          }
        }
        previousArrival = display ? { id: fragment, top: topFor(display), scrollY: window.scrollY } : undefined
        previousReadingTop = arrivalTop
        previousWidth = innerWidth
        const selected = targets.findLast((target) => target.id === fragment ||
          (destination && boundary(target).contains(destination)) ||
          (target.id.endsWith('.parameters') && fragment.startsWith(target.id.replace(/\.parameters$/, '.parameter.'))))
        const selectedTop = selected ? topFor(selected) : -1
        const keepSelected = selected && (initial || (selectedTop >= readingTopFor(selected, readingTop) && selectedTop < innerHeight))
        const current = keepSelected ? selected
          : targets.findLast((target) => topFor(target) <= readingTopFor(target, readingTop) + 1) ?? targets[0]
        for (const link of links) {
          if (decode(link.hash) === current?.id) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        }
        if (current?.id !== previousSection && row && !row.contains(document.activeElement)) {
          const active = row.querySelector('[aria-current="location"]')
          if (active) {
            const bounds = row.getBoundingClientRect()
            const link = active.getBoundingClientRect()
            if (link.left < bounds.left) row.scrollLeft += link.left - bounds.left
            else if (link.right > bounds.right) row.scrollLeft += link.right - bounds.right
          }
        }
        previousSection = current?.id
      }
      const schedule = () => {
        cancelAnimationFrame(this.frame)
        this.frame = requestAnimationFrame(() => update())
      }
      window.addEventListener('scroll', schedule, { passive: true, signal })
      window.addEventListener('hashchange', () => {
        if (arriving) settleArrival()
        schedule()
      }, { signal })
      // Fragment navigations that no click in this layout started: a typed or scripted hash.
      window.navigation?.addEventListener('navigate', (event) => {
        if (!event.hashChange || event.navigationType === 'traverse' || !event.destination.sameDocument) return
        requestedFragment = decode(new URL(event.destination.url).hash)
        beginArrival(requestedFragment)
      }, { signal })
      layout?.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href]') : null
        if (!(link instanceof HTMLAnchorElement) || event.defaultPrevented || event.button !== 0 ||
            event.metaKey || event.ctrlKey || event.altKey || event.shiftKey || link.hasAttribute('download') ||
            (link.target && link.target !== '_self')) return
        const target = new URL(link.href, location.href)
        if (!target.hash || target.origin !== location.origin || target.pathname !== location.pathname || target.search !== location.search) return
        requestedFragment = decode(target.hash)
        beginArrival(requestedFragment)
        schedule()
      }, { signal })
      window.addEventListener('resize', schedule, { signal })
      this.observer = new ResizeObserver(schedule)
      if (header) this.observer.observe(header)
      if (row) this.observer.observe(row)
      if (members) this.observer.observe(members)
      if (memberHeading) this.observer.observe(memberHeading)
      for (const entry of groupHeadings) this.observer.observe(entry.heading)
      document.fonts?.ready.then(() => { if (!signal.aborted) schedule() })
      update(true)
    }

    disconnectedCallback() {
      this.controller?.abort()
      this.observer?.disconnect()
      cancelAnimationFrame(this.frame)
      this.resetMembers?.()
      document.documentElement.style.removeProperty('--api-header-height')
      document.documentElement.style.removeProperty('--api-sections-height')
      document.documentElement.removeAttribute('data-api-sections-measured')
    }
  }
  if (!customElements.get('api-page-contents')) customElements.define('api-page-contents', ApiPageContents)
})()
</script>
