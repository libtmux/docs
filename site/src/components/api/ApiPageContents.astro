---
import type { ApiSection } from '../../lib/api-sections'
import ApiBadge from './ApiBadge.astro'

interface Props {
  sections: ApiSection[]
  related: { name: string; identity: string; kind: string; href: string }[]
}
const { sections, related } = Astro.props as Props
---
<api-page-contents class="api-page-contents" data-pagefind-ignore="all">
  <aside aria-label="Reference page navigation">
    <nav aria-label="On this page">
      <h2>On this page</h2>
      <ul>
        {sections.map((section, i) => <li class:list={[section.nested && 'api-contents-nested']}>
          <a href={`#${section.id}`} data-api-section-link aria-current={i === 0 ? 'location' : undefined}>{section.label}</a>
        </li>)}
      </ul>
    </nav>
    {related.length > 0 && <nav class="api-related" aria-label="Related APIs">
      <h2>Related APIs</h2>
      <ul>{related.map((symbol) => <li>
        <a href={symbol.href} title={symbol.identity} aria-label={symbol.identity}>
          <ApiBadge label={symbol.kind} variant="kind" value={symbol.kind} compact /><code>{symbol.name}</code>
        </a>
      </li>)}</ul>
    </nav>}
  </aside>
</api-page-contents>
<script is:inline data-astro-rerun>
(() => {
  class ApiPageContents extends HTMLElement {
    controller
    frame = 0

    connectedCallback() {
      this.controller = new AbortController()
      const { signal } = this.controller
      const decode = (hash) => { try { return decodeURIComponent(hash.slice(1)) } catch { return hash.slice(1) } }
      const update = (initial = false) => {
        const links = [...document.querySelectorAll('[data-api-section-link]')]
        const targets = [...new Set(links.map((link) => decode(link.hash)))]
          .map((id) => document.getElementById(id)).filter(Boolean)
          .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)
        // A short page cannot scroll its final section up to the sticky header.
        // Keep an explicitly selected section active while it remains visible.
        const fragment = decode(location.hash)
        const destination = document.getElementById(fragment)
        const selected = targets.findLast((target) => target.id === fragment ||
          (destination && target.contains(destination)) ||
          (target.id.endsWith('.parameters') && fragment.startsWith(target.id.replace(/\.parameters$/, '.parameter.'))))
        const selectedTop = selected?.getBoundingClientRect().top ?? -1
        const keepSelected = selected && (initial || (selectedTop >= 112 && selectedTop < innerHeight))
        const current = keepSelected ? selected
          : targets.findLast((target) => target.getBoundingClientRect().top <= 144) ?? targets[0]
        for (const link of links) {
          if (decode(link.hash) === current?.id) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        }
      }
      const schedule = () => {
        cancelAnimationFrame(this.frame)
        this.frame = requestAnimationFrame(() => update())
      }
      window.addEventListener('scroll', schedule, { passive: true, signal })
      window.addEventListener('hashchange', schedule, { signal })
      window.addEventListener('resize', schedule, { signal })
      update(true)
    }

    disconnectedCallback() {
      this.controller?.abort()
      cancelAnimationFrame(this.frame)
    }
  }
  if (!customElements.get('api-page-contents')) customElements.define('api-page-contents', ApiPageContents)
})()
</script>
