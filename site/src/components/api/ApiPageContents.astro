---
import type { ApiSection } from '../../lib/api-sections'
import ApiBadge from './ApiBadge.astro'

interface Props {
  sections: ApiSection[]
  related: { name: string; identity: string; kind: string; href: string }[]
}
const { sections, related } = Astro.props as Props
---
<api-page-contents class="api-page-contents" data-pagefind-ignore="all">
  <aside aria-label="Reference page navigation">
    <nav aria-label="On this page">
      <h2>On this page</h2>
      <ul>
        {sections.map((section, i) => <li class:list={[section.nested && 'api-contents-nested']}>
          <a href={`#${section.id}`} data-api-section-link aria-current={i === 0 ? 'location' : undefined}>{section.label}</a>
        </li>)}
      </ul>
    </nav>
    {related.length > 0 && <nav class="api-related" aria-label="Related APIs">
      <h2>Related APIs</h2>
      <ul>{related.map((symbol) => <li>
        <a href={symbol.href} title={symbol.identity} aria-label={symbol.identity}>
          <ApiBadge label={symbol.kind} variant="kind" value={symbol.kind} compact /><code>{symbol.name}</code>
        </a>
      </li>)}</ul>
    </nav>}
  </aside>
</api-page-contents>
<script is:inline data-astro-rerun>
(() => {
  class ApiPageContents extends HTMLElement {
    controller
    observer
    frame = 0

    connectedCallback() {
      this.controller = new AbortController()
      const { signal } = this.controller
      const layout = this.closest('.api-reference-layout')
      const header = document.querySelector('.site-header')
      const row = layout?.querySelector('.api-section-links')
      const root = document.documentElement
      let previousReadingTop
      let previousSection
      const measure = () => {
        const headerHeight = Math.ceil(header?.getBoundingClientRect().height ?? 0)
        const rowHeight = Math.ceil(row?.getBoundingClientRect().height ?? 0)
        root.style.setProperty('--api-header-height', `${headerHeight}px`)
        root.style.setProperty('--api-sections-height', `${rowHeight}px`)
        root.setAttribute('data-api-sections-measured', '')
        return headerHeight + rowHeight + (Number.parseFloat(getComputedStyle(root).fontSize) || 16) * 0.75
      }
      const decode = (hash) => { try { return decodeURIComponent(hash.slice(1)) } catch { return hash.slice(1) } }
      const update = (initial = false) => {
        const readingTop = measure()
        const links = [...(layout?.querySelectorAll('[data-api-section-link]') ?? [])]
        const targets = [...new Set(links.map((link) => decode(link.hash)))]
          .map((id) => document.getElementById(id)).filter(Boolean)
          .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)
        // A short page cannot scroll its final section up to the sticky header.
        // Keep an explicitly selected section active while it remains visible.
        const fragment = decode(location.hash)
        const destination = document.getElementById(fragment)
        if (previousReadingTop !== undefined && readingTop > previousReadingTop && destination) {
          const display = destination.querySelector(':scope > :is(h1, h2, h3, h4, h5, h6)') ?? destination
          const top = display.getBoundingClientRect().top
          if (top >= previousReadingTop - 1 && top < readingTop) window.scrollBy({ top: top - readingTop, behavior: 'instant' })
        }
        previousReadingTop = readingTop
        const selected = targets.findLast((target) => target.id === fragment ||
          (destination && target.contains(destination)) ||
          (target.id.endsWith('.parameters') && fragment.startsWith(target.id.replace(/\.parameters$/, '.parameter.'))))
        const selectedTop = selected?.getBoundingClientRect().top ?? -1
        const keepSelected = selected && (initial || (selectedTop >= readingTop && selectedTop < innerHeight))
        const current = keepSelected ? selected
          : targets.findLast((target) => target.getBoundingClientRect().top <= readingTop + 1) ?? targets[0]
        for (const link of links) {
          if (decode(link.hash) === current?.id) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        }
        if (current?.id !== previousSection && row && !row.contains(document.activeElement)) {
          const active = row.querySelector('[aria-current="location"]')
          if (active) {
            const bounds = row.getBoundingClientRect()
            const link = active.getBoundingClientRect()
            if (link.left < bounds.left) row.scrollLeft += link.left - bounds.left
            else if (link.right > bounds.right) row.scrollLeft += link.right - bounds.right
          }
        }
        previousSection = current?.id
      }
      const schedule = () => {
        cancelAnimationFrame(this.frame)
        this.frame = requestAnimationFrame(() => update())
      }
      window.addEventListener('scroll', schedule, { passive: true, signal })
      window.addEventListener('hashchange', schedule, { signal })
      window.addEventListener('resize', schedule, { signal })
      this.observer = new ResizeObserver(schedule)
      if (header) this.observer.observe(header)
      if (row) this.observer.observe(row)
      document.fonts?.ready.then(() => { if (!signal.aborted) schedule() })
      update(true)
    }

    disconnectedCallback() {
      this.controller?.abort()
      this.observer?.disconnect()
      cancelAnimationFrame(this.frame)
      document.documentElement.style.removeProperty('--api-header-height')
      document.documentElement.style.removeProperty('--api-sections-height')
      document.documentElement.removeAttribute('data-api-sections-measured')
    }
  }
  if (!customElements.get('api-page-contents')) customElements.define('api-page-contents', ApiPageContents)
})()
</script>
