---
import { qualifiedNameOf, docSummaryText, sourceUrl, symbolsForProduct, type ApiModel, type ApiSymbol } from '@libtmux/api-model'
import DocsLayout from '../../layouts/DocsLayout.astro'
import ApiEntry from './ApiEntry.astro'
import ApiScalarMembers from './ApiScalarMembers.astro'
import ApiTmuxSections from './ApiTmuxSections.astro'
import { fieldCellType, memberTable, variantPayloads } from '../../lib/api-sections'
import { apiTmuxSections } from '../../lib/api-tmux-sections'
import { productApiAlternatives, productApiHref, productApiIndex } from '../../lib/product-api'
import { DOC_PRODUCTS, PORT_BY_SLUG, portPageUrl, productApiPath, type DocProduct } from '../../lib/ports'
import { symbolSource } from '../../lib/markdown-twins'
import '../../styles/api.css'
import '../../styles/vendor/gp-sphinx-api.css'
interface Props { model: ApiModel; symbol: ApiSymbol; version: string }
const { model, symbol, version } = Astro.props
const product = symbol.product as DocProduct
const hrefFor = (entry: ApiSymbol) => productApiHref(model, entry, version)
const index = productApiIndex(model, version)
const members = symbolsForProduct(model, product).filter((entry) => entry.parent === symbol.id)
// Where the port keeps a type's data in a table, its fields or an enum's variants lead as a summary of the entries below, in their order.
const table = memberTable(symbol, members, model.port)
const payloads = table?.columns === 'variants' ? variantPayloads(model.symbols, table.rows) : undefined
// A row draws the type its port keeps in a field's `type`, which for a Swift property is the declaration without its name.
const cellType = (member: ApiSymbol) => fieldCellType(member, model.port)
// Every member keeps its entry, so under a table the entries are the detail of its rows rather than a second list of the same members.
const membersHeading = table ? 'Member details' : 'Members'
const pagePath = `${productApiPath(product)}/${symbol.slug}`
const port = PORT_BY_SLUG[model.port]
const breadcrumbs = [
  { name: port.name, url: portPageUrl(port, version) },
  { name: DOC_PRODUCTS[product].label, url: portPageUrl(port, version, product) },
  { name: 'API reference', url: portPageUrl(port, version, productApiPath(product)) },
  { name: qualifiedNameOf(symbol), url: hrefFor(symbol), symbol: true },
]
let defaults: Record<string, string> = {}
try { defaults = JSON.parse(process.env.LIBTMUX_DOCS_PORT_DEFAULTS || '{}') } catch { /* Local defaults are latest. */ }
const alternativesFor = (entry: ApiSymbol) => productApiAlternatives(model, entry, version, defaults)
// The page's own symbol lists its links as sections; each member below keeps its compact rows.
const tmuxSections = apiTmuxSections(model.port, symbol, alternativesFor(symbol))
---

<DocsLayout title={qualifiedNameOf(symbol)} symbolTitle breadcrumbs={breadcrumbs} description={symbol.doc?.summary ? docSummaryText(symbol.doc.summary, model.port) : `${symbol.name} API documentation.`}
  inventoryId={`api:${symbol.publicId ?? symbol.id}`}
  port={model.port} product={product} version={version} pagePath={pagePath} tableOfContents={false}
  pageSource={symbolSource(model, symbol)} markdown="source">
  <div class="api-reference-content not-prose">
  {symbol.apiScope === 'supporting' && <p>This type appears in public signatures. It is not a package entry point.</p>}
  <ApiEntry symbol={symbol} index={index} port={model.port} alternativesFor={alternativesFor} heading linkRows={false} sourceUrl={(entry) => sourceUrl(model, entry)} />
  <ApiTmuxSections sections={tmuxSections} />
  {table && <div class="api-field-table mt-8">
    <h2 class="api-section-heading text-lg font-semibold" id={table.id}>{table.label}<span class="api-section-count">{table.rows.length}</span><a class="api-heading-link" href={`#${table.id}`} aria-label={`Link to ${table.label}`}>#</a></h2>
    <ApiScalarMembers owner={symbol} members={table.rows} index={index} hrefFor={hrefFor} columns={table.columns} label={table.label} payloads={payloads} repeated cellType={cellType} />
  </div>}
  {members.length > 0 && <div class="api-members mt-8">
    <h2 class="api-section-heading text-lg font-semibold" id="api-members">{membersHeading}<span class="api-section-count">{members.length}</span><a class="api-heading-link" href="#api-members" aria-label={`Link to ${membersHeading}`}>#</a></h2>
    {members.map((member) => <ApiEntry symbol={member} index={index} port={model.port} alternativesFor={alternativesFor} member nameHref={hrefFor(member)} sourceUrl={(entry) => sourceUrl(model, entry)} />)}
  </div>}
  </div>
</DocsLayout>

<script>
  import { crossHighlight } from '../../lib/cross-highlight'
  crossHighlight(document)
</script>
