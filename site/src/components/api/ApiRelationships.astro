---
import type { ApiModelBase, ApiSymbol } from '@libtmux/api-model'
import { qualifiedNameOf } from '@libtmux/api-model'
import type { ApiRelationshipPath, ApiRelationshipSection } from '../../lib/api-relationships'
import { apiCallSource } from '../../lib/api-relationships'
import ApiBadge from './ApiBadge.astro'

interface Props {
  owner?: ApiSymbol
  model?: ApiModelBase
  sections?: ApiRelationshipSection[]
  paths?: ApiRelationshipPath[]
  hrefFor: (symbol: ApiSymbol) => string
}
const { owner, model, sections = [], paths = [], hrefFor } = Astro.props
const callers = sections.find((section) => section.id === 'api-called-by')
const calls = sections.find((section) => section.id === 'api-calls')
const sides = [callers, calls]
const callSource = (section: ApiRelationshipSection, symbol: ApiSymbol) => !model || !owner ? undefined
  : section.id === 'api-calls' ? apiCallSource(model, owner, symbol)
    : section.id === 'api-called-by' ? apiCallSource(model, symbol, owner) : undefined
---

{owner && (callers || calls) && <section class="api-call-network mt-8" aria-labelledby="api-call-network">
  <h2 class="api-section-heading text-lg font-semibold" id="api-call-network">Call neighborhood<a class="api-heading-link" href="#api-call-network" aria-label="Link to Call neighborhood">#</a></h2>
  <p class="text-sm opacity-75">Recorded direct calls in this source version. Callback references appear separately below.</p>
  <div class="api-call-network__columns">
    {sides.map((side, i) => <>
      {i === 1 && <div class="api-call-network__current">
        <span class="api-call-network__arrow" aria-hidden="true">→</span>
        <a href={hrefFor(owner)} aria-current="page">{owner.name}</a>
        <span class="api-call-network__arrow" aria-hidden="true">→</span>
      </div>}
      <div class="api-call-network__side">
        <h3>{i === 0 ? 'Called by' : 'Calls'}</h3>
        {side ? <>
          <ul>{side.items.slice(0, 5).map((symbol) => <li><a href={hrefFor(symbol)} title={qualifiedNameOf(symbol)}>{symbol.name}</a></li>)}</ul>
          {side.items.length > 5 && <a class="api-call-network__more" href={`#${side.id}`}>All {side.items.length} {i === 0 ? 'callers' : 'calls'} ↓</a>}
        </> : <p class="text-sm opacity-70">None recorded</p>}
      </div>
    </>)}
  </div>
</section>}

{paths.length > 0 && <section class="api-source-paths mt-8" aria-labelledby="api-source-paths">
  <h2 class="api-section-heading text-lg font-semibold" id="api-source-paths">Paths through the source<a class="api-heading-link" href="#api-source-paths" aria-label="Link to Paths through the source">#</a></h2>
  <p class="text-sm opacity-75">Follow these functions to explore a task. Arrows show source relationships.</p>
  {paths.map((path) => <div class="api-source-path">
    <h3 class="text-sm font-semibold">{path.title}</h3>
    <ol>{path.symbols.map((symbol, i) => <li>
      {i > 0 && <span class="api-source-path__edge">{path.edges[i - 1] === 'call' ? 'calls' : 'references'} →</span>}
      <a href={hrefFor(symbol)} aria-current={owner?.id === symbol.id ? 'page' : undefined} title={qualifiedNameOf(symbol)}>{symbol.name}</a>
    </li>)}</ol>
  </div>)}
</section>}

{sections.map((section) => <section class="mt-8" aria-labelledby={section.id}>
  <h2 class="api-section-heading text-lg font-semibold" id={section.id}>{section.label}<a class="api-heading-link" href={`#${section.id}`} aria-label={`Link to ${section.label}`}>#</a></h2>
  <ul class="api-member-list mt-3">
    {section.items.map((symbol) => <li>
      <a class="api-member-link" href={hrefFor(symbol)}>{qualifiedNameOf(symbol)}</a>
      <span class="api-member-badges"><ApiBadge label={symbol.kind} variant="kind" value={symbol.kind} /></span>
      {callSource(section, symbol) && <a class="text-xs" href={callSource(section, symbol)}>Call site ↗</a>}
    </li>)}
  </ul>
</section>)}

<style>
  .api-call-network__columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: .75rem; margin-top: 1rem; }
  .api-call-network__side { min-width: 0; }
  .api-call-network__side h3 { font-size: .8rem; font-weight: 600; margin: 0 0 .5rem; }
  .api-call-network__side ul, .api-source-path ol { list-style: none; padding: 0; margin: 0; }
  .api-call-network__side li { margin: .4rem 0; }
  .api-call-network__side li a, .api-call-network__current a, .api-source-path li a { display: block; padding: .45rem .6rem; border: 1px solid var(--color-edge); border-radius: .35rem; font-family: var(--font-mono); font-size: .8rem; overflow-wrap: anywhere; text-decoration: none; }
  .api-call-network__current { display: flex; align-items: center; gap: .35rem; min-width: 0; }
  .api-call-network__current a, .api-source-path [aria-current="page"] { background: color-mix(in srgb, var(--theme-primary) 10%, transparent); font-weight: 600; }
  .api-call-network__current a { min-width: 0; }
  .api-call-network__more { font-size: .8rem; }
  .api-call-network a:focus-visible, .api-source-path a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .api-source-path { margin-top: 1rem; }
  .api-source-path h3 { margin-bottom: .4rem; }
  .api-source-path ol { display: flex; flex-wrap: wrap; gap: .5rem; }
  .api-source-path li { display: flex; align-items: center; gap: .5rem; min-width: 0; max-width: 100%; margin: 0; }
  .api-source-path li a { min-width: 0; }
  .api-source-path__edge { font-size: .75rem; flex-shrink: 0; }
  @media (max-width: 640px) {
    .api-call-network__columns { grid-template-columns: minmax(0, 1fr); }
    .api-call-network__current { flex-direction: column; }
    .api-call-network__arrow { rotate: 90deg; }
  }
</style>
