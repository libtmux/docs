---
import type { ApiModel, ApiSymbol, SourceApiModel, SymbolIndex } from '@libtmux/api-model'
import { aliasMembersTarget, membersOf, pageMembersOf, memberTier, docSummaryText, memberSignals, parameterId, qualifiedNameOf, moduleOf, modulesIn, sourceUrl as apiSourceUrl, symbolsForProduct } from '@libtmux/api-model'
import mentionsData from '../../data/mentions.json'
import ApiEntry from '../../components/api/ApiEntry.astro'
import ApiTmuxSections from './ApiTmuxSections.astro'
import { apiTmuxSections } from '../../lib/api-tmux-sections'
import ApiScalarMembers from './ApiScalarMembers.astro'
import ApiRelationships from './ApiRelationships.astro'
import { apiRelationshipSections, type ApiRelationshipPath } from '../../lib/api-relationships'
import ApiBadge from '../../components/api/ApiBadge.astro'
import ApiGlossaryContent from './ApiGlossaryContent.astro'
import { apiGlossary, apiGlossaryHeadings, API_GLOSSARY_TITLE, apiGlossaryHref } from '../../lib/api-glossary'
import ApiQualifiedName from '../../components/api/ApiQualifiedName.astro'
import ApiType from '../../components/api/ApiType.astro'
import ApiPageContents from '../../components/api/ApiPageContents.astro'
import { apiEntryFields, apiEntrySections, apiMemberGroups, apiMemberSections, fieldsLabel, fieldsRepeated, memberTable, memberTableColumns, relatedTypeLinks, variantPayloads, type ApiSection } from '../../lib/api-sections'
import PageToolbar from '../../components/PageToolbar.astro'
import PagePortSwitcher from '../../components/PagePortSwitcher.astro'
import DocumentationContext from '../../components/docs/DocumentationContext.astro'
import type { PagePortLink } from '../../lib/page-port-links'
import { pagePortsFor } from '../../lib/page-ports-for'
import { pageBreadcrumbs } from '../../lib/sidebar'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { apiInventoryIdentity } from '../../lib/inventory-targets'
import { withRoot } from '../../lib/site-root'
import { API_MODELS, API_NAV, PORT_NAME, indexFor, isMemberOwner, ownersOf, pageSlug, referenceAlternatives, topLevelTypesOf } from '../../lib/api-models'
import { PORT_BY_SLUG, referenceUrl } from '../../lib/ports'
import { productApiHref } from '../../lib/product-api'
import { nativeQualifiedName } from '../../lib/native-name'
import { symbolSource } from '../../lib/markdown-twins'
import { localeSourcePath } from '../../i18n/locales'
import { buildLocale } from '../../i18n/resolve'
import { buildTarget, defaultVersionFor } from '../../lib/versions'
import ApiDoc from '../../components/api/ApiDoc.astro'
import ApiTree from '../../components/api/ApiTree.astro'
import type { PortNavData } from '../../lib/api-models'
import { apiTreeVersion, bucketAncestors, bucketForSymbol, navTree, referenceTree, referenceTreeFor, referenceNavigation, referenceIndexSections, referenceIndexSectionsFor, type TreeBucket } from '../../lib/api-tree'
import { sidebarSelection } from '../../lib/api-sidebar'
import type { BreadcrumbItem } from '../../lib/sidebar'
import SymbolName from '../../components/api/SymbolName.astro'
import '../../styles/api.css'
import '../../styles/vendor/gp-sphinx-api.css'
import { tmuxManualUrl } from '../../lib/tmux-manual-data'
import type { ResolvedUsage } from '../../lib/tmux-reference'
import TmuxUsage from '../tmux/TmuxUsage.astro'

/** Source projects supply identity and navigation to the same API renderer. */
export interface SourceReferenceContext {
  model: SourceApiModel
  label: string
  title: string
  description: string
  version: string
  referenceBase: string
  pagePath: string
  breadcrumbs: BreadcrumbItem[]
  nav: PortNavData
  tree: TreeBucket[]
  index: SymbolIndex
  pagePorts: PagePortLink[]
  manualLinks?: { name: string; href: string }[]
  usage?: ResolvedUsage[]
  catalogLinks?: { name: string; href: string }[]
  paths?: ApiRelationshipPath[]
}

interface Props {
  model?: ApiModel
  source?: SourceReferenceContext
  owner?: ApiSymbol
  searchable?: boolean
  glossary?: boolean
}
const { model: portModel, source, owner, searchable = true, glossary = false } = Astro.props as Props
const model = source?.model ?? portModel
const port = portModel?.port
const language = source?.model.language ?? port
const version = source?.version ?? buildTarget(process.env).version
const label = source?.label ?? (port ? PORT_NAME[port] ?? port : '')
const refBase = source?.referenceBase ?? (port && PORT_BY_SLUG[port]
  ? referenceUrl(PORT_BY_SLUG[port], version) : withRoot('/reference/'))

/** What the hub counts per port: the core library, without its products. */
const coreCount = (m: ApiModel) =>
  m.symbols.length - new Set([...symbolsForProduct(m, 'mcp'), ...symbolsForProduct(m, 'workspace')].map((s) => s.id)).size
/*
 * The route param is the page's own path below `/reference/`, so composing
 * `pagePath` from it cannot disagree with the URL. Deriving it from `owner`
 * instead dropped the port: every symbol page in all eight ports declared a
 * canonical at `/reference/<symbol>/`, a URL that does not exist, and two
 * ports sharing a symbol slug declared the same one.
 */
const { slug } = Astro.params


/** Ids of the types that have a page of their own. */
const pageOwners = model ? ownersOf(model) : []
const paged = new Set(pageOwners.map((s) => s.id))

/**
 * Every symbol has a page, so every link is to one.
 *
 * This had three branches — a type to its page, a member to an anchor on its
 * owner's, everything else to an anchor on the port index — and two of them
 * were wrong often enough to produce links to pages that were never
 * generated. One rule, total over the model, cannot have that failure.
 */
const hrefFor = (s: ApiSymbol): string =>
  source ? `${refBase}${s.slug ?? pageSlug(s.publicId ?? s.id)}/` : portModel
    // productApiHref, not refBase: a signature on a core page can name a
    // Workspace Manager or MCP type, and that type's page is in its own
    // package's reference rather than this one.
    ? productApiHref(portModel!, s, version)
    : withRoot('/reference/')
/*
 * The stub is what the index route has instead of a model.
 *
 * Its port is a real slug because `PortSlug` admits nothing else, which is
 * exactly how this became a bug: `indexFor` memoises per port, so when this
 * route built before any Python page the empty index claimed the `py` key and
 * every Python page after it resolved against nothing. `indexFor` now refuses
 * to cache a model with no symbols, which is the guard that makes this safe.
 */
const pagePorts = source && owner ? source.pagePorts : await pagePortsFor(glossary ? 'reference/glossary' : source ? 'reference' : slug ? `reference/${slug}` : 'reference', port, version)
const index = source?.index ?? indexFor(portModel ?? { port: 'py', extractor: '', symbols: [] }, hrefFor)

/**
 * The navigation tree: the curated buckets, each with the types it holds.
 *
 * This was every type in the module, alphabetical. On Go that meant 221
 * entries in one run, because 213 of Go's 221 types live in one package and
 * there was no prefix to group by — `Server` sorted next to `BindKeyRequest`
 * and looked no more important.
 *
 * The buckets and their contents are decided once per port in
 * `scripts/gen-api-model.mjs` and read here. Nothing is computed per page but
 * which branch to open.
 */
const nav = source?.nav ?? (port ? API_NAV[port] : undefined)
const dependencyNavigation = port && PORT_BY_SLUG[port]?.apiDependencyNavigation?.length ? referenceNavigation(port) : undefined
const tree = source?.tree ?? dependencyNavigation?.tree ?? (port ? navTree(port) : [])

/** What the sidebar navigates: this port's inventory, or the source project's. */
const sidebarInventory = model ? (port ? referenceTree(port) : referenceTreeFor('tmux', model, tree)) : undefined

/** Nav ids of the types that own members, which open into them in the tree. */
const withMembers = new Set([...pageOwners.map((s) => s.publicId ?? s.id), ...(dependencyNavigation?.members.keys() ?? [])])

/** The type this page is about, or the one it is a member of. */
const currentType =
  owner && isMemberOwner(owner)
    ? owner
    : owner?.parent
      ? model?.symbols.find((sym) => sym.id === owner.parent)
      : undefined

/**
 * Which branch this page sits in, using the curated placement map.
 *
 * `placement` is symbol id to bucket id, built alongside `assignments` so the
 * page never walks every bucket looking for itself. A declaration uses its
 * own placement first, including cmdlets grouped separately from their module.
 * Members without a placement inherit the nearest placed owner's bucket.
 */
const currentBucket = bucketForSymbol(model, nav, owner)

/** The top-level bucket that holds the current one, which may be its parent. */
const currentRoot = bucketAncestors(tree, currentBucket)[0]?.id
/**
 * Most useful first, in the sidebar and on the page alike: the accessors that
 * walk the hierarchy, then the operations every port shares, then the rest,
 * with private and special members last. See `member-order.ts`.
 */
const signals = memberSignals(port ?? '', mentionsData.mentions)
const currentMembers = currentType && model
  ? membersOf(model, currentType, signals)
  : []
const ancestorMembers = new Map<string, { id: string; name: string; kind: string; href: string }[]>()
let ancestor = currentType
while (ancestor && model && !ancestorMembers.has(ancestor.publicId ?? ancestor.id)) {
  ancestorMembers.set(ancestor.publicId ?? ancestor.id, membersOf(model, ancestor, signals)
    .map((member) => ({ id: member.id, name: member.name, kind: member.kind, href: hrefFor(member) })))
  ancestor = ancestor.parent ? model.symbols.find((symbol) => symbol.id === ancestor!.parent) : undefined
}

/** This port's package, for the definition block's Package row. */
const portMeta = port ? PORT_BY_SLUG[port] : undefined
const ownerPackage = owner?.package ?? portMeta?.packageName
const packageMeta = portMeta?.packages?.find((candidate) => candidate.name === ownerPackage)
const packageUrl = packageMeta?.registry ?? portMeta?.registry?.url ?? withRoot(`/${port}/`)

/**
 * The module rows of the definition block.
 *
 * `moduleOf` strips the symbol's own name from its path, which for a member
 * yields its owning *type* rather than a module — `libtmux.Pane` for
 * `libtmux.Pane.wrap_flag`. Linking that to the port index produced thousands
 * of links to anchors the index never renders. So the module is the type's
 * module, the type gets a row of its own, and the module links only when the
 * index actually has that anchor.
 */
const declaringType = owner?.parent ? model?.symbols.find((s) => s.id === owner.parent) : undefined
const ownerModule = owner ? moduleOf(declaringType ?? owner) : undefined
const moduleAnchors = new Set(model ? modulesIn(model).map((m) => m.name) : [])
const moduleLabel = ['java', 'kotlin', 'scala', 'go'].includes(port ?? '') ? 'Package'
  : ['csharp', 'fsharp', 'cxx'].includes(port ?? '') ? 'Namespace' : 'Module'

/** Share the entry's verified relationships, including cmdlets and facade modules. */
const conceptEntries =
  owner && port ? referenceAlternatives(port, owner.publicId ?? owner.id) : []

/**
 * An unmapped language is not evidence that the language lacks the concept.
 * Native differences are described in the entry's "In other ports" section.
 */
const counterparts = portModel
  ? Object.keys(API_MODELS)
      .filter((p) => p !== port)
      .map((p) => {
        const entry = conceptEntries.flatMap((group) => group.ports).find((entry) => entry.port === p && entry.href)
        return { ...entry, port: p, label: PORT_NAME[p] ?? p }
      })
  : []

const sourceUrl = (symbol: ApiSymbol): string | undefined => model
  ? apiSourceUrl(model, symbol, refBase)
  : undefined

const members = owner && model ? pageMembersOf(model, owner, signals) : []

const owners = (model ? topLevelTypesOf(model) : []).sort((a, b) => a.name.localeCompare(b.name))

/**
 * How many entries in the contents share each name.
 *
 * Two different types can be called `Server` — Rust has five, in
 * `libtmux`, `blocking` and three more — and a list that renders both as
 * "Server" asks the reader to pick by guessing. Only the repeats are
 * qualified: appending a module to all 553 entries would bury the name that
 * is being scanned for under the path that is not.
 */
const ownerNames = new Map<string, number>()
for (const o of owners) ownerNames.set(o.name, (ownerNames.get(o.name) ?? 0) + 1)

/**
 * The port index, grouped by module.
 *
 * A flat list of a thousand symbols is a wall, and it left prose with nowhere
 * to point: `libtmux.neo`, `LibTmux.Testing` and `libtmux::test` are named
 * constantly in the guides and were unlinkable, because no extractor emits a
 * module as a symbol and this page gave one no anchor. Each section's `id` is
 * the module's own spelling, which is what the resolver hands back.
 */
const namedGroups = (model ? modulesIn(model) : []).map((m) => ({
  name: m.name,
  types: m.symbols.filter((s) => paged.has(s.id)),
  // Functions, constants, and types without members still have individual pages.
  free: m.symbols
    .filter((s) => !paged.has(s.id))
    .sort((a, b) => a.kind.localeCompare(b.kind) || a.name.localeCompare(b.name)),
}))

/** Top-level declarations without members, listed alongside the owner types. */
const freeSymbols = (model?.symbols ?? [])
  .filter((s) => !s.parent && !paged.has(s.id))
  .sort((a, b) => a.kind.localeCompare(b.kind) || a.name.localeCompare(b.name))

/**
 * Symbols with no module at all, in one unnamed group.
 *
 * The partition has to be complete or the page silently drops symbols.
 * Swift's ids are bare — `Server`, not `LibTmux.Server` — so every one of its
 * 88 types has an empty module and the grid rendered nothing at all when the
 * groups were built from module names alone.
 */
const rootGroup = {
  name: '',
  types: owners.filter((s) => !namedGroups.some((m) => m.types.includes(s))),
  free: freeSymbols.filter((s) => !namedGroups.some((m) => m.free.includes(s))),
}
const moduleGroups = [...namedGroups, rootGroup].filter((m) => m.types.length || m.free.length)

/**
 * Whether this port groups by module.
 *
 * `modulesIn` decides — it returns nothing for a port whose "modules" are one
 * per symbol, which is what docfx and the Java extractor produce by taking a
 * module segment from the file name. Deciding it there rather than here is
 * what keeps the modules that resolve and the modules that get an anchor the
 * same set.
 *
 * Fixing those two ports properly means teaching `LAYOUT` that Java's module
 * is its directory, as Go's already is, and that a .NET namespace is not its
 * file — but that moves every anchor and inventory entry for both, so it is a
 * decision to make deliberately rather than a side effect of this page.
 */
const grouped = namedGroups.length > 0

/**
 * What the index actually renders: module sections, or one flat list when
 * grouping would not group. Either way every top-level symbol appears exactly
 * once.
 */
/**
 * The index groups by the same buckets the sidebar does.
 *
 * It grouped by module, so the sidebar taught one shape and the page it links
 * to showed another. `collapsed` comes from the compiled nav and decides which
 * sections open: the domain leads, the machinery is present but folded.
 *
 * The module anchors survive this. `#<module>` is what the definition block,
 * the prose linker and the inventories all point at — grouping by bucket
 * without them broke 9,160 links — so a compact module index is emitted
 * alongside the bucket sections, carrying every anchor and landing a reader
 * on a real heading rather than a hidden span.
 */
/*
 * Every top-level symbol, not just the ones that own a page of members.
 *
 * The nav places every top-level symbol; `topLevelTypesOf` is stricter.
 * Looking a bucket's members up in the stricter list dropped 18 of Go's from
 * the index and 3 of TypeScript's — `tmux.PaneDirection` among them — which
 * `check-xrefs` caught as resolution falling by six, because a symbol that
 * renders nowhere links nowhere.
 */
const bucketSections = source ? referenceIndexSectionsFor(source.model, tree) : port ? referenceIndexSections(port) : []

const sections = bucketSections.length
  ? bucketSections
  : grouped
    ? moduleGroups.map((m) => ({ ...m, id: m.name, collapsed: false }))
    : [{ id: '', name: '', collapsed: false, types: owners, free: freeSymbols }]

const indexNames = new Map<string, number>()
for (const symbol of sections.flatMap((section) => [...section.types, ...section.free])) {
  indexNames.set(symbol.name, (indexNames.get(symbol.name) ?? 0) + 1)
}
const indexContext = (symbol: ApiSymbol) => {
  if ((indexNames.get(symbol.name) ?? 0) < 2) return undefined
  if (port === 'scala') return { label: `API: ${symbol.id.includes('.cats.') ? 'Cats Effect' : symbol.id.includes('.ox.') ? 'Ox' : 'Direct API'}`, kind: 'context' }
  const name = qualifiedNameOf(symbol).slice(0, -symbol.name.length).replace(/(?:::|[./])$/, '')
  // Qualified context can be a receiver type rather than an import package.
  const isGoPackage = port === 'go' && !symbol.parent
  return name ? { label: isGoPackage ? `Package: ${name}` : `In ${name}`, kind: isGoPackage ? 'package' : 'context' } : undefined
}

// Existing index fragments land on the card that links to the full declaration.
const legacyIndexAnchors = (symbol: ApiSymbol) => [...new Set([
  ...apiEntrySections(symbol, language).map((section) => section.id),
  ...apiEntryFields(symbol, language).params.map((param) => parameterId(symbol, param.name)),
])]

const inherited = members.filter((m) => m.inheritedFrom)
const listed = members.filter((m) => !m.inheritedFrom || memberTier(m, signals) === 'parent')
const otherInherited = inherited.filter((m) => memberTier(m, signals) !== 'parent')
// A type with typed fields, or an enum with variants, and other members shows them as a table, then the rest as the usual list.
const table = owner ? memberTable(owner, listed, port) : undefined
const fieldsAndRest = table !== undefined && table.rest.length > 0
const shown = fieldsAndRest ? table.rest : listed
const memberGroups = apiMemberGroups(shown, signals)
const tableColumns = owner ? memberTableColumns(owner, listed, port) : undefined
const showMemberGroups = !tableColumns && memberGroups.length > 1
const aliasedMembers = owner && model ? aliasMembersTarget(model, owner) : undefined
// A table takes its language's word for its rows: Fields, Properties or Variants. A fields block keeps the id `api-fields`, a variants block `api-variants`.
const tableHeading = table?.label ?? fieldsLabel(port)
// Each payload type is drawn in full on its variant's own page, where check-type-links counts it; the rows here are repeats of that page.
const payloads = table?.columns === 'variants' && model ? variantPayloads(model.symbols, table.rows) : undefined
// A row repeats a type drawn in full elsewhere when a variant has a page of its own, or when the port's fields do: C# properties.
const rowsRepeat = (columns?: string) => columns === 'variants' || (columns === 'fields' && fieldsRepeated(port))
const membersLabel = aliasedMembers ? `Members of ${aliasedMembers.name}` : tableColumns === 'fields' || tableColumns === 'variants' ? tableHeading : owner?.variant || (language === 'julia' && owner?.kind === 'struct' && shown.every((member) => member.kind === 'property')) ? 'Fields' : 'Members'
const glossaryContext = apiGlossary(`${refBase}glossary/`)
const pageSections: ApiSection[] = glossary ? apiGlossaryHeadings(glossaryContext.path).map((heading) => ({
  id: heading.slug, label: heading.text, nested: heading.depth === 3,
})) : owner ? [
  { id: 'api-overview', label: 'Overview' },
  ...apiEntrySections(owner, language, index),
  ...apiMemberSections({ fields: fieldsAndRest ? table.rows.length : 0, members: shown.length, label: membersLabel, fieldsLabel: tableHeading, fieldsId: table?.id, groups: showMemberGroups ? memberGroups : [] }),
  ...(otherInherited.length ? [{ id: 'api-inherited', label: 'Inherited members', count: otherInherited.length }] : []),
] : []
const relationshipSections = owner && model ? apiRelationshipSections(model, owner) : []
const paths = (source?.paths ?? []).filter((path) => !owner || path.symbols.some((symbol) => symbol.id === owner.id))
if (relationshipSections.some((section) => ['api-calls', 'api-called-by'].includes(section.id))) pageSections.push({ id: 'api-call-network', label: 'Call neighborhood' })
if (paths.length) pageSections.push({ id: 'api-source-paths', label: 'Paths through the source', count: paths.length })
pageSections.push(...relationshipSections.map((section) => ({ id: section.id, label: section.label, count: section.items.length })))
// A library symbol's tmux and cross-port links are sections of its page; a C declaration keeps its rows.
const tmuxSections = owner && port && !source?.manualLinks ? apiTmuxSections(port, owner) : []
pageSections.push(...tmuxSections.map((section) => ({ id: section.id, label: section.label, count: section.count })))
const related = owner && model ? relatedTypeLinks(model, owner, members, index, hrefFor, { language, repeated: ownerNames, includeInternal: Boolean(source) }) : []
if (related.length) pageSections.push({ id: 'api-related-types', label: 'Related types', count: related.length })
// The methods that send the command are what a reader of the C needs last, after the code around it.
const usage = source?.usage ?? []
if (owner && usage.length) pageSections.push({ id: 'api-tmux-usage', label: 'In libtmux' })
const title = glossary ? API_GLOSSARY_TITLE : owner
  ? qualifiedNameOf(owner)
  : model
    ? source?.title ?? `${label} API reference`
    : 'API reference'
const pageTitle = glossary ? API_GLOSSARY_TITLE : owner ? title : source?.title ?? 'API reference'
const displayName = owner ? (declaringType ? `${declaringType.name}.${owner.name}` : owner.name) : pageTitle
const breadcrumbs = source?.breadcrumbs ?? await pageBreadcrumbs(displayName, glossary ? 'reference/glossary' : slug ? `reference/${slug}` : 'reference', version, port)
const pagePath = glossary ? 'reference/glossary' : source?.pagePath ?? (slug ? `reference/${slug}` : 'reference')
const description = glossary ? glossaryContext.description : source?.description ?? `Types, methods, and functions in libtmux for ${label}.`
const bases = owner && 'extends' in owner ? owner.extends ?? [] : []
---

<BaseLayout
  inventoryId={owner ? `api:${apiInventoryIdentity(owner, language ?? '', declaringType?.kind)}` : undefined}
  title={title}
  description={
    owner
      ? // The summary is written in this port's doc dialect, and a card, a
        // meta tag and a JSON-LD blob all take a string: `{@link Pane}` and
        // ``Server`` reached all three as markup.
        owner.doc?.summary
        ? docSummaryText(owner.doc.summary, port)
        : `${qualifiedNameOf(owner)} API documentation.`
      : model
        ? description
        : 'Types, methods, and functions in the libtmux language libraries.'
  }
  pagePath={pagePath}
  portSlug={port}
  documentationLayout={model ? 'reference' : undefined}
  version={version}
  noindex={source ? version !== 'latest' : true}
  searchable={searchable}
  pageSource={model && (owner || source) ? symbolSource(model, owner) : undefined}
  markdown={glossary ? { href: `${glossaryContext.path.slice(0, -1)}.md` } : owner ? 'source' : 'rendered'}
  markdownIndex={!owner}
  flush
  breadcrumbs={breadcrumbs}
>
  {model && <div slot="header-navigation" class="site-header-language">
    <PagePortSwitcher entries={pagePorts} portSlug={port} tmux={!port} reserveLabelWidth />
  </div>}
  {model && <DocumentationContext slot="context" port={port} version={version}
    locale={buildLocale()} sourcePath={localeSourcePath(Astro.url.pathname, buildLocale())} reference>
    <button type="button" class="api-nav-toggle" slot="navigation" data-api-nav-toggle data-pagefind-ignore="all" aria-controls="api-nav" aria-expanded="false">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path stroke-linecap="round" d="M2 4h12M2 8h12M2 12h8" />
          </svg>
          <span class="sr-only">{label} API contents</span>
        </button>
  </DocumentationContext>}
  <!-- Flush: the tree's column runs from the header to the footer against the
       viewport's edge, as Learn's does, and only the text column is padded. -->
  <main class:list={["api-reference-layout grid", owner && 'api-reference-layout--symbol', glossary && 'api-reference-layout--glossary']}>
    {model && sidebarInventory && (
      <ApiTree
        presentation="outline"
        inventory={sidebarInventory}
        selectedSymbol={sidebarSelection(sidebarInventory, owner)}
        referenceBase={refBase}
        glossaryHref={port ? `${refBase}glossary/` : undefined}
        portName={label}
        tree={tree}
        hrefs={dependencyNavigation?.hrefs}
        currentRoot={currentRoot}
        currentBucket={currentBucket}
        currentTypeId={currentType ? (currentType.publicId ?? currentType.id) : undefined}
        ownerNavId={owner ? (owner.publicId ?? owner.id) : undefined}
        ownerId={owner?.id}
        members={currentMembers.map((m) => ({ id: m.id, name: m.name, kind: m.kind, href: hrefFor(m) }))}
        ancestorMembers={ancestorMembers}
        withMembers={withMembers}
        currentPath={Astro.url.pathname}
        version={apiTreeVersion(model, tree, dependencyNavigation?.hrefs)}
      />
    )}

    <div class="api-reference-content min-w-0 px-4 py-6 lg:px-6">
      <PageToolbar breadcrumbs={breadcrumbs} />
      <header id={owner ? 'api-overview' : undefined} class:list={[owner && 'api-reference-heading']}>
        {owner && <div class="api-reference-eyebrow">
          <ApiBadge label={owner.command?.kind ?? owner.kind} variant="kind" value={owner.kind} />
          <span>{source?.model.project ?? portMeta?.projectName}</span>
          {owner.doc?.since && <span>Since {owner.doc.since}</span>}
          <span class="api-badge api-badge--mod api-reference-version"><span class="api-badge__label">{version}</span></span>
        </div>}
        <h1 class="scroll-mt-24 text-2xl font-semibold tracking-tight">
          <SymbolName name={displayName} />
        </h1>
        {owner && <>
          {owner.doc?.summary && <p class="api-reference-summary">
            <ApiDoc text={owner.doc.summary} index={index} context={owner} />
          </p>}
          {bases.length > 0 && <div class="api-reference-relationships">
            <span>Base types</span>
            {bases.map((base) => <ApiType type={base} index={index} context={owner} chip />)}
          </div>}
        </>}
      </header>

      {glossary && <>
        <details class="api-glossary-contents" data-pagefind-ignore="all">
          <summary>On this page</summary>
          <nav aria-label="On this page"><ul>{pageSections.map((section) =>
            <li class:list={[section.nested && 'api-contents-nested']}>
              <a href={`#${section.id}`} data-api-section-link>{section.label}</a>
            </li>)}
          </ul></nav>
        </details>
        <div class="prose dark:prose-invert mt-6 max-w-none"><ApiGlossaryContent contextPath={glossaryContext.path} /></div>
      </>}
      {
        !glossary && !owner && !model && (
          <>
            <p class="mt-3"><a href={tmuxManualUrl()}>tmux manual</a>: command flags and behavior by tmux version.</p>
            <p class="mt-3 max-w-2xl">
              Choose a language to browse its public types, functions, and
              members, with signatures, examples, and links to related guides.
            </p>
            <p class="mt-4">
              <a href={withRoot('/reference/symbols/a/')}>Symbol index (A–Z)</a>
              <span class="ml-2 text-sm opacity-60">
                every name in every port, for when you know the name and not
                the library
              </span>
            </p>
            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              {Object.entries(API_MODELS).map(([port, m]) => (
                <a
                  class="block rounded border border-slate-200 p-4 hover:bg-slate-100 dark:border-slate-800 dark:hover:bg-slate-800"
                  href={PORT_BY_SLUG[port] ? referenceUrl(PORT_BY_SLUG[port], defaultVersionFor(port)) : withRoot('/reference/')}
                >
                  <span class="text-lg font-semibold">{PORT_NAME[port] ?? port}</span>
                  <span class="ml-2 text-sm opacity-60">{coreCount(m)} symbols</span>
                  <p class="mt-1 text-sm opacity-75">
                    {m.symbols.filter((s) => s.doc?.summary).length} documented,
                    {' '}{topLevelTypesOf(m).length} types
                  </p>
                </a>
              ))}
            </div>
          </>
        )
      }

      {
        !glossary && !owner && model && (
          <>
            <p class="mt-3 max-w-2xl">
              {source ? description : port === 'powershell'
                ? 'Browse the LibTmux cmdlets by the tmux objects and operations they control. Each command includes syntax, parameter sets, pipeline types, and examples.'
                : `Browse the ${label} types and operations for working with tmux. Start with the core objects below, or search for a type or member.`}
            </p>
            {paths.length > 0 && <ApiRelationships paths={paths} hrefFor={hrefFor} />}
            {sections.map((mod) => (
              /*
                `collapsed` comes from the compiled nav and is the one thing
                that decides whether a section opens: the domain leads, the
                machinery is present and folded. It is a `<details>` either
                way so the two read as the same kind of thing, and `open` is
                server-rendered so a reader without JavaScript sees the same
                page.
              */
              <details class="api-index-section mt-10" open={!mod.collapsed}>
                {/*
                  Prefixed, because eleven bucket names collide with module
                  names on Rust alone — `server`, `session`, `pane`,
                  `options`. Duplicate ids are invalid and `#server` would
                  resolve to whichever came first. `#<module>` is the one the
                  rest of the site links to, so it keeps the bare name and the
                  section takes the prefix.
                */}
                <summary
                  id={mod.id ? `section-${mod.id}` : undefined}
                  class="api-index-summary scroll-mt-24 border-b border-edge pb-1 font-mono text-sm font-semibold tracking-tight"
                >
                  {mod.name || 'Types'}
                  <span class="ml-2 font-sans text-xs font-normal opacity-60">
                    {[
                      mod.types.length > 0 && `${mod.types.length} ${mod.types.length === 1 ? 'type' : 'types'}`,
                      mod.free.length > 0 &&
                        `${mod.free.length} ${port === 'powershell' ? 'cmdlets' : mod.free.length === 1 ? 'function or constant' : 'functions and constants'}`,
                    ]
                      .filter(Boolean)
                      .join(', ')}
                  </span>
                </summary>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                  {/*
                    The card is a div and only its name is the link. A summary
                    carries cross-references, and an `a` inside an `a` is not
                    parseable: the browser closed the card at the first nested
                    link and left the description behind as the grid's next
                    cell, so a type's prose sat beside the wrong card. The
                    `::after` in `api-index-card` keeps the whole card
                    clickable without nesting anything.
                  */}
                  {[...mod.types, ...mod.free].map((o) => {
                    const count = model.symbols.filter((symbol) => symbol.parent === o.id).length
                    const kind = o.signatures.some((signature) => /\bannotation class\b/.test(signature.raw ?? ''))
                      ? 'annotation' : o.command?.kind ?? o.kind
                    const context = indexContext(o)
                    return (
                    <div id={mod.free.includes(o) ? o.publicId ?? o.id : undefined}
                      class="api-index-card scroll-mt-24 rounded border border-slate-200 p-3 hover:bg-slate-100 dark:border-slate-800 dark:hover:bg-slate-800">
                      {mod.free.includes(o) && legacyIndexAnchors(o).map((id) => <span id={id} class="sr-only" />)}
                      <div class="api-index-card__heading">
                        <a class="api-index-card__link font-mono font-semibold" href={hrefFor(o)}><ApiBadge label={kind} variant="kind" value={kind} compact preview={false} />{o.name}</a>
                        <ApiBadge label={kind === 'typealias' ? 'type alias' : kind} variant="kind" value={kind} plain />
                        {context && <span class="api-index-card__context">
                          <ApiBadge label={context.label} variant="mod" value={context.kind} preview={false} />
                        </span>}
                        {count > 0 && <span class="text-xs opacity-60">{count} {count === 1 ? 'member' : 'members'}</span>}
                      </div>
                      {o.doc?.summary && (
                        <p class="mt-1 text-sm opacity-80">
                          <ApiDoc text={o.doc.summary} index={index} context={o} citations={false} />
                        </p>
                      )}
                    </div>
                  )})}
                </div>
              </details>
            ))}

            {bucketSections.length > 0 && grouped && (
              <section class="mt-12">
                <h2 class="border-b border-edge pb-1 font-mono text-sm font-semibold tracking-tight">
                  By module
                  <span class="ml-2 font-sans text-xs font-normal opacity-60">
                    {moduleGroups.length} modules
                  </span>
                </h2>
                {/*
                  A disclosure per module, after the domains, because the sections above
                  group by bucket rather than by module: `libtmux.neo` names
                  nothing a reader can click through to, and this list said so
                  with a bare name and a count. A module with 65 symbols read
                  as a dead end.

                  The `id` stays exactly where it was, on the element the count
                  sits beside. `#<module>` is what the definition block, the
                  prose linker and the inventories all point at — 9,160 links —
                  and a fragment that lands on a closed disclosure still lands
                  on the right row. The script at the foot of this page opens
                  it; without JavaScript it is one click, which is what a
                  `<details>` is for.
                */}
                <ul class="api-module-index mt-3 grid gap-x-6 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
                  {moduleGroups.map((m) => (
                    <li>
                      <details id={m.name || undefined} class="api-module scroll-mt-24">
                        <summary class="api-module__name font-mono text-sm">
                          {m.name || 'Types'}
                          <span class="ml-2 font-sans text-xs opacity-60">
                            {m.types.length + m.free.length}
                          </span>
                        </summary>
                        <ul class="api-module__symbols">
                          {[...m.types, ...m.free].map((sym) => (
                            <li>
                              <a class="api-module__symbol" href={hrefFor(sym)}>
                                <SymbolName name={sym.name} />
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </>
        )
      }

      {
        owner && (
          <>
            {pageSections.length > 1 &&
              <nav class="api-section-links" aria-label="Reference sections" data-pagefind-ignore="all">
                {pageSections.filter((section) => !section.nested && !['Description', 'References'].includes(section.label))
                  .map((section, i) => <a href={`#${section.id}`} data-api-section-link aria-current={i === 0 ? 'location' : undefined}>{section.label}{section.count && <span>{section.count}</span>}</a>)}
              </nav>}
            <!-- The type's own entry, through the same component as its
                 members. It is a declaration like any other — the only
                 difference is that this one is what the page is about, which
                 `heading` says. Rendering it by hand here is how the summary
                 came to display raw reST while every member's rendered. -->
            {/*
              Where this symbol lives, above the description.

              learn.microsoft.com opens every API page with Namespace,
              Assemblies and Source before a word of prose, and it is the right
              order: a reader arriving from a search needs to know which module
              and which package this is before deciding whether the description
              applies to them. Each row is a link, not a string.
            */}


            {/*
                Indexed, not displayed twice: `data-pagefind-meta` puts the
                package, module and source file into the search index as
                fields, so a result can say where a symbol lives instead of
                making the reader open it to find out.
              */}
              {ownerPackage && (
                <span hidden data-pagefind-meta={`package:${ownerPackage}`} />
              )}
              {ownerModule && <span hidden data-pagefind-meta={`module:${ownerModule}`} />}
              {owner?.source?.file && (
                <span hidden data-pagefind-meta={`file:${owner.source.file}`} />
              )}
              {owner?.kind && <span hidden data-pagefind-meta={`kind:${owner.kind}`} />}
            <details class="api-source-details" data-pagefind-ignore="all" open>
              <script is:inline>
                window.__initApiSourceDetails?.(document)
              </script>
              <summary>{source ? 'Source' : 'Source and package'}</summary>
              <dl class="api-definition">
              {/* The module, namespace or package this symbol is in, and its full name with a button to copy it; the page heading above carries neither. */}
              <dt>Qualified name</dt>
              <dd><ApiQualifiedName name={nativeQualifiedName(model, owner)} /></dd>
              {ownerModule && (
                <>
                  <dt>{moduleLabel}</dt>
                  <dd>
                    {moduleAnchors.has(ownerModule) ? (
                      <a href={`${refBase}#${ownerModule}`}>{ownerModule}</a>
                    ) : (
                      ownerModule
                    )}
                  </dd>
                </>
              )}
              {declaringType && (
                <>
                  <dt>Declared in</dt>
                  <dd><a href={hrefFor(declaringType)}>{declaringType.name}</a></dd>
                </>
              )}
              {ownerPackage && (
                <>
                  <dt>{moduleLabel === 'Package' ? 'Distribution' : 'Package'}</dt>
                  <dd><a href={packageUrl}>{ownerPackage}</a></dd>
                </>
              )}
              {owner.source?.file && (
                <>
                  <dt>Source</dt>
                  <dd>
                    <a href={sourceUrl(owner)} rel="nofollow noopener">
                      {owner.source.file}
                    </a>
                  </dd>
                </>
              )}
              {counterparts.some((c) => c.href) && (
                <>
                  <dt>Other languages</dt>
                  <dd class="api-definition-langs">
                    {counterparts.map((c) =>
                      c.href ? (
                        <span class="api-lang"><a href={c.href}>{c.label}</a>{c.note && c.kind && <ApiBadge label={c.kind} variant="kind" value={c.kind} plain />}</span>
                      ) : (
                        <span class="api-lang-absent" title={`No ${c.label} counterpart is mapped`}>
                          {c.label}
                        </span>
                      ),
                    )}
                  </dd>
                </>
              )}
            </dl>
            </details>

            <section class="api-overview mt-6" aria-label="Declaration and behavior">
              {/*
                `heading` for a type, `member` for everything else.

                It marked every entry as a heading once every symbol had a
                page, which gave a method's own page the band and margin
                gp-sphinx reserves for a type — on a page that already carries
                an <h1> with the same name. The band is duplicated emphasis
                there, and the parity check reads it as a difference in two
                treatments.
              */}
              <ApiEntry
                symbol={owner}
                parentKind={declaringType?.kind}
                index={index}
                sourceUrl={sourceUrl}
                port={port}
                language={language}
                manualLinks={source?.manualLinks}
                catalogLinks={source?.catalogLinks}
                linkRows={!(owner && port && !source?.manualLinks)}
                heading={isMemberOwner(owner)}
                member={!isMemberOwner(owner)}
                showSummary={false}
                showBases={false}
                legacyId={`${owner.publicId ?? owner.id}.declaration`}
              />
            </section>

            {/*
              A list, not a stack of entries.

              Every member has its own page, so inlining them here would
              publish each twice and make a large type's page the longest
              document on the site. What a reader wants from a type page is
              the shape of the type — the names, their kind and one line each
              — which is what learn.microsoft.com puts here too.
            */}
            {fieldsAndRest && owner && (
              <div class="api-field-table mt-8">
                <h2 class="api-section-heading text-lg font-semibold" id={table.id}>{tableHeading}<span class="api-section-count">{table.rows.length}</span><a class="api-heading-link" href={`#${table.id}`} aria-label={`Link to ${tableHeading}`}>#</a></h2>
                <ApiScalarMembers owner={owner} members={table.rows} index={index} hrefFor={hrefFor} columns={table.columns} label={tableHeading} payloads={payloads} repeated={rowsRepeat(table.columns)} />
              </div>
            )}
            {shown.length > 0 && (
              <div class="api-members mt-8">
                <h2 class="api-section-heading text-lg font-semibold" id="api-members">{aliasedMembers ? <>Members of <a class="api-members-target" href={hrefFor(aliasedMembers)}><code>{aliasedMembers.name}</code></a></> : membersLabel}<span class="api-section-count">{shown.length}</span><a class="api-heading-link" href="#api-members" aria-label={`Link to ${membersLabel}`}>#</a></h2>
                {tableColumns ? <ApiScalarMembers owner={owner} members={listed} index={index} hrefFor={hrefFor} columns={tableColumns} label={tableHeading} payloads={payloads} repeated={rowsRepeat(tableColumns)} /> : memberGroups.map((group) => <section id={showMemberGroups ? undefined : group.id} class:list={['api-member-group', !showMemberGroups && 'api-member-group--single']} aria-labelledby={showMemberGroups ? group.id : 'api-members'}>
                {showMemberGroups && <h3 id={group.id}>{group.label}<span class="api-section-count">{group.members.length}</span><a class="api-heading-link" href={`#${group.id}`} aria-label={`Link to ${group.label}`}>#</a></h3>}
                <ul class="api-member-list mt-3">
                  {group.members.map((m) => (
                    <li>
                      <span><ApiBadge label={m.kind} variant="kind" value={m.kind} compact preview={false} /><a class="api-member-link" href={hrefFor(m)}>{m.name}</a>{m.type && <span class="api-member-type">: <ApiType type={m.type} index={index} context={m} /></span>}</span>
                      <span class="api-member-badges">
                        <ApiBadge label={m.kind} variant="kind" value={m.kind} plain />
                        {m.inheritedFrom && <a class="api-badge api-badge--mod" href={apiGlossaryHref('inherited', Astro.url.pathname)} title={`Inherited from ${m.inheritedFrom}`} aria-description={`Inherited from ${m.inheritedFrom}`} data-preview-context={`Inherited from ${m.inheritedFrom}.`}><span class="api-badge__label">inherited</span></a>}
                      </span>
                      {m.doc?.summary && (
                        <span class="api-member-summary">
                          <ApiDoc text={m.doc.summary} index={index} context={m} citations={false} />
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
                </section>)}
              </div>
            )}

            {otherInherited.length > 0 && (
              <>
                <h2 class="api-section-heading mt-12 text-lg font-semibold" id="api-inherited">Inherited members<span class="api-section-count">{otherInherited.length} {otherInherited.length === 1 ? 'member' : 'members'}</span><a class="api-heading-link" href="#api-inherited" aria-label="Link to Inherited members">#</a></h2>
                <p class="mt-1 text-sm opacity-70">
                  Reached through {[...new Set(otherInherited.map((m) => m.inheritedFrom))].join(', ')}.
                </p>
                <ul class="api-member-list mt-4">
                  {otherInherited.map((m) => (
                    <li>
                      <span><ApiBadge label={m.kind} variant="kind" value={m.kind} compact preview={false} /><a class="api-member-link" href={hrefFor(m)}>{m.name}</a></span>
                      <span class="api-member-badges">
                        <ApiBadge label={m.kind} variant="kind" value={m.kind} plain />
                        <a class="api-badge api-badge--mod" href={apiGlossaryHref('inherited', Astro.url.pathname)} title={`Inherited from ${m.inheritedFrom}`} aria-description={`Inherited from ${m.inheritedFrom}`} data-preview-context={`Inherited from ${m.inheritedFrom}.`}><span class="api-badge__label">inherited</span></a>
                      </span>
                      {m.doc?.summary && (
                        <span class="api-member-summary">
                          <ApiDoc text={m.doc.summary} index={index} context={m} citations={false} />
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </>
            )}
            <ApiRelationships owner={owner} model={model} sections={relationshipSections} paths={paths} hrefFor={hrefFor} />
            <ApiTmuxSections sections={tmuxSections} />
            {related.length > 0 && <section class="api-related-types" aria-labelledby="api-related-types">
              <h2 class="api-section-heading text-lg font-semibold" id="api-related-types">Related types<a class="api-heading-link" href="#api-related-types" aria-label="Link to Related types">#</a></h2>
              <div class="api-related-cards">
                {related.map((item) => <div class="api-index-card api-related-card">
                  <a class="api-index-card__link" href={item.href} title={item.identity}>
                    <ApiBadge label={item.kind} variant="kind" value={item.kind} compact />
                    <code>{item.qualified ? <SymbolName name={item.name} /> : item.name}</code>
                  </a>
                  {item.symbol.doc?.summary && <p><ApiDoc text={item.symbol.doc.summary} index={index} context={item.symbol} citations={false} /></p>}
                </div>)}
              </div>
            </section>}
            {usage.length > 0 && <section class="api-tmux-usage" aria-labelledby="api-tmux-usage">
              <h2 class="api-section-heading text-lg font-semibold" id="api-tmux-usage">In libtmux<a class="api-heading-link" href="#api-tmux-usage" aria-label="Link to In libtmux">#</a></h2>
              {usage.map((entry) => <>
                <p>These methods send <a href={entry.manualHref}><code>{entry.command}</code></a>.</p>
                <TmuxUsage usage={entry} />
              </>)}
            </section>}
          </>
        )
      }
    </div>
    {(owner || glossary) && <ApiPageContents sections={pageSections} related={related} />}
  </main>



</BaseLayout>
