---
/**
 * The head of a port's reference home: what the reference covers, the view switch, and where else to read it.
 *
 * The counts come from the model. "By area" is this page; "A-Z index" opens the alphabetical index, a page per letter
 * so a letter is a stable, linkable unit. The ecosystem host is an alternative, linked beside the switch and not as
 * the primary reference, and the source revision appears here once, in mono.
 */
import { API_MODELS } from '../../lib/api-models'
import { countsSentence, firstIndexLetter, indexCounts, sourceRevision } from '../../lib/api-index-head'
import { PORT_BY_SLUG } from '../../lib/ports'

interface Props {
  port: string
  /** The reference root of this port and version, which holds `symbols/<letter>/`. */
  base: string
}
const { port, base } = Astro.props as Props
const model = API_MODELS[port]
const counts = model ? indexCounts(model) : []
const host = PORT_BY_SLUG[port]?.ecosystemHost
const revision = model ? sourceRevision(model) : undefined
const azHref = model ? `${base.replace(/\/?$/, '/')}symbols/${firstIndexLetter(model)}/` : undefined
---
{counts.length > 0 && <p class="api-index-counts">{countsSentence(counts)}.</p>}
<div class="api-index-view-row">
  <nav class="api-index-view" aria-label="View of the reference">
    <a href="?view=area" aria-current="page">By area</a>
    {azHref && <a href={azHref}>A–Z index</a>}
  </nav>
  {(host || revision) && <span class="api-index-also">
    {host && <>Also on <a href={host.url}>{host.name}</a></>}
    {host && revision && ' · '}
    {revision && <>source <code>{revision}</code></>}
  </span>}
</div>
<style is:global>
  .api-index-counts { margin: .5rem 0 0; color: var(--color-foreground-muted); font-size: 14px; line-height: 20px; font-variant-numeric: tabular-nums; }
  .api-index-view-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; margin-block: 1rem 0; }
  .api-index-view { display: inline-flex; border: 1px solid var(--control-border, #7f8d9b); border-radius: var(--radius-md, 6px); overflow: hidden; }
  html[data-theme-mode='dark'] .api-index-view { border-color: var(--control-border, #718294); }
  @media (prefers-color-scheme: dark) { html:not([data-theme-mode]):not([data-theme='light']) .api-index-view { border-color: var(--control-border, #718294); } }
  .api-index-view a { display: inline-flex; align-items: center; min-block-size: 28px; padding-inline: 12px; font-size: 13px; color: var(--text-color); text-decoration: none; }
  .api-index-view a + a { border-inline-start: 1px solid var(--color-background-border); }
  .api-index-view a:hover { background: var(--color-api-background-hover); }
  .api-index-view a[aria-current] { background: var(--color-api-background-hover); font-weight: 600; }
  .api-index-view a:focus-visible { outline: 2px solid var(--focus-ring-color, var(--theme-primary)); outline-offset: 2px; }
  .api-index-also { font-size: 13px; color: var(--color-foreground-muted); }
  .api-index-also code { font-size: 12px; }
  @media (max-width: 30rem) { .api-index-view a { min-block-size: var(--touch-target, 2.75rem); } }
</style>
