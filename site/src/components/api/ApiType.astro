---
import type { ApiSymbol, Signature, SymbolIndex } from '@libtmux/api-model'
import { qualifiedNameOf } from '@libtmux/api-model'
import SymbolName from './SymbolName.astro'

/**
 * A type annotation, with every name it mentions linked.
 *
 * `list[Window] | None` renders as three links and two literal fragments:
 * `list` and `None` go to docs.python.org the way intersphinx sends them,
 * `Window` goes to its own entry on this site, and the brackets and pipe are
 * untouched so the annotation still reads as the annotation.
 *
 * Names that resolve to nothing stay plain. That is deliberate — a link to a
 * guess is worse than no link, and unresolved names are a signal worth seeing.
 *
 * `context` is the symbol the annotation belongs to. It separates candidates
 * that a bare name cannot: `Pane` on a page in package `tmux` is `tmux.Pane`,
 * never `workspace.Pane`. Without it both are equally good and neither links.
 */
interface Props {
  type: string
  index: SymbolIndex
  context?: ApiSymbol
  chip?: boolean
  signature?: Signature
}
const { type, index, context, chip, signature } = Astro.props as Props
const spans = index.linkType(type, context, signature)
/* gp-sphinx renders a type cross-reference as a code chip — `Bases:` and the
   parameter list both — and chips the names that resolve to nothing too, so
   the box marks "this is a type" and the colour marks "this one is a link".
   Punctuation between them stays outside the chip. */
const NAME = /^[A-Za-z_][A-Za-z0-9_.]*$/
// Keep compound operators intact when a native declaration wraps.
const literalParts = (text: string) => text.split(/(->|=>|<:|:>)/).filter(Boolean)
const isOperator = (text: string) => /^(->|=>|<:|:>)$/.test(text)
---
<span class="api-type">{
  spans.map((span) =>
    span.link ? (
      <a
        href={span.link.href}
        class:list={['api-type-link', chip && 'api-literal api-literal--link']}
        rel={span.link.external ? 'nofollow noopener' : undefined}
        title={span.link.external ? `${span.text} (${span.link.project ?? "external"})` : span.link.symbol ? qualifiedNameOf(span.link.symbol) : undefined}
      ><SymbolName name={span.text} /></a>
    ) : (
      <span class:list={[
        span.declaration || span.keyword ? 'api-type-label' : 'api-punct',
        span.keyword && 'api-keyword',
        span.declaration && (span.text === context?.name ? 'api-declaration-name' : 'api-parameter-name'),
        chip && NAME.test(span.text) && 'api-literal',
      ]}>{literalParts(span.text).map((part) => isOperator(part)
        ? <span class="api-operator">{part}</span> : part)}</span>
    ),
  )
}</span>
