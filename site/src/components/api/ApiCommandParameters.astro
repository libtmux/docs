---
import { parameterId, type ApiSymbol, type Param, type SymbolIndex } from '@libtmux/api-model'
import { parameterBindingFacts, POWER_SHELL_COMMON_HELP, POWER_SHELL_COMMON_HELP_TITLE } from '../../lib/api-sections'
import ApiDoc from './ApiDoc.astro'
import ApiType from './ApiType.astro'
import ApiFieldOverloads from './ApiFieldOverloads.astro'

interface Props {
  params: (Param & { overloads: string[] })[]
  symbol: ApiSymbol
  index: SymbolIndex
}
const { params, symbol, index } = Astro.props as Props
const specific = params.filter((p) => !p.binding?.common)
const common = params.filter((p) => p.binding?.common)
const anchor = (param: Param) => params.find((p) => p.name === param.name) === param ? parameterId(symbol, param.name) : undefined
---

<ul class="simple api-command-parameters">
  {specific.map((p) => <li id={anchor(p)}>
    <p class="api-parameter-heading">
      <span class="api-parameter-signature"><strong><a href={`#${encodeURIComponent(parameterId(symbol, p.name))}`}><code>-{p.name}</code></a></strong>{p.type && <>{' ('}<ApiType type={p.type} index={index} context={symbol} />{')'}</>}<ApiFieldOverloads labels={p.overloads} /></span>
      <a class="api-heading-link" href={`#${encodeURIComponent(parameterId(symbol, p.name))}`} aria-label={`Link to -${p.name} parameter`} data-pagefind-ignore="all">#</a>
    </p>
    {p.doc && <p><ApiDoc text={p.doc} index={index} context={symbol} /></p>}
    <dl class="api-definition api-parameter-facts">
      {parameterBindingFacts(p).map((fact) => <><dt>{fact.label}</dt><dd><ApiDoc text={fact.value} index={index} context={symbol} /></dd></>)}
    </dl>
  </li>)}
</ul>
{common.length > 0 && <details class="api-common-parameters" id={`${symbol.publicId ?? symbol.id}.common-parameters`}>
  <summary>Common parameters <span class="api-count">{new Set(common.map((p) => p.name)).size}</span></summary>
  <p>PowerShell supplies these parameters. See <a href={POWER_SHELL_COMMON_HELP}>{POWER_SHELL_COMMON_HELP_TITLE}</a> for their effects.</p>
  <ul class="simple api-command-parameters">
    {common.map((p) => <li id={anchor(p)}>
      <p class="api-parameter-heading">
        <span class="api-parameter-signature"><strong><a href={`#${encodeURIComponent(parameterId(symbol, p.name))}`}><code>-{p.name}</code></a></strong>{p.type && <>{' ('}<ApiType type={p.type} index={index} context={symbol} />{')'}</>}</span>
        <a class="api-heading-link" href={`#${encodeURIComponent(parameterId(symbol, p.name))}`} aria-label={`Link to -${p.name} parameter`} data-pagefind-ignore="all">#</a>
      </p>
      {p.doc && <p><ApiDoc text={p.doc} index={index} context={symbol} /></p>}
      <div class="api-parameter-resources">
        {p.binding && p.binding.aliases.length > 0 && <span>Aliases: {p.binding.aliases.map((alias, i) => <>{i > 0 && ', '}<a href={`#${encodeURIComponent(parameterId(symbol, p.name))}`}><code>{alias}</code></a></>)}</span>}
        <a href={`${POWER_SHELL_COMMON_HELP}#-${p.name.toLowerCase()}`} aria-label={`Microsoft Learn reference for -${p.name}`}>Microsoft Learn reference</a>
      </div>
      <ApiFieldOverloads labels={p.overloads} />
    </li>)}
  </ul>
</details>}
