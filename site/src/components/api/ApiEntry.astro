---
import { boundLabel, parameterId, qualifiedNameOf, typeParameterId, typeParameterList, type ApiSymbol, type SymbolIndex } from '@libtmux/api-model'
import { API_MODELS, mentionsOf, referenceAlternatives } from '../../lib/api-models'
import { productApiIndex } from '../../lib/product-api'
import { defaultVersionFor } from '../../lib/versions'
import { SITE_ROOT } from '../../lib/site-root'
import { proseHref } from '../../lib/docs-paths'
import { Code } from 'astro-expressive-code/components'
import { codeLang } from '../../lib/highlight'
import Aside from '../Aside.astro'
import ApiBadge from './ApiBadge.astro'
import ApiDoc from './ApiDoc.astro'
import ApiProse from './ApiProse.astro'
import ApiType from './ApiType.astro'
import { asideFor } from '../../lib/aside'
import { apiCommandFacts, apiCommandRelatedLinks, apiEntryFields, apiMethodDetails, anonymousDeclarationLabel, nativeSignatureText as unformattedNativeSignatureText, parameterBindingText, usesNativeSignatures } from '../../lib/api-sections'
import { tmuxCommandsFor, tmuxManualUrl } from '../../lib/tmux-manual-data'
import { CATALOG_KINDS, tmuxCatalogKindsForSymbol, tmuxCatalogUrl } from '../../lib/tmux-catalog'
import ApiFieldOverloads from './ApiFieldOverloads.astro'
import ApiCommandParameters from './ApiCommandParameters.astro'
import ApiSignatureParameters from './ApiSignatureParameters.astro'
import { apiSignatureLayouts } from '../../lib/code-layout'
import { pythonSignatureLayout } from '../../lib/python-code-layout'

/**
 * One documented symbol, in the shape gp-sphinx's stylesheet expects.
 *
 * `dl.py` / `dt.sig` / `dd`, not nested `div`s. The brief left the structure
 * open; this is the one gp-sphinx's rules match, and it is also what docutils
 * chose, because a reference entry *is* a definition list — a term and its
 * description. Nested divs would have meant re-writing 1,652 lines of CSS by
 * hand to arrive at the same picture.
 *
 * A container query stacks the toolbar above the complete signature when
 * the entry narrows, preserving one declaration at every width.
 */
interface Props {
  symbol: ApiSymbol
  index: SymbolIndex
  /** Repository blob URL builder, for the source link. */
  sourceUrl?: (symbol: ApiSymbol) => string | undefined
  /** This entry's port. Enables the cross-language block; omit to hide it. */
  port?: string
  /** Declaration syntax, independent of library-port identity. */
  language?: string
  manualLinks?: { name: string; href: string }[]
  /** Catalog pages for a declaration in a source reference. */
  catalogLinks?: { name: string; href: string }[]
  /** Override equivalent links for a product or version context. */
  alternativesFor?: (symbol: ApiSymbol) => ReturnType<typeof referenceAlternatives>
  /**
   * This entry is a member of the page's subject.
   *
   * gp-sphinx gets the lighter treatment — no shadow, transparent header band,
   * tighter margin — from literal nesting: its methods live inside the class's
   * `<dd>`. This site renders them as siblings so the page is a flat list a
   * sidebar can index and a reader can scan, and says "nested" with a class
   * instead. Same picture, without burying 98 entries inside one description.
   */
  member?: boolean
  /** Open the member's own page from its declaration name. */
  nameHref?: string
  /**
   * This entry is the page's subject, not one of its members.
   *
   * A type at the top of its own page reads as a declaration — `class
   * libtmux.Server` — where the same type in a list reads as a name. gp-sphinx
   * draws the keyword and the module prefix for exactly this reason, and the
   * bases belong here too.
   */
  heading?: boolean
  /** The page header already carries this summary. */
  showSummary?: boolean
  /** A reference page may show these relationships beside its title. */
  showBases?: boolean
  /** Previous fragment for the same declaration. */
  legacyId?: string
}
const { symbol, index, sourceUrl, port, language = port, manualLinks, catalogLinks, alternativesFor, heading = false, member = false,
  showSummary = true, showBases = true, legacyId, nameHref } = Astro.props as Props
const anchor = symbol.publicId ?? symbol.id
const kind = symbol.kind
const nativeEntries = language === 'c' ? symbol.signatures.filter((signature) => signature.raw) : symbol.signatures
const signatureLayouts = await apiSignatureLayouts(symbol, language)
const nativeSignatureText: typeof unformattedNativeSignatureText = (entry, signature, port) =>
  signatureLayouts.get(signature)?.text ?? unformattedNativeSignatureText(entry, signature, port)

// A Swift layout is the declaration, even where the port documents few parameters.
// A Python layout only spaces the parameter list, which keeps its own markup.
const nativeSignatures = usesNativeSignatures(symbol, language) || (language === 'swift' && signatureLayouts.size > 0)

/**
 * The Sphinx domain this port's symbols belong to.
 *
 * `data-domain` is a hook gp-sphinx's rules read, so it has to carry a real
 * answer. Python is `py` and C++ is `cpp` because those domains exist and
 * mean this; TypeScript is `js` for the same reason. The other five have no
 * Sphinx domain at all, and `std` is what Sphinx itself uses for a thing it
 * has no domain for — claiming `py` for a Rust trait would be a lie a
 * consumer could act on.
 */
const DOMAIN: Record<string, string> = { py: 'py', ts: 'js', cxx: 'cpp', c: 'c' }
const domain = language ? (DOMAIN[language] ?? 'std') : 'py'

/**
 * An absent reason, split so its backticked symbol names render as code.
 *
 * The reason names symbols in another port, the way the rest of the
 * reference writes them, and rendering the string as-is printed the
 * backticks. `ApiDoc` is the wrong tool: it resolves a name against the
 * page's own port, and these names are deliberately from another one.
 *
 * A frontmatter function rather than an expression in the template. A regex
 * literal in the markup body parses as JSX, and `astro check` read the `<`
 * that never came as an unclosed tag through to the end of the file.
 */
const absentParts = (text?: string) => (text ?? '').split(/`([^`]+)`/)

const elsewhere = port ? (alternativesFor?.(symbol) ?? referenceAlternatives(port, anchor)).map((group) => ({
  ...group,
  ports: group.ports.filter((entry) => entry.port !== port).map((entry) => {
    const target = entry.publicId ? API_MODELS[entry.port]?.symbols.find((symbol) =>
      (symbol.publicId ?? symbol.id) === entry.publicId) : undefined
    return { ...entry, qualifiedName: target ? qualifiedNameOf(target) : entry.publicId }
  }),
})) : []

const inheritedHref = symbol.inheritedFrom
  ? index.resolve(symbol.inheritedFrom, 'class')?.href
  : undefined

/**
 * The source link, for inherited members too.
 *
 * Excluding them cost 24 of this page's 98 links — exactly the gap against
 * gp-sphinx. An inherited member records the file and line of the class that
 * *declares* it, which is where a reader wanting the code needs to go; the
 * entry already says which class that is.
 */
const source = sourceUrl?.(symbol)

/** The keyword a declaration of this kind opens with, where one exists. */
const KEYWORD: Record<string, string> = {
  class: 'class',
  exception: 'exception',
  interface: 'interface',
  struct: 'struct',
  union: 'union',
  enum: 'enum',
  trait: 'trait',
  typealias: 'type',
}
const keyword = heading ? KEYWORD[kind] : undefined

/**
 * The module path, shown only in heading mode.
 *
 * `libtmux.` before `Server`, dimmed — which is what tells a reader whether
 * two same-named types on different pages are the same type.
 */
const qualifiedName = qualifiedNameOf(symbol)
const prename = heading && qualifiedName.endsWith(symbol.name)
  ? qualifiedName.slice(0, qualifiedName.length - symbol.name.length)
  : ''

const bases = heading && showBases ? ((symbol as { extends?: string[] }).extends ?? []) : []

/** Python wraps by the columns the bar spends before its parameters, which differ by heading and member. */
const pythonLayouts = language === 'py' ? new Map(await Promise.all(symbol.signatures.map(async (signature) =>
  [signature, await pythonSignatureLayout(signature, { name: `${keyword ? `${keyword} ` : ''}${prename}${symbol.name}` })] as const))) : undefined

const examples = symbol.doc?.examples ?? []
const references = symbol.doc?.references ?? []

/**
 * Prose that discusses this symbol.
 *
 * The reverse of what `rehype-api-links` does: it sends a reader from a guide
 * to the reference, and this sends them back. Grouped by section, because
 * "explained in a concept" and "used in an example" are different offers.
 */
const mentions = port ? mentionsOf(port, symbol.id) : []
const tmuxCommands = manualLinks ?? (port ? tmuxCommandsFor(port, anchor).map((command) => ({ ...command, href: tmuxManualUrl('latest', command.name) })) : [])
// Members that wrap options or hooks lead to the catalog of what they take.
const catalogEntries = catalogLinks ?? (port && !manualLinks ? tmuxCatalogKindsForSymbol(port, symbol).map((kind) => ({ name: CATALOG_KINDS[kind].label, href: tmuxCatalogUrl('latest', kind) })) : [])
const mentionSections = [...new Set(mentions.map((m) => m.section ?? 'docs'))].sort()

const badges = [
  { label: symbol.command?.kind ?? kind, variant: 'kind' as const, value: kind },
  ...(symbol.package ? [{ label: symbol.package, variant: 'mod' as const, value: 'package' }] : []),
  ...symbol.modifiers.map((m) => ({ label: m, variant: 'mod' as const, value: m })),
  ...(symbol.signatures.length > 1 && symbol.modifiers.includes('overload')
    ? [
        {
          label: `${symbol.signatures.length} overloads`,
          variant: 'mod' as const,
          value: 'overload',
        },
      ]
    : []),
]

/**
 * The assigned value, for an attribute or constant that has one.
 *
 * `child_id_attribute = 'session_id'` is how gp-sphinx renders it and how the
 * source reads. The model carried `value` all along and nothing displayed it.
 */
const value = (symbol as { value?: string }).value

/**
 * A signature long enough to hide behind a summary.
 *
 * Ten parameters is gp-sphinx's own default and it is the right shape of
 * threshold: 44 of this estate's 5,641 signatures reach it, which is the
 * handful where the parameter list stops being a signature and starts being
 * a wall. Folding at three would hide 717 signatures that read fine.
 *
 * A `<details>` rather than gp-sphinx's button and hidden panel. It is the
 * same affordance with keyboard and screen-reader behaviour built in, it
 * works with scripting off, and a browser opens it by itself when a fragment
 * points inside — which is the case their `expandForHash` exists to handle.
 */
const FOLD_THRESHOLD = 10
/**
 * Decided per signature, not per symbol.
 *
 * An overload set has one entry and several signatures with different
 * parameter counts. Taking the last one's length and applying it to all of
 * them folded eight short signatures that read fine — 44 folds across 36
 * entries, where the two counts should have matched.
 */
const folds = (sig: { params: unknown[] }) => sig.params.length >= FOLD_THRESHOLD
const foldable = symbol.signatures.some(folds)

const { params, returns, raises, typeParameters } = apiEntryFields(symbol, language)
const methods = apiMethodDetails(symbol)
const overloadTargets = new Map(methods.map((method) => [method.overloadLabel, method.id]))
/**
 * Parameters declared by an enclosing type that this symbol's signature uses.
 * Their anchors live on the declaring page, so these entries link there instead of
 * repeating an id.
 */
const inheritedTypeParameters = index.inheritedTypeParameters(symbol).map((entry) => ({
  ...entry,
  ownerHref: entry.href.split('#')[0],
  ownerLabel: `${entry.owner.name}${typeParameterList(language, index.typeParametersDeclaredBy(entry.owner))}`,
}))
const hasTypeParameters = typeParameters.length > 0 || inheritedTypeParameters.length > 0
/** `const`, `in`, `out` and variance marks read as part of the name; `+` and `-` attach without a space. */
const modifierOf = (p: { modifier?: string }) => p.modifier ? (/^[+-]$/.test(p.modifier) ? p.modifier : `${p.modifier} `) : ''
const hasFields = hasTypeParameters || params.length > 0 || returns.length > 0 || raises.length > 0

/**
 * Whether there is a description at all.
 *
 * An empty `<dd>` still paints its padding and border, so an undocumented
 * attribute rendered as a header above an empty box. A definition list with a
 * term and no description is valid and reads correctly; a blank one is a gap
 * the reader has to interpret.
 */
const hasBody =
  mentions.length > 0 ||
  (symbol.doc?.admonitions?.length ?? 0) > 0 ||
  Boolean(symbol.doc?.changed) ||
  bases.length > 0 ||
  examples.length > 0 ||
  references.length > 0 ||
  Boolean(symbol.inheritedFrom) ||
  Boolean(symbol.exportedFrom) ||
  Boolean(symbol.publicOwner && symbol.publicOwner !== symbol.id) ||
  Boolean(showSummary && symbol.doc?.summary) ||
  Boolean(symbol.doc?.body) ||
  Boolean(symbol.doc?.deprecated) ||
  Boolean(symbol.command) ||
  methods.length > 0 ||
  hasFields ||
  tmuxCommands.length > 0 ||
  catalogEntries.length > 0 ||
  elsewhere.length > 0
---

<dl
  class:list={[
    'py',
    kind,
    'gp-sphinx-api-container',
    member && 'gp-sphinx-api-container--member',
    symbol.doc?.deprecated && 'gp-sphinx-badge--state-deprecated',
  ]}
>
  <dt
    class:list={['sig sig-object py gp-sphinx-api-header', nativeSignatures && 'api-native-header']}
    id={anchor}
    data-symbol-id={symbol.id}
    data-domain={domain}
    data-objtype={kind}
    data-badge-count={String(badges.length)}
    data-has-badges={String(badges.length > 0)}
    data-has-fold={String(foldable)}
    data-has-source={String(Boolean(source))}
    data-signature-expanded="false"
  >
    {legacyId && legacyId !== anchor && <span id={legacyId} class="section-anchor-alias" />}
    <div class="gp-sphinx-api-layout gp-sphinx-api-layout--responsive">
      <div class="gp-sphinx-api-layout-left">
        <span class="gp-sphinx-api-signature">
          {language === 'julia' && kind === 'typealias' && symbol.type && (
            <span class="api-native-signature"><span class="api-declaration-name">{symbol.name}</span> = <ApiType type={symbol.type} index={index} context={symbol} /></span>
          )}
          {nativeSignatures ? (nativeEntries.length ? nativeEntries.map((sig) => (
            <span class:list={['api-native-signature', port === 'fsharp' && 'api-native-signature--fsharp', signatureLayouts.has(sig) && 'api-native-signature--formatted']}
              tabindex={signatureLayouts.has(sig) ? '0' : undefined}
              role={signatureLayouts.has(sig) ? 'region' : undefined}
              aria-label={signatureLayouts.has(sig) ? `Signature for ${symbol.name}${symbol.signatures.length > 1 ? `, overload ${symbol.signatures.indexOf(sig) + 1} of ${symbol.signatures.length}` : ''}` : undefined}
              data-code-columns={signatureLayouts.get(sig)?.limit} data-code-width-status={signatureLayouts.has(sig) ? (signatureLayouts.get(sig)!.failures.length ? 'unresolved' : 'fits') : undefined} data-code-width-failures={signatureLayouts.get(sig)?.failures.length ? JSON.stringify(signatureLayouts.get(sig)!.failures) : undefined}>{sig.label && sig.label !== '__AllParameterSets' && <span class="api-native-signature-label">{sig.label}{sig.isDefault ? ' (default)' : ''}: </span>}<ApiType type={nativeSignatureText(symbol, sig, language)} index={index} context={symbol} signature={sig} nameHref={nameHref} layout={signatureLayouts.get(sig)} /></span>
          )) : <span class="api-native-signature">{anonymousDeclarationLabel(symbol)}</span>) : <>
          {keyword && <em class="property"><span class="pre">{keyword}</span> </em>}
          {prename && <span class="sig-prename descclassname"><span class="pre">{prename}</span></span>}<span class="sig-name descname">{nameHref ? <a class="api-signature-name-link pre" href={nameHref}>{symbol.name}</a> : <span class="pre">{symbol.name}</span>}</span>
          {
            symbol.signatures.length === 0 && symbol.type && (
              <>
                <span class="sig-paren">: </span>
                <ApiType type={symbol.type} index={index} context={symbol} />
              </>
            )
          }
          {
            symbol.signatures.length === 0 && value && (
              <>
                <span class="o"> = </span>
                <span class="default_value">{value}</span>
              </>
            )
          }
          {
            symbol.signatures.map((sig) => (
              <>
                {folds(sig) ? (
                  <details class="gp-sphinx-api-fold">
                    <summary class="gp-sphinx-api-signature-toggle">
                      <span class="sig-paren">(</span>
                      <span class="gp-sphinx-api-signature-preview">
                        {sig.params.length} parameters
                      </span>
                      <span class="sig-paren">)</span>
                    </summary>
                    <span class="gp-sphinx-api-signature-expanded">
                      <ApiSignatureParameters signature={sig} symbol={symbol} index={index} language={language} layout={pythonLayouts?.get(sig)} />
                    </span>
                  </details>
                ) : (
                  <ApiSignatureParameters signature={sig} symbol={symbol} index={index} language={language} layout={pythonLayouts?.get(sig)} />
                )}
                {sig.returns && (
                  <span class="sig-return">
                    <span class="sig-return-icon">{language === 'ts' ? ':' : '→'}</span>{' '}
                    <span class="sig-return-typehint">
                      {pythonLayouts?.get(sig)?.returns?.includes('\n')
                        ? <span class="api-signature-parameters--multiline"><ApiType type={pythonLayouts.get(sig)!.returns!} index={index} context={symbol} signature={sig} /></span>
                        : <ApiType type={pythonLayouts?.get(sig)?.returns ?? sig.returns} index={index} context={symbol} signature={sig} />}
                    </span>
                  </span>
                )}
              </>
            ))
          }
          </>}
        </span>
      </div>
      <div class="gp-sphinx-api-layout-right">
        <span class="gp-sphinx-api-slot gp-sphinx-api-slot--badges">
          {badges.map((b) => <ApiBadge label={b.label} variant={b.variant} value={b.value} />)}
        </span>
        {
          /*
           * The brackets are punctuation, not part of the link.
           *
           * `[source]` was one anchor, so hovering underlined the brackets
           * too and the click target included them. gp-sphinx's own viewcode
           * link is the whole thing, which is the one place this deliberately
           * differs — see notes/gp-sphinx-parity.md.
           *
           * The wrapper keeps the layout classes so the vendored rule making
           * this an inline-flex item in the header row still applies; only
           * the anchor inside it is new.
           */
          source && (
            <span class="gp-sphinx-api-source-link viewcode-link">
              <span class="pre">[<a class="api-source-anchor" href={source}>source</a>]</span>
            </span>
          )
        }
        <a class="headerlink" href={`#${anchor}`} title={`Permalink to ${symbol.name}`}>&#182;</a>
      </div>
    </div>
  </dt>

  {hasBody && (
  <dd>
    {symbol.exportedFrom && (
      <p class="gp-sphinx-api-facts">
        Exported from <ApiType type={symbol.exportedFrom} index={index} />
      </p>
    )}
    {
      symbol.inheritedFrom && (
        <p class="gp-sphinx-api-facts">
          Inherited from{' '}
          {inheritedHref ? (
            <a href={inheritedHref}>
              <code>{symbol.inheritedFrom}</code>
            </a>
          ) : (
            <code>{symbol.inheritedFrom}</code>
          )}
        </p>
      )
    }

    {
      symbol.publicOwner && symbol.publicOwner !== symbol.id && (
        <p class="gp-sphinx-api-facts">
          Public owner: <code>{symbol.publicOwner}</code>
        </p>
      )
    }

    {
      bases.length > 0 && (
        <div class="gp-sphinx-api-facts api-bases">
          <span class="api-bases-label">Bases:</span>
          <ul class="api-bases-list">
            {bases.map((b) => (
              <li>
                <ApiType type={b} index={index} context={symbol} chip />
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {showSummary && symbol.doc?.summary && (
      <p class="gp-sphinx-api-summary">
        <ApiDoc text={symbol.doc.summary} index={index} context={symbol} />
      </p>
    )}
    {symbol.doc?.body && (
      <div class="gp-sphinx-api-description" id={`${anchor}.description`}>
        <h2 class="rubric api-section-heading">Description<a class="api-heading-link" href={`#${anchor}.description`} aria-label="Link to Description">#</a></h2>
        <ApiProse text={symbol.doc.body} index={index} context={symbol} />
      </div>
    )}

    {symbol.command && (
      <div class="gp-sphinx-api-command" id={`${anchor}.command`}>
        <h2 class="rubric api-section-heading">Command details<a class="api-heading-link" href={`#${anchor}.command`} aria-label="Link to Command details">#</a></h2>
        <dl class="api-definition api-command-facts">
          {apiCommandFacts(symbol, Astro.url.pathname).map((fact) => <><dt>{fact.label}</dt><dd><ApiDoc text={fact.value} index={index} context={symbol} /></dd></>)}
        </dl>
        {apiCommandRelatedLinks(symbol, index).length > 0 && <div class="api-command-related">
          <span class="api-command-related__label">Related APIs</span>
          <ul>{apiCommandRelatedLinks(symbol, index).map((link) => <li><a href={link.href} class="api-xref">
            {link.symbol ? <><ApiBadge label={link.symbol.command?.kind ?? link.symbol.kind} value={link.symbol.command?.kind ?? link.symbol.kind} variant="kind" compact /><code>{link.text}</code></> : link.text}
          </a></li>)}</ul>
        </div>}
      </div>
    )}

    {methods.length > 0 && (
      <div class="gp-sphinx-api-methods" id={`${anchor}.methods`}>
        <h2 class="rubric api-section-heading">Methods<a class="api-heading-link" href={`#${anchor}.methods`} aria-label="Link to Methods">#</a></h2>
        {methods.map(({ id, label, signature }) => {
          const methodSource = signature.source && sourceUrl?.({ ...symbol, source: signature.source })
          return (
          <section id={id} class="api-method">
            {symbol.signatures.length > 1 ? <h3 class="api-native-signature"><ApiType type={nativeSignatureText(symbol, signature, language)} index={index} context={symbol} signature={signature} layout={signatureLayouts.get(signature)} />{methodSource && <span class="api-method-source">[<a href={methodSource} aria-label={`Source for ${label}`}>source</a>]</span>}<a class="api-heading-link" href={`#${id}`} aria-label="Link to method">#</a></h3>
              : methodSource && methodSource !== source && <p><span class="api-method-source">[<a href={methodSource} aria-label={`Source for ${label}`}>source</a>]</span></p>}
            {signature.extension && <p>Available when <code>{signature.extension}</code> is loaded.</p>}
            {signature.doc?.summary && <ApiProse text={signature.doc.summary} index={index} context={symbol} />}
            {signature.doc?.body && <ApiProse text={signature.doc.body} index={index} context={symbol} />}
          </section>
        )})}
      </div>
    )}

    {
      examples.length > 0 && (
        <div class="gp-sphinx-api-examples" id={`${anchor}.examples`}>
          <h2 class="rubric api-section-heading">Examples<a class="api-heading-link" href={`#${anchor}.examples`} aria-label="Link to Examples">#</a></h2>
          {examples.map((ex) => (
            <>
              {(ex.intro || ex.sourceUrl) && (
                <p class="gp-sphinx-api-example-intro">
                  {ex.intro && <ApiDoc text={ex.intro} index={index} context={symbol} />}
                  {ex.sourceUrl && <a class="api-example-source" href={ex.sourceUrl}>View source</a>}
                </p>
              )}
              <div class="gp-sphinx-api-example">
                {/* Preserve source comments, including Swift's required tools-version directive. */}
                <Code code={ex.code} lang={codeLang(ex.lang)} title="" />
              </div>
              {ex.outro && <div class="gp-sphinx-api-example-outro"><ApiDoc text={ex.outro} index={index} context={symbol} /></div>}
            </>
          ))}
        </div>
      )
    }

    {
      references.length > 0 && (
        <div class="gp-sphinx-api-references" id={`${anchor}.references`}>
          <h2 class="rubric api-section-heading">References<a class="api-heading-link" href={`#${anchor}.references`} aria-label="Link to References">#</a></h2>
          <dl class="citation">
            {references.map((r) => (
              <>
                <dt id={`citation-${r.name}`}>[{r.name}]</dt>
                <dd>
                  <p>
                    <ApiDoc text={r.text} index={index} context={symbol} />
                  </p>
                </dd>
              </>
            ))}
          </dl>
        </div>
      )
    }

    {
      symbol.doc?.deprecated && (
        <Aside type="caution" title="Deprecated">
          <ApiProse text={symbol.doc.deprecated} index={index} context={symbol} />
        </Aside>
      )
    }

    {
      symbol.doc?.changed && (
        <Aside type="note" title="Changed">
          <ApiProse text={symbol.doc.changed} index={index} context={symbol} />
        </Aside>
      )
    }

    {
      (symbol.doc?.admonitions ?? []).map((a) => (
        <Aside type={asideFor(a.kind).type} title={asideFor(a.kind).title}>
          <ApiProse text={a.text} index={index} context={symbol} />
        </Aside>
      ))
    }

    {
      hasFields && (
        <div class="gp-sphinx-api-parameters">
          <dl class="field-list simple">
            {hasTypeParameters && (
              <>
                <dt class="field-odd" id={`${anchor}.type-parameters`}>Type parameters</dt>
                <dd class="field-odd">
                  <ul class="simple api-parameters api-type-parameters">
                    {typeParameters.map((p, i) => (
                      <li id={typeParameters.findIndex((entry) => entry.name === p.name) === i ? typeParameterId(symbol, p.name) : undefined}>
                        <p class="api-parameter-heading">
                          <span class="api-parameter-signature">
                            {/* One line: Astro turns a line break between these parts into a space. */}
                            {p.modifier && <span class="api-type-parameter-modifier">{modifierOf(p)}</span>}<strong><a href={`#${encodeURIComponent(typeParameterId(symbol, p.name))}`}><code>{p.name}</code></a></strong>
                          </span>
                          <a class="api-heading-link" href={`#${encodeURIComponent(typeParameterId(symbol, p.name))}`} aria-label={`Link to ${p.name} type parameter`} data-pagefind-ignore="all">#</a>
                          <ApiFieldOverloads labels={p.overloads} targets={overloadTargets} />
                        </p>
                        {(p.bound || p.default) && (
                          <p class="api-type-parameter-facts">
                            {p.bound && <span class="api-type-parameter-fact"><span class="api-type-parameter-label">{boundLabel(language, p)}</span>{' '}<ApiType type={p.bound} index={index} context={symbol} /></span>}
                            {p.default && <span class="api-type-parameter-fact"><span class="api-type-parameter-label">Default</span>{' '}<ApiType type={p.default} index={index} context={symbol} /></span>}
                          </p>
                        )}
                        {p.doc && <ApiProse text={p.doc} index={index} context={symbol} />}
                      </li>
                    ))}
                    {inheritedTypeParameters.map(({ owner, parameter: p, href, ownerHref, ownerLabel }) => (
                      <li>
                        <p class="api-parameter-heading">
                          <span class="api-parameter-signature">
                            {p.modifier && <span class="api-type-parameter-modifier">{modifierOf(p)}</span>}<strong><a href={href}><code>{p.name}</code></a></strong>
                          </span>
                          <span class="api-type-parameter-owner">declared by <a href={ownerHref}><code>{ownerLabel}</code></a></span>
                        </p>
                        {(p.bound || p.default) && (
                          <p class="api-type-parameter-facts">
                            {p.bound && <span class="api-type-parameter-fact"><span class="api-type-parameter-label">{boundLabel(language, p)}</span>{' '}<ApiType type={p.bound} index={index} context={owner} /></span>}
                            {p.default && <span class="api-type-parameter-fact"><span class="api-type-parameter-label">Default</span>{' '}<ApiType type={p.default} index={index} context={owner} /></span>}
                          </p>
                        )}
                        {p.doc && <ApiProse text={p.doc} index={index} context={owner} />}
                      </li>
                    ))}
                  </ul>
                </dd>
              </>
            )}
            {params.length > 0 && (
              <>
                <dt class="field-odd" id={`${anchor}.parameters`}>Parameters</dt>
                <dd class="field-odd">
                  {symbol.command ? <ApiCommandParameters params={params} symbol={symbol} index={index} /> : <ul class="simple api-parameters">
                    {params.map((p, i) => (
                      <li id={params.findIndex((entry) => entry.name === p.name) === i ? parameterId(symbol, p.name) : undefined}>
                        <p class:list={[(language === 'julia' || language === 'ts') && 'api-parameter-heading']}>
                          <span class="api-parameter-signature">
                            {/* One line: Astro turns a line break between these parts into a space. */}
                            <strong><a href={`#${encodeURIComponent(parameterId(symbol, p.name))}`}><code>{p.name}</code></a></strong>{p.optional && '?'}{(language === 'julia' || language === 'ts') && p.default !== undefined && <>{' = '}<code>{p.default}</code></>}{p.type && <>{' ('}<ApiType type={p.type} index={index} context={symbol} language={language} />{') '}</>}
                          </span>
                          <a class="api-heading-link" href={`#${encodeURIComponent(parameterId(symbol, p.name))}`} aria-label={`Link to ${p.name} parameter`} data-pagefind-ignore="all">#</a>
                          {p.doc && !['julia', 'ts'].includes(language ?? '') && <>{' – '}<ApiDoc text={p.doc} index={index} context={symbol} /></>}
                          {p.since && <span class="gp-sphinx-api-param-since">added {p.since}</span>}
                          {p.deprecated && (
                            <span class="gp-sphinx-api-param-deprecated">
                              deprecated {p.deprecated}
                            </span>
                          )}
                          <ApiFieldOverloads labels={p.overloads} targets={overloadTargets} />
                        </p>
                        {p.doc && ['julia', 'ts'].includes(language ?? '') && <ApiProse text={p.doc} index={index} context={symbol} />}
                        {p.binding && <p class="api-parameter-binding"><ApiDoc text={parameterBindingText(p)!} index={index} context={symbol} /></p>}
                      </li>
                    ))}
                  </ul>}
                </dd>
              </>
            )}
            {returns.length > 0 && (
              <>
                <dt class="field-even" id={`${anchor}.returns`}>Returns</dt>
                <dd class="field-even">
                  {returns.map((entry) => (
                    <p>
                      <ApiDoc text={entry.doc} index={index} context={symbol} />
                      <ApiFieldOverloads labels={entry.overloads} targets={overloadTargets} />
                    </p>
                  ))}
                </dd>
              </>
            )}
            {raises.length > 0 && (
              <>
                <dt class="field-odd" id={`${anchor}.errors`}>Raises</dt>
                <dd class="field-odd">
                  <ul class="simple">
                    {raises.map((r) => (
                      <li>
                        <p>
                          <ApiType type={r.type} index={index} context={symbol} />
                          {r.doc && (
                            <>
                              {' – '}
                              <ApiDoc text={r.doc} index={index} context={symbol} />
                            </>
                          )}
                          <ApiFieldOverloads labels={r.overloads} targets={overloadTargets} />
                        </p>
                      </li>
                    ))}
                  </ul>
                </dd>
              </>
            )}
          </dl>
        </div>
      )
    }

    {tmuxCommands.length > 0 && <p class="gp-sphinx-api-mentions">
      <span class="gp-sphinx-api-mentions-label">tmux command</span>
      {tmuxCommands.map((command, i) => <>
        {i > 0 && ', '}
        <a href={command.href}><code>{command.name}</code></a>
      </>)}
    </p>}
    {catalogEntries.length > 0 && <p class="gp-sphinx-api-mentions">
      <span class="gp-sphinx-api-mentions-label">tmux catalog</span>
      {catalogEntries.map((entry, i) => <>
        {i > 0 && ', '}
        <a href={entry.href}>{entry.name}</a>
      </>)}
    </p>}
    {
      mentions.length > 0 && (
        <p class="gp-sphinx-api-mentions">
          <span class="gp-sphinx-api-mentions-label">Discussed in</span>
          {mentionSections.map((section, i) => (
            <>
              {i > 0 && <span class="gp-sphinx-api-mentions-sep"> · </span>}
              {mentions
                .filter((m) => (m.section ?? 'docs') === section)
                .map((m, j) => (
                  <>
                    {j > 0 && ', '}
                    <a href={proseHref(m.page, SITE_ROOT)}>{m.title ?? m.page}</a>
                  </>
                ))}
            </>
          ))}
        </p>
      )
    }

    {
      elsewhere.map((c) => (
        <details class="api-elsewhere">
          <summary>
            In other ports <span class="api-elsewhere-label">{c.label}</span>
          </summary>
          <ul>
            {c.ports.map((e) => (
              <li>
                <span class="api-elsewhere-port">{e.name}</span>
                <div class="api-elsewhere-value">
                  {e.href ? (
                    <a href={e.href}>
                      {e.kind && <ApiBadge label={e.kind} value={e.kind} variant="kind" compact preview={false} />}
                      <code>{e.qualifiedName}</code>
                    </a>
                  ) : e.publicId ? (
                    <code>{e.qualifiedName}</code>
                  ) : (
                    <span class="api-elsewhere-absent">
                      {absentParts(e.absent).map((part, i) =>
                        i % 2 ? <code>{part}</code> : part,
                      )}
                    </span>
                  )}
                  {e.note && API_MODELS[e.port] && <p class="api-elsewhere-note">
                    <ApiDoc text={e.note} index={productApiIndex(API_MODELS[e.port], defaultVersionFor(e.port))} />
                  </p>}
                </div>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </dd>
  )}
</dl>
