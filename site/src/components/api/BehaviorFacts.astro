---
/**
 * What a call promises, next to the signature it qualifies: completion, bounds, ownership, errors, transport.
 *
 * Each row is a sentence the declaration's own doc comment states, kept verbatim, with the line it stands on at the
 * pinned revision. A row with nothing stated is omitted; the grid never says "unknown" and never borrows a fact from
 * another port. The full doc comment still renders under Description. Error and type names in a fact are
 * cross-references, resolved the way the rest of the entry resolves them.
 */
import type { ApiSymbol, SymbolIndex } from '@libtmux/api-model'
import ApiDoc from './ApiDoc.astro'

interface Props {
  symbol: ApiSymbol
  index: SymbolIndex
  /** The link a citation opens: the line at the pinned revision, on the site or on GitHub. */
  sourceUrl?: (symbol: ApiSymbol) => string | undefined
}
const { symbol, index, sourceUrl } = Astro.props as Props
const behavior = symbol.behavior
const LABELS = {
  completion: 'Completion', boundedBy: 'Bounded by', returns: 'Returns', ownership: 'Ownership', mutation: 'Mutation',
  errors: 'Errors', transport: 'Transport', cleanup: 'Cleanup',
} as const
const ORDER = ['completion', 'boundedBy', 'returns', 'ownership', 'mutation', 'errors', 'transport', 'cleanup'] as const
const base = (file: string) => file.split('/').at(-1)!
// The first citation names its file; the next ones in the same file give only the line.
const seen = new Set<string>()
const rows = behavior ? ORDER.flatMap((row) => {
  const fact = behavior[row]
  if (!fact) return []
  const place = seen.has(fact.source.file) ? `:${fact.source.line}` : `${base(fact.source.file)}:${fact.source.line}`
  seen.add(fact.source.file)
  const kind = fact.origin === 'doc comment' ? 'doc comment' : fact.origin === 'signature' ? 'signature' : fact.via ? `${fact.via} doc` : 'curated'
  return [{ row, label: LABELS[row], fact, citation: `${kind} · ${place}`, href: sourceUrl?.({ ...symbol, source: { ...symbol.source, file: fact.source.file, line: fact.source.line } }) }]
}) : []
const requires = behavior?.requires
const requiresRow = requires?.tmux ? {
  text: `Needs tmux ${requires.tmux}.`, citation: `doc comment · ${seen.has(requires.source.file) ? '' : base(requires.source.file)}:${requires.source.line}`,
  href: sourceUrl?.({ ...symbol, source: { ...symbol.source, file: requires.source.file, line: requires.source.line } }),
} : undefined
---
{(rows.length > 0 || requiresRow) && <div class="api-behavior"><dl class="api-behavior__grid" aria-label={`Behaviour of ${symbol.name}`}>
  {rows.map(({ row, label, fact, citation, href }) => <div data-row={row}>
    <dt>{label}</dt>
    <dd><ApiDoc text={fact.text} index={index} context={symbol} citations={false} />{href ? <a class="api-behavior__src" href={href}>{citation}</a> : <span class="api-behavior__src">{citation}</span>}</dd>
  </div>)}
  {requiresRow && <div data-row="requires">
    <dt>tmux version</dt>
    <dd>{requiresRow.text}{requiresRow.href ? <a class="api-behavior__src" href={requiresRow.href}>{requiresRow.citation}</a> : <span class="api-behavior__src">{requiresRow.citation}</span>}</dd>
  </div>}
</dl></div>}
<style is:global>
  /*
   * The rows are cells of one grid with a hairline between them, so the facts read as part of the declaration's own
   * block. Cells draw their own end and bottom lines and the grid is pulled over the clip by one pixel, so a last row
   * that is not full leaves page ground, not a grey block.
   */
  .api-behavior { margin: 0 0 1rem; border: 1px solid var(--color-background-border); border-radius: var(--radius-md, 6px); overflow: hidden; }
  /* Under the signature, inside the entry's own border: edge to edge, with no box of its own. */
  dl.py > dd > .api-behavior:first-child { margin: -0.75rem -1rem 0.75rem; border: 0; border-block-end: 1px solid var(--color-background-border); border-radius: 0; }
  .api-behavior__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); margin: 0 -1px -1px 0; padding: 0; }
  .api-behavior__grid > div { padding: 8px 12px; border-inline-end: 1px solid var(--color-background-border); border-block-end: 1px solid var(--color-background-border); background: var(--background-color); }
  .api-behavior__grid dt { margin: 0; font: 600 12px/16px var(--font-sans, sans-serif); letter-spacing: .04em; text-transform: uppercase; color: var(--color-foreground-muted); }
  .api-behavior__grid dd { margin: 2px 0 0; padding: 0; font-size: 14px; line-height: 20px; }
  .api-behavior__grid dd code { font-size: 13px; }
  .api-behavior__src { display: block; margin-top: 2px; font-size: 12px; line-height: 16px; color: var(--color-foreground-muted); text-decoration: none; }
  a.api-behavior__src:hover { color: var(--color-link); text-decoration: underline; }
  a.api-behavior__src:focus-visible { outline: 2px solid var(--focus-ring-color, var(--theme-primary)); outline-offset: 2px; }
  @media print { .api-behavior { break-inside: avoid; } }
</style>
