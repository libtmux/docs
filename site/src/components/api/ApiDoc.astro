---
import type { ApiSymbol, SymbolIndex, LinkTarget } from '@libtmux/api-model'
import { linkTmuxDoc } from '../../lib/tmux-links'
import { plainMention, TMUX_KIND_TITLES } from '../../lib/mention-badge'
import { ENVIRONMENT_VARIABLE, formKind, isWithin, writtenForm } from '../../lib/symbol-form'

/**
 * Doc-comment prose with its cross-references resolved.
 *
 * 93.5% of libtmux's docstring references land on a real symbol. The rest —
 * chained calls whose receiver type is not knowable without inference, and a
 * handful of stale references to methods that no longer exist — render as
 * plain text, which is what Sphinx does when it cannot resolve one either.
 */
interface Props {
  text: string
  index: SymbolIndex
  /** The symbol this doc belongs to, so `:attr:`.panes`` can resolve. */
  context?: ApiSymbol
  /**
   * Whether a citation should link.
   *
   * `[server_manual]` points at this page's own References section, which
   * only the entry that owns the docstring renders. A summary reproduced
   * somewhere else — the port index, a member list — has no such section, so
   * the link would resolve to nothing. The label still reads correctly.
   */
  citations?: boolean
  /** A name in a directory: drawn as a chip, without its owner's name on the owner's page. */
  chip?: boolean
}
const { text, index, context, citations = true, chip = false } = Astro.props as Props
// Through the index, so the tokenizer knows which language's spelling of a
// cross-reference it is reading. Tokenizing here meant reST for all eight.
const spans = linkTmuxDoc(index.docSpans(text, context))
const memberReference = /^(?:[\w$]+(?:\.[\w$]+)*)?#[^\s#]+(?:\([^#]*\))?$/
const labelParts = (label: string, qualified: boolean) => qualified ? label.split(/(#)/) : [label]

/** A link to a declaration of this site names its kind in the tooltip and the accessible name; api.css tints it, so prose draws no badge. */
function mentionOf(link: LinkTarget | undefined, kind: string | undefined, title: string | undefined, label: string) {
  if (!kind || link?.external || link?.href === undefined) return undefined
  return plainMention(kind, label, title)
}
---
<span>{
  spans.map((span) => {
    if (span.kind === 'link') {
      // A tmux command is never written as a call, in any language.
      const text = span.tmux === 'command' ? writtenForm({ lang: index.language, kind: 'command', label: span.text }) : span.text
      const mention = span.tmux ? mentionOf({ href: span.href, external: false }, span.tmux, TMUX_KIND_TITLES[span.tmux], text) : undefined
      const name = span.code ? <code class="api-literal api-literal--link">{text}</code> : text
      if (mention) return <a class="tmux-mention api-doc-link" href={span.href} rel="noopener" title={mention.title} data-api-kind={mention.dataApiKind} aria-label={mention.ariaLabel}>{name}</a>
      return <a href={span.href} rel="noopener">{name}</a>
    }
    if (span.kind === 'code') return <code class="api-literal">{ENVIRONMENT_VARIABLE.test(span.text) ? writtenForm({ lang: index.language, kind: 'environment', label: span.text }) : span.text}</code>
    if (span.kind === 'kbd') return <kbd>{span.text}</kbd>
    if (span.kind === 'strong') return <strong>{span.text}</strong>
    if (span.kind === 'emphasis') return <em>{span.text}</em>
    if (span.kind === 'text') return <span>{span.text}</span>
    // A citation points into this page's own References section, which is
    // rendered only when the docstring defines one. Where it does not, the
    // label still reads correctly as `[name]`.
    if (span.kind === 'citation') {
      return citations ? (
        <a class="citation-reference" href={`#citation-${span.target}`}>{span.label}</a>
      ) : (
        <span>{span.label}</span>
      )
    }
    // An environment variable is named without the shell's sigil, and is no member to link.
    const environment = !span.link && ENVIRONMENT_VARIABLE.test(span.label)
    const parts = span.link ? [] : environment ? [{ text: writtenForm({ lang: index.language, kind: 'environment', label: span.label }) }] : span.parts ?? index.linkLiteral(span.label, context)
    const symbol = span.link?.symbol
    // A chip on its owner's page drops the owner: `Server.Open` reads `Open` beside Server's other members.
    const own = chip && context ? [`${context.name}.`, `${context.name}::`, `${context.name}#`, `${context.name}:`, `${context.name}/`, '#'].find((prefix) => span.label.startsWith(prefix)) : undefined
    const bare = own ? span.label.slice(own.length) : span.label
    // A symbol is written the way its language's own documentation writes it: `kill()` in Python, `Server#kill` in Ruby.
    const owner = symbol && index.parentOf(symbol)
    // A tool is named on the wire, as a command is, and is not called by that name.
    const label = symbol ? writtenForm({
      lang: index.language, kind: index.isMcpTool(symbol) ? 'command' : formKind(index.language, symbol, owner), symbol, owner, label: bare, chip,
      onOwnerPage: isWithin(context, owner, (scope) => index.parentOf(scope)),
    }) : bare
    const qualified = !chip && memberReference.test(label) && Boolean(span.link || parts.some((part) => part.link))
    // The accessible name is the text a reader sees.
    const mention = mentionOf(span.link, symbol?.kind, symbol?.command?.kind ?? symbol?.kind, label)
    const name = <code class="api-literal api-literal--link">{labelParts(label, qualified).map((text) => qualified && text === '#' ? <span class="api-reference-separator">{text}</span> : text)}</code>
    if (span.link && mention) return (
      <a class:list={['api-xref api-mention api-doc-link', { 'api-mention--chip': chip }]} href={span.link.href} title={mention.title} data-api-kind={mention.dataApiKind} aria-label={mention.ariaLabel}>{name}</a>
    )
    return span.link ? (
      <a class="api-xref" href={span.link.href} rel={span.link.external ? 'nofollow noopener' : undefined}>{name}</a>
    ) : (
      <code class="api-literal">{parts.map((part) => {
        const separated = labelParts(part.text, qualified).map((text) => qualified && text === '#' ? <span class="api-reference-separator">{text}</span> : text)
        if (!part.link) return separated
        // A name linked inside a longer literal is a mention like any other: its kind is its ink, and the literal keeps its frame.
        const kind = part.link.symbol?.kind
        const inside = mentionOf(part.link, kind, part.link.symbol?.command?.kind ?? kind, part.text)
        return <a class:list={['api-xref api-literal--link', inside && 'api-mention api-doc-link']} href={part.link.href} title={inside?.title} data-api-kind={inside?.dataApiKind} aria-label={inside?.ariaLabel}>{separated}</a>
      })}</code>
    )
  })
}</span>
