---
/**
 * A kind or modifier badge.
 *
 * gp-sphinx puts one on every entry and it is most of what makes its
 * reference scannable: you can tell a property from a method from an
 * inherited attribute without reading a signature. Kinds are filled and
 * coloured; modifiers are outline-only, so exactly one thing per entry is
 * loud.
 */
import { kindMark } from '../../lib/api-labels'
import { apiGlossaryHref } from '../../lib/api-glossary'
interface Props {
  label: string
  variant: 'kind' | 'mod'
  /** Drives the palette class: the symbol kind, or the modifier name. */
  value: string
  /** The small symbol mark shared by navigation and related APIs. */
  compact?: boolean
  /** Cards already provide context; their badges keep ordinary glossary links. */
  preview?: boolean
}
const { label, variant, value, compact = false, preview = true } = Astro.props as Props
const palette = value === 'cmdlet' ? 'function' : value
const text = compact ? kindMark(palette) : label
// Cmdlets use the function palette but retain their PowerShell command kind.
const href = compact ? undefined : apiGlossaryHref(variant === 'kind' ? label : value, Astro.url.pathname)
// Compact marks already sit inside navigation links.
const Tag = href ? 'a' : 'span'
---
{text && <Tag
  href={href}
  data-link-preview={href && preview ? '' : undefined}
  class:list={compact ? ['api-nav__kind', `api-badge--kind-${palette}`] : [
    'api-badge',
    `api-badge--${variant}`,
    `api-badge--${variant}-${palette}`,
  ]}
  title={preview ? compact ? value : variant === 'kind' ? `${label} (kind)` : label : undefined}
  aria-label={href ? `${label}: read the ${variant === 'kind' ? label : value} definition in the API glossary` : undefined}
  aria-hidden={compact ? 'true' : undefined}
><span class="api-badge__label">{text}</span></Tag>}
