---
/**
 * A kind or modifier badge.
 *
 * A kind has three forms. In a heading or a declaration header it is the
 * legend chip: the mark and the word in one token, so the heading teaches the
 * letter every time. Inside a link or a navigation row it is the compact mark.
 * Beside a name in a list or a table it is the plain word. Modifiers are
 * outline-only words, so kind stays the loudest thing.
 */
import { kindLabel, kindMark, kindPalette, markClass } from '../../lib/api-labels'
import { apiGlossaryHref } from '../../lib/api-glossary'
interface Props {
  label: string
  variant: 'kind' | 'mod'
  /** Drives the palette class: the symbol kind, or the modifier name. */
  value: string
  /** The small symbol mark shared by navigation and related APIs. */
  compact?: boolean
  /** A kind beside a name in a list or a table: the plain word, no chip. */
  plain?: boolean
  /** Cards already provide context; their badges keep ordinary glossary links. */
  preview?: boolean
}
const { label, variant, value, compact = false, plain = false, preview = true } = Astro.props as Props
const palette = kindPalette(value)
const word = kindLabel(label)
const text = compact ? kindMark(value) : word
// Cmdlets use the function palette but retain their PowerShell command kind.
const href = compact || plain ? undefined : apiGlossaryHref(variant === 'kind' ? label : value, Astro.url.pathname)
// Compact marks already sit inside navigation links.
const Tag = href ? 'a' : 'span'
const legend = variant === 'kind' && !compact && !plain
const mark = legend ? kindMark(value) : undefined
---
{plain && variant === 'kind' && label && <span class={`api-kind-word api-badge--kind-${palette}`}>{word}</span>}
{legend && label && <Tag
  href={href}
  data-link-preview={href && preview ? '' : undefined}
  class:list={['api-badge', 'api-badge--kind', `api-badge--kind-${palette}`, 'api-leg']}
  data-mark={mark ? markClass(mark) : undefined}
  title={preview ? `${word} (kind)` : undefined}
  aria-label={href ? `${word}: read the ${word} definition in the API glossary` : undefined}
>{mark && <span class="api-leg__m" aria-hidden="true"><span class="api-leg__g" data-mark={markClass(mark)}>{mark}</span></span>}<span class="api-leg__w"><span class="api-badge__label api-leg__wl">{word}</span></span></Tag>}
{!plain && !legend && text && <Tag
  href={href}
  data-link-preview={href && preview ? '' : undefined}
  class:list={compact ? ['api-nav__kind', `api-badge--kind-${palette}`] : [
    'api-badge',
    `api-badge--${variant}`,
    `api-badge--${variant}-${palette}`,
  ]}
  title={preview ? compact ? kindLabel(value) : variant === 'kind' ? `${word} (kind)` : label : variant === 'mod' && !compact ? label : undefined}
  aria-label={href ? `${word}: read the ${variant === 'kind' ? word : value} definition in the API glossary` : undefined}
  aria-hidden={compact ? 'true' : undefined}
><span class="api-badge__label" data-mark={compact ? markClass(text) : undefined}>{text}</span></Tag>}
