---
/**
 * A kind or modifier badge.
 *
 * gp-sphinx puts one on every entry and it is most of what makes its
 * reference scannable: you can tell a property from a method from an
 * inherited attribute without reading a signature. Kinds are filled and
 * coloured; modifiers are outline-only, so exactly one thing per entry is
 * loud.
 */
import { kindMark } from '../../lib/api-labels'
interface Props {
  label: string
  variant: 'kind' | 'mod'
  /** Drives the palette class: the symbol kind, or the modifier name. */
  value: string
  /** The small symbol mark shared by navigation and related APIs. */
  compact?: boolean
}
const { label, variant, value, compact = false } = Astro.props as Props
const text = compact ? kindMark(value) : label
---
{text && <span
  class:list={compact ? ['api-nav__kind', `api-badge--kind-${value}`] : [
    'api-badge',
    `api-badge--${variant}`,
    `api-badge--${variant}-${value}`,
  ]}
  title={compact ? value : variant === 'kind' ? `${label} (kind)` : label}
  aria-hidden={compact ? 'true' : undefined}
>{text}</span>}
