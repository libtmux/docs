---
import type { KeywordHelp } from '@libtmux/api-model'
import LinkPreview from '../LinkPreview.astro'

interface Props {
  text: string
  help: KeywordHelp
}
const { text, help } = Astro.props
// Request-local numbering keeps repeated words unique without random build bytes.
const locals = Astro.locals as { apiKeywordSequence?: number }
const id = `api-keyword-help-${locals.apiKeywordSequence = (locals.apiKeywordSequence ?? 0) + 1}`
---
<button type="button" class="api-type-label api-keyword api-keyword-trigger"
  popovertarget={id} popovertargetaction="show" aria-label={`About ${text}: ${help.title}`}
>{text}</button><LinkPreview id={id} title={help.title} description={help.description}
  href={help.href} actionLabel="Language documentation" class="api-keyword-help" />

<style>
  .api-keyword-trigger {
    display: inline;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font: inherit;
    cursor: help;
    text-decoration: underline dotted;
    text-decoration-color: currentColor;
    text-underline-offset: 0.2em;
  }
  .api-keyword-trigger:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 3px;
  }
</style>

<script>
  import { positionLinkPreview } from '../../lib/link-preview-browser'
  const place = (panel: HTMLElement) => {
    const trigger = document.querySelector<HTMLElement>(`[popovertarget="${panel.id}"].api-keyword-trigger`)
    if (trigger) positionLinkPreview(panel, trigger)
  }
  // Native activation opens the popover after beforetoggle; place it before paint.
  document.addEventListener('beforetoggle', (event) => {
    const panel = event.target
    if (panel instanceof HTMLElement && panel.matches('.api-keyword-help') &&
      (event as ToggleEvent).newState === 'open') requestAnimationFrame(() => place(panel))
  }, true)
  const placeOpen = () => document.querySelectorAll<HTMLElement>('.api-keyword-help:popover-open').forEach(place)
  window.addEventListener('resize', placeOpen)
  window.addEventListener('scroll', placeOpen, { passive: true })
  const triggerFor = (target: EventTarget | null) => target instanceof Element
    ? target.closest<HTMLButtonElement>('.api-keyword-trigger') : null
  const show = (trigger: HTMLButtonElement | null, previous?: EventTarget | null) => {
    const panel = trigger?.popoverTargetElement
    if (!(panel instanceof HTMLElement) || !panel.showPopover ||
      (previous instanceof Node && panel.contains(previous))) return
    panel.showPopover({ source: trigger! })
  }
  document.addEventListener('pointerover', (event) => {
    if (event.pointerType === 'mouse') show(triggerFor(event.target))
  })
  document.addEventListener('focusin', (event) => show(triggerFor(event.target), event.relatedTarget))
  const dismissUnused = () => {
    for (const panel of document.querySelectorAll<HTMLElement>('.api-keyword-help:popover-open')) {
      const trigger = document.querySelector(`[popovertarget="${panel.id}"].api-keyword-trigger`)
      if (!panel.matches(':hover, :focus-within') && !trigger?.matches(':hover, :focus')) panel.hidePopover()
    }
  }
  document.addEventListener('pointerout', (event) => {
    if (event.target instanceof Element && event.target.closest('.api-keyword-trigger, .api-keyword-help')) {
      setTimeout(dismissUnused, 150)
    }
  })
  document.addEventListener('focusout', () => setTimeout(dismissUnused, 0))
</script>
