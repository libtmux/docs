---
/**
 * One level of the reference tree, and every level under it.
 *
 * Microsoft Learn's shape: a leaf is the link itself (`li role=none > a
 * role=treeitem`), and a branch is an `li role=treeitem` whose row holds a
 * link to its own page, a count and a chevron, with its children in a
 * `role=group`. The link is not the treeitem on a branch, so clicking it
 * navigates and clicking the rest of the row toggles, and one row is never
 * two controls at once.
 */
import SymbolName from './SymbolName.astro'
import ApiBadge from './ApiBadge.astro'
import type { SidebarNode } from '../../lib/api-sidebar'

export type TreeNode = SidebarNode

interface Props {
  nodes: TreeNode[]
}

const { nodes } = Astro.props as Props
const items = nodes.filter((node) => !node.section && !node.heading)
---

{
  nodes.map((node) =>
    node.heading ? (
      <li role="none" class="api-nav__section api-nav__caption"><span>{node.label}</span></li>
    ) : node.section ? (
      <li role="none" class="api-nav__section"><span>{node.label}</span><span>{node.count} {node.section}</span></li>
    ) : node.disabled ? (
      <li role="none"><span role="treeitem" class="api-nav__row api-nav__leaf" aria-disabled="true"
        aria-level={node.level} aria-setsize={items.length} aria-posinset={items.indexOf(node) + 1} tabindex={node.tab ? '0' : '-1'}
        aria-description="No objects advertised in the reference configuration" style={`--level:${node.level}`}>
        <span class="api-nav__label">{node.labelHtml ? <Fragment set:html={node.labelHtml} /> : <SymbolName name={node.label} />}</span>
        <span class="api-nav__count">{node.count}</span>
      </span></li>
    ) : node.expanded !== undefined ? (
      <li
        role="treeitem"
        class="api-nav__item"
        aria-level={node.level}
        aria-setsize={items.length}
        aria-posinset={items.indexOf(node) + 1}
        aria-expanded={node.expanded ? 'true' : 'false'}
        aria-labelledby={node.count !== undefined ? `${node.id} ${node.id}-count` : node.id}
        aria-description={node.kind}
        tabindex={node.tab ? '0' : '-1'}
        data-lazy={node.lazy}
      >
        <div class="api-nav__row" style={`--level:${node.level}`}>
          <span class="api-nav__chevron" aria-hidden="true" />
          {node.kind && !node.quiet && <ApiBadge label={node.kind} variant="kind" value={node.kind} compact />}
          {node.href ? (
            <a class="api-nav__label" id={node.id} href={node.href} data-api-shortcut={node.shortcut || undefined} tabindex="-1" aria-current={node.current ? 'page' : undefined}>
              {node.labelHtml ? <Fragment set:html={node.labelHtml} /> : <SymbolName name={node.label} />}
            </a>
          ) : (
            <>
              <span class="api-nav__label" id={node.id}>
                {node.labelHtml ? <Fragment set:html={node.labelHtml} /> : <SymbolName name={node.label} />}
              </span>
              {node.fallbackHref && <noscript><a class="api-nav__label" href={node.fallbackHref}>{node.labelHtml ? <Fragment set:html={node.labelHtml} /> : <SymbolName name={node.label} />}</a></noscript>}
            </>
          )}
          {node.count !== undefined && (
            <span class="api-nav__count" id={`${node.id}-count`}>
              {node.count}
            </span>
          )}
        </div>
        {node.children && (
          <ul role="group" class="api-nav__group">
            <Astro.self nodes={node.children} />
          </ul>
        )}
      </li>
    ) : (
      <li role="none">
        <a
          role="treeitem"
          class="api-nav__row api-nav__leaf"
          aria-level={node.level}
          aria-setsize={items.length}
          aria-posinset={items.indexOf(node) + 1}
          href={node.href}
          data-api-shortcut={node.shortcut || undefined}
          tabindex={node.tab ? '0' : '-1'}
          aria-current={node.current ? 'page' : undefined}
          aria-description={node.kind}
          target={node.external ? '_blank' : undefined}
          rel={node.external ? 'noopener noreferrer' : undefined}
          style={`--level:${node.level}`}
        >
          {node.kind && !node.quiet && <ApiBadge label={node.kind} variant="kind" value={node.kind} compact />}
          <span class="api-nav__label">
            {node.labelHtml ? <Fragment set:html={node.labelHtml} /> : <SymbolName name={node.label} />}
          </span>
          {node.count !== undefined && <span class="api-nav__count">{node.count}</span>}
          {node.external && <span class="api-nav__external" aria-hidden="true">&#8599;&#65038;</span>}
          {node.external && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
      </li>
    ),
  )
}
