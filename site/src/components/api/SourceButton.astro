---
/**
 * The source control in a signature header: a legend chip beside the kind
 * badge. With the pane's script it opens the declaration's source beside the
 * page; without it, it is the link it replaced, to GitHub at the pinned
 * revision. A symbol with no cached file keeps the plain `[source]` link, so
 * no control offers a view that cannot load.
 */
import type { ApiSymbol } from '@libtmux/api-model'
import { hasSourceView } from '../../lib/api-source-pages'
import '../../styles/source.css'

interface Props {
  symbol: ApiSymbol
  port?: string
  /** Where the source is without the pane: GitHub at the pinned revision, or the page of an embedded file. */
  href: string
}
const { symbol, port, href } = Astro.props as Props
const { file, line } = symbol.source ?? {}
const available = hasSourceView(port, symbol)
---

{available ? (
  <a class="api-badge api-leg api-source-button" href={href} data-source-open data-source-slug={symbol.slug} data-source-file={file}
    data-source-line={line} data-source-title={symbol.name} data-source-kind={symbol.kind}
    aria-label={`Source of ${symbol.name}`}>
    <span class="api-leg__m" aria-hidden="true">
      <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="m5.5 4.5-3.5 3.5 3.5 3.5M10.5 4.5l3.5 3.5-3.5 3.5" /></svg>
    </span>
    <span class="api-leg__w"><span class="api-badge__label api-leg__wl">source</span></span>
  </a>
) : <span class="pre">[<a class="api-source-anchor" href={href}>source</a>]</span>}
