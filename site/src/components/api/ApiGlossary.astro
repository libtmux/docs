---
import ApiGlossaryContent from './ApiGlossaryContent.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'
import { DEFAULT_LOCALE, localeRoot } from '../../i18n/locales'
import { PORT_BY_SLUG, portPageUrl, referenceUrl, DOC_PRODUCTS, type DocProduct } from '../../lib/ports'
import { buildTarget } from '../../lib/versions'
interface Props { port?: string; product?: DocProduct; version?: string }
const { port, product, version = buildTarget(process.env).version } = Astro.props
const referenceBase = port ? referenceUrl(PORT_BY_SLUG[port], version, product ?? 'core') : `${localeRoot(DEFAULT_LOCALE)}reference/`
const pagePath = product ? `${product}/reference/glossary` : 'reference/glossary'
const glossaryPath = `${referenceBase}glossary/`
import { CONTRIBUTE_BRANCH, CONTRIBUTE_REPO } from '../../i18n/contribute'
import { apiGlossary, apiGlossaryHeadings, API_GLOSSARY_PATH, API_GLOSSARY_TITLE } from '../../lib/api-glossary'

const { title, description } = apiGlossary(glossaryPath)
const headings = apiGlossaryHeadings(glossaryPath)
const markdownHref = `${glossaryPath.slice(0, -1)}.md`
---

<DocsLayout
  title={title}
  description={description}
  port={port} product={product} version={version}
  pagePath={pagePath}
  sourcePath={pagePath}
  locale={DEFAULT_LOCALE}
  locales={[DEFAULT_LOCALE]}
  canonicalOverride={port ? undefined : API_GLOSSARY_PATH}
  searchable
  headings={headings}
  markdown={{ href: markdownHref }}
  pageSource={{ repo: CONTRIBUTE_REPO, ref: CONTRIBUTE_BRANCH, path: 'site/src/lib/api-glossary.ts' }}
  breadcrumbs={[
    { name: port ? PORT_BY_SLUG[port].name : 'libtmux', url: port ? portPageUrl(PORT_BY_SLUG[port], version) : localeRoot(DEFAULT_LOCALE) },
    ...(port && product ? [{ name: DOC_PRODUCTS[product].label, url: portPageUrl(PORT_BY_SLUG[port], version, product) }] : []),
    { name: 'API reference', url: referenceBase },
    { name: title, url: glossaryPath },
  ]}
  navigation={port ? undefined : [
    { type: 'link', label: 'API reference', href: referenceBase },
    { type: 'link', label: API_GLOSSARY_TITLE, href: glossaryPath },
  ]}
>
  <ApiGlossaryContent contextPath={glossaryPath} />
</DocsLayout>
