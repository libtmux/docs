---
/**
 * The drawn tmux of one frame: its panes in the layout tmux reported, a pane's
 * id, command and output, and a status line of its windows. Shared by the MCP
 * replay and the Core API player; each host puts its own caption under it.
 *
 * A layout a result reported, or a pane listing that gives every pane its
 * position and size, gives each pane its rectangle, in cells. Without one, a
 * window of several panes is a list with no sizes, labelled, rather than boxes
 * whose sizes nothing stated; a window of one pane fills the screen, which is
 * what one pane is.
 *
 * With `every`, the screen holds every window of every session side by side,
 * as tmux's own tree mode previews them, each labelled with its index and
 * name, over one status line of the sessions, so a window made in the
 * background or in another session is drawn the moment it exists. `marks` names what the call changed, which the drawing shows in the
 * accent colour: a window it added, a pane it added, changed, resized or
 * selected, a label it renamed or selected. In a window of several panes the
 * active one's label is drawn bold, as the window's own status marks it with
 * `*`.
 *
 * With `client`, the screen is what a client attached to the oldest session
 * (the lowest `$` id) sees: that session's current window, under one status
 * line of its windows, as tmux draws them, with `*` on the current one. A
 * window made in the background is a new label in the status line, not a
 * second screen; another session is a name at the status line's right end.
 * Each window of each session is drawn too, hidden: a window's label, or
 * another session's name, is a button that shows it until the player moves
 * to another call, which shows the client's window again
 * (`bindClientViews`). A label whose window the call added, renamed or
 * selected, or whose panes it changed out of sight, is drawn in the accent
 * colour, as tmux flags a window with activity; so is a session the call
 * added or changed.
 */
import { renderRects, type Rect } from '../../lib/tmux-layout'
import { parseLayout } from '../../lib/tmux-layout-string'
import { windowLabel, type Frame, type PaneState, type WindowState } from '../../lib/mcp-replay'
import type { TmuxMarks } from '../../lib/core-player'
import '../../styles/tmux-layout.css'
import '../../styles/mcp-replay.css'

interface Props {
  frame: Frame
  /** Whether an earlier frame had a session, so an empty one says "No sessions" rather than nothing. */
  hadSessions: boolean
  /** Prefix of the drawing's SVG ids, which must differ between players on one page. */
  idPrefix?: string
  /** Draw every window of every session, not only the first session's active one. */
  every?: boolean
  /** Draw the first session's current window as an attached client sees it, with every other window a click away. */
  client?: boolean
  /** What the call changed, for `every`'s and `client`'s drawings to mark. */
  marks?: TmuxMarks
}
const { frame, hadSessions, idPrefix = 'rp', every = false, client = false, marks = { windows: [], panes: [], labels: [], sessions: [] } } = Astro.props as Props
const WIDTH = 44
const HEIGHT = 12

function windowOf(frame: Frame) {
  const session = frame.sessions[0]
  return session ? session.windows.find((window) => window.active) ?? session.windows[0] : undefined
}
const draw = (frame: Frame) => {
  const window = windowOf(frame)
  if (!window) return undefined
  const parsed = window.layout ? parseLayout(window.layout) : undefined
  if (parsed) {
    const panes: PaneState[] = parsed.panes.map((placed) => window.panes.find((pane) => pane.id === placed.id) ?? { id: placed.id })
    const rects: Rect[] = parsed.panes
    const size: [number, number] = [parsed.width, parsed.height]
    return { window, panes, rects, size, svg: renderRects(panes.map(() => []), rects, size, { id: `${idPrefix}-${frame.done}`, label: `tmux window of ${panes.length} pane${panes.length === 1 ? '' : 's'}` }) }
  }
  // Without a layout, a pane listing that gives every pane its position and size is geometry too; the window is as large as they reach.
  const boxed = window.panes.every((pane) => pane.left !== undefined && pane.top !== undefined && pane.width !== undefined && pane.height !== undefined)
  if (boxed) {
    const rects: Rect[] = window.panes.map((pane) => ({ x: pane.left!, y: pane.top!, w: pane.width!, h: pane.height! }))
    const size: [number, number] = [Math.max(...rects.map((rect) => rect.x + rect.w)), Math.max(...rects.map((rect) => rect.y + rect.h))]
    return { window, panes: window.panes, rects, size, svg: renderRects(window.panes.map(() => []), rects, size, { id: `${idPrefix}-${frame.done}`, label: `tmux window of ${window.panes.length} pane${window.panes.length === 1 ? '' : 's'}` }) }
  }
  if (window.panes.length === 1) {
    const size: [number, number] = [WIDTH, HEIGHT]
    const rects: Rect[] = [{ x: 0, y: 0, w: WIDTH, h: HEIGHT }]
    return { window, panes: window.panes, rects, size, svg: renderRects([[]], rects, size, { id: `${idPrefix}-${frame.done}`, label: 'tmux window of 1 pane' }) }
  }
  return { window, panes: window.panes, rects: undefined, size: [WIDTH, HEIGHT] as [number, number], svg: '' }
}
const drawn = every || client ? undefined : draw(frame)
const session = frame.sessions[0]

// A window's panes as rectangles in its own cells, for `every`: the layout, else the pane listing, else one pane filling it.
function geometry(window: WindowState): { panes: PaneState[]; rects: Rect[]; size: [number, number] } | undefined {
  const parsed = window.layout ? parseLayout(window.layout) : undefined
  if (parsed) return { panes: parsed.panes.map((placed) => window.panes.find((pane) => pane.id === placed.id) ?? { id: placed.id }), rects: parsed.panes, size: [parsed.width, parsed.height] }
  if (window.panes.length > 0 && window.panes.every((pane) => pane.left !== undefined && pane.top !== undefined && pane.width !== undefined && pane.height !== undefined)) {
    const rects: Rect[] = window.panes.map((pane) => ({ x: pane.left!, y: pane.top!, w: pane.width!, h: pane.height! }))
    return { panes: window.panes, rects, size: [Math.max(...rects.map((rect) => rect.x + rect.w)), Math.max(...rects.map((rect) => rect.y + rect.h))] }
  }
  return window.panes.length === 1 ? { panes: window.panes, rects: [{ x: 0, y: 0, w: WIDTH, h: HEIGHT }], size: [WIDTH, HEIGHT] } : undefined
}
const tiles = every ? frame.sessions.flatMap((owner) => owner.windows.map((window) => ({ session: owner, window, shape: geometry(window) }))) : []
// Columns for the tiles. A tmux window is wider than it is tall, so two windows stack, which keeps a
// side-by-side split readable; three or four share two columns, and more share three.
const columns = tiles.length <= 2 ? 1 : tiles.length <= 4 ? 2 : 3
const rows = Math.max(1, Math.ceil(tiles.length / columns))
const percent = (value: number, total: number) => `${(value / total) * 100}%`

// `client`: one view per window, keyed by session and window (and by index when a session links the window twice), and the one the first session's client is on.
type SessionOf = Frame['sessions'][number]
const viewKey = (owner: SessionOf, window: WindowState) => `${owner.id ?? owner.name ?? ''}/${window.id ?? window.index ?? window.name ?? ''}${window.id !== undefined && owner.windows.filter((other) => other.id === window.id).length > 1 ? `:${window.index}` : ''}`
const currentOf = (owner: SessionOf) => owner.windows.find((window) => window.active) ?? owner.windows[0]
const sessionNumber = (owner: SessionOf) => Number(/^\$(\d+)$/.exec(owner.id ?? '')?.[1] ?? Number.POSITIVE_INFINITY)
const clientSession = client ? [...frame.sessions].sort((a, b) => sessionNumber(a) - sessionNumber(b))[0] : undefined
const clientWindow = clientSession ? currentOf(clientSession) : undefined
const clientKey = clientSession && clientWindow ? viewKey(clientSession, clientWindow) : ''
const views = client ? frame.sessions.flatMap((owner) => owner.windows.map((window) => ({ owner, window, key: viewKey(owner, window), shape: geometry(window) }))) : []
// What changed out of sight: a pane of a window the client is not on.
// tmux draws the line between two panes in a cell of its own; each pane takes half of it, so the line, and an outline inside a pane, meet with no gap.
const spread = (rect: Rect, size: [number, number]) => {
  const left = rect.x > 0 ? rect.x - 0.5 : 0
  const top = rect.y > 0 ? rect.y - 0.5 : 0
  const right = rect.x + rect.w < size[0] ? rect.x + rect.w + 0.5 : size[0]
  const bottom = rect.y + rect.h < size[1] ? rect.y + rect.h + 0.5 : size[1]
  return `left:${percent(left, size[0])};top:${percent(top, size[1])};width:${percent(right - left, size[0])};height:${percent(bottom - top, size[1])}`
}
const changedPanes = (window: WindowState) => window.panes.some((pane) => pane.id !== undefined && marks.panes.includes(pane.id))
const labelMarked = (window: WindowState) => window.id !== undefined && (marks.windows.includes(window.id) || marks.labels.includes(window.id) || (window !== clientWindow && changedPanes(window)))
const sessionMarked = (owner: SessionOf) => (owner.id !== undefined && marks.sessions.includes(owner.id)) || (owner !== clientSession && owner.windows.some(labelMarked))
---
<div class={`mcp-tmux${every || client ? ' mcp-tmux--tiles' : ''}${client ? ' mcp-tmux--client' : ''}`} data-client-view={client ? clientKey : undefined}>
  {client ? (views.length > 0 ? (
    <div class="mcp-tmux__screen mcp-tmux__screen--client mcp-client">
      <div class="mcp-client__views">
        {views.map(({ window, key, shape }) => (
          <div class={`mcp-tile mcp-client__view${window.id && marks.windows.includes(window.id) ? ' is-new' : ''}`} data-view={key} hidden={key !== clientKey}>
            <div class="mcp-tile__panes">
              {shape ? shape.panes.map((pane, index) => {
                const rect = shape.rects[index]!
                const lines = [...(pane.typed !== undefined ? [`$ ${pane.typed}`] : []), ...(pane.output?.trimEnd().split('\n') ?? [])]
                const edges = `${rect.x + rect.w < shape.size[0] ? ' has-right' : ''}${rect.y + rect.h < shape.size[1] ? ' has-below' : ''}`
                return (
                  <div class={`mcp-pane mcp-tile__pane${edges}${pane.active && shape.panes.length > 1 ? ' is-active' : ''}${pane.id && marks.panes.includes(pane.id) ? ' is-changed' : ''}`} style={spread(rect, shape.size)}>
                    {pane.id && <span class="mcp-pane__id">{pane.id}{pane.command ? ` ${pane.command}` : ''}</span>}
                    {lines.length > 0 && <pre class="mcp-pane__text">{lines.join('\n')}</pre>}
                  </div>
                )
              }) : <ul class="mcp-tile__list">{window.panes.map((pane) => <li class="mcp-pane__id">{pane.id ?? ''}{pane.command ? ` ${pane.command}` : ''}</li>)}</ul>}
            </div>
          </div>
        ))}
      </div>
      <div class="mcp-tmux__status mcp-client__status" role="group" aria-label="tmux status line: show a window or a session">
        {frame.sessions.map((owner) => (
          <span class="mcp-client__session" data-session-windows={owner.windows.map((window) => viewKey(owner, window)).join(' ')} hidden={owner !== clientSession}>
            <span class={`mcp-tmux__session${owner.id && marks.sessions.includes(owner.id) ? ' is-changed' : ''}`}>[{owner.name ?? owner.id}]</span>
            <span class="mcp-tmux__windows">
              {owner.windows.map((window) => (
                <button type="button" class={`mcp-client__button mcp-tmux__window${viewKey(owner, window) === clientKey ? ' is-current' : ''}${labelMarked(window) ? ' is-changed' : ''}`} data-show={viewKey(owner, window)} aria-pressed={viewKey(owner, window) === clientKey ? 'true' : 'false'} title={window.active ? `Window ${windowLabel(window)}, the session's current window` : `Show window ${windowLabel(window)}`}>{windowLabel(window)}{window.active ? '*' : ''}</button>
              ))}
            </span>
          </span>
        ))}
        {frame.sessions.length > 1 && (
          <span class="mcp-client__others">
            {frame.sessions.map((owner) => {
              const current = currentOf(owner)
              return <button type="button" class={`mcp-client__button mcp-client__other${sessionMarked(owner) ? ' is-changed' : ''}`} data-show={current ? viewKey(owner, current) : ''} data-session-switch={owner.windows.map((window) => viewKey(owner, window)).join(' ')} hidden={owner === clientSession} title={`Show session ${owner.name ?? owner.id}`}>{owner.name ?? owner.id}</button>
            })}
          </span>
        )}
      </div>
    </div>
  ) : (
    <div class="mcp-tmux__screen mcp-tmux__screen--client mcp-tmux__screen--empty mcp-tmux__screen--placeholder">
      <svg class="mcp-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.5" /><path d="m4.5 6.5 2 1.5-2 1.5M8.5 10h3" /></svg>
      <span>{hadSessions ? 'No sessions' : 'No tmux server yet'}</span>
    </div>
  )) : every ? (tiles.length > 0 ? (
    <div class="mcp-tmux__screen mcp-tmux__screen--tiles" style={`grid-template-columns:repeat(${columns},minmax(0,1fr));grid-template-rows:repeat(${rows},minmax(0,1fr))`}>
      {tiles.map(({ session: owner, window, shape }) => (
        <div class={`mcp-tile${window.id && marks.windows.includes(window.id) ? ' is-new' : ''}`}>
          <div class="mcp-tile__panes">
            {shape ? shape.panes.map((pane, index) => {
              const rect = shape.rects[index]!
              const lines = [...(pane.typed !== undefined ? [`$ ${pane.typed}`] : []), ...(pane.output?.trimEnd().split('\n') ?? [])]
              const edges = `${rect.x + rect.w < shape.size[0] ? ' has-right' : ''}${rect.y + rect.h < shape.size[1] ? ' has-below' : ''}`
              return (
                <div class={`mcp-pane mcp-tile__pane${edges}${pane.active && shape.panes.length > 1 ? ' is-active' : ''}${pane.id && marks.panes.includes(pane.id) ? ' is-changed' : ''}`} style={`left:${percent(rect.x, shape.size[0])};top:${percent(rect.y, shape.size[1])};width:${percent(rect.w, shape.size[0])};height:${percent(rect.h, shape.size[1])}`}>
                  {pane.id && <span class="mcp-pane__id">{pane.id}{pane.command ? ` ${pane.command}` : ''}</span>}
                  {lines.length > 0 && <pre class="mcp-pane__text">{lines.join('\n')}</pre>}
                </div>
              )
            }) : <ul class="mcp-tile__list">{window.panes.map((pane) => <li class="mcp-pane__id">{pane.id ?? ''}{pane.command ? ` ${pane.command}` : ''}</li>)}</ul>}
          </div>
          <div class={`mcp-tile__status${window.id && marks.labels.includes(window.id) ? ' is-changed' : ''}`}>{frame.sessions.length > 1 ? `${owner.name ?? owner.id}:` : ''}{windowLabel(window)}{window.active ? '*' : ''}</div>
        </div>
      ))}
    </div>
  ) : (
    <div class="mcp-tmux__screen mcp-tmux__screen--tiles mcp-tmux__screen--empty mcp-tmux__screen--placeholder">
      <svg class="mcp-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.5" /><path d="m4.5 6.5 2 1.5-2 1.5M8.5 10h3" /></svg>
      <span>{hadSessions ? 'No sessions' : 'No tmux server yet'}</span>
    </div>
  )) : drawn && drawn.rects ? (
    <div class={`mcp-tmux__screen${frame.reading === 'panes' ? ' is-reading' : ''}`} style={`aspect-ratio:${drawn.size[0] * 8} / ${drawn.size[1] * 17}`}>
      <Fragment set:html={drawn.svg} />
      {drawn.panes.map((pane, index) => {
        const rect = drawn.rects![index]!
        const lines = [...(pane.typed !== undefined ? [`$ ${pane.typed}`] : []), ...(pane.output?.trimEnd().split('\n') ?? [])]
        return (
          <div class="mcp-pane" style={`left:${(rect.x / drawn.size[0]) * 100}%;top:${(rect.y / drawn.size[1]) * 100}%;width:${(rect.w / drawn.size[0]) * 100}%;height:${(rect.h / drawn.size[1]) * 100}%`}>
            {pane.id && <span class="mcp-pane__id">{pane.id}{pane.command ? ` ${pane.command}` : ''}</span>}
            {lines.length > 0 && <pre class="mcp-pane__text">{lines.join('\n')}</pre>}
          </div>
        )
      })}
    </div>
  ) : drawn ? (
    <div class="mcp-tmux__screen mcp-tmux__screen--unsized">
      <p class="mcp-tmux__unsized">Panes, sizes not read yet</p>
      <ul>{drawn.panes.map((pane) => <li class="mcp-pane__id">{pane.id ?? ''}{pane.command ? ` ${pane.command}` : ''}</li>)}</ul>
    </div>
  ) : (
    <div class="mcp-tmux__screen mcp-tmux__screen--empty">{hadSessions && <span>No sessions</span>}</div>
  )}
  {every && <div class="mcp-tmux__status mcp-tmux__status--sessions">{frame.sessions.map((owner) => (owner.name ?? owner.id) && <span class={`mcp-tmux__session${owner.id && marks.sessions.includes(owner.id) ? ' is-changed' : ''}`}>[{owner.name ?? owner.id}]</span>)}</div>}
  {!every && !client && <div class={`mcp-tmux__status${frame.reading === 'sessions' ? ' is-reading' : ''}`}>
    {session && (session.name ?? session.id) && <span class="mcp-tmux__session">[{session.name ?? session.id}]</span>}
    {session && (
      <span class={`mcp-tmux__windows${frame.reading === 'windows' ? ' is-reading' : ''}`}>
        {session.windows.map((window) => windowLabel(window) && (
          <span class={`mcp-tmux__window${window === windowOf(frame) ? ' is-current' : ''}`}>{windowLabel(window)}{window.active ? '*' : ''}</span>
        ))}
      </span>
    )}
  </div>}
</div>
