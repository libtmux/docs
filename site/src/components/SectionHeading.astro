---
interface Props {
  id: string
  level?: 2 | 3 | 4 | 5 | 6
  legacyId?: string
}
const { id, level = 2, legacyId } = Astro.props
const Heading = `h${level}` as const
---

<Heading id={id}>
  {legacyId && legacyId !== id && <span id={legacyId} class="section-anchor-alias" />}
  <slot /><a class="anchor-link" href={`#${id}`} aria-label="Link to this section" data-pagefind-ignore="all">¶</a>
</Heading>
