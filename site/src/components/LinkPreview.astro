---
interface Props {
  id?: string
  title?: string
  description?: string
  href?: string
  actionLabel?: string
  class?: string
}
const { id = 'reference-link-preview', title = 'Reference preview', description = '', href,
  actionLabel = 'Open reference', class: className } = Astro.props
---
<span id={id} popover="auto" role="dialog" aria-label={title}
  class:list={['reference-link-preview not-prose', className]} data-pagefind-ignore="all">
  <span class="reference-link-preview__heading"><code id={`${id}-title`} data-preview-title>{title}</code><button type="button" data-preview-close popovertarget={id} popovertargetaction="hide" aria-label="Close preview">×</button></span>
  <button type="button" data-preview-expand hidden aria-expanded="false" aria-controls={`${id}-title`}>Show full name</button>
  <span data-preview-description>{description}</span>
  <span data-preview-detail hidden></span>
  <code data-preview-signature hidden></code>
  <a href={href} data-preview-open data-preview-skip>{actionLabel}</a>
</span>
<style is:global>
  a[data-link-preview]:not(.api-badge) {
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-color: currentColor;
    text-underline-offset: .2em;
  }
  a[data-link-preview]:not(.api-badge):has(.api-literal--link) { color: var(--color-link); }
  a[data-link-preview]:not(.api-badge) code { text-decoration-line: none; }
  .reference-link-preview {
    position: fixed; inset: 0; margin: auto; padding: 1rem;
    box-sizing: border-box; width: min(40rem, calc(100vw - 2rem)); max-height: min(28rem, calc(100dvh - 2rem));
    overflow: auto; border: 1px solid var(--color-background-border); border-radius: .5rem;
    background: var(--color-background-secondary); color: var(--color-foreground-primary);
    box-shadow: 0 6px 24px rgb(0 0 0 / 22%);
    font: 400 .875rem/1.5 var(--font-sans); white-space: normal; overflow-wrap: anywhere;
  }
  .reference-link-preview [hidden] { display: none; }
  .reference-link-preview__heading { display: flex; align-items: baseline; gap: .75rem; margin-bottom: .65rem; }
  .reference-link-preview__heading code { flex: 1; min-width: 0; }
  .reference-link-preview code { font-family: var(--font-mono, ui-monospace, monospace); }
  .reference-link-preview__heading button { flex: none; margin-left: auto; padding: .1rem .4rem; cursor: pointer; }
  .reference-link-preview [data-preview-expand] { margin-bottom: .65rem; color: var(--color-link); text-decoration: underline; cursor: pointer; }
  .reference-link-preview [data-preview-description], .reference-link-preview [data-preview-detail] { display: block; margin-bottom: .65rem; }
  .reference-link-preview [data-preview-detail][hidden] { display: none; }
  .reference-link-preview [data-preview-signature] { font: .8125rem/1.5 var(--font-mono, ui-monospace, monospace); white-space: pre-wrap; padding: .5rem; margin-block: .75rem; background: var(--shiki-light-bg, var(--color-background-primary)); color: var(--shiki-light, inherit); border: 1px solid var(--color-background-border); border-radius: .25rem; }
  .reference-link-preview [data-preview-signature] span { font-style: var(--shiki-light-font-style); font-weight: var(--shiki-light-font-weight); text-decoration: var(--shiki-light-text-decoration); }
  html[data-theme-mode="dark"] .reference-link-preview [data-preview-signature] { background: var(--shiki-dark-bg, var(--color-background-primary)); color: var(--shiki-dark, inherit); }
  html[data-theme-mode="dark"] .reference-link-preview [data-preview-signature] span { font-style: var(--shiki-dark-font-style); font-weight: var(--shiki-dark-font-weight); text-decoration: var(--shiki-dark-text-decoration); }
  .reference-link-preview [data-preview-signature]:not([hidden]) { display: block; }
  .reference-link-preview [data-preview-open] { color: var(--color-link); text-decoration: underline; }
  .reference-link-preview :focus-visible { outline: 2px solid var(--color-link); outline-offset: 3px; }
</style>
<script>
  import { initLinkPreviews, disposeLinkPreviews } from '../lib/link-preview-browser'
  initLinkPreviews()
  document.addEventListener('astro:page-load', initLinkPreviews)
  document.addEventListener('astro:before-swap', disposeLinkPreviews)
</script>
