---
/**
 * What a page needs and where to install it, in one line under the title.
 *
 * The package and its maturity name what the page's code runs against; the
 * link jumps to the installer on the product's home. Data from `pageNeeds`.
 */
import StatusBadge from '../StatusBadge.astro'
import type { ProductStatus } from '../../lib/ports'

interface Props {
  text: string
  status?: ProductStatus
  href?: string
}
const { text, status, href } = Astro.props
---
<p class="page-needs not-prose" data-page-needs data-pagefind-ignore="all">
  <span>{text}</span>
  {status && <StatusBadge status={status} />}
  {href && <a href={href}>Install</a>}
</p>
<style>
  .page-needs { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .5rem; margin: 0 0 1.25rem; padding: .5rem .75rem; border: 1px solid var(--color-edge); border-radius: var(--radius-md, .375rem); color: var(--text-color); font-size: .875rem; line-height: 1.4; }
  .page-needs a { color: var(--color-link); font-weight: 500; }
</style>
