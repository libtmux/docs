---
/**
 * How a port page ends: previous and next, typed related groups and the way up.
 *
 * A group says why its entries belong and is absent when it has none; the
 * ladder repeats the sidebar head's targets, so a reader who scrolled past the
 * sidebar still has a way up. The block is a `nav` named "Continue" and the
 * ladder is a list named "Up". Data from `lib/page-end.ts`.
 */
import ApiBadge from '../api/ApiBadge.astro'
import StatusBadge from '../StatusBadge.astro'
import type { PageEndData } from '../../lib/page-end'

type Props = PageEndData
const { prev, next, groups, up } = Astro.props
---
<nav class="page-end" aria-label="Continue" data-page-end data-pagefind-ignore="all">
  {(prev || next) && <div class="page-end__seq">
    {prev && <a class="page-end__step" href={prev.href} rel="prev" data-page-end-prev><small>Previous</small><strong>{prev.code ? <code>{prev.label}</code> : prev.label}</strong></a>}
    {next && <a class="page-end__step page-end__step--next" href={next.href} rel="next" data-page-end-next><small>Next</small><strong>{next.code ? <code>{next.label}</code> : next.label}</strong></a>}
  </div>}
  {groups.length > 0 && <div class="page-end__groups">
    {groups.map((group) => <section class="page-end__group" data-page-end-group={group.id}>
      <h3>{group.title}{group.count !== undefined && <>{' '}<span class="page-end__count">{group.count}</span></>}</h3>
      <p class="page-end__why">{group.why}</p>
      <ul>{group.items.slice(0, 4).map((item) => <li>
        {item.kind && <ApiBadge label={item.kind} variant="kind" value={item.kind} compact />}
        <a href={item.href}>{item.code ? <code>{item.label}</code> : item.label}</a>
        {item.status && <StatusBadge status={item.status} />}
      </li>)}</ul>
    </section>)}
  </div>}
  <ul class="page-end__up" aria-label="Up" data-page-end-up>
    {up.map((link) => <li><a href={link.href}>
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
      <span>{link.code ? <code>{link.label}</code> : link.label}</span>
    </a></li>)}
  </ul>
</nav>
<style>
  .page-end { display: grid; gap: 1.25rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-edge); font-size: .9375rem; container-type: inline-size; }
  .page-end__seq { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .page-end__step { display: grid; gap: .125rem; padding: .75rem 1rem; border: 1px solid var(--color-edge); border-radius: var(--radius-lg, .5rem); color: inherit; text-decoration: none; }
  .page-end__step:hover { border-color: var(--color-link); }
  .page-end__step:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  .page-end__step small { color: var(--color-foreground-muted); font: 400 .8125rem/1.3 var(--font-sans); }
  .page-end__step strong { color: var(--color-link); font-weight: 600; overflow-wrap: anywhere; }
  .page-end__step code, .page-end__up code { color: inherit; font-size: .875em; font-weight: inherit; }
  .page-end__step--next { grid-column: 2; text-align: right; }
  .page-end__groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem 1.5rem; }
  .page-end__group h3 { display: flex; align-items: baseline; gap: .375rem; margin: 0; color: var(--text-color); font: 600 .875rem/1.3 var(--font-sans); }
  .page-end__count { padding: 0 .35rem; border-radius: var(--radius-xs, .25rem); background: var(--color-surface); color: var(--color-foreground-muted); font: 500 0.75rem/1.5 var(--font-sans); font-variant-numeric: tabular-nums; }
  .page-end__why { margin: .125rem 0 .375rem; color: var(--color-foreground-muted); font-size: .8125rem; line-height: 1.35; }
  .page-end__group ul { display: grid; gap: .25rem; margin: 0; padding: 0; list-style: none; }
  .page-end__group li { display: flex; align-items: center; gap: .375rem; min-width: 0; margin: 0; line-height: 1.4; }
  .page-end__group li a { min-width: 0; overflow-wrap: anywhere; color: var(--color-link); text-decoration: underline; text-underline-offset: .15em; }
  .page-end__group li a:has(> code) { text-decoration-style: dotted; }
  .page-end__group li code { font-size: .8125rem; }
  .page-end__up { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin: 0; padding: .75rem 0 0; border-top: 1px dashed var(--color-edge); list-style: none; font-size: .875rem; }
  /* With no sequence or related groups above it, the up row needs no second rule under the page-end border. */
  .page-end__up:first-child { padding-top: 0; border-top: 0; }
  .page-end__up li { margin: 0; }
  .page-end__up a { display: inline-flex; align-items: center; gap: .3rem; color: var(--color-foreground-muted); text-decoration: none; }
  .page-end__up a:hover { color: var(--color-link); text-decoration: underline; }
  .page-end__up a:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  /* Below 30rem of the block's own width the sequence stacks. */
  @container (max-width: 30rem) {
    .page-end__seq { grid-template-columns: minmax(0, 1fr); }
    .page-end__step--next { grid-column: 1; text-align: left; }
  }
</style>
