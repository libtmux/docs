---
import TableOfContentsIcon from '../icons/TableOfContentsIcon.astro'
interface Props { tableOfContents?: boolean; native?: boolean; api?: boolean }
const { tableOfContents = false, native = false, api = false } = Astro.props
const Control = native ? 'label' : 'button'
const SidebarControl = api ? 'button' : Control
---
    <SidebarControl
      id={api ? undefined : 'mobile-sidebar-toggle'}
      data-api-nav-toggle={api || undefined}
      type={native && !api ? undefined : 'button'}
      for={native && !api ? '__navigation' : undefined}
      role={native && !api ? 'button' : undefined}
      tabindex={native && !api ? 0 : undefined}
      aria-label="Open navigation menu"
      aria-controls={api ? 'api-nav' : native ? 'native-navigation' : 'mobile-sidebar'}
      aria-expanded="false"
      class:list={['toolbar-button', api ? 'reference-sidebar-toggle' : !native && 'documentation-sidebar-toggle']}
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </SidebarControl>
    {
      tableOfContents && (
        <Control
          id="mobile-toc-toggle"
          type={native ? undefined : 'button'}
          for={native ? '__toc' : undefined}
          role={native ? 'button' : undefined}
          tabindex={native ? 0 : undefined}
          aria-label="Open table of contents"
          aria-controls={native ? 'native-toc' : 'mobile-toc'}
          aria-expanded="false"
          class="toolbar-button ml-auto"
        >
          <TableOfContentsIcon class="h-5 w-5" />
        </Control>
      )
    }
<style>
  .toolbar-button { display: flex; align-items: center; justify-content: center; flex: none; height: 2.25rem; width: 2.25rem; border-radius: .375rem; border: 1px solid var(--color-edge); }
  .toolbar-button:hover { background: var(--color-surface-hover); }
  .toolbar-button:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  @media (min-width: 64rem) { .documentation-sidebar-toggle { display: none; } }
  @media (min-width: 56rem) { .reference-sidebar-toggle { display: none; } }
</style>
