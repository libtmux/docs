---
/**
 * Documentation sidebar. Scoped to one port when `port` is set (a page under
 * /py/ shows only Python nav, plus its reference-tree entry); omit it for
 * the shell's own shared pages (concepts, guides, examples) to get their
 * `sidebar.group` sectioning with no port-specific entry appended.
 *
 * Rendered twice per page by DocsLayout — once in the mobile drawer, once in
 * the desktop column — so it owns no positioning of its own; the caller
 * decides how it's placed.
 */
import { getSidebar, isActivePath, type SidebarItem } from '../../lib/sidebar'
import { DEFAULT_LOCALE, type Locale } from '../../i18n/locales'
import SidebarLink from './SidebarLink.astro'
import SidebarSection from './SidebarSection.astro'
import { PORT_BY_SLUG, type DocProduct } from '../../lib/ports'
import { currentDocumentation, getDocumentationSurfaces } from '../../lib/documentation-navigation'
import '../../styles/api-tree.css'

interface Props {
  port?: string
  product?: DocProduct
  version: string
  currentPath: string
  /** Scopes the nav to one locale, the way `port` scopes it to one port. */
  locale?: Locale
  /** A generated reference can supply its own section tree. */
  navigation?: SidebarItem[]
}

const { port, product, version, currentPath, locale = DEFAULT_LOCALE, navigation } = Astro.props
const portInfo = port ? PORT_BY_SLUG[port] : undefined
const surfaces = portInfo ? await getDocumentationSurfaces(portInfo.slug, version, locale) : []
const selected = surfaces.length ? currentDocumentation(surfaces, currentPath) : undefined
const pageItems: SidebarItem[] = navigation ?? (selected ? selected.section.items : await getSidebar(port, version, locale, product))
---

{selected && <p class="section-context"><span>{selected.surface.label}</span><a href={selected.section.href}>{selected.section.label}</a></p>}
<div data-section-navigation>
  <label class="section-search" data-section-search-label hidden>
    <span class="sr-only">Find a page in {selected?.section.label ?? 'documentation'}</span>
    <input type="search" autocomplete="off" placeholder="Find page" data-section-search />
  </label>
  <nav aria-label={selected ? `${selected.surface.label}: ${selected.section.label}` : 'Documentation'} class="sidebar-nav">
  {
    pageItems.map((item) =>
      item.type === 'group' ? (
        <SidebarSection label={item.label} href={item.href} items={item.items} currentPath={currentPath} />
      ) : (
        <SidebarLink href={item.href} label={item.href === selected?.section.href && item.label === selected.section.label ? 'Overview' : item.label} external={item.external} kind={item.kind} isActive={isActivePath(item.href, currentPath)} />
      ),
    )
  }
  </nav>
  <p class="section-empty" data-section-empty role="status" hidden>No matching pages.</p>
</div>

<style>
  .section-context { margin: 0 0 .75rem; }
  .section-context span { display: block; color: var(--color-muted); font-size: .75rem; }
  .section-context a { font-size: .875rem; font-weight: 600; }
  .sidebar-nav {
    --api-nav-indent: .75rem;
    font-size: 0.875rem;
  }
  [hidden] { display: none !important; }
  .section-search { display: block; margin-bottom: .65rem; }
  .section-search input { width: 100%; min-width: 0; border: 1px solid var(--color-edge); border-radius: .35rem; padding: .5rem .65rem; background: var(--background-color); color: inherit; font-size: .8125rem; }
  .section-search input:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 2px; }
  .section-empty { padding: .5rem; color: var(--color-muted); font-size: .8125rem; }
  .sidebar-nav::-webkit-scrollbar {
    width: 4px;
  }
  .sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
  }
  .sidebar-nav::-webkit-scrollbar-thumb {
    background: rgb(203 213 225); /* slate-300 */
    border-radius: 2px;
  }
  :global([data-theme-mode='dark']) .sidebar-nav::-webkit-scrollbar-thumb {
    background: rgb(71 85 105); /* slate-600 */
  }
</style>
