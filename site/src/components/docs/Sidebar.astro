---
/**
 * Documentation sidebar. Scoped to one port when `port` is set (a page under
 * /py/ shows only Python nav, plus its reference-tree entry); omit it for
 * the shell's own shared pages (concepts, guides, examples) to get their
 * `sidebar.group` sectioning with no port-specific entry appended.
 *
 * Rendered twice per page by DocsLayout — once in the mobile drawer, once in
 * the desktop column — so it owns no positioning of its own; the caller
 * decides how it's placed.
 */
import { getSidebar, isActivePath, portAreas, referenceEntries, type SidebarItem, type SidebarLinkItem } from '../../lib/sidebar'
import { DEFAULT_LOCALE, type Locale } from '../../i18n/locales'
import SidebarLink from './SidebarLink.astro'
import SidebarSection from './SidebarSection.astro'
import { DOC_PRODUCTS, PORT_BY_SLUG, portPageUrl, type DocProduct } from '../../lib/ports'

interface Props {
  port?: string
  product?: DocProduct
  version: string
  currentPath: string
  /** Scopes the nav to one locale, the way `port` scopes it to one port. */
  locale?: Locale
  /**
   * The menu only, without the page list.
   *
   * The reference pages have a navigation column of their own — a tree over
   * twelve thousand symbols — and they had nothing above it: a reader who
   * reached `/reference/ts/` could not get back to the TypeScript guides
   * without the browser's back button. The full nav would answer that and
   * push the tree two screens down, so this renders the part that is a menu
   * (the port's products, its documentation areas, its references) and leaves
   * the part that is a page list to the pages that have room for it.
   */
  menuOnly?: boolean
}

const { port, product, version, currentPath, locale = DEFAULT_LOCALE, menuOnly = false } = Astro.props
const portInfo = port ? PORT_BY_SLUG[port] : undefined
// Skipped entirely when the caller wants the menu: `getSidebar` queries the
// content collection and sorts it, and the reference renders this component on
// every one of its pages.
const items: SidebarItem[] = menuOnly
  ? port
    ? [portAreas(port, version), { type: 'group', label: 'Reference', items: referenceEntries(port, version) }]
    : []
  : await getSidebar(port, version, locale, product)
const products: SidebarLinkItem[] = portInfo ? [
  { type: 'link', label: 'Core library', href: portPageUrl(portInfo, version) },
  ...Object.entries(DOC_PRODUCTS).map(([slug, info]): SidebarLinkItem => ({
    type: 'link', label: info.label, href: portPageUrl(portInfo, version, slug),
  })),
] : []
---

{portInfo && <nav aria-label="Products" class="product-nav">
  <SidebarSection label={portInfo.name} items={products} currentPath={currentPath} />
</nav>}
<nav aria-label="Documentation" class="sidebar-nav">
  {
    items.map((item) =>
      item.type === 'group' ? (
        <SidebarSection label={item.label} items={item.items} currentPath={currentPath} />
      ) : (
        <SidebarLink href={item.href} label={item.label} external={item.external} isActive={isActivePath(item.href, currentPath)} />
      ),
    )
  }
</nav>

<style>
  .sidebar-nav::-webkit-scrollbar {
    width: 4px;
  }
  .sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
  }
  .sidebar-nav::-webkit-scrollbar-thumb {
    background: rgb(203 213 225); /* slate-300 */
    border-radius: 2px;
  }
  :global([data-theme-mode='dark']) .sidebar-nav::-webkit-scrollbar-thumb {
    background: rgb(71 85 105); /* slate-600 */
  }
</style>
