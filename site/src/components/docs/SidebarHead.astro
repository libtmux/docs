---
/**
 * The head of every left column on a port page: one way up, then the scope.
 *
 * The up row goes exactly one level higher than the rows below it list, so it
 * is never a Back button: it reaches the same place whatever the reader came
 * from. The scope title links to that scope's home and carries its maturity.
 * Sections carry no badge, because they inherit their product's. Version and
 * translation language stay with the context strip.
 *
 * Plain links, so the head works without a script; `lib/sidebar-head.ts` says
 * which levels there are and what each one lists.
 */
import StatusBadge from '../StatusBadge.astro'
import type { HeadLink, SidebarHeadData } from '../../lib/sidebar-head'

interface Props {
  up: HeadLink
  title: SidebarHeadData['title']
  /** Names the column for the element that labels itself by its title. */
  titleId?: string
}
const { up, title, titleId } = Astro.props
---
<div class="sidebar-head" data-sidebar-head>
  <a class="sidebar-head__up" href={up.href} aria-label={`Up to ${up.label}`} data-sidebar-head-up>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 3.5-4.5 4.5 4.5 4.5" /></svg>
    <span>{up.label}</span>
  </a>
  <div class="sidebar-head__scope">
    <a class="sidebar-head__title" href={title.href} id={titleId} data-sidebar-head-title>{title.label}</a>
    {title.status && <StatusBadge status={title.status} />}
  </div>
</div>
<style>
  .sidebar-head { display: grid; gap: .125rem; margin: 0 0 .5rem; padding: 0 0 .5rem; border-bottom: 1px solid var(--color-edge); }
  .sidebar-head__up {
    display: inline-flex; align-items: center; gap: .35rem; justify-self: start;
    min-height: 1.75rem; margin: 0 0 0 -.375rem; padding: 0 .5rem 0 .375rem; border-radius: var(--radius-xs, .25rem);
    color: var(--color-foreground-muted); font: 500 .8125rem/1.25 var(--font-sans); text-decoration: none;
  }
  .sidebar-head__up:hover { background: var(--color-surface-hover); color: var(--color-link); }
  .sidebar-head__up:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: -2px; }
  .sidebar-head__up svg { flex: none; }
  .sidebar-head__scope { display: flex; align-items: center; gap: .5rem; min-height: 2rem; }
  .sidebar-head__title { display: block; min-width: 0; color: var(--text-color); font: 600 .9375rem/1.3 var(--font-sans); text-decoration: none; overflow-wrap: anywhere; }
  .sidebar-head__title:hover { color: var(--color-link); }
  .sidebar-head__title:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: -2px; border-radius: var(--radius-xs, .25rem); }
  /* In the API column the head sits on the tree's own inset, as the search field and the rows do. */
  :global(.api-nav) > .sidebar-head { margin-inline: .5rem; }
  .sidebar-head__scope > :global(.status-badge) { flex: none; margin-left: auto; }
</style>
