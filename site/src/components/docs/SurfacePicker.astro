---
import DocumentationIcon from './DocumentationIcon.astro'
import { currentDocumentation, type DocumentationSurface } from '../../lib/documentation-navigation'
import { branding } from '../../lib/branding'
import { PORT_BY_SLUG } from '../../lib/ports'
import { withRoot } from '../../lib/site-root'
import type { Locale } from '../../i18n/locales'
import '../../styles/documentation-picker.css'
import TmuxLogo from '../tmux/Logo.astro'
interface Props { surfaces: DocumentationSurface[]; currentPath: string; port?: string; version: string; locale: Locale; solutionsOnly?: boolean }
const { surfaces, currentPath, port, version, locale, solutionsOnly = false } = Astro.props
const { surface, section } = currentDocumentation(surfaces, currentPath)
const descriptions: Record<string, string> = { core: 'API reference and guides', mcp: 'Tools for connected assistants', workspace: 'Repeatable development environments', tmux: 'Commands, configuration and terminal workflows' }
const artwork = (id: string) => {
  const path = branding(port, id === 'core' ? '' : id).asset('logo.svg')
  return withRoot(path)
}
---
<details class="surface-picker doc-picker" data-surface-picker data-doc-picker data-pagefind-ignore="all">
  <summary aria-label={solutionsOnly ? 'Choose a solution' : `Choose documentation: ${surface.label}, ${section.label}`}>
    {port ? <img class="surface-artwork" src={artwork(surface.id)} width="30" height="30" alt="" /> : <TmuxLogo />}
    <span class="surface-current"><strong>{!solutionsOnly && surface.id === 'tmux'
      ? <><span class="surface-name-full">{surface.label}</span><span class="surface-name-short">tmux</span></>
      : solutionsOnly ? <><span class="home-solution-name-full">Choose a solution</span><span class="home-solution-name-short" aria-hidden="true">Solution</span></> : surface.label}</strong>{!solutionsOnly && <small>{section.label}</small>}</span>
    <svg class="doc-picker-caret" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
  </summary>
  <div class="surface-panel doc-picker-panel" data-surface-panel data-picker-panel>
    <p class="doc-picker-title">{solutionsOnly ? 'Choose a solution' : 'Choose documentation'} <span class="doc-picker-count">{surfaces.length}</span></p>
    <label class="doc-picker-search" hidden data-surface-search-label data-picker-search-label>
      <span class="sr-only">{solutionsOnly ? 'Find a solution' : 'Find an app or section'}</span>
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3.5 3.5"/></svg>
      <input type="search" placeholder="Find documentation…" autocomplete="off" data-surface-search data-picker-search />
    </label>
    <nav aria-label={solutionsOnly ? 'Documentation solutions' : 'Documentation apps and sections'}>
      {surfaces.map((entry) => solutionsOnly ? <a class="surface-destination doc-picker-option" href={entry.href}
        data-picker-option data-match={`${entry.label} ${descriptions[entry.id]}`}>
        <img class="surface-artwork" src={artwork(entry.id)} width="30" height="30" alt="" />
        <span class="surface-group-name"><strong>{entry.label}</strong>{' '}<small>{descriptions[entry.id]}</small></span>
        <span class="surface-destination-arrow" aria-hidden="true">→</span>
      </a> : <details class="surface-group" data-surface-group data-picker-group open={entry.id === surface.id}>
        <summary>{port ? <img class="surface-artwork" src={artwork(entry.id)} width="30" height="30" alt="" /> : <TmuxLogo />}
          <span class="surface-group-name"><strong>{entry.label}</strong>{' '}<small>{descriptions[entry.id]}</small></span>
          <svg class="surface-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 4 4 4-4 4" /></svg>
        </summary>
        <div class="surface-options doc-picker-options">
          {entry.sections.map((item) => item.href && <a href={item.href} class="surface-option doc-picker-option"
            data-surface-option data-picker-option data-match={`${entry.label} ${item.label} ${item.id === 'reference' ? 'api tools cli' : ''}`}
            aria-current={entry.id === surface.id && item.id === section.id ? 'location' : undefined}>
              <DocumentationIcon name={item.id} /><span>{item.label}</span>
              {entry.id === surface.id && item.id === section.id && <span class="doc-picker-check" aria-hidden="true">✓</span>}
            </a>)}
        </div>
        {entry.sections.some((item) => item.alternatives?.length) && <div class="surface-alternatives">
          <small>Other references</small>
          {entry.sections.flatMap((item) => item.alternatives ?? []).map((item) => <a
            href={item.href} class="surface-option doc-picker-option" data-surface-option data-picker-option data-match={`${entry.label} Reference ${item.label}`}
            target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
            <DocumentationIcon name="reference" /><span>{item.label}</span>
            {item.external && <><span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></>}
          </a>)}
        </div>}
      </details>)}
    </nav>
    <p class="doc-picker-empty" data-surface-empty data-picker-empty hidden>No matching documentation.</p>
    <p class="sr-only" role="status" data-surface-status data-picker-status></p>
    <div class="surface-picker-footer" aria-label="Current documentation context"><span>{port ? PORT_BY_SLUG[port].name : 'tmux'}</span>{' · '}<span>{version}</span>{' · '}<span>{locale}</span></div>
  </div>
</details>
<style>
  .surface-picker { width: 100%; }
  summary { display: flex; align-items: center; gap: .6rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .surface-picker > summary { min-height: 2.5rem; padding: .2rem .4rem; }
  .surface-current { min-width: 0; line-height: 1.35; }
  .surface-current strong, .surface-current small { display: block; }
  .surface-name-short { display: none; }
  .home-solution-name-short { display: none; }
  @media (max-width: 24rem) {
    .surface-name-full { display: none; }
    .surface-name-short { display: inline; }
  }
  small { font-size: .6875rem; color: var(--color-muted); }
  .surface-artwork { flex: none; width: 1.875rem; height: 1.875rem; object-fit: contain; }
  .surface-chevron { flex: none; margin-left: auto; color: var(--color-muted); }
  .surface-group[open] > summary .surface-chevron { transform: rotate(90deg); }
  .surface-panel > nav { display: grid; gap: .25rem; padding-bottom: .25rem; }
  .surface-group > summary { min-height: 4rem; padding: .7rem .4rem; border-radius: .4rem; }
  .surface-destination { min-height: 4rem; }
  .surface-destination-arrow { margin-left: auto; }
  .surface-group-name { min-width: 0; }
  .surface-group-name strong, .surface-group-name small { display: block; }
  .surface-group-name strong { font-weight: 500; }
  .surface-group-name small { margin-top: .2rem; }
  .surface-options { padding-top: .25rem; padding-bottom: .75rem; }
  .surface-alternatives { padding: .25rem 0 .5rem; border-top: 1px solid var(--color-edge); }
  .surface-alternatives > small { padding-inline: .4rem; }
  .surface-alternatives:not(:has(a:not([hidden]))) { display: none; }
  .surface-picker-footer { display: flex; flex-wrap: wrap; gap: .5rem; margin: .15rem -.75rem -.75rem; padding: .65rem 1rem; border-top: 1px solid var(--color-edge); border-radius: 0 0 .65rem .65rem; background: var(--color-surface); color: var(--color-muted); font-size: .6875rem; }
</style>
