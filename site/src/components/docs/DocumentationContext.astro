---
import SurfacePicker from './SurfacePicker.astro'
import PagePortSwitcher from '../PagePortSwitcher.astro'
import VersionSwitcher from '../VersionSwitcher.astro'
import LocaleSwitcher from '../LocaleSwitcher.astro'
import { getDocumentationSurfaces } from '../../lib/documentation-navigation'
import type { PagePortLink } from '../../lib/page-port-links'
import type { Locale } from '../../i18n/locales'
import type { LocaleStatus } from '../../i18n/resolve'
import { TMUX_VERSIONS, tmuxReference, tmuxReferenceUrl } from '../../lib/tmux-reference'

interface Props {
  port?: string
  version: string
  locale: Locale
  sourcePath: string
  pagePorts: PagePortLink[]
  localeStatuses?: Record<string, LocaleStatus>
  reference?: boolean
}
const { port, version, locale, sourcePath, pagePorts, localeStatuses, reference = false } = Astro.props
const surfaces = await getDocumentationSurfaces(port, version, locale)
const command = sourcePath.match(/^tmux\/[^/]+\/reference\/(.+?)\/?$/)?.[1]
const tmuxVersions = !port ? TMUX_VERSIONS.map((entry) => ({
  label: entry === 'latest' ? `Latest (${tmuxReference(entry).version})` : entry,
  href: tmuxReferenceUrl(entry, command === 'manual' || tmuxReference(entry).commands.some((item) => item.name === command) ? command : undefined),
  current: entry === version,
})) : undefined
---
<div class:list={['documentation-context', reference && 'documentation-context--reference']} data-documentation-context data-pagefind-ignore="all">
  <div class="documentation-context-inner">
    <div class="documentation-context-surface">
      <SurfacePicker surfaces={surfaces} currentPath={Astro.url.pathname} port={port} version={version} locale={locale} />
    </div>
    <div class="documentation-context-selectors" aria-label="Documentation context">
      <PagePortSwitcher entries={pagePorts} portSlug={port} tmux={!port} />
      <VersionSwitcher portSlug={port} version={version} entries={tmuxVersions} />
      <LocaleSwitcher locale={locale} sourcePath={sourcePath} localeStatuses={localeStatuses ?? { [locale]: 'translated' }} />
    </div>
    <div class="documentation-context-navigation"><slot name="navigation" /></div>
  </div>
</div>
<style>
  .documentation-context { position: relative; z-index: 35; border-bottom: 1px solid var(--color-edge); background: var(--color-surface); }
  .documentation-context-inner { position: relative; display: flex; align-items: stretch; max-width: var(--site-frame-width, 100rem); margin-inline: auto; }
  .documentation-context--reference .documentation-context-inner { max-width: var(--site-frame-width, 108rem); }
  .documentation-context-surface { display: flex; align-items: center; flex: 0 1 16rem; min-width: 0; padding: .25rem .75rem; border-right: 1px solid var(--color-edge); }
  .documentation-context-selectors { display: flex; flex: none; align-items: center; gap: .4rem; min-width: 0; padding: .25rem .75rem; }
  .documentation-context-navigation { display: flex; flex: none; align-items: center; gap: .4rem; margin-left: auto; padding: .25rem .75rem .25rem 0; }
  .documentation-context-navigation:empty { display: none; }
  .documentation-context-navigation :global(.api-nav-toggle) { flex: none; justify-content: center; width: 2.25rem; height: 2.25rem; margin: 0; padding: 0; gap: 0; }
  @media (min-width: 64rem) { .documentation-context-navigation { display: none; } }
  @media (min-width: 56rem) { .documentation-context--reference .documentation-context-navigation { display: none; } }
  .documentation-context :global(.doc-picker) { position: static; }
  .documentation-context :global(.doc-picker-panel) { left: .5rem; }
  .documentation-context :global(.doc-picker:not([data-enhanced]) > .doc-picker-panel) { width: min(var(--picker-width), calc(100% - 1rem)); }
  .documentation-context :global(.surface-picker > summary) { border-color: transparent; background: transparent; padding-inline-start: calc(var(--site-gutter) - .75rem - 1px); }
  .documentation-context :global(.surface-picker > summary:hover), .documentation-context :global(.surface-picker[open] > summary) { border-color: var(--color-edge); background: var(--background-color); }
  .documentation-context :global(.surface-current strong), .documentation-context :global(.surface-current small) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 40rem) {
    .documentation-context-surface { flex: 1 1 0; padding: .25rem; }
    .documentation-context-selectors { flex: none; gap: .2rem; padding: .25rem; }
    .documentation-context-navigation { gap: .2rem; padding: .25rem .25rem .25rem 0; }
    .documentation-context :global(.surface-picker > summary) { padding-inline: calc(var(--site-gutter) - .25rem - 1px) .2rem; gap: .3rem; }
    .documentation-context :global(.surface-artwork) { width: 1.5rem; height: 1.5rem; }
    .documentation-context :global([data-page-port-switcher] > summary), .documentation-context :global([data-locale-picker] > summary), .documentation-context :global([data-version-picker] > summary) { padding-inline: .35rem; gap: .2rem; }
    .documentation-context :global([data-page-port-switcher] > summary > svg:first-child), .documentation-context :global([data-locale-picker] > summary > span[lang]) { display: none; }
    .documentation-context :global(.page-port-name) { display: none; }
    .documentation-context :global(.page-port-short-name) { display: inline; }
    .documentation-context :global(.version-label) { max-width: 4.5rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .documentation-context :global(.toolbar-button) { width: 2rem; height: 2.25rem; }
  }
</style>
