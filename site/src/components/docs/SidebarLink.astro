---
/**
 * One sidebar entry. Doubles as the outbound ecosystem-reference link
 * (external + target=_blank) so Sidebar.astro doesn't need a second
 * component for that case.
 */
import ApiBadge from '../api/ApiBadge.astro'
interface Props {
  href: string
  label: string
  isActive?: boolean
  external?: boolean
  level?: number
  kind?: string
  /** The kind stays on the row for assistive technology; its mark is not drawn. */
  quiet?: boolean
  disabled?: boolean
  /** Pages in the row's section, muted and right-aligned. */
  count?: number
  /** Jumps to the product's installer: the download mark leads the label. */
  install?: boolean
}

const { href, label, isActive = false, external = false, level = 1, kind, quiet = false, disabled = false, count, install = false } = Astro.props
const Tag = disabled ? 'span' : 'a'
---

<Tag
  href={disabled ? undefined : href}
  role={disabled ? 'link' : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  title={disabled ? 'No objects advertised in the reference configuration' : undefined}
  data-sidebar-label={label}
  class:list={['sidebar-link api-nav__row', { active: isActive }]}
  style={`--level:${level}`}
  aria-current={isActive ? 'page' : undefined}
  aria-description={kind}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {kind && !quiet && <ApiBadge label={kind} variant="kind" value={kind} compact />}
  {install && <svg class="sidebar-link__install" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5v7M4.75 6.5 8 9.75l3.25-3.25M3 12.5h10" /></svg>}
  <span>{label}</span>
  {count !== undefined && <span class="sidebar-link__count">{count}<span class="sr-only">{count === 1 ? ' page' : ' pages'}</span></span>}
  {
    external && (
      <span class="external-indicator" aria-hidden="true">
        &#8599;&#65038;
      </span>
    )
  }
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</Tag>

<style>
  .sidebar-link[hidden] { display: none; }
  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0.125rem 0;
    font-size: 0.875rem;
    color: var(--color-foreground-primary);
    text-decoration: none;
  }

  :global([data-theme-mode='dark']) .sidebar-link {
    color: var(--color-foreground-primary);
  }

  /* The column scrolls, so the ring sits inside the row's edge rather than being clipped. */
  .sidebar-link:focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: -2px;
  }

  .sidebar-link:hover {
    color: var(--color-foreground-primary);
    background: var(--color-surface-hover);
  }

  :global([data-theme-mode='dark']) .sidebar-link:hover {
    color: var(--color-foreground-primary);
    background: var(--color-surface-hover);
  }

  .sidebar-link.active {
    color: var(--theme-primary);
    background: var(--current-row-bg);
    font-weight: 600;
  }

  .external-indicator {
    font-size: 0.75rem;
    opacity: 0.6;
  }
  .sidebar-link[aria-disabled='true'] {
    color: var(--color-muted);
    opacity: .6;
    cursor: default;
    background: none;
  }
  .sidebar-link__install { flex: none; margin-right: .25rem; opacity: .75; }
  /* Page counts are muted and tabular, and never the row's accent: the current row keeps one colour. */
  .sidebar-link__count { margin-left: auto; padding-left: .5rem; color: var(--color-foreground-muted); font-size: .75rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .sidebar-link.active .sidebar-link__count { color: inherit; }
</style>
