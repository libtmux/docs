---
/**
 * One sidebar entry. Doubles as the outbound ecosystem-reference link
 * (external + target=_blank) so Sidebar.astro doesn't need a second
 * component for that case.
 */
import ApiBadge from '../api/ApiBadge.astro'
interface Props {
  href: string
  label: string
  isActive?: boolean
  external?: boolean
  level?: number
  kind?: string
  /** The kind stays on the row for assistive technology; its mark is not drawn. */
  quiet?: boolean
  disabled?: boolean
}

const { href, label, isActive = false, external = false, level = 1, kind, quiet = false, disabled = false } = Astro.props
const Tag = disabled ? 'span' : 'a'
---

<Tag
  href={disabled ? undefined : href}
  role={disabled ? 'link' : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  title={disabled ? 'No objects advertised in the reference configuration' : undefined}
  data-sidebar-label={label}
  class:list={['sidebar-link api-nav__row', { active: isActive }]}
  style={`--level:${level}`}
  aria-current={isActive ? 'page' : undefined}
  aria-description={kind}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {kind && !quiet && <ApiBadge label={kind} variant="kind" value={kind} compact />}
  <span>{label}</span>
  {
    external && (
      <span class="external-indicator" aria-hidden="true">
        &#8599;&#65038;
      </span>
    )
  }
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</Tag>

<style>
  .sidebar-link[hidden] { display: none; }
  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0.125rem 0;
    font-size: 0.875rem;
    color: var(--color-foreground-primary);
    text-decoration: none;
  }

  :global([data-theme-mode='dark']) .sidebar-link {
    color: var(--color-foreground-primary);
  }

  .sidebar-link:hover {
    color: var(--color-foreground-primary);
    background: var(--color-surface-hover);
  }

  :global([data-theme-mode='dark']) .sidebar-link:hover {
    color: var(--color-foreground-primary);
    background: var(--color-surface-hover);
  }

  .sidebar-link.active {
    color: var(--theme-primary);
    background: color-mix(in oklab, var(--theme-primary), transparent 90%);
    font-weight: 500;
  }

  :global([data-theme-mode='dark']) .sidebar-link.active {
    background: color-mix(in oklab, var(--theme-primary), transparent 85%);
  }

  .external-indicator {
    font-size: 0.75rem;
    opacity: 0.6;
  }
  .sidebar-link[aria-disabled='true'] {
    color: var(--color-muted);
    opacity: .6;
    cursor: default;
    background: none;
  }
</style>
