---
/**
 * One sidebar entry. Doubles as the outbound ecosystem-reference link
 * (external + target=_blank) so Sidebar.astro doesn't need a second
 * component for that case.
 */
interface Props {
  href: string
  label: string
  isActive?: boolean
  external?: boolean
}

const { href, label, isActive = false, external = false } = Astro.props
---

<a
  href={href}
  class:list={['sidebar-link', { active: isActive }]}
  aria-current={isActive ? 'page' : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span>{label}</span>
  {
    external && (
      <span class="external-indicator" aria-hidden="true">
        &#8599;&#65038;
      </span>
    )
  }
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</a>

<style>
  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    margin: 0.125rem 0;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: rgb(71 85 105); /* slate-600 */
    text-decoration: none;
  }

  :global([data-theme-mode='dark']) .sidebar-link {
    color: rgb(148 163 184); /* slate-400 */
  }

  .sidebar-link:hover {
    color: rgb(15 23 42); /* slate-900 */
    background: rgb(241 245 249); /* slate-100 */
  }

  :global([data-theme-mode='dark']) .sidebar-link:hover {
    color: rgb(241 245 249); /* slate-100 */
    background: rgb(30 41 59); /* slate-800 */
  }

  .sidebar-link.active {
    color: var(--theme-primary);
    background: color-mix(in oklch, var(--theme-primary), transparent 90%);
    font-weight: 500;
  }

  :global([data-theme-mode='dark']) .sidebar-link.active {
    background: color-mix(in oklch, var(--theme-primary), transparent 85%);
  }

  .external-indicator {
    font-size: 0.75rem;
    opacity: 0.6;
  }
</style>
