---
/**
 * A labeled group of sidebar links (frontmatter `sidebar.group`). Always
 * expanded — collapsing is left for later since no port has enough pages
 * yet to need it.
 */
import { isActivePath, type SidebarLinkItem } from '../../lib/sidebar'
import SidebarLink from './SidebarLink.astro'

interface Props {
  label: string
  items: SidebarLinkItem[]
  currentPath: string
}

const { label, items, currentPath } = Astro.props
---

<div class="sidebar-section">
  <p class="section-label">{label}</p>
  <div>
    {
      items.map((item) => (
        <SidebarLink href={item.href} label={item.label} external={item.external} isActive={isActivePath(item.href, currentPath)} />
      ))
    }
  </div>
</div>

<style>
  .sidebar-section {
    margin-bottom: 1rem;
  }

  .section-label {
    margin: 0 0 0.25rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(100 116 139); /* slate-500 */
  }

  :global([data-theme-mode='dark']) .section-label {
    color: rgb(148 163 184); /* slate-400 */
  }
</style>
