---
import { isActivePath, type SidebarItem } from '../../lib/sidebar'
import SidebarLink from './SidebarLink.astro'
import ApiBadge from '../api/ApiBadge.astro'

interface Props {
  label: string
  href?: string
  kind?: string
  level?: number
  items: SidebarItem[]
  currentPath: string
}

const { label, href, kind, level = 1, items, currentPath } = Astro.props
const current = Boolean(href && isActivePath(href, currentPath))
const containsCurrent = (entries: SidebarItem[]): boolean => entries.some((item) =>
  Boolean(item.href && isActivePath(item.href, currentPath)) || (item.type === 'group' && containsCurrent(item.items)))
const expanded = current || containsCurrent(items)
---

{items.length ? (
  <details class="sidebar-section" open={expanded}>
    <summary class="api-nav__row section-label" style={`--level:${level}`}>
      {href ? <a href={href} data-sidebar-label={label} class="api-nav__label" aria-current={current ? 'page' : undefined} aria-description={kind}>{kind && <ApiBadge label={kind} variant="kind" value={kind} compact />}{label}</a>
        : <span class="api-nav__label" aria-description={kind}>{kind && <ApiBadge label={kind} variant="kind" value={kind} compact />}{label}</span>}
      <span class="api-nav__chevron" aria-hidden="true" />
    </summary>
    <div class="sidebar-section__children">
      {items.map((item) => item.type === 'group'
        ? <Astro.self label={item.label} href={item.href} kind={item.kind} items={item.items} currentPath={currentPath} level={level + 1} />
        : <SidebarLink href={item.href} label={item.label} external={item.external} kind={item.kind} disabled={item.disabled}
            isActive={isActivePath(item.href, currentPath)} level={level + 1} />)}
    </div>
  </details>
) : href && <SidebarLink href={href} label={label} kind={kind} isActive={current} level={level} />}

<style>
  .sidebar-section { margin-block: 0.125rem; }
  .section-label { list-style: none; }
  .section-label > .api-nav__label { display: flex; align-items: center; gap: .25rem; min-width: 0; }
  .section-label::-webkit-details-marker { display: none; }
  .section-label:focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: -2px;
  }
  .sidebar-section[open] > summary > .api-nav__chevron::before {
    transform: translateY(0.1rem) rotate(225deg);
  }
  .sidebar-section:not([open]):has([aria-current='page']) > summary {
    background: color-mix(in oklab, var(--theme-primary), transparent 90%);
    font-weight: 600;
  }
</style>
