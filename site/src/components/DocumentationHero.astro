---
interface Props { name: string; tagline: string; logo: string }
const { name, tagline, logo } = Astro.props
---
<section class="port-hero max-w-4xl">
  <img src={logo} width="88" height="88" alt="" class="port-hero__mark" />
  <div class="min-w-0 wrap-anywhere">
    <h1 id="_top" class="mt-1 text-4xl font-semibold tracking-tight sm:text-5xl">{name}</h1>
    <p class="port-hero__tagline mt-2 text-xl">{tagline}</p>
    <slot />
  </div>
  {Astro.slots.has('links') && <div class="port-hero__links"><slot name="links" /></div>}
</section>
<style>
  /* Logo, text and links in one row; the links take the top right and never share the text's column. */
  .port-hero { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: "mark text links"; align-items: start; gap: 1.5rem; }
  .port-hero__links { grid-area: links; justify-self: end; max-width: 100%; padding-top: .5rem; }
  .port-hero__mark { grid-area: mark; }
  .port-hero > div:not(.port-hero__links) { grid-area: text; }
  /* About 60 to 65 characters a line: the sentence keeps its measure whether or not the pills are beside it. */
  @media (min-width: 48rem) {
    .port-hero > div:not(.port-hero__links) { max-width: 36rem; }
  }
  /* One pill per row, as wide as the widest, in the top right cell. */
  .port-hero__links :global(.port-links) { display: grid; grid-template-columns: max-content; gap: .5rem; justify-items: stretch; }
  .port-hero__links :global(.port-link) { justify-content: flex-start; }
  @media (max-width: 47.99rem) {
    .port-hero { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: "mark text" ". links"; }
    .port-hero__links { justify-self: start; padding-top: 0; }
    .port-hero__links :global(.port-links) { display: flex; flex-wrap: wrap; }
  }
  .port-hero__mark { width: 88px; height: 88px; flex: none; object-fit: contain; }
  .port-hero__tagline { color: var(--color-foreground-muted); }
  @media (max-width: 479px) {
    .port-hero { display: block; }
    .port-hero__links { margin-top: .75rem; }
    .port-hero__mark { margin-bottom: 1rem; }
  }
</style>
