---
// BackToTop component with beautiful, accessible styling for light and dark modes
// Features:
// - Control outline, page ground and muted ink from the design tokens
// - Hover scale
// - The shared focus ring (base rule in global.css)
// - ARIA attributes for screen reader support
// - Below the phone breakpoint a 12px inset, and it appears only after two screens of scrolling
// - It stops above the footer: the part of the footer on screen lifts it, so it never covers the footer's links
---

<button
  id="back-to-top"
  class="fixed z-50 p-3 rounded-full
  bg-[var(--background-color)] text-muted
  border border-control shadow-md
  hover:bg-surface-hover hover:text-[var(--text-color)]
  hover:shadow-lg hover:scale-110
  focus-visible:scale-110
  cursor-pointer
  opacity-0 translate-y-4 pointer-events-none"
  aria-label="Back to top"
  title="Scroll to top"
  type="button"
>
  <svg 
    width="15" 
    height="15" 
    viewBox="0 0 15 15" 
    fill="none" 
    xmlns="http://www.w3.org/2000/svg" 
    class="h-5 w-5"
    aria-hidden="true"
  >
    <path 
      d="M3.13523 8.84197C3.3241 9.04343 3.64052 9.05363 3.84197 8.86477L7.5 5.43536L11.158 8.86477C11.3595 9.05363 11.6759 9.04343 11.8648 8.84197C12.0536 8.64051 12.0434 8.32409 11.842 8.13523L7.84197 4.38523C7.64964 4.20492 7.35036 4.20492 7.15803 4.38523L3.15803 8.13523C2.95657 8.32409 2.94637 8.64051 3.13523 8.84197Z" 
      fill="currentColor" 
      fill-rule="evenodd" 
      clip-rule="evenodd"
    />
  </svg>
</button>

<style>
  /* The corner comes from named properties. A transform lifts the button above the footer's visible part (--back-to-top-footer,
     set by the script below) and above the audio player bar (4rem), whichever is taller, so the lift moves no layout. */
  #back-to-top {
    right: var(--back-to-top-inset);
    bottom: var(--back-to-top-inset);
    transform: translateY(calc(-1 * max(var(--back-to-top-player-lift, 0rem), var(--back-to-top-footer, 0px))));
  }
  #back-to-top[data-lift='player'] { --back-to-top-player-lift: 4rem; }
</style>

<script>
  import { below } from '../lib/breakpoints'

  // Listeners are scoped to an AbortController so re-initialization after
  // ClientRouter navigations replaces them instead of stacking duplicates.
  let controller: AbortController | null = null

  function initBackToTop() {
    controller?.abort()
    controller = new AbortController()
    const { signal } = controller
    const button = document.getElementById('back-to-top')
    if (!button) return

    const footer = document.querySelector<HTMLElement>('[data-site-footer]')
    let isVisible = false
    let isPlayerVisible = false
    let footerShown = -1

    // The player bar is h-16 (4rem); the stylesheet lifts the button over it.
    const updatePlayerLift = () => {
      button.dataset.lift = isPlayerVisible ? 'player' : ''
    }

    // The footer scrolls up under the button's corner. The part of it on screen is how far the button must rise to stop above its top edge.
    const updateFooterClearance = () => {
      if (!footer) return
      const shown = Math.max(0, Math.round(document.documentElement.clientHeight - footer.getBoundingClientRect().top))
      if (shown === footerShown) return
      footerShown = shown
      button.style.setProperty('--back-to-top-footer', `${shown}px`)
    }

    // On a phone the button waits for two screens of scrolling, so it does not sit over the first screens' controls.
    const phone = window.matchMedia(below('phone'))

    const toggleVisibility = () => {
      // Show button when scrolled down 300px, or two screens on a phone
      if (window.pageYOffset > (phone.matches ? 2 * window.innerHeight : 300)) {
        if (!isVisible) {
          isVisible = true
          button.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none')
          button.classList.add('opacity-100', 'translate-y-0')
        }
      } else {
        if (isVisible) {
          isVisible = false
          button.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none')
          button.classList.remove('opacity-100', 'translate-y-0')
        }
      }

      updateFooterClearance()

      // Check if audio player bar is visible
      const newIsPlayerVisible = document.body.classList.contains('player-visible')
      if (newIsPlayerVisible !== isPlayerVisible) {
        isPlayerVisible = newIsPlayerVisible
        updatePlayerLift()
      }
    }

    const handleClick = () => {
      // Site is intentionally motionless: jump, don't smooth-scroll
      window.scrollTo({ top: 0 })
    }

    // Add listeners; the controller cleans up the previous generation
    window.addEventListener('scroll', toggleVisibility, { signal, passive: true })
    window.addEventListener('resize', toggleVisibility, { signal, passive: true })
    phone.addEventListener('change', toggleVisibility, { signal })
    // Content above the footer can change height without a scroll, which moves the footer's top edge.
    const resizes = new ResizeObserver(toggleVisibility)
    resizes.observe(document.body)
    signal.addEventListener('abort', () => resizes.disconnect())
    button.addEventListener('click', handleClick, { signal })

    // Check initial state
    toggleVisibility()
  }

  // Initialize on first load
  initBackToTop()

  // Re-initialize after view transitions
  document.addEventListener('astro:after-swap', initBackToTop)
</script>
