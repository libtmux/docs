---
import ColorSchemeSwitcher from './ColorSchemeSwitcher.astro'
import LocaleSwitcher from './LocaleSwitcher.astro'
import VersionSwitcher from './VersionSwitcher.astro'
import HeaderLinks from './HeaderLinks.astro'
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales'
import type { LocaleStatus } from '../i18n/resolve'
import { portHeaderLinks } from '../lib/header-links'
import { PORT_BY_SLUG, portPageUrl, productAvailable } from '../lib/ports'
import { withPortRoot, withRoot } from '../lib/site-root'

interface Props {
  documentationContext?: boolean
  portSlug?: string
  version: string
  /** Current page path for the locale control. */
  pagePath?: string
  /** Current locale, for the locale switcher. */
  locale?: Locale
  /**
   * This page's path with any locale prefix removed. The locale switcher
   * needs the unprefixed form: it composes each target from that locale's own
   * root, and `pagePath` in a port build is relative to the port instead.
   */
  sourcePath?: string
  /** Each available locale's translation status. */
  localeStatuses?: Record<string, LocaleStatus>
}
const {
  portSlug,
  version,
  pagePath = '',
  locale = DEFAULT_LOCALE,
  sourcePath,
  localeStatuses,
  documentationContext = false,
} = Astro.props as Props

/*
 * Source, package and reference links belong to a port's pages. A page with no
 * port, such as the homepage or the tmux manual, has no package to name.
 */
const port = portSlug ? PORT_BY_SLUG[portSlug] : undefined
const links = port ? portHeaderLinks(port) : undefined
---

{/* The first tab stop on every page (record 0077). It is hidden until focused and leads to `main#content`; the script below covers a native page, whose article is not a `main`. */}
<a class="skip-link" href="#content">Skip to content</a>

<header
  class="site-header sticky top-0 z-40 border-b border-edge"
  style="background: var(--topnav-background); backdrop-filter: blur(var(--topnav-backdrop-blur, 8px));"
>
  <div class="site-header__bar">
    <a href={withRoot('/')} class="site-header__mark font-mono text-lg font-semibold tracking-tight">
      <span class="site-header__wordmark">libtmux</span>
    </a>

    <slot name="navigation" />

    <div class="site-header__spacer"></div>

    {/*
      The repository and package host are ordinary links, always one click
      away; the disclosure beside them lists every other package and source
      directory. They fit the bar from 48rem; below that the Menu panel holds
      a second copy and CSS leaves one of the two shown.
    */}
    {
      port && links && links.actions.length > 0 && (
        <div class="site-header__destinations" role="group" aria-label="Repository and packages" data-pagefind-ignore="all">
          <HeaderLinks port={port} links={links} placement="bar" />
        </div>
      )
    }

    {/* Keep search and colour controls visible at every width. */}
    <div class="site-header__always">
      <a
        href={portSlug ? withPortRoot(`/${portSlug}/${version}/search/`) : withRoot('/search/')}
        class="topnav-chip site-header__search border border-control"
        aria-label="Search the documentation"
        aria-keyshortcuts="Control+K Meta+K"
      >
        <svg class="site-header__search-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="7" cy="7" r="4.25" />
          <path d="M10.2 10.2 14 14" stroke-linecap="round" />
        </svg>
        <span class="site-header__search-label">Search</span>
        {/* The shortcut is announced by aria-keyshortcuts; the cap is for sighted readers. Apple keyboards get the Command glyph from the script below. */}
        <kbd class="site-header__search-hint" aria-hidden="true" data-search-hint>Ctrl K</kbd>
      </a>
      <ColorSchemeSwitcher />
    </div>

    {/*
      One disclosure rather than a scripted drawer. `<details>` brings its own
      toggle semantics, its own keyboard handling and a closed state that is
      genuinely out of the tab order, none of which has to be kept true by
      hand — the same reason the locale switcher is one.

      The button shows only when it holds something the bar does not. Under a
      ContextStrip the panel's content is the bar's destinations below 48rem
      and two links the product picker already offers above it, so from 48rem
      the whole disclosure goes and its panel stays in the document for the
      first-paint hold below.
    */}
    <details class:list={['site-header__menu', documentationContext && 'site-header__menu--overflow']} data-header-menu>
      <summary class="topnav-chip site-header__menu-button" aria-label="More navigation">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M2 4h12M2 8h12M2 12h12" stroke-linecap="round" />
        </svg>
        <span class="site-header__menu-label">Menu</span>
      </summary>

      {/* The last part of the bar: the base layout holds the first frame until this arrives. */}
      <div id="site-header-panel" class="site-header__panel">
        {!documentationContext && <div class="site-header__panel-row site-header__panel-controls">
          <VersionSwitcher portSlug={pagePath.startsWith('reference') ? undefined : portSlug} version={version} />
          {
            localeStatuses && (
              <LocaleSwitcher
                locale={locale}
                sourcePath={sourcePath ?? pagePath}
                localeStatuses={localeStatuses}
              />
            )
          }
        </div>}
        <div class="site-header__panel-row site-header__panel-links">
          <a href={withPortRoot('/reference/')} class="topnav-chip px-2 py-1 text-sm">Reference</a>
          {port && productAvailable(port, 'mcp') && <a href={portPageUrl(port, version, 'mcp')} class="topnav-chip px-2 py-1 text-sm">MCP</a>}
        </div>
        {port && links && links.actions.length > 0 && <div class="site-header__panel-row site-header__panel-destinations" role="group" aria-label="Repository and packages" data-pagefind-ignore="all">
          <HeaderLinks port={port} links={links} placement="menu" />
        </div>}
      </div>
    </details>
  </div>
</header>

<script>
  import { installSkipLink } from '../lib/skip-link'

  installSkipLink()

  /** The key is Command on Apple keyboards and Control elsewhere; the server renders the latter. */
  function nameSearchKey() {
    const platform = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? navigator.platform ?? ''
    if (!/mac|iphone|ipad|ipod/i.test(platform)) return
    for (const hint of document.querySelectorAll('[data-search-hint]')) hint.textContent = '⌘K'
  }

  nameSearchKey()
  document.addEventListener('astro:after-swap', nameSearchKey)
</script>
