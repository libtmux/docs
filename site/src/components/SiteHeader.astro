---
import { branding } from '../lib/branding'
import ColorSchemeSwitcher from './ColorSchemeSwitcher.astro'
import LocaleSwitcher from './LocaleSwitcher.astro'
import PortSwitcher from './PortSwitcher.astro'
import VersionSwitcher from './VersionSwitcher.astro'
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales'
import type { LocaleStatus } from '../i18n/resolve'
import { withPortRoot, withRoot } from '../lib/site-root'

interface Props {
  documentationContext?: boolean
  portSlug?: string
  version: string
  /** Current page path for the locale control. */
  pagePath?: string
  /** Current locale, for the locale switcher. */
  locale?: Locale
  /**
   * This page's path with any locale prefix removed. The locale switcher
   * needs the unprefixed form: it composes each target from that locale's own
   * root, and `pagePath` in a port build is relative to the port instead.
   */
  sourcePath?: string
  /** Each available locale's translation status. */
  localeStatuses?: Record<string, LocaleStatus>
}
const {
  portSlug,
  version,
  pagePath = '',
  locale = DEFAULT_LOCALE,
  sourcePath,
  localeStatuses,
  documentationContext = false,
} = Astro.props as Props
const brand = branding(portSlug, pagePath)
---

<header
  class="site-header sticky top-0 z-40 border-b border-edge"
  style="background: var(--topnav-background); backdrop-filter: blur(var(--topnav-backdrop-blur, 8px));"
>
  <div class="site-header__bar">
    <a href={withRoot('/')} class="site-header__mark font-mono text-lg font-semibold tracking-tight"><img src={withRoot(brand.asset('logo.svg'))} width="28" height="28" alt="" aria-hidden="true" />libtmux</a>

    {/*
      Keep language navigation on one line. On phones, move it into the menu
      so the header leaves room for the page and its documentation toolbar.
    */}
    <div class="site-header__ports"><PortSwitcher portSlug={portSlug} version={version} /></div>

    <div class="site-header__spacer"></div>

    {/*
      Always visible, at every width. Reading in the wrong colour scheme is
      uncomfortable in a way that reaching one menu deeper for the language
      list is not, and search is the control a reader wants when the page they
      landed on is the wrong one.
    */}
    <div class="site-header__always">
      <a
        href={portSlug ? withPortRoot(`/${portSlug}/${version}/search/`) : withRoot('/search/')}
        class="topnav-chip site-header__search border border-edge"
        aria-label="Search the documentation"
      >
        <svg class="site-header__search-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="7" cy="7" r="4.25" />
          <path d="M10.2 10.2 14 14" stroke-linecap="round" />
        </svg>
        <span class="site-header__search-label">Search</span>
      </a>
      <ColorSchemeSwitcher />
    </div>

    {/*
      One disclosure rather than a scripted drawer. `<details>` brings its own
      toggle semantics, its own keyboard handling and a closed state that is
      genuinely out of the tab order, none of which has to be kept true by
      hand — the same reason the locale switcher is one.
    */}
    <details class="site-header__menu">
      <summary class="topnav-chip site-header__menu-button" aria-label="More navigation">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M2 4h12M2 8h12M2 12h12" stroke-linecap="round" />
        </svg>
        <span class="site-header__menu-label">Menu</span>
      </summary>

      <div class="site-header__panel">
        {/* Hidden while the language navigation fits in the bar. */}
        <div class="site-header__panel-ports">
          <PortSwitcher portSlug={portSlug} version={version} />
        </div>
        {!documentationContext && <div class="site-header__panel-row site-header__panel-controls">
          <VersionSwitcher portSlug={pagePath.startsWith('reference') ? undefined : portSlug} version={version} />
          {
            localeStatuses && (
              <LocaleSwitcher
                locale={locale}
                sourcePath={sourcePath ?? pagePath}
                localeStatuses={localeStatuses}
              />
            )
          }
        </div>}
        <div class="site-header__panel-row site-header__panel-links">
          <a href={withPortRoot('/reference/')} class="topnav-chip px-2 py-1 text-sm">Reference</a>
          <a href={withRoot('/mcp/')} class="topnav-chip px-2 py-1 text-sm">MCP</a>
        </div>
      </div>
    </details>
  </div>
</header>
