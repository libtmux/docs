---
import DocsLayout from '../../layouts/DocsLayout.astro'
import DocCard from '../../components/DocCard.astro'
import { withRoot } from '../../lib/site-root'
import { tmuxReferenceUrl } from '../../lib/tmux-reference'
import { pagePortsFor } from '../../lib/page-ports-for'
import TmuxLogo from './Logo.astro'
const pages = [
  { label: 'Guides', href: withRoot('/tmux/guides/'), body: 'Create sessions, split panes, send input and capture output.' },
  { label: 'Topics', href: withRoot('/tmux/topics/'), body: 'Understand targeting, options, hooks, completion and server ownership.' },
  { label: 'Concepts', href: withRoot('/tmux/concepts/'), body: 'Learn how servers, sessions, windows and panes fit together.' },
  { label: 'Examples', href: withRoot('/tmux/examples/'), body: 'Run complete programs with setup, expected results and cleanup.' },
  { label: 'Manual', href: tmuxReferenceUrl(), body: 'Look up command syntax, flags and behavior for your tmux version.' },
]
---
<DocsLayout title="Just tmux" description="Use tmux from your terminal: guides, topics and a versioned manual."
  pagePath="tmux" pagePorts={await pagePortsFor('')} tableOfContents={false}>
  <TmuxLogo size={56} />
  <p>Create terminal workspaces, keep sessions running, and control windows and panes from the command line.</p>
  <p>This is the <a href={withRoot('/')}>libtmux</a> website. Our libraries and supporting tools control tmux;
    these pages are maintained separately from the <a href="https://github.com/tmux/tmux/wiki">official tmux website</a>.</p>
  <p>tmux was created by <a href="https://github.com/nicm">Nicholas Marriott (nicm)</a> and is developed with its
    <a href="https://github.com/tmux/tmux/graphs/contributors">contributors</a>.
    Thank you to Nicholas Marriott and everyone who makes tmux possible.</p>
  <div class="not-prose grid gap-4 sm:grid-cols-2">
    {pages.map((page) => <DocCard {...page} />)}
  </div>
  <p>The <a href={withRoot('/')}>language libraries</a> control the same tmux objects from application code. Command pages link to related guides and library APIs.</p>
</DocsLayout>
