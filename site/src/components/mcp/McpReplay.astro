---
/**
 * A prompt and the tool calls an agent makes for it, as a replay.
 *
 * Shared by the MCP overview and the port landing page. The calls come from
 * `EXAMPLES` in `lib/mcp-examples.ts`, which a test checks against each tool's
 * input schema in the port's `tools/list` snapshot. With a recorded session
 * (`gen-mcp-transcript.mjs`) the chat on the left shows each call and the
 * result the server answered, and the tmux preview on the right shows the
 * layout and panes of the recording's own tmux server after that call, with
 * pane output from the calls' results, or the state the results describe when
 * the recording stored none (`lib/mcp-replay.ts`). The script
 * below plays the session, or lets a reader step through it. Without script
 * the whole chat and the final state show. Without a recording the page shows
 * the requests only, says so, and draws no preview.
 */
import { Code } from 'astro-expressive-code/components'
import type { Frame } from '../../lib/mcp-replay'
import { tierFor, type WorkedExample } from '../../lib/mcp-showcase'
import ReplayControls from '../replay/ReplayControls.astro'
import TmuxScreen from '../replay/TmuxScreen.astro'
import '../../styles/mcp-showcase.css'
import '../../styles/mcp-replay.css'

interface Props {
  example: WorkedExample
  portName: string
  /** The heading's level: 2 on the overview, where it is a section, 3 inside a landing panel. */
  level?: 2 | 3
}
const { example, portName, level = 2 } = Astro.props as Props
const Heading = `h${level}` as 'h2' | 'h3'
const { recording } = example
const total = example.steps.length
const args = (value: Record<string, unknown>) => JSON.stringify(value)
const shown = (value: unknown) => (typeof value === 'string' ? value : JSON.stringify(value, null, 2))
const answers = recording?.answers ?? []

/** What each frame's note says, for a recording that has no tmux state of its own: it can say only what the call read. */
const note = (frame: Frame) => {
  if (!frame.tool) return 'Before the first call.'
  return frame.reading ? `${frame.tool} read the ${frame.reading}; tmux itself is unchanged.` : `After ${frame.tool}.`
}
---
<Heading id="worked-example">Worked example</Heading>
<p>Given this prompt, an agent connected to the {portName} server makes these calls{recording ? ' and gets these results' : ''}.</p>
<section class={`not-prose mcp-replay${recording ? '' : ' mcp-replay--requests'}`} data-mcp-replay data-steps={total} aria-label="Worked example replay">
  {recording && (
    <header class="mcp-replay__head" data-head hidden>
      <span class="mcp-replay__title">Replay</span>
      <span class="mcp-replay__hint" data-hint>Hover a call to preview the tmux state after it. Click to pin it.</span>
    </header>
  )}
  <div class="mcp-replay__body" tabindex={recording ? 0 : undefined} data-body>
    {recording && (
      <div class="mcp-replay__tmux" data-tmux role="group" aria-label="tmux state after the call shown">
        {recording.frames.map((frame) => {
          return (
            <div class="mcp-frame" data-frame={frame.done} hidden={frame.done !== total}>
              <TmuxScreen frame={frame} hadSessions={recording.frames.some((earlier) => earlier.done < frame.done && earlier.sessions.length > 0)} />
              {frame.recorded ? (
                <p class="mcp-frame__note">{frame.tool ? <>tmux after <code>{frame.tool}</code>{frame.unchanged ? ': unchanged, the call only reads.' : '.'}</> : 'tmux before the first call.'}</p>
              ) : (
                <p class="mcp-frame__note">{note(frame)}</p>
              )}
            </div>
          )
        })}
      </div>
    )}
    <div class="mcp-replay__chat" data-chat>
      <div class="mcp-turn mcp-turn--user" data-turn="prompt"><span class="mcp-turn__who">you</span><p>{example.prompt}</p></div>
      {example.steps.map((step, index) => {
        const tier = tierFor(step.tool)
        return (
          <article class="mcp-turn" data-turn={index}>
            <p class="mcp-turn__say"><span class="mcp-turn__who">agent</span>{step.caption}</p>
            <div class="mcp-call">
              <span class="mcp-call__dot" aria-hidden="true"></span>
              <span class="mcp-call__tool"><a href={step.tool.href}><code>{step.tool.name}</code></a></span>
              {tier && <span class={`mcp-tier mcp-tier--${step.tool.tier}`} title={tier.tooltip}>{tier.label}</span>}
              <code class="mcp-call__args">{args(step.arguments)}</code>
            </div>
            {recording && <button type="button" class="mcp-turn__pin" data-pin aria-pressed="false" tabindex="-1" hidden aria-label={`Pin the tmux state after ${step.tool.name}`}><svg class="mcp-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2.5h6v11L8 11l-3 2.5z" /></svg></button>}
            {recording && step.result !== undefined && (
              <details class="mcp-result" open>
                <summary>Result</summary>
                <div class="mcp-result__body"><Code code={shown(step.result)} lang={typeof step.result === 'string' ? 'text' : 'json'} frame="none" /></div>
              </details>
            )}
          </article>
        )
      })}
      {recording && answers.length > 0 && (
        <div class="mcp-turn mcp-turn--answer" data-turn={total}>
          <button type="button" class="mcp-turn__pin" data-pin aria-pressed="false" tabindex="-1" hidden aria-label="Pin the final tmux state"><svg class="mcp-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2.5h6v11L8 11l-3 2.5z" /></svg></button>
          <p class="mcp-turn__say"><span class="mcp-turn__who">agent</span>
            {answers.map((answer, index) => <>{index > 0 && '; '}{answer.pane ? `in ${answer.pane} it` : 'It'} printed <q>{answer.line}</q></>)}.</p>
        </div>
      )}
    </div>
  </div>
  {recording && <ReplayControls marks={example.steps.map((step) => `Show the state after ${step.tool.name}`)} />}
</section>
{recording ? (
  <p class="not-prose mcp-provenance">
    Calls and results are recorded against <a href={`https://github.com/${recording.repo}/tree/${recording.revision}`}><code>{recording.repo}</code></a>
    at <code>{recording.revision.slice(0, 9)}</code>, on a private {recording.tmux} server{recording.answers.length > 0 && <>, running {recording.runner}</>}.
    {recording.tmuxState ? "The preview takes its layout and panes from the recording's own tmux server after each call, and a pane's output from the results of the calls." : 'The preview draws only what those results state.'}
    The agent's narration is illustrative.
    {recording.documentedRevision && <> This page documents <a href={`https://github.com/${recording.repo}/tree/${recording.documentedRevision}`}><code>{recording.documentedRevision.slice(0, 9)}</code></a>, a different revision. The calls have the same input{recording.outputsChecked && ' and output'} schemas there, but the results at that revision may differ from the recorded ones.</>}
    {recording.shortened && <> Long values in a result are shortened here; the recording keeps them.</>}
    {recording.projectDirectory && <> The sandbox's project directory is shown as <code>{recording.projectDirectory}</code>.</>}
    {recording.generation && <> The server's generation differs on every run. A real call sends the generation <code>{recording.generation.listedBy}</code> returned, and the server refuses <code>{recording.generation.token}</code> itself as <code>{recording.generation.refusedAs}</code>; the recording shows the generation as <code>{recording.generation.token}</code>.</>}
  </p>
) : (
  <p class="not-prose mcp-provenance">Requests only: no recorded results for {portName} yet.</p>
)}

<script>
  import { bindReplay } from '../../lib/replay-player'

  function bindReplayChat(root: HTMLElement) {
    const total = Number(root.dataset.steps)
    const body = root.querySelector<HTMLElement>('[data-body]')!
    const chat = root.querySelector<HTMLElement>('[data-chat]')!
    const turns = [...root.querySelectorAll<HTMLElement>('[data-turn]')].filter((turn) => turn.dataset.turn !== 'prompt')
    const pins = turns.map((turn) => turn.querySelector<HTMLButtonElement>('[data-pin]')!)
    const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')]
    const hint = root.querySelector<HTMLElement>('[data-hint]')
    // A touch screen fires mouseenter on a tap and never mouseleave, so only a pointer that can hover previews.
    const canHover = window.matchMedia?.('(hover: hover)').matches ?? true
    const head = root.querySelector<HTMLElement>('[data-head]')
    const IDLE_HINT = canHover ? 'Hover a call to preview the tmux state after it. Click to pin it.' : 'Tap a call to pin the tmux state after it.'
    // The one call whose pin button is a tab stop; arrow keys move it, so the list is a single stop.
    let rover = -1

    const player = bindReplay(root, {
      body,
      total: () => total,
      // Calls made so far, the call pinned by a click, and the call under the pointer or focus.
      render({ step, shown, pinned }, scroll) {
        turns.forEach((turn) => {
          const index = Number(turn.dataset.turn)
          // The answer comes after the last call, so it shows once every call has played.
          turn.hidden = index === total ? step < total : index >= step
          if (index < total && index + 1 === shown) turn.setAttribute('aria-current', 'step')
          else turn.removeAttribute('aria-current')
          turn.classList.toggle('is-pinned', pinned !== null && Math.min(index + 1, total) === pinned)
        })
        const visible = turns.map((turn, position) => (turn.hidden ? -1 : position)).filter((position) => position >= 0)
        const active = visible.includes(rover) ? rover : visible.at(-1) ?? -1
        pins.forEach((pin, position) => {
          pin.setAttribute('aria-pressed', String(pinned !== null && Math.min(Number(turns[position]!.dataset.turn) + 1, total) === pinned))
          pin.tabIndex = position === active ? 0 : -1
        })
        frames.forEach((frame) => { frame.hidden = Number(frame.dataset.frame) !== shown })
        if (hint) hint.textContent = pinned !== null ? 'Pinned. Click the call again, or press Escape, to follow the replay.' : IDLE_HINT
        if (scroll) chat.scrollTo({ top: chat.scrollHeight, behavior: window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
      },
      ownsKey: (target) => target.hasAttribute('data-pin'),
    })
    if (!player) return
    if (head) head.hidden = false
    root.querySelectorAll<HTMLDetailsElement>('details.mcp-result').forEach((details) => { details.open = false })

    pins.forEach((pin) => { pin.hidden = false })
    turns.forEach((turn, position) => {
      const frame = Math.min(Number(turn.dataset.turn) + 1, total)
      const pin = pins[position]!
      if (canHover) {
        turn.addEventListener('mouseenter', () => player.hover(frame))
        turn.addEventListener('mouseleave', () => player.hover(null))
      }
      // A click anywhere on the call pins it, for a pointer; the button is the way in for a keyboard and for assistive technology.
      turn.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a, summary, button')) return
        player.togglePin(frame)
      })
      pin.addEventListener('click', () => { rover = position; player.togglePin(frame) })
      pin.addEventListener('focus', () => { rover = position })
      pin.addEventListener('keydown', (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return
        const visible = turns.map((candidate, index) => (candidate.hidden ? -1 : index)).filter((index) => index >= 0)
        const next = visible[visible.indexOf(position) + (event.key === 'ArrowDown' ? 1 : -1)]
        if (next === undefined) return
        event.preventDefault()
        rover = next
        player.refresh()
        pins[next]!.focus()
      })
    })
  }

  const bindAll = () => document.querySelectorAll<HTMLElement>('[data-mcp-replay]:not([data-live])').forEach(bindReplayChat)
  bindAll()
  document.addEventListener('astro:after-swap', bindAll)
</script>
