---
/**
 * A prompt and the tool calls an agent makes for it, as a replay.
 *
 * Shared by the MCP overview and the port landing page. The calls come from
 * `EXAMPLES` in `lib/mcp-examples.ts`, which a test checks against each tool's
 * input schema in the port's `tools/list` snapshot. With a recorded session
 * (`gen-mcp-transcript.mjs`) the chat on the left shows each call and the
 * result the server answered, and the tmux preview on the right shows the
 * layout and panes of the recording's own tmux server after that call, with
 * pane output from the calls' results, or the state the results describe when
 * the recording stored none (`lib/mcp-replay.ts`). The script
 * below plays the session, or lets a reader step through it. Without script
 * the whole chat and the final state show. The markup is drawn at rest (record 0081), where the script starts: the prompt and the first call, the tmux after that call, no turn highlighted, the first mark a hollow ring, so binding it changes nothing on screen; `mcp-replay.css` shows the finished chat instead where there is no script, and for a reader who asked for less motion until the script binds (that reader opens on the finished chat). Without a recording the page shows
 * the requests only, says so, and draws no preview.
 *
 * Selecting text in a turn never changes the step. Hovering a turn previews the
 * tmux after it; its pin button holds that step, and the controls and the arrow
 * keys move between steps. The first stepping action leaves rest. Nothing plays
 * until the reader presses play, unless the instance sets `autoplay`.
 */
import { Code } from 'astro-expressive-code/components'
import type { Frame } from '../../lib/mcp-replay'
import { replyParagraphs, tierFor, type WorkedExample } from '../../lib/mcp-showcase'
import ReplayControls from '../replay/ReplayControls.astro'
import TmuxScreen from '../replay/TmuxScreen.astro'
import '../../styles/mcp-showcase.css'
import '../../styles/mcp-replay.css'

interface Props {
  example: WorkedExample
  portName: string
  /** The heading's level: 2 on the overview, where it is a section, 3 inside a landing panel. */
  level?: 2 | 3
  /** Play by itself once the replay is 40% on screen. Off by default; a reader's selection, scroll or focus stops it, and reduced motion never starts it. */
  autoplay?: boolean
}
const { example, portName, level = 2, autoplay = false } = Astro.props as Props
const Heading = `h${level}` as 'h2' | 'h3'
const { recording } = example
const total = example.steps.length
// The replay opens at rest on the first call: its turn and the tmux after it show, and nothing is highlighted.
const opening = Math.min(1, total)
const args = (value: Record<string, unknown>) => JSON.stringify(value)
const shown = (value: unknown) => (typeof value === 'string' ? value : JSON.stringify(value, null, 2))
const reply = recording?.reply

/** What each frame's note says, for a recording that has no tmux state of its own: it can say only what the call read. */
const note = (frame: Frame) => {
  if (!frame.tool) return 'Before the first call.'
  return frame.reading ? `${frame.tool} read the ${frame.reading}; tmux itself is unchanged.` : `After ${frame.tool}.`
}
---
{/* The heading was "Worked example"; links to that anchor still land here. */}
<span id="worked-example"></span>
<Heading id="tmux-through-mcp">tmux through MCP</Heading>
<section class={`not-prose mcp-replay${recording ? '' : ' mcp-replay--requests'}`} data-mcp-replay data-steps={total} data-autoplay={autoplay ? '' : undefined} aria-label="tmux through MCP replay">
  {recording && (
    <header class="mcp-replay__head" data-head>
      <span class="mcp-replay__title">Replay</span>
      <span class="mcp-replay__hint" data-hint>Hover a call to preview the tmux state after it. Use its pin button to hold it. With the replay focused, the arrow keys, Home and End step through the calls.</span>
    </header>
  )}
  <div class="mcp-replay__body" tabindex={recording ? 0 : undefined} role={recording ? 'group' : undefined} aria-label={recording ? 'The chat and the tmux it leaves' : undefined} aria-keyshortcuts={recording ? 'ArrowLeft ArrowRight Home End' : undefined} data-body>
    {recording && (
      <div class="mcp-replay__tmux" data-tmux role="group" aria-label="tmux state after the call shown">
        {recording.frames.map((frame) => {
          return (
            <div class="mcp-frame" data-frame={frame.done} data-off={frame.done === opening ? undefined : ''}>
              <TmuxScreen frame={frame} hadSessions={recording.frames.some((earlier) => earlier.done < frame.done && earlier.sessions.length > 0)} />
              {frame.recorded ? (
                <p class="mcp-frame__note">{frame.tool ? <>tmux after <code>{frame.tool}</code>{frame.unchanged ? ': unchanged, the call only reads.' : '.'}</> : 'tmux before the first call.'}</p>
              ) : (
                <p class="mcp-frame__note">{note(frame)}</p>
              )}
            </div>
          )
        })}
      </div>
    )}
    <div class="mcp-replay__chat" data-chat>
      <div class="mcp-turn mcp-turn--user" data-turn="prompt"><span class="mcp-turn__who">You</span><p>{example.prompt}</p></div>
      {example.steps.map((step, index) => {
        const tier = tierFor(step.tool)
        return (
          <article class="mcp-turn" data-turn={index} data-off={recording && index >= opening ? '' : undefined}>
            <p class="mcp-turn__say"><span class="mcp-turn__who">Agent</span>{step.caption}</p>
            <div class="mcp-call">
              <span class="mcp-call__dot" aria-hidden="true"></span>
              <span class="mcp-call__tool"><a href={step.tool.href}><code>{step.tool.name}</code></a></span>
              {tier && <span class={`mcp-tier mcp-tier--${step.tool.tier}`} title={tier.tooltip}>{tier.label}</span>}
              <code class="mcp-call__args">{args(step.arguments)}</code>
            </div>
            {recording && <button type="button" class="mcp-turn__pin" data-pin aria-pressed="false" tabindex="-1" hidden aria-label={`Pin the tmux state after ${step.tool.name}`}><svg class="mcp-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2.5h6v11L8 11l-3 2.5z" /></svg></button>}
            {recording && step.result !== undefined && (
              <details class="mcp-result" open>
                <summary>Result</summary>
                <div class="mcp-result__body"><Code code={shown(step.result)} lang={typeof step.result === 'string' ? 'text' : 'json'} frame="none" /></div>
              </details>
            )}
          </article>
        )
      })}
      {recording && reply && (
        // The agent's closing reply is its words, not a step: no tool, result or pin, and no mark on the rail. Output it quotes is <samp>. A recording without a reply has no closing turn: nothing is built from the panes (record 0074).
        <div class="mcp-turn mcp-turn--answer" data-turn={total} data-off>
          <span class="mcp-turn__who">Agent</span>
          {replyParagraphs(reply).map((runs) => <p>{runs.map((run) => (run.kind === 'code' ? <code>{run.text}</code> : run.kind === 'output' ? <samp>{run.text}</samp> : run.text))}</p>)}
        </div>
      )}
    </div>
  </div>
  {recording && <ReplayControls start="Show tmux before the first call" at={opening} rest={opening > 0} marks={example.steps.map((step) => `Show the state after ${step.tool.name}`)} />}
</section>
{!recording && <p class="not-prose mcp-replay-note">Requests only: no recorded results for {portName} yet.</p>}

<script>
  import { bindReplay, linkedStep } from '../../lib/replay-player'

  function bindReplayChat(root: HTMLElement, linked: number | undefined) {
    const total = Number(root.dataset.steps)
    const body = root.querySelector<HTMLElement>('[data-body]')!
    const chat = root.querySelector<HTMLElement>('[data-chat]')!
    const turns = [...root.querySelectorAll<HTMLElement>('[data-turn]')].filter((turn) => turn.dataset.turn !== 'prompt')
    // Only calls have a pin; the closing reply is not a step.
    const pins = turns.map((turn) => turn.querySelector<HTMLButtonElement>('[data-pin]'))
    const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')]
    const hint = root.querySelector<HTMLElement>('[data-hint]')
    // A touch screen fires mouseenter on a tap and never mouseleave, so only a pointer that can hover previews.
    const canHover = window.matchMedia?.('(hover: hover)').matches ?? true
    const KEYS = ' With the replay focused, the arrow keys, Home and End step through the calls.'
    const IDLE_HINT = (canHover ? 'Hover a call to preview the tmux state after it. Use its pin button to hold it.' : 'Use a call\'s pin button to hold the tmux state after it.') + KEYS
    // The one call whose pin button is a tab stop; arrow keys move it, so the list is a single stop.
    let rover = -1

    const player = bindReplay(root, {
      body,
      content: chat,
      autoplay: root.hasAttribute('data-autoplay'),
      // Open at rest: the first call and the tmux after it show, no turn is highlighted. A link that names a step opens on it instead.
      opening: linked ?? 1,
      rest: linked === undefined,
      // A reader who asked for less motion has the finished chat, and presses play to watch it again.
      reducedOpening: 'end',
      total: () => total,
      // Calls made so far, the call pinned by a click, and the call under the pointer or focus.
      render({ step, shown, pinned, rest }, scroll) {
        turns.forEach((turn) => {
          const index = Number(turn.dataset.turn)
          // The answer comes after the last call, so it shows once every call has played.
          turn.toggleAttribute('data-off', index === total ? step < total : index >= step)
          if (index < total && index + 1 === shown && !rest) turn.setAttribute('aria-current', 'step')
          else turn.removeAttribute('aria-current')
          turn.classList.toggle('is-pinned', pinned !== null && index < total && index + 1 === pinned)
        })
        const visible = turns.map((turn, position) => (turn.hasAttribute('data-off') || !pins[position] ? -1 : position)).filter((position) => position >= 0)
        const active = visible.includes(rover) ? rover : visible.at(-1) ?? -1
        pins.forEach((pin, position) => {
          if (!pin) return
          pin.setAttribute('aria-pressed', String(pinned !== null && Math.min(Number(turns[position]!.dataset.turn) + 1, total) === pinned))
          pin.tabIndex = position === active ? 0 : -1
        })
        frames.forEach((frame) => { frame.toggleAttribute('data-off', Number(frame.dataset.frame) !== shown) })
        if (hint) hint.textContent = pinned !== null ? 'Pinned. Press its pin button again, or Escape, to follow the replay.' : IDLE_HINT
        if (scroll) chat.scrollTo({ top: chat.scrollHeight, behavior: window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
      },
      ownsKey: (target) => target.hasAttribute('data-pin'),
    })
    if (!player) return
    // The results fold away as the replay plays them; a replay that starts finished keeps them open, as a page with no script has them.
    if (!player.reduced) root.querySelectorAll<HTMLDetailsElement>('details.mcp-result').forEach((details) => { details.open = false })

    pins.forEach((pin) => { if (pin) pin.hidden = false })
    turns.forEach((turn, position) => {
      const frame = Math.min(Number(turn.dataset.turn) + 1, total)
      const pin = pins[position]
      if (!pin) return
      if (canHover) {
        turn.addEventListener('mouseenter', () => player.hover(frame))
        turn.addEventListener('mouseleave', () => player.hover(null))
      }
      // A click or a drag in a turn selects its text; the pin button, the one way to hold a call, is a real button for a pointer, a keyboard and assistive technology.
      pin.addEventListener('click', () => { rover = position; player.togglePin(frame) })
      pin.addEventListener('focus', () => { rover = position })
      pin.addEventListener('keydown', (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return
        const visible = turns.map((candidate, index) => (candidate.hasAttribute('data-off') || !pins[index] ? -1 : index)).filter((index) => index >= 0)
        const next = visible[visible.indexOf(position) + (event.key === 'ArrowDown' ? 1 : -1)]
        if (next === undefined) return
        event.preventDefault()
        rover = next
        player.refresh()
        pins[next]!.focus()
      })
    })
  }

  const bindAll = () => {
    const linked = linkedStep('[data-mcp-replay]')
    document.querySelectorAll<HTMLElement>('[data-mcp-replay]:not([data-live])').forEach((root) => bindReplayChat(root, linked))
  }
  bindAll()
  document.addEventListener('astro:after-swap', bindAll)
</script>
