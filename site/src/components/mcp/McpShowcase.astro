---
/**
 * A port's MCP tools grouped by what they request, with a worked prompt.
 *
 * Rendered from the MCP overview rather than from Markdown, because a
 * content-collection entry cannot import a component. Grouping, purposes and
 * the example come from `lib/mcp-showcase.ts`, which reads the port's
 * `tools/list` snapshot.
 */
import { PORT_BY_SLUG } from '../../lib/ports'
import type { McpShowcase, ShowcaseTool } from '../../lib/mcp-showcase'
import { tierFor } from '../../lib/mcp-showcase'
import McpWorkedExample from './McpWorkedExample.astro'
import '../../styles/mcp-showcase.css'

interface Props {
  showcase: McpShowcase
}
const { showcase } = Astro.props as Props
const grouped = showcase.groups.some((group) => group.tier)
const tier = (tool: ShowcaseTool) => tierFor(tool)
const name = PORT_BY_SLUG[showcase.port].name
---
<section class="mcp-showcase" data-mcp-showcase>
  <h2 id={grouped ? 'tools-by-tier' : 'tools'}>{grouped ? 'Tools by tier' : 'Tools'}</h2>
  <p>
    {grouped
      ? <>The {name} server groups its tools by what they request. A tier badge tells you how far a call reaches before you approve it.</>
      : <>The {name} server declares no toolsets, so its tools are listed together. Read each tool's page before enabling it.</>}
    {showcase.selectsToolsets && <> Set <code>LIBTMUX_TOOLSETS</code> to a comma-separated list of tiers, such as <code>inspect,manage</code>, to offer only those tools.</>}
  </p>
  <div class="not-prose">
    {showcase.groups.map((group) => (
      <section class="mcp-group">
        {group.tier && (
          <>
            <h3 class="mcp-group__title" id={`tier-${group.tier.id}`}>
              <span class={`mcp-tier mcp-tier--${group.tier.id}`} title={group.tier.tooltip}>{group.tier.label}</span>
            </h3>
            <p class="mcp-group__summary">{group.tier.summary}</p>
          </>
        )}
        <ul class="mcp-tools" role="list">
          {group.tools.map((tool) => (
            <li class="mcp-tool">
              <span class="mcp-tool__head">
                <span class="mcp-tool__title"><a class="mcp-tool__name" href={tool.href}><code>{tool.name}</code></a></span>
                {tier(tool) && <span class={`mcp-tier mcp-tier--${tool.tier}`} title={tier(tool)!.tooltip}>{tier(tool)!.label}</span>}
              </span>
              {tool.purpose && <span class="mcp-tool__purpose" title={tool.purpose}>{tool.purpose}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p><a href={showcase.toolsHref}>Browse every tool</a>, with its arguments, result and protocol data.</p>
  {showcase.example && <McpWorkedExample example={showcase.example} portName={name} />}
</section>
<style>
  .mcp-group {
    margin-block: 1.75rem;
  }
  .mcp-group__title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }
  .mcp-group__summary {
    margin-block: 0.25rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .mcp-tools {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .mcp-tool {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-edge);
    border-radius: var(--card-radius, 0.5rem);
    background: var(--color-surface);
  }
  /* A flex row makes each child a block, and a block link takes no preview line. The name sits in a span of its own to stay inline. */
  .mcp-tool__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 0.5rem;
  }
  /* The span's own text size keeps its line as tall as the name's. */
  .mcp-tool__title {
    font-size: 0.875rem;
  }
  .mcp-tool__name {
    font-size: 0.875rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .mcp-tool__name code {
    font-size: inherit;
    font-weight: inherit;
  }
  .mcp-tool__purpose {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
