---
/**
 * A prompt and the tool calls an agent makes for it, each with its tier badge.
 *
 * Shared by the MCP overview and the port landing page. The calls come from
 * `EXAMPLES` in `lib/mcp-showcase.ts`, which a test checks against each tool's
 * input schema in the port's `tools/list` snapshot.
 */
import { Code } from 'astro-expressive-code/components'
import { tierFor, type WorkedExample } from '../../lib/mcp-showcase'
import '../../styles/mcp-showcase.css'

interface Props {
  example: WorkedExample
  portName: string
  /** The heading's level: 2 on the overview, where it is a section, 3 inside a landing panel. */
  level?: 2 | 3
}
const { example, portName, level = 2 } = Astro.props as Props
const Heading = `h${level}` as 'h2' | 'h3'
/** One line: the tool, then its arguments as JSON. */
const call = (name: string, args: Record<string, unknown>) => `${name} ${JSON.stringify(args)}`
const shown = (value: unknown) => (typeof value === 'string' ? value : JSON.stringify(value, null, 2))
const { recording } = example
---
<Heading id="worked-example">Worked example</Heading>
<p>Given this prompt, an agent connected to the {portName} server makes these calls{recording ? ' and gets these results' : ''}.</p>
<blockquote class="mcp-prompt"><p>{example.prompt}</p></blockquote>
<ol class="mcp-steps">
  {example.steps.map((step) => {
    const tier = tierFor(step.tool)
    return (
      <li>
        <p>
          {step.caption} <a href={step.tool.href}><code>{step.tool.name}</code></a>
          {tier && <> <span class={`mcp-tier mcp-tier--${step.tool.tier}`} title={tier.tooltip}>{tier.label}</span></>}
        </p>
        <Code code={call(step.tool.name, step.arguments)} lang="text" title="Call" frame="code" />
        {recording && step.result !== undefined && <Code code={shown(step.result)} lang={typeof step.result === 'string' ? 'text' : 'json'} title="Result" frame="code" />}
      </li>
    )
  })}
</ol>
{recording ? (
  <>
    {recording.output && (
      <>
        <p class="mcp-after">What the command printed, as the agent reads it back from the last result:</p>
        <Code code={recording.output} lang="text" title="Output in the pane" frame="code" />
      </>
    )}
    <p class="mcp-provenance">
      Recorded against <a href={`https://github.com/${recording.repo}/tree/${recording.revision}`}><code>{recording.repo}</code></a>
      at <code>{recording.revision.slice(0, 9)}</code>, on a private {recording.tmux} server, running {recording.runner}.
      Long values in a result are shortened here; the recording keeps them.
    </p>
  </>
) : (
  <p class="mcp-provenance">Requests only: no recorded results for {portName} yet.</p>
)}
