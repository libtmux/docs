const { icon, class: className = '' } = Astro.props as Props
const { label, path } = ICONS[icon]
---

<svg
  class:list={['registry-icon', className]}
  data-icon={icon}
  viewBox="0 0 24 24"
  fill="currentColor"
  role="img"
  aria-label={label}
  focusable="false"
><path d={path} /></svg>

<style is:global>
  /*
   * One custom property per mark, read by whatever wraps the icon in a link.
   * Declared here, beside the paths, so adding a mark is one edit rather than
   * two files.
   */
  .registry-icon[data-icon='github'] { --icon-brand: #181717; --icon-brand-dark: #f0f6fc; }
  .registry-icon[data-icon='pypi'] { --icon-brand: #3775a9; --icon-brand-dark: #4b8bbe; }
  .registry-icon[data-icon='npm'] { --icon-brand: #cb3837; --icon-brand-dark: #e8615f; }
  .registry-icon[data-icon='crates'] { --icon-brand: #000000; --icon-brand-dark: #ffffff; }
  .registry-icon[data-icon='go'] { --icon-brand: #00add8; --icon-brand-dark: #29beb0; }
  .registry-icon[data-icon='maven'] { --icon-brand: #1b1c30; --icon-brand-dark: #8ea9c9; }
  .registry-icon[data-icon='nuget'] { --icon-brand: #004880; --icon-brand-dark: #6ea6d9; }

  .registry-icon {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
</style>
