/**
 * Brand marks for the places a libtmux package is published.
 *
 * Drawn in `currentColor`, so an icon is the colour of the text around it in
 * both schemes and carries no theme of its own. The brand colour arrives only
 * on hover and focus, from `--icon-brand` — a mark that is always coloured
 * competes with the page, and one that is never coloured is harder to pick out
 * of a row. Two values per brand because three of these marks are near-black:
 * GitHub, crates.io and Maven Central would each disappear into a dark page if
 * their one published hex were used in both schemes.
 *
 * Path data from simple-icons (CC0-1.0). The marks themselves belong to their
 * projects and are used here to identify the destination, which is what the
 * links are for.
 */
interface Props {
  icon: IconName
  class?: string
}

export type IconName = 'github' | 'pypi' | 'npm' | 'crates' | 'go' | 'maven' | 'nuget'

