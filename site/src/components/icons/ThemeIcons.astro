---
interface Props {
  icon: 'sun' | 'moon' | 'computer' | 'check'
  class?: string
}

type CirclePath = { type: 'circle'; cx: string; cy: string; r: string }
type LinePath = { type: 'line'; x1: string; y1: string; x2: string; y2: string }
type PathPath = { type: 'path'; d: string }
type RectPath = { type: 'rect'; x: string; y: string; width: string; height: string; rx: string; ry: string }
type PolylinePath = { type: 'polyline'; points: string }

type SvgPath = CirclePath | LinePath | PathPath | RectPath | PolylinePath

const { icon, class: className = '' } = Astro.props

const icons: Record<string, { label: string; paths: SvgPath[] }> = {
  sun: {
    label: 'Light mode',
    paths: [
      { type: 'circle', cx: '12', cy: '12', r: '5' },
      { type: 'line', x1: '12', y1: '1', x2: '12', y2: '3' },
      { type: 'line', x1: '12', y1: '21', x2: '12', y2: '23' },
      { type: 'line', x1: '4.22', y1: '4.22', x2: '5.64', y2: '5.64' },
      { type: 'line', x1: '18.36', y1: '18.36', x2: '19.78', y2: '19.78' },
      { type: 'line', x1: '1', y1: '12', x2: '3', y2: '12' },
      { type: 'line', x1: '21', y1: '12', x2: '23', y2: '12' },
      { type: 'line', x1: '4.22', y1: '19.78', x2: '5.64', y2: '18.36' },
      { type: 'line', x1: '18.36', y1: '5.64', x2: '19.78', y2: '4.22' },
    ],
  },
  moon: {
    label: 'Dark mode',
    paths: [{ type: 'path', d: 'M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z' }],
  },
  computer: {
    label: 'System mode',
    paths: [
      { type: 'rect', x: '2', y: '3', width: '20', height: '14', rx: '2', ry: '2' },
      { type: 'line', x1: '8', y1: '21', x2: '16', y2: '21' },
      { type: 'line', x1: '12', y1: '17', x2: '12', y2: '21' },
    ],
  },
  check: {
    label: 'Selected option',
    paths: [{ type: 'polyline', points: '20 6 9 17 4 12' }],
  },
}

const currentIcon = icons[icon]

if (!currentIcon) {
  throw new Error(`Unknown icon: ${icon}`)
}
---

<svg
  aria-label={currentIcon.label}
  class={`text-current ${className}`}
  fill="none"
  role="img"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="2"
  style="shape-rendering: geometricPrecision"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
>
  {currentIcon.paths.map((path: SvgPath) => {
    switch (path.type) {
      case 'circle':
        return <circle cx={path.cx} cy={path.cy} r={path.r} />;
      case 'line':
        return <line x1={path.x1} y1={path.y1} x2={path.x2} y2={path.y2} />;
      case 'path':
        return <path d={path.d} />;
      case 'rect':
        return <rect x={path.x} y={path.y} width={path.width} height={path.height} rx={path.rx} ry={path.ry} />;
      case 'polyline':
        return <polyline points={path.points} />;
    }
  })}
</svg>