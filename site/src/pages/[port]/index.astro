---
import { PORTS, portHomeUrl, type Port } from '../../lib/ports'
import { IS_ROOT_BUILD } from '../../lib/site-root'
import { defaultVersionFor } from '../../lib/versions'
import { DEFAULT_LOCALE } from '../../i18n/locales'
import { buildLocale } from '../../i18n/resolve'

/**
 * `/<port>/`: a redirect to the port's default version.
 *
 * The edge function answers this URL with a 302 from its KeyValueStore
 * (infra/cloudfront-function.js rule 1), so readers reach this page only
 * when that lookup misses. It takes the shape of Astro's own static redirect
 * (`redirectTemplate`): meta refresh, `noindex`, canonical, visible link.
 */
export function getStaticPaths() {
  // Root build only: every port+version build renders this route too.
  if (!IS_ROOT_BUILD) return []
  // Port trees are English; every route into one lands on /en/<port>/.
  if (buildLocale() !== DEFAULT_LOCALE) return []

  return PORTS.map((port) => ({
    params: { port: port.slug },
    props: { port },
  }))
}

interface Props {
  port: Port
}

const { port } = Astro.props as Props
const destination = portHomeUrl(port, defaultVersionFor(port.slug))
const canonical = new URL(destination, Astro.site ?? 'https://libtmux.org').href
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <title>{port.name} documentation</title>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a href={destination}>Continue to the {port.name} documentation</a>
  </body>
</html>
