---
/**
 * Kind badges in context: one section per context, each rendered with the
 * recommended treatment and its alternatives, in a light and a dark pane.
 *
 * Every treatment sits on one palette (six hue families, tuned per mode) and
 * one em-scaled mark; the CSS is scoped to `.ic-*` here and does not touch the
 * site's badge styles. Section text is built as HTML strings, so a context is
 * one render function and a list of variants.
 */
import DemoLayout from '../../../components/demo/DemoLayout.astro'
import { FAMS, KINDS, RING_FAMS, familyCss, famWorst, kindOf, pillCss, type Scheme } from '../../../lib/badge-demo'

const esc = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')

interface BadgeOpts {
  aria?: string
  active?: boolean
  opaque?: boolean
  open?: boolean
  tap?: boolean
}

/**
 * One mark. `t` is the treatment, written on the badge itself so contexts can
 * mix treatments without CSS order deciding between them.
 */
function b(t: string, kind: string, o: BadgeOpts = {}): string {
  const k = kindOf(kind)
  const word = t === 'K'
  const at = [`data-t="${t}"`, `data-fam="${k.fam}"`, `data-s="${k.shape}"`]
  if (t === 'AE') at.push(`data-f="${k.geo}"`)
  if (!word && k.x) at.push('data-x')
  if (RING_FAMS.has(k.fam)) at.push('data-ring')
  if (o.opaque) at.push('data-opaque')
  if (o.active) at.push('data-active')
  if (o.tap) at.push('data-tap')
  const live = t === 'AF' || t === 'SR' || o.tap
  if (live) at.push(`data-word="${k.word}"`, 'tabindex="0"', 'role="img"', `aria-label="${o.aria ?? k.word}"`)
  else at.push('aria-hidden="true"')
  const cls = ['ic-b', word && 'ic-b--word', o.open && 'is-open'].filter(Boolean).join(' ')
  const marks = `data-m1="${esc(k.mark)}"`
  const inner = word
    ? `<span class="ic-b__l">${esc(k.word)}</span>`
    : t === 'SR'
      ? `<span class="ic-b__l ic-b__m" ${marks}></span><span class="ic-b__l ic-b__w">${esc(k.word)}</span>`
      : `<span class="ic-b__l" ${marks}></span>`
  return `<span class="${cls}" ${at.join(' ')}>${inner}</span>`
}

/** A mention: the mark, then the name as a link. Treatments without a mark change what precedes the name. */
function m(t: string, kind: string, text: string, o: BadgeOpts = {}): string {
  const k = kindOf(kind)
  const code = `<code>${esc(text)}</code>`
  if (t === 'NONE') return `<a class="ic-m" href="#">${code}</a>`
  if (t === 'TEXT') return `<a class="ic-m" href="#"><code>[${esc(k.mark)}] ${esc(text)}</code></a>`
  if (t === 'AB') {
    const ring = RING_FAMS.has(k.fam) ? ' data-ring' : ''
    return `<a class="ic-split" href="#" data-fam="${k.fam}"${ring}><span class="ic-split__k">${esc(k.mark)}</span><span class="ic-split__n">${code}</span></a>`
  }
  return `<a class="ic-m" href="#">${b(t, kind, o)}${code}</a>`
}

/** A later mention: the link alone. The kind is in the tooltip and the accessible name. */
function later(kind: string, text: string, open = false): string {
  const k = kindOf(kind)
  return `<a class="ic-m ic-m--later${open ? ' is-open' : ''}" href="#" data-kind="${k.word}" aria-label="${k.word}: ${esc(text)}"><code>${esc(text)}</code></a>`
}

/** The legend chip: one box, a mark segment and a word segment of equal height, split by a divider. */
function leg(kind: string): string {
  const k = kindOf(kind)
  return `<span class="ic-leg" data-fam="${k.fam}"><span class="ic-leg__m" aria-hidden="true"><span class="ic-leg__g" data-m1="${esc(k.mark)}"></span></span><span class="ic-leg__w">${esc(k.word)}</span></span>`
}
const quiet = (kind: string) => `<span class="ic-quiet">${esc(kindOf(kind).word)}</span>`

