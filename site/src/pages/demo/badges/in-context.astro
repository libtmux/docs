  {
    n: 15, title: 'Changelog and release notes', rule: 'Group by kind; the chip is the group header, so items carry no mark',
    variants: [
      { t: 'Q', label: 'Q', rec: true, caption: 'group by kind · legend chip as the header · no per-item marks' },
      { t: 'T', label: 'T', caption: 'grouped by change · outline mark on every item' },
    ],
    render: (v) => logDemo(v.t),
  },
  {
    n: 16, title: 'Breadcrumbs', rule: 'Navigation already names the place',
    variants: [
      { t: 'NONE', label: 'none', rec: true, caption: 'no mark' },
      { t: 'U', label: 'U', caption: 'ink mark on the last crumb' },
    ],
    render: (v) => crumbDemo(v.t),
  },
  {
    n: 17, title: 'Tabs', rule: 'Rule 2 · the word; the family hue marks the selected tab',
    variants: [{ t: 'word', label: 'word', rec: true, caption: 'word only · 2px indicator in the family hue · click a tab' }],
    render: () => tabsDemo(),
  },
  {
    n: 18, title: 'Active state: selected node, target heading, hovered link', rule: 'Rule 3 · solid is a state; a ring where white is under 4.5:1',
    variants: [{ t: 'R', label: 'R', rec: true, caption: `solid on selected, :target, hover, focus · 600-step fill, white glyph · 2px ring on ${RING_LIST}` }],
    render: (_v, s) => activeDemo(s),
  },
  {
    n: 19, title: 'Status: deprecated, experimental, since', rule: 'Rule 3 · a pill is status, never kind',
    variants: [{ t: 'Y', label: 'Y', rec: true, caption: 'soft pill · 12px/600 · radius 999px · neutral or warning hue · the kind stays a mark' }],
    render: () => statusDemo(),
  },
  {
    n: 20, title: 'Large and alone: social card, hero, empty state', rule: 'Rule 3 · solid is a hero when it stands alone',
    variants: [{ t: 'SOLID', label: 'solid', rec: true, caption: 'solid 56px · 600-step fill · white glyph · radius .2em' }],
    render: () => heroDemo(),
  },
  {
    n: 21, title: 'Print and PDF', rule: 'Ink, tints stripped · the Print toggle applies the same rules',
    variants: [{ t: 'U', label: 'U', rec: true, caption: '@media print · transparent fill, 1px black border, black glyph' }],
    render: () => printDemo(),
  },
  {
    n: 22, title: 'forced-colors and prefers-contrast: more', rule: 'Outline in system colours · the Forced colors toggle applies the same rules',
    variants: [{ t: 'T', label: 'T', rec: true, caption: '@media (forced-colors: active) · Canvas fill, CanvasText border, Highlight when active' }],
    render: () => forcedDemo(),
  },
  {
    n: 23, title: 'Plain text, RSS, README, search snippets', rule: 'No colour, no boxes: the mark is text',
    variants: [
      { t: 'TEXT', label: '[m]', rec: true, caption: 'bracketed single mark' },
    ],
    render: () => plainDemo(),
  },
  {
    n: 24, title: 'Touch', rule: 'Nothing is hover-only · headings teach, a tap shows the word',
    variants: [{ t: 'M', label: 'M', rec: true, caption: 'same marks · legend chip in the heading · tap a mark for its word' }],
    render: () => touchDemo(),
  },
  {
    n: 25, title: 'Legend: every kind', rule: 'Rule 2 · the vocabulary, spelled out',
    variants: [
      { t: 'Q', label: 'Q', rec: true, caption: 'legend-chip grid · mark and word for every kind' },
      { t: 'K', label: 'K', caption: 'word-chip grid' },
    ],
    render: (v) => legendDemo(v.t),
  },
]

const pane = (c: Context, v: Variant, scheme: Scheme) => `<div class="ic-pane" data-pane="${scheme}" data-ctx="${c.n}">${c.render(v, scheme)}</div>`

const section = (c: Context) => `<section id="c${c.n}" class="ic-sec">
<header class="ic-sh"><span class="ic-n">${c.n}</span><h2>${c.title}</h2><p class="ic-rule">${c.rule}</p></header>
${c.variants
  .map(
    (v) =>
      `<div class="ic-var"><div class="ic-vh"><span class="ic-vl">${v.label}</span>${v.rec ? '<span class="ic-vr">Recommended</span>' : ''}<span class="ic-vc">${v.caption}</span></div><div class="ic-panes">${pane(c, v, 'light')}${pane(c, v, 'dark')}</div></div>`,
  )
  .join('\n')}
</section>`

// ---- the system, at the top ----

const famChips = () =>
  Object.entries(FAMS)
    .map(([f, v]) => `<span class="ic-fam" data-fam="${f}">${f} · ${v.hue}</span>`)
    .join('')
const sysPane = (scheme: Scheme) =>
  `<div class="ic-pane" data-pane="${scheme}"><div class="ic-marks">${KINDS.map((k) => b('M', k.kind)).join('')}</div><div class="ic-fams">${famChips()}</div></div>`
const RULES: [string, string][] = [
  ['Base mark', 'M tuned tint, built em-scaled (N), sans 600, on the global families palette (P)'],
  ['Palette', 'six hue families, global: types, traits, callables, members, meta, tools; tuned per mode'],
  ['Size', '1.35em square · glyph .8em · radius .2em · it follows the text it sits in'],
  ['Rule 1', 'fill follows crowding: alone, tint · a short run or a column, outline or split chip · a long run, chrome, no colour budget, ink'],
  ['Rule 2', 'the word appears wherever the reader cannot hover: headings, menus, tooltips, tables'],
  ['Rule 3', 'solid is a state or a hero, never a default · a pill is status, never kind'],
  ['Contrast', `worst glyph on fill: light ${famWorst('light')}, dark ${famWorst('dark')} · white on solid under 4.5:1 takes a ring: ${RING_LIST}`],
]
const system = `<section id="system" class="ic-sec ic-sys"><header class="ic-sh"><h2>The system</h2></header><dl class="ic-rules">${RULES.map(([k, d]) => `<div><dt>${k}</dt><dd>${d}</dd></div>`).join('')}</dl><div class="ic-panes">${sysPane('light')}${sysPane('dark')}</div></section>`

const board = system + '\n' + CONTEXTS.map(section).join('\n')

const bar = `<div class="ic-bar"><span class="ic-bar__grp"><a class="ic-bar__lab" href="../">Board</a><a class="ic-bar__lab" href="#system">System</a>${CONTEXTS.map(
  (c) => `<a href="#c${c.n}" class="ic-jump" title="${esc(c.title)}">${c.n}</a>`,
).join('')}</span><span class="ic-bar__tools"><button type="button" class="ic-tool" data-ic-toggle="print" aria-pressed="false">Print</button><button type="button" class="ic-tool" data-ic-toggle="forced" aria-pressed="false">Forced colors</button><button type="button" class="ic-tool" data-ic-toggle="shape" aria-pressed="false">Shape</button></span></div>`

// Print and forced-colours rules, written once and applied twice: under the media query and under the toggle.
const printRules = (root: string) => `
${root} .ic-b,${root} .ic-leg,${root} .ic-split,${root} .ic-split__k,${root} .ic-split__n,${root} .ic-pill,${root} .ic-fam,${root} .ic-b__l{background:transparent!important;color:#000!important;border:1px solid #000!important;box-shadow:none!important;outline:0!important;translate:none}
${root} .ic-b__l,${root} .ic-split__k,${root} .ic-split__n{border:0!important}
${root} .ic-leg__m,${root} .ic-leg__w,${root} .ic-leg__g{background:transparent!important;color:#000!important;border:0!important}
${root} .ic-leg__m{border-right:1px solid #000!important}
${root} .ic-pane{background:#fff!important;color:#000!important;border-color:#999!important}
${root} .ic-pane a,${root} .ic-pane code,${root} a,${root} code{color:#000!important}
${root} code{background:transparent!important;border-color:#999!important}
`
const forcedRules = (root: string) => `
${root} .ic-b,${root} .ic-leg,${root} .ic-split,${root} .ic-pill,${root} .ic-fam{background:Canvas!important;color:CanvasText!important;border:1px solid CanvasText!important;box-shadow:none!important;forced-color-adjust:none}
${root} .ic-b__l,${root} .ic-split__k,${root} .ic-split__n,${root} .ic-leg__g,${root} .ic-leg__w{background:transparent!important;color:CanvasText!important;border-color:CanvasText!important}
${root} .ic-leg__m{background:transparent!important;color:CanvasText!important;border-color:CanvasText!important}
${root} :is(.ic-m:hover,.ic-m:focus-visible,.ic-sel,:target) .ic-b{background:Highlight!important;color:HighlightText!important;border-color:Highlight!important}
${root} :is(.ic-m:hover,.ic-m:focus-visible,.ic-sel,:target) .ic-b .ic-b__l{color:HighlightText!important}
${root} .ic-pane{background:Canvas!important;color:CanvasText!important;border-color:CanvasText!important}
${root} .ic-pane a,${root} a{color:LinkText!important}
${root} code{background:Canvas!important;color:CanvasText!important;border-color:CanvasText!important}
`
const modeCss = `@media print{.ic-bar{display:none!important}${printRules('.ic-root')}}@media (forced-colors:active){${forcedRules('.ic-root')}}${printRules('.ic-root[data-print]')}${printRules('.ic-paper')}${forcedRules('.ic-root[data-forced]')}${forcedRules('.ic-forcedbox')}`
---

<DemoLayout title="Badges in context" description="Kind badges in each context they appear in." current="/demo/badges/in-context/">
  <h1 class="text-3xl font-semibold tracking-tight">Badges in context</h1>
  <p class="mt-2 text-muted">One system, 25 contexts. Recommended first, alternatives after, light and dark.</p>
  <Fragment set:html={bar} />
  <div class="ic-root" data-ic-root>
    <Fragment set:html={board} />
  </div>

  <style is:inline set:html={familyCss + pillCss}></style>
  <style is:inline set:html={modeCss}></style>
</DemoLayout>

<script is:inline>
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null
    if (!target) return
    const tab = target.closest('.ic-tab')
    if (tab) {
      const list = tab.closest('[data-ic-tabs]')
      for (const t of list.querySelectorAll('.ic-tab')) t.setAttribute('aria-selected', String(t === tab))
      list.querySelector('.ic-tabs__p').textContent = tab.dataset.text
      return
    }
    const tap = target.closest('.ic-b[data-tap]')
    if (tap) tap.classList.toggle('is-open')
    if (target.closest('.ic-pane a:not(.ic-perma)')) event.preventDefault()
  })
  const root = document.querySelector('[data-ic-root]')
  const apply = (name, on) => {
    if (!root) return
    if (on) root.setAttribute('data-' + name, '')
    else root.removeAttribute('data-' + name)
    document.querySelector('[data-ic-toggle="' + name + '"]')?.setAttribute('aria-pressed', String(on))
  }
  for (const button of document.querySelectorAll('[data-ic-toggle]')) {
    button.addEventListener('click', () => apply(button.dataset.icToggle, button.getAttribute('aria-pressed') !== 'true'))
  }
  const query = new URLSearchParams(location.search)
  for (const name of ['print', 'forced', 'shape']) if (query.get(name) === '1') apply(name, true)
  if (query.get('fonts') === 'fallback' && root) root.dataset.fonts = 'fallback'
</script>

<style is:global>
  /* Page chrome */
  .ic-bar {
    position: sticky; top: 3.3rem; z-index: 30; display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .9rem;
    margin: 1rem 0 0; padding: .5rem 0; border-bottom: 1px solid var(--color-edge); background: var(--background-color, canvas);
  }
  .ic-bar__grp { display: inline-flex; flex-wrap: wrap; align-items: center; gap: .2rem; }
  .ic-bar__lab { margin-right: .35rem; color: var(--color-muted); font: 600 .625rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; text-decoration: none; }
  .ic-bar__lab:hover { color: inherit; }
  .ic-bar__tools { display: inline-flex; flex-wrap: wrap; gap: .3rem; margin-left: auto; }
  .ic-tool {
    padding: .25rem .5rem; border: 1px solid var(--color-edge); border-radius: .375rem; background: var(--color-surface);
    font: 500 .6875rem/1 var(--font-sans); cursor: pointer;
  }
  .ic-tool[aria-pressed='true'] { background: var(--color-surface-hover); font-weight: 700; }
  .ic-jump {
    display: inline-grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 .3rem;
    border: 1px solid var(--color-edge); border-radius: .3rem; background: var(--color-surface);
    font: 600 .6875rem/1 var(--font-mono); text-decoration: none; color: inherit;
  }
  .ic-jump:hover { background: var(--color-surface-hover); }
  .ic-root[data-fonts='fallback'] { --font-sans: 'DejaVu Sans', Verdana, sans-serif; --font-mono: 'DejaVu Sans Mono', Menlo, Consolas, monospace; }
  .ic-sec { margin-top: 3rem; scroll-margin-top: 7rem; }
  .ic-sh { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem; margin-bottom: .6rem; padding-bottom: .5rem; border-bottom: 1px solid var(--color-edge); }
  .ic-n {
    align-self: center; display: inline-grid; place-items: center; min-width: 2rem; height: 2rem; padding: 0 .4rem;
    border-radius: .5rem; background: var(--color-surface-hover); font: 700 .9375rem/1 var(--font-sans);
  }
  .ic-sh h2 { margin: 0; font: 600 1.125rem/1.3 var(--font-sans); }
  .ic-rule { flex: 1 1 100%; margin: 0; color: var(--color-muted); font: .75rem/1.4 var(--font-mono); }
  .ic-var { margin-top: 1rem; }
  .ic-vh { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .6rem; margin-bottom: .45rem; }
  .ic-vl {
    display: inline-grid; place-items: center; min-width: 1.75rem; height: 1.5rem; padding: 0 .45rem; border-radius: .375rem;
    background: var(--color-surface-hover); font: 700 .75rem/1 var(--font-sans);
  }
  .ic-vr { padding: .15rem .45rem; border-radius: 999px; background: color-mix(in srgb, var(--color-link, #2757dd) 14%, transparent); color: var(--color-link, #2757dd); font: 600 .625rem/1.2 var(--font-sans); text-transform: uppercase; letter-spacing: .06em; }
  .ic-vc { flex: 1 1 18rem; color: var(--color-muted); font: .75rem/1.4 var(--font-mono); }
  .ic-panes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 1rem; }
  .ic-rules { margin: 0 0 1rem; display: grid; gap: .3rem; }
  .ic-rules > div { display: grid; grid-template-columns: 6rem 1fr; gap: .75rem; align-items: baseline; }
  .ic-rules dt { color: var(--color-muted); font: 600 .6875rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .ic-rules dd { margin: 0; font: .8125rem/1.5 var(--font-sans); }
  .ic-marks { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; font-size: .9375rem; }
  .ic-fams { display: flex; flex-wrap: wrap; gap: .35rem; }
  .ic-fam { padding: .15rem .55rem; border: 1px solid color-mix(in srgb, var(--fh) var(--ba), transparent); border-radius: .25rem; background: var(--fb); color: var(--ff); font: 600 .6875rem/1.3 var(--font-sans); }

  /* Panes carry their own scheme */
  .ic-pane {
    position: relative; display: flex; flex-direction: column; gap: .9rem; min-width: 0; padding: 1rem 1.15rem;
    border: 1px solid var(--bd-edge); border-radius: .5rem; background: var(--bd-bg); color: var(--bd-fg);
    --color-edge: var(--bd-edge); --color-muted: var(--bd-muted); --color-surface-hover: var(--bd-hover);
  }
  .ic-pane::before {
    content: attr(data-pane); position: absolute; top: .4rem; right: .6rem;
    color: var(--bd-muted); font: .625rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .06em;
  }
  .ic-pane[data-pane='light'] {
    --bd-bg: #fff; --bd-fg: #1a1c1e; --bd-muted: #6b6f76; --bd-edge: #eeebee; --bd-surface: #f8f9fb; --bd-hover: #efeff4; --bd-link: #2757dd;
    --ba: 30%; --bd-nbg: rgb(0 0 0 / .05); --tip-bg: #1a1c1e; --tip-fg: #fff;
    --tk-k: #7c3aed; --tk-f: #b45309; --tk-t: #1d4ed8; --tk-s: #15803d; --tk-c: #6b6f76;
    color-scheme: light;
  }
  .ic-pane[data-pane='dark'] {
    --bd-bg: #131416; --bd-fg: #cfd0d0; --bd-muted: #81868d; --bd-edge: #303335; --bd-surface: #1a1c1e; --bd-hover: #1e2124; --bd-link: #5ca5ff;
    --ba: 18%; --bd-nbg: rgb(255 255 255 / .08); --tip-bg: #e4e6e8; --tip-fg: #131416;
    --tk-k: #c4b5fd; --tk-f: #fcd34d; --tk-t: #93c5fd; --tk-s: #86efac; --tk-c: #81868d;
    color-scheme: dark;
  }
  .ic-pane p, .ic-pane h3, .ic-pane h4, .ic-pane h5, .ic-pane pre, .ic-pane ul { margin: 0; }
  .ic-prose { font: 400 1rem/1.8 var(--font-sans); }
  .ic-pane a { color: var(--bd-link); text-decoration: none; }
  .ic-pane code {
    padding: .05em .3em; border: 1px solid var(--bd-edge); border-radius: .25rem; background: var(--bd-surface);
    font: 400 .875em/1.4 var(--font-mono); color: inherit;
  }
  .ic-pane kbd {
    padding: .1em .45em; border: 1px solid var(--bd-edge); border-bottom-width: 2px; border-radius: .3em; background: var(--bd-surface);
    font: 500 .8125em/1.2 var(--font-mono); color: var(--bd-fg);
  }
  .ic-lead { color: var(--bd-muted); font: 600 .6875rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; margin-right: .35rem; }

  /* A mention is the mark, then the name, centred as the site does it */
  .ic-m { display: inline-flex; align-items: baseline; gap: .25em; max-inline-size: 100%; vertical-align: baseline; position: relative; }
  .ic-m > .ic-b { align-self: center; }
  .ic-m code { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .ic-m--later::after {
    content: attr(data-kind); position: absolute; left: 0; bottom: calc(100% + 4px); z-index: 6; display: none; padding: 2px 7px; border-radius: .3em;
    background: var(--tip-bg); color: var(--tip-fg); font: 500 .6875rem/1.3 var(--font-sans); white-space: nowrap; text-decoration: none;
  }
  .ic-m--later:is(:hover, :focus-visible, .is-open)::after { display: block; }

  /* The mark: em-scaled, tuned tint on the family palette. Treatments change a few variables. */
  .ic-b {
    --w: 1.35em; --r: .2em; --bw: 1px;
    display: inline-grid; place-items: center; flex: none; box-sizing: border-box;
    min-width: var(--w); height: var(--h, var(--w)); padding: var(--py, 0) var(--px, 0);
    border: var(--bw) solid var(--bdv, color-mix(in srgb, var(--fh) var(--ba), transparent)); border-radius: var(--r);
    background: var(--bgv, var(--fb)); color: var(--fgv, var(--ff));
    font: 600 1em/1 var(--font-sans); white-space: nowrap; user-select: none; box-shadow: var(--sh, none);
  }
  .ic-b__l { display: block; font-size: .8em; line-height: 1; }
  .ic-b__l::before { content: attr(data-m1); }
  .ic-b[data-x] > .ic-b__l { translate: 0 -.09em; }

  /* V soft tint, W soft tint + border, T outline, U ink, X medium solid */
  .ic-b[data-t='V'] { --w: 1.5em; --r: .3em; --bw: 0; --bgv: color-mix(in srgb, var(--fh) 14%, var(--bd-bg)); --fgv: var(--f8); }
  .ic-b[data-t='W'] { --bgv: color-mix(in srgb, var(--fh) 8%, var(--bd-bg)); --bdv: color-mix(in srgb, var(--fh) 45%, transparent); }
  .ic-b[data-t='T'] { --bgv: transparent; --bdv: color-mix(in srgb, var(--fh) 60%, transparent); }
  .ic-b[data-t='T'][data-opaque] { --bgv: var(--bd-bg); }
  .ic-b[data-t='U'] { --bgv: color-mix(in srgb, var(--bd-fg) 7%, transparent); --bdv: color-mix(in srgb, var(--bd-fg) 14%, transparent); --fgv: var(--bd-fg); }
  .ic-b[data-t='X'] { --bw: 0; --bgv: var(--fm); --fgv: var(--f9); }
  /* AD left-accent tag (table alternative only), AE silhouettes */
  .ic-b[data-t='AE'] { --w: 1.45em; }
  .ic-b[data-t='AD'] { --w: 1.5em; --r: .15em; --bgv: var(--bd-nbg); --fgv: var(--bd-fg); border-width: 0 0 0 .2em; border-color: var(--fh); }
  .ic-b[data-t='AE'][data-f='calls'] { --r: 999px; }
  .ic-b[data-t='AE'][data-f='data'] {
    --bgv: color-mix(in srgb, var(--bd-fg) 6%, transparent); --bdv: color-mix(in srgb, var(--bd-fg) 16%, transparent); --fgv: var(--bd-fg);
    --w: auto; display: inline-flex; align-items: center; justify-content: center; gap: .3em; padding: 0 .45em;
  }
  .ic-b[data-t='AE'][data-f='data']::before { content: ''; flex: none; width: .3em; height: .3em; border-radius: 50%; background: var(--fh); }
  /* K gp-sphinx word chip */
  .ic-b--word { --w: auto; --h: auto; --px: 8px; --py: 2.6px; --r: 3.5px; font: 700 11px/1 var(--font-sans); letter-spacing: .01em; }
  .ic-b--word .ic-b__l { font-size: 1em; }
  .ic-b--word .ic-b__l::before { content: none; }

  /* The Monograms and Shape toggles */
  .ic-root[data-shape] .ic-b[data-s='ci']:not(.ic-b--word, [data-t='AD'], [data-t='AE']) { --r: 999px; --w: 1.45em; }
  .ic-root[data-shape] .ic-b[data-s='di']:not(.ic-b--word, [data-t='AD'], [data-t='AE']) { --w: 1.05em; --r: .12em; rotate: 45deg; margin-inline: .22em; }
  .ic-root[data-shape] .ic-b[data-s='di']:not(.ic-b--word, [data-t='AD'], [data-t='AE']) > .ic-b__l { rotate: -45deg; }

  /* Active state: solid in the family hue, or a ring where white is under 4.5:1 */
  :is(.ic-m:hover, .ic-m:focus-visible, .ic-sel, :target, .ic-act:hover) .ic-b:not([data-ring], .ic-b--word, [data-t='SOLID']),
  .ic-b[data-active]:not([data-ring]) {
    --bgv: var(--fs); --fgv: #fff; --bdv: var(--fs);
  }
  :is(.ic-m:hover, .ic-m:focus-visible, .ic-sel, :target, .ic-act:hover) .ic-b[data-ring]:not(.ic-b--word),
  .ic-b[data-active][data-ring] { --sh: 0 0 0 2px var(--fh); }

