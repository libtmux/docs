  { id: 'x', set: 2, spec: 'Set 2 · 3 Medium solid, dark text', name: 'Mid solid', label: 'mark', legend: 'contrast', caption: 'sans 12px/600 · 20px square · hue-400 fill, hue-950 glyph · no border or shade · radius 4px' },
