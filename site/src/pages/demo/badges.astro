  { id: 'k', set: 0, name: 'gp-sphinx chip', label: 'word', caption: 'sans 11px/700 · word · padding 2.6×8px · tint, 1px border · radius 3.5px · dotted label' },
  { id: 'l', set: 0, name: 'Hybrid', label: 'mark', head: 'word', caption: 'solid marks (G) in prose and tree · word chips (J) in headings' },

  // Set 1
  { id: 'm', set: 1, spec: 'Set 1 · 1 Tuned tint mark', name: 'Tuned tint mark', label: 'mark', legend: 'contrast', caption: 'sans 12px/600 · 20px square · border hue 30% / 18% dark · radius 4px · bg hue-100 / 900 · glyph 700 / 300' },
  { id: 'n', set: 1, spec: 'Set 1 · 2 Em-scaled mark', name: 'Em-scaled mark', label: 'mark', caption: '1.35em square · glyph .8em/600 · radius .2em · vertical-align middle · tuned colours' },
  { id: 'o', set: 1, spec: 'Set 1 · 3 Shape-encoded case', name: 'Shape-encoded case', label: 'mark', shape: true, caption: 'tuned mark · square types 20px · circle members 21px · diamond for $ and ! · glyph 12px/600' },
  { id: 'p', set: 1, spec: 'Set 1 · 4 Hue families', name: 'Hue families', label: 'mark', fam: true, legend: 'fams', caption: 'tuned mark · six family hues, glyph names the kind · families differ in lightness' },
  { id: 'q', set: 1, spec: 'Set 1 · 5 Legend chip for headings', name: 'Legend chip', label: 'mark', head: 'legend', quiet: true, caption: 'tuned mark in prose · heading chip = mark + word 11px/600 · same tint, border, radius · quiet sibling below' },
  { id: 'r', set: 1, spec: 'Set 1 · 6 Solid as a state', name: 'Solid as a state', label: 'mark', ring: true, target: true, hoverMarks: true, caption: 'tuned marks · solid on selected row, :target heading, hovered link or mark · 2px ring where white is under 5:1' },
  { id: 's', set: 1, spec: 'Set 1 · 7 Density rule + reveal', name: 'Density rule + reveal', label: 'mark', reveal: true, density: true, caption: 'first mention marked · hover or focus widens the mark into the word · aria-label always' },
