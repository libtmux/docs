  { id: 'e', set: 0, name: '13px sans bold', label: 'mark', caption: 'sans 13px/700 · 22px square · 1px border · radius 5px · tint' },
  { id: 'f', set: 0, name: 'Wide pill', label: 'mark', caption: 'sans 12px/700 · 28×20px pill · 1px border · radius 10px · tint' },
  { id: 'g', set: 0, name: 'Solid', label: 'mark', caption: 'sans 13px/700 · 22px square · solid fill, white mark · radius 5px · inner shade' },
  { id: 'h', set: 0, name: 'Soft tint', label: 'mark', caption: 'sans 13px/600 · 22px square · no border, 20% tint · radius 6px' },
  { id: 'i', set: 0, name: 'libtmux-mcp box', label: 'mark', caption: 'sans 10px/700 · 16px square · solid fill, white mark · radius 3px · inner shade' },
