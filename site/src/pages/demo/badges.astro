---
/**
 * Kind badge candidates, each in a light and a dark pane.
 *
 * The panes carry their own colours, so both schemes show at once whatever
 * the page theme is. Candidate A uses the real badge classes with the real
 * variables re-pointed per pane; the rest are scoped to `.bd-*` here and do
 * not touch the site's badge styles.
 *
 * The board is built as HTML strings below and rendered through one
 * fragment, so a candidate is a config entry plus a few CSS variables.
 */
import DemoLayout from '../../components/demo/DemoLayout.astro'
import { kindMark, markHeight } from '../../lib/api-labels'
import '../../styles/api-tree.css'

// Light bg, fg, border, then dark bg, fg, border: a snapshot of api-kinds.css,
// held here so one page can show both schemes.
const GROUPS: Record<string, string[]> = {
  class: ['#eef2ff', '#4338ca', '#6366f1', '#1e1b4b', '#a5b4fc', '#6366f1'],
  exception: ['#fff1f2', '#be123c', '#f43f5e', '#4c0519', '#fda4af', '#fb7185'],
  function: ['#e8f0fe', '#1a56db', '#3b82f6', '#172554', '#93c5fd', '#3b82f6'],
  method: ['#ecfeff', '#0e7490', '#06b6d4', '#083344', '#67e8f9', '#22d3ee'],
  property: ['#f0fdfa', '#0f766e', '#14b8a6', '#042f2e', '#5eead4', '#2dd4bf'],
  attribute: ['#f1f5f9', '#475569', '#94a3b8', '#1e293b', '#cbd5e1', '#64748b'],
  constant: ['#f5f5f5', '#525252', '#a3a3a3', '#262626', '#d4d4d4', '#737373'],
  module: ['#f0fdf4', '#166534', '#22c55e', '#052e16', '#86efac', '#4ade80'],
  typealias: ['#f5f3ff', '#6d28d9', '#8b5cf6', '#2e1065', '#c4b5fd', '#a78bfa'],
  command: ['#fff7ed', '#c2410c', '#f97316', '#431407', '#fdba74', '#fb923c'],
  option: ['#f7fee7', '#4d7c0f', '#84cc16', '#1a2e05', '#bef264', '#a3e635'],
  hook: ['#fdf4ff', '#a21caf', '#d946ef', '#4a044e', '#f0abfc', '#e879f9'],
  format: ['#fffbeb', '#a16207', '#eab308', '#422006', '#fde047', '#facc15'],
}

// Tailwind steps 100 to 950 per hue, for the tuned palettes. Each kind group
// keeps the hue it has today.
const SCALE: Record<string, string[]> = {
  indigo: ['#e0e7ff', '#c7d2fe', '#a5b4fc', '#818cf8', '#6366f1', '#4f46e5', '#4338ca', '#3730a3', '#312e81', '#1e1b4b'],
  rose: ['#ffe4e6', '#fecdd3', '#fda4af', '#fb7185', '#f43f5e', '#e11d48', '#be123c', '#9f1239', '#881337', '#4c0519'],
  blue: ['#dbeafe', '#bfdbfe', '#93c5fd', '#60a5fa', '#3b82f6', '#2563eb', '#1d4ed8', '#1e40af', '#1e3a8a', '#172554'],
  cyan: ['#cffafe', '#a5f3fc', '#67e8f9', '#22d3ee', '#06b6d4', '#0891b2', '#0e7490', '#155e75', '#164e63', '#083344'],
  teal: ['#ccfbf1', '#99f6e4', '#5eead4', '#2dd4bf', '#14b8a6', '#0d9488', '#0f766e', '#115e59', '#134e4a', '#042f2e'],
  slate: ['#f1f5f9', '#e2e8f0', '#cbd5e1', '#94a3b8', '#64748b', '#475569', '#334155', '#1e293b', '#0f172a', '#020617'],
  neutral: ['#f5f5f5', '#e5e5e5', '#d4d4d4', '#a3a3a3', '#737373', '#525252', '#404040', '#262626', '#171717', '#0a0a0a'],
  green: ['#dcfce7', '#bbf7d0', '#86efac', '#4ade80', '#22c55e', '#16a34a', '#15803d', '#166534', '#14532d', '#052e16'],
  violet: ['#ede9fe', '#ddd6fe', '#c4b5fd', '#a78bfa', '#8b5cf6', '#7c3aed', '#6d28d9', '#5b21b6', '#4c1d95', '#2e1065'],
  orange: ['#ffedd5', '#fed7aa', '#fdba74', '#fb923c', '#f97316', '#ea580c', '#c2410c', '#9a3412', '#7c2d12', '#431407'],
  lime: ['#ecfccb', '#d9f99d', '#bef264', '#a3e635', '#84cc16', '#65a30d', '#4d7c0f', '#3f6212', '#365314', '#1a2e05'],
  fuchsia: ['#fae8ff', '#f5d0fe', '#f0abfc', '#e879f9', '#d946ef', '#c026d3', '#a21caf', '#86198f', '#701a75', '#4a044e'],
  yellow: ['#fef9c3', '#fef08a', '#fde047', '#facc15', '#eab308', '#ca8a04', '#a16207', '#854d0e', '#713f12', '#422006'],
  amber: ['#fef3c7', '#fde68a', '#fcd34d', '#fbbf24', '#f59e0b', '#d97706', '#b45309', '#92400e', '#78350f', '#451a03'],
}
const hx = (hue: string, step: number): string => SCALE[hue]![step === 950 ? 9 : step / 100 - 1]!
const HUE: Record<string, string> = {
  class: 'indigo', exception: 'rose', function: 'blue', method: 'cyan', property: 'teal', attribute: 'slate',
  constant: 'neutral', module: 'green', typealias: 'violet', command: 'orange', option: 'lime', hook: 'fuchsia', format: 'yellow',
}

type Scheme = 'light' | 'dark'
const SCHEMES: Scheme[] = ['light', 'dark']
const PAGE: Record<Scheme, string> = { light: '#ffffff', dark: '#131416' }
const NEUTRAL: Record<Scheme, string> = { light: '#eceef1', dark: '#2b2e33' }
const INK: Record<Scheme, string> = { light: '#14161a', dark: '#f4f5f6' }

const rgb = (hex: string): number[] => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16))
const lin = (c: number) => ((c / 255) <= 0.04045 ? c / 255 / 12.92 : (((c / 255) + 0.055) / 1.055) ** 2.4)
const lum = (hex: string) => {
  const [r, g, b] = rgb(hex)
  return 0.2126 * lin(r!) + 0.7152 * lin(g!) + 0.0722 * lin(b!)
}
const ratio = (a: string, b: string) => {
  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x)
  return (hi! + 0.05) / (lo! + 0.05)
}
/** `color-mix(in srgb, over pct%, under)`, resolved. */
const mixHex = (over: string, pct: number, under: string) =>
  '#' + rgb(over).map((c, i) => Math.round((c * pct) / 100 + rgb(under)[i]! * (1 - pct / 100)).toString(16).padStart(2, '0')).join('')

// The tuned palette: glyph 700 on 100 in light, 300 on 900 in dark. A hue that
// misses 4.5:1 takes the next step in, so no pair ships below the floor.
const tunedFg = (group: string, scheme: Scheme): string => {
  const hue = HUE[group]!
  const [base, alt] = scheme === 'light' ? [700, 800] : [300, 200]
  const bg = hx(hue, scheme === 'light' ? 100 : 900)
  return ratio(hx(hue, base), bg) >= 4.5 ? hx(hue, base) : hx(hue, alt)
}
const tunedBase = (group: string, scheme: Scheme) => hx(HUE[group]!, scheme === 'light' ? 700 : 300)
const firmFg = (group: string, scheme: Scheme) => hx(HUE[group]!, scheme === 'light' ? 800 : 200)
// White on the 700 fill: a hue under 5:1 takes a ring for the active state instead.
const RING = new Set(Object.keys(GROUPS).filter((g) => ratio('#ffffff', hx(HUE[g]!, 700)) < 5))

// Hue families: colour says the category, the glyph says the kind. Families
// differ in lightness as well as hue: types and tools sit a step heavier.
const FAMS: Record<string, { hue: string; light: [number, number]; dark: [number, number] }> = {
  types: { hue: 'blue', light: [200, 900], dark: [800, 100] },
  traits: { hue: 'violet', light: [100, 700], dark: [900, 300] },
  callables: { hue: 'amber', light: [200, 900], dark: [900, 200] },
  members: { hue: 'green', light: [100, 800], dark: [900, 200] },
  meta: { hue: 'rose', light: [100, 700], dark: [900, 300] },
  tools: { hue: 'cyan', light: [200, 900], dark: [800, 100] },
}
const famPair = (fam: string, scheme: Scheme): [string, string] => {
  const f = FAMS[fam]!
  const [bg, fg] = f[scheme]
  return [hx(f.hue, fg), hx(f.hue, bg)]
}

// glyph, fill per candidate, for the contrast line under it
const CONTRAST: Record<string, (group: string, scheme: Scheme) => [string, string]> = {
  m: (g, s) => [tunedFg(g, s), hx(HUE[g]!, s === 'light' ? 100 : 900)],
  t: (g, s) => [tunedFg(g, s), PAGE[s]],
  v: (g, s) => [firmFg(g, s), mixHex(hx(HUE[g]!, 500), 14, PAGE[s])],
  w: (g, s) => [tunedFg(g, s), mixHex(hx(HUE[g]!, 500), 8, PAGE[s])],
  x: (g) => [hx(HUE[g]!, 950), hx(HUE[g]!, 400)],
  y: (g, s) => [tunedFg(g, s), mixHex(hx(HUE[g]!, 500), 10, PAGE[s])],
  ag: (g, s) => [firmFg(g, s), mixHex(hx(HUE[g]!, 500), 16, PAGE[s])],
  ah: (g, s) => [firmFg(g, s), mixHex(hx(HUE[g]!, 500), 16, PAGE[s])],
  ai: (g, s) => [firmFg(g, s), NEUTRAL[s]],
  aj: (g, s) => [INK[s], hx(HUE[g]!, s === 'light' ? 200 : 800)],
}
function worstBase(scheme: Scheme) {
  let low = { r: Infinity, g: '' }
  for (const g of Object.keys(GROUPS)) {
    const r = ratio(tunedBase(g, scheme), hx(HUE[g]!, scheme === 'light' ? 100 : 900))
    if (r < low.r) low = { r, g }
  }
  return `${low.r.toFixed(2)}:1 ${low.g}`
}
function worstContrast(id: string, scheme: Scheme) {
  const pair = CONTRAST[id]!
  let low = { r: Infinity, g: '' }
  for (const g of Object.keys(GROUPS)) {
    const [fg, bg] = pair(g, scheme)
    const r = ratio(fg, bg)
    if (r < low.r) low = { r, g }
  }
  return `${low.r.toFixed(2)}:1 ${low.g}`
}
const famWorst = (scheme: Scheme) => {
  let low = { r: Infinity, f: '' }
  for (const f of Object.keys(FAMS)) {
    const [fg, bg] = famPair(f, scheme)
    const r = ratio(fg, bg)
    if (r < low.r) low = { r, f }
  }
  return `${low.r.toFixed(2)}:1 ${low.f}`
}

// Tinted colours per scheme, plus a solid fill (the light foreground) for the
// filled candidates, plus the tuned and family variables. The real variable
// names are set too, for candidate A.
const paletteCss = SCHEMES.map((scheme, si) => {
  const at = si * 3
  const real = Object.entries(GROUPS)
    .map(([g, v]) => `--api-kind-${g}-bg:${v[at]};--api-kind-${g}-fg:${v[at + 1]};--api-kind-${g}-border:${v[at + 2]};`)
    .join('')
  const light = scheme === 'light'
  const groups = Object.entries(GROUPS)
    .map(([g, v]) => {
      const h = HUE[g]!
      const tuned = `--ub:${hx(h, light ? 100 : 900)};--uf:${tunedFg(g, scheme)};--uh:${hx(h, 500)};--u2:${hx(h, light ? 200 : 800)};--u8:${firmFg(g, scheme)};--um:${hx(h, 400)};--u9:${hx(h, 950)};--us:${hx(h, 700)};`
      return `.bd-pane[data-pane='${scheme}'] [data-g='${g}']{--tbg:${v[at]};--tfg:${v[at + 1]};--tbd:${v[at + 2]};--sbg:${v[1]};--sbd:${v[at + 2]};${tuned}}`
    })
    .join('')
  const fams = Object.keys(FAMS)
    .map((f) => {
      const [fg, bg] = famPair(f, scheme)
      return `.bd-pane[data-pane='${scheme}'] [data-fam='${f}']{--fmb:${bg};--fmf:${fg};--fmh:${hx(FAMS[f]!.hue, 500)}}`
    })
    .join('')
  return `.bd-pane[data-pane='${scheme}']{${real}}${groups}${fams}`
}).join('')

interface Kind {
  kind: string
  group: string
  word: string
  mark: string
  x: boolean
  mono: string
  abbr: string
  fam: string
  geo: string
  shape: string
}

const KIND_DEFS: [string, string, string][] = [
  ['class', 'class', 'class'],
  ['interface', 'class', 'interface'],
  ['struct', 'class', 'struct'],
  ['union', 'typealias', 'union'],
  ['enum', 'typealias', 'enum'],
  ['trait', 'class', 'trait'],
  ['module', 'module', 'module'],
  ['typealias', 'typealias', 'type alias'],
  ['prompt', 'typealias', 'prompt'],
  ['resource-template', 'property', 'template'],
  ['exception', 'exception', 'exception'],
  ['format', 'format', 'format'],
  ['command', 'command', 'command'],
  ['key', 'property', 'key'],
  ['function', 'function', 'function'],
  ['method', 'method', 'method'],
  ['property', 'property', 'property'],
  ['attribute', 'attribute', 'attribute'],
  ['constant', 'constant', 'constant'],
  ['tool', 'function', 'tool'],
  ['resource', 'property', 'resource'],
  ['option', 'option', 'option'],
  ['hook', 'hook', 'hook'],
]
// Two-character monograms: Title case for types, lower case for members and
// callables, a sigil first for the symbol kinds.
const MONO: Record<string, string> = {
  class: 'Cl', interface: 'In', struct: 'St', union: 'Un', enum: 'En', trait: 'Tr', module: 'Mo', typealias: 'Ta',
  prompt: 'Pm', 'resource-template': 'Rt', exception: '!e', format: '#f', command: '$c', key: ':k',
  function: 'fn', method: 'mt', property: 'pr', attribute: 'at', constant: 'cn', tool: 'tl', resource: 'rs', option: 'op', hook: 'hk',
}
const ABBR: Record<string, string> = {
  class: 'class', interface: 'iface', struct: 'struct', union: 'union', enum: 'enum', trait: 'trait', module: 'mod', typealias: 'alias',
  prompt: 'prompt', 'resource-template': 'tmpl', exception: 'exc', format: 'fmt', command: 'cmd', key: 'key',
  function: 'func', method: 'meth', property: 'prop', attribute: 'attr', constant: 'const', tool: 'tool', resource: 'res', option: 'opt', hook: 'hook',
}
const FAMILY: Record<string, string> = {
  class: 'types', struct: 'types', enum: 'types', union: 'types', typealias: 'types', module: 'types',
  interface: 'traits', trait: 'traits',
  function: 'callables', method: 'callables', command: 'callables',
  property: 'members', attribute: 'members', constant: 'members', key: 'members', option: 'members',
  exception: 'meta', prompt: 'meta', 'resource-template': 'meta', format: 'meta',
  tool: 'tools', resource: 'tools', hook: 'tools',
}
// Silhouette families for the geometry candidate.
const GEO: Record<string, string> = {
  class: 'types', interface: 'types', struct: 'types', union: 'types', enum: 'types', trait: 'types', module: 'types',
  typealias: 'types', exception: 'types', prompt: 'types', 'resource-template': 'types',
  function: 'calls', method: 'calls', command: 'calls', tool: 'calls', hook: 'calls',
  property: 'data', attribute: 'data', constant: 'data', key: 'data', option: 'data', resource: 'data', format: 'data',
}
const shapeOf = (mark: string) => (/^[A-Z#:]$/.test(mark) ? 'sq' : /^[$!]$/.test(mark) ? 'di' : 'ci')

const KINDS: Kind[] = KIND_DEFS.map(([kind, group, word]) => {
  const mark = kindMark(kind)!
  return { kind, group, word, mark, x: markHeight(mark) === 'x', mono: MONO[kind]!, abbr: ABBR[kind]!, fam: FAMILY[kind]!, geo: GEO[kind]!, shape: shapeOf(mark) }
})
const kindOf = (kind: string) => KINDS.find((k) => k.kind === kind)!

type Ctx = 'prose' | 'marks' | 'tree' | 'head' | 'table' | 'sig'
type Label = 'mark' | 'mono' | 'word' | 'abbr' | 'legend'

interface Candidate {
  id: string
  name: string
  caption: string
  /** Round and set: 0 is the first round. */
  set: number
  /** The spec this implements, for sets 1 to 4. */
  spec?: string
  /** Shown in prose, the mark row, the tree, the table and the signature. */
  label: Label
  /** Shown in the heading row, when it differs. */
  head?: Label
  /** The site's own classes, so the baseline is the real thing. */
  real?: boolean
  fam?: boolean
  shape?: boolean
  geo?: boolean
  ring?: boolean
  reveal?: boolean
  popover?: boolean
  form?: 'split'
  ink?: Ctx[]
  density?: boolean
  target?: boolean
  hoverMarks?: boolean
  quiet?: boolean
  legend?: 'contrast' | 'fams'
}

const CANDIDATES: Candidate[] = [
