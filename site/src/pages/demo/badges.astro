  { id: 'aa', set: 3, spec: 'Set 3 · 1 Tinted contextual hybrid', name: 'Tinted contextual hybrid', label: 'mono', head: 'abbr', caption: 'mono 12px/700 · 26×20px · 12% tint, 25% border · radius 4px · headings take the 4–5 letter chip' },
  { id: 'ab', set: 3, spec: 'Set 3 · 2 Unified split chip', name: 'Split chip', label: 'mono', form: 'split', caption: 'cap: mono 12px/700, 18% tint · name: 4% fg surface · 1px hairline between · nowrap, no underline' },
  { id: 'ac', set: 3, spec: 'Set 3 · 3 Case-encoded monograms', name: 'Case-encoded monograms', label: 'mono', caption: 'mono 12px/700 · 24×20px · tint, 1px border · radius 4px · Title case types, lower case members, sigil symbols' },
  { id: 'ad', set: 3, spec: 'Set 3 · 4 Left-accent micro-tag', name: 'Left-accent tag', label: 'mono', caption: 'mono 12px/700 · 26×20px · 5% grey fill (8% white dark) · 2.5px hue bar on the left · radius 2px' },
  { id: 'ae', set: 3, spec: 'Set 3 · 5 Geometric silhouette encoding', name: 'Silhouette encoding', label: 'mono', geo: true, caption: 'mono 12px/700 · tint, 1px border · types radius 3px · callables capsule · data neutral chip with a 4px dot' },
  { id: 'af', set: 3, spec: 'Set 3 · 6 Expand-on-focus monogram', name: 'Expand on focus', label: 'mark', popover: true, caption: 'mono 13px/700 (C) · hover or focus pops the kind word, 11px/700 solid · aria-label always' },

  // Set 4
  { id: 'ag', set: 4, spec: 'Set 4 · 1 Soft tint, firm sans letter', name: 'Soft tint, firm sans', label: 'mark', legend: 'contrast', caption: 'sans .8125em/600 in 1.125em square · 16% tint, no border · radius .16em · glyph hue-800 / 200' },
  { id: 'ah', set: 4, spec: 'Set 4 · 2 Soft tint, firm mono letter', name: 'Soft tint, firm mono', label: 'mark', legend: 'contrast', caption: 'same as AG with mono .8125em/600 (C’s letter) · square, tint, radius and gap unchanged' },
  { id: 'ai', set: 4, spec: 'Set 4 · 3 Neutral fill, coloured letter', name: 'Neutral fill, hue letter', label: 'mark', legend: 'contrast', caption: 'one grey fill (#eceef1 / #2b2e33) · glyph hue-800 / 200 · no outline · AG geometry' },
  { id: 'aj', set: 4, spec: 'Set 4 · 4 Tinted fill, ink letter', name: 'Tinted fill, ink letter', label: 'mark', legend: 'contrast', caption: 'hue-200 / 800 fill · one ink glyph (#14161a / #f4f5f6) · AG geometry · no outline' },
  { id: 'ak', set: 4, spec: 'Set 4 · 5 Compact marks, quiet word labels', name: 'Compact + word labels', label: 'mark', head: 'word', caption: 'AG marks in prose and tree · heading label 12px/600 word, 16% tint, radius 3px (K shape)' },
]

const esc = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;')

const labelFor = (c: Candidate, ctx: Ctx): Label => (ctx === 'head' && c.head ? c.head : c.label)

function legendChip(c: Candidate, k: Kind): string {
  const mark = badge({ ...c, head: undefined, label: 'mark' }, k, 'prose')
  return `<span class="bd-leg" data-g="${k.group}">${mark}<span class="bd-leg__w">${esc(k.word)}</span></span>`
}

function badge(c: Candidate, k: Kind, ctx: Ctx, link = false): string {
  const label = labelFor(c, ctx)
  if (c.real) {
    const cls = `${link ? 'api-link-kind ' : ''}api-nav__kind api-badge--kind-${k.kind}`
    return `<span class="${cls}" aria-hidden="true" title="${k.kind}"><span class="api-badge__label"${k.x ? ' data-mark="x"' : ''}>${esc(k.mark)}</span></span>`
  }
  if (label === 'legend') return legendChip(c, k)
  const word = label === 'word' || label === 'abbr'
  const text = { mark: k.mark, mono: k.mono, word: k.word, abbr: k.abbr }[label]
  const cls = ['bd-b', word && 'bd-b--word', label === 'mono' && 'bd-b--mono', c.ink?.includes(ctx) && 'bd-b--ink'].filter(Boolean).join(' ')
  const attrs = [`data-g="${k.group}"`]
  if (c.fam) attrs.push(`data-fam="${k.fam}"`)
  if (c.shape) attrs.push(`data-s="${k.shape}"`)
  if (c.geo) attrs.push(`data-f="${k.geo}"`)
  if (label === 'mark' && k.x) attrs.push('data-x')
  if (c.ring && RING.has(k.group)) attrs.push('data-ring')
  const live = c.reveal || c.popover
  if (live) attrs.push(`data-word="${k.word}"`, 'tabindex="0"', 'role="img"', `aria-label="${k.word}"`)
  else attrs.push('aria-hidden="true"', `title="${k.kind}"`)
  const inner = c.reveal
    ? `<span class="bd-b__l bd-b__m">${esc(text)}</span><span class="bd-b__l bd-b__w">${esc(k.word)}</span>`
    : `<span class="bd-b__l">${esc(text)}</span>`
  return `<span class="${cls}" ${attrs.join(' ')}>${inner}</span>`
}

function mention(c: Candidate, kind: string, text: string, ctx: Ctx = 'prose'): string {
  const k = kindOf(kind)
  const name = `<code>${esc(text)}</code>`
  const sig = ctx === 'sig' ? ' bd-m--sig' : ''
  if (c.real) {
    return `<a class="api-mention${sig}" href="#">${badge(c, k, ctx, true)}<span class="api-symbol-link__name">${name}</span></a>`
  }
  if (c.form === 'split') {
    return `<a class="bd-split${sig}" href="#" data-g="${k.group}"><span class="bd-split__k">${esc(k.mono)}</span><span class="bd-split__n">${name}</span></a>`
  }
  return `<a class="bd-m${sig}" href="#">${badge(c, k, ctx)}<span class="bd-name">${name}</span></a>`
}

const plainMention = (text: string) => `<a class="bd-m bd-m--plain" href="#"><span class="bd-name"><code>${esc(text)}</code></span></a>`

type Part = string | [string, string] | [string, string, 'plain']

const PROSE: Part[] = [
  ['method', 'TmuxTools::builder(server)'],
  ' constructs a tool surface over a libtmux ',
  ['struct', 'Server'],
  '. Pass a ',
  ['struct', 'Selection'],
  ' through ',
  ['method', '.selection()'],
  ', then build it. ',
  ['method', 'offered()'],
  ' reports the tools in scope.',
]
// Later mentions of the same names stay plain code links under the density rule.
const PROSE_DENSITY: Part[] = [
  ...PROSE,
  ' Each ',
  ['struct', 'Selection', 'plain'],
  ' narrows the ',
  ['struct', 'Server', 'plain'],
  '; call ',
  ['method', '.selection()', 'plain'],
  ' again to replace it.',
]
const TREE: [string, string, string][] = [
  ['struct', 'Server', ''],
  ['method', 'new_session', 'in'],
  ['property', 'session_name', 'in'],
]
const HEADING: [string, string][] = [
  ['struct', 'Server'],
  ['method', 'new_session()'],
]
const TABLE: [[string, string], [string, string]][] = [
  [['method', 'new_session'], ['struct', 'Session']],
  [['property', 'session_name'], ['enum', 'Option']],
]
// fn new_session(&self, name: Option<&str>) -> Result<Session, Error>
type SigPart = string | [string, string]
const SIGNATURE: SigPart[] = [
  'fn ', ['method', 'new_session'], '(&self, name: ', ['enum', 'Option'], '<&str>) -> ',
  ['enum', 'Result'], '<', ['struct', 'Session'], ', ', ['enum', 'Error'], '>',
]

function renderParts(c: Candidate, parts: Part[]): string {
  return parts
    .map((part) => {
      if (typeof part === 'string') return esc(part)
      return part.length === 3 ? plainMention(part[1]) : mention(c, part[0], part[1])
    })
    .join('')
}

function legendFor(c: Candidate, scheme: Scheme): string {
  if (c.legend === 'fams') {
    const chips = Object.entries(FAMS)
      .map(([f, v]) => `<span class="bd-b bd-b--word" data-fam="${f}">${f} · ${v.hue}</span>`)
      .join('')
    return `<div class="bd-legend">${chips}<span class="bd-legend__n">worst glyph on fill ${famWorst(scheme)}</span></div>`
  }
  if (c.legend === 'contrast') {
    const base = c.id === 'm' && worstBase(scheme) !== worstContrast('m', scheme) ? ` · 700 on 100 alone: ${worstBase(scheme)}` : ''
    return `<div class="bd-legend"><span class="bd-legend__n">worst glyph on fill ${worstContrast(c.id, scheme)}${base}</span></div>`
  }
  return ''
}

function pane(c: Candidate, scheme: Scheme): string {
  const prose = renderParts(c, c.density ? PROSE_DENSITY : PROSE)
  const marks = KINDS.map((k) => {
    const b = badge(c, k, 'marks')
    return c.hoverMarks ? `<a class="bd-m" href="#" aria-label="${k.word}">${b}</a>` : b
  }).join('')
  const tree = TREE.map(([kind, name, indent], i) => {
    const on = i === 1 ? ' bd-row--on' : ''
    const body = c.form === 'split' ? mention(c, kind, name, 'tree') : `${badge(c, kindOf(kind), 'tree')}<span>${name}</span>`
    return `<div class="bd-row${indent ? ' bd-row--in' : ''}${on}">${body}</div>`
  }).join('')
  const heading = HEADING.map(([kind, name]) => {
    const body = c.form === 'split' ? mention(c, kind, name, 'head') : `${badge(c, kindOf(kind), 'head')}<span>${esc(name)}</span>`
    return `<span class="bd-hitem">${body}</span>`
  }).join('')
  const hid = c.target ? ` id="${c.id}-h-${scheme}"` : ''
  const perma = c.target ? `<a class="bd-perma" href="#${c.id}-h-${scheme}" aria-label="Target this heading">#</a>` : ''
  const quiet = c.quiet
    ? `<h3 class="bd-hrow bd-hrow--quiet">${HEADING.map(([, name], i) => `<span class="bd-hitem"><span class="bd-quiet">${i ? 'method' : 'struct'}</span><span>${esc(name)}</span></span>`).join('')}</h3>`
    : ''
  const table = `<table class="bd-table"><thead><tr><th>Member</th><th>Type</th></tr></thead><tbody>${TABLE.map(
    ([a, b]) => `<tr><td>${mention(c, a[0], a[1], 'table')}</td><td>${mention(c, b[0], b[1], 'table')}</td></tr>`,
  ).join('')}</tbody></table>`
  const sig = `<p class="bd-sig">${SIGNATURE.map((p) => (typeof p === 'string' ? esc(p) : mention(c, p[0], p[1], 'sig'))).join('')}</p>`
  return `<div class="bd-pane" data-pane="${scheme}">
<p class="bd-prose">${prose}</p>
<div class="bd-marks">${marks}</div>
<div class="bd-tree">${tree}</div>
<h3 class="bd-hrow"${hid}>${heading}${perma}</h3>${quiet}
${table}
${sig}
${legendFor(c, scheme)}</div>`
}

const SETS = [
  { n: 0, id: 'round-1', label: 'Round 1' },
  { n: 1, id: 'set-1', label: 'Set 1' },
  { n: 2, id: 'set-2', label: 'Set 2' },
  { n: 3, id: 'set-3', label: 'Set 3' },
  { n: 4, id: 'set-4', label: 'Set 4' },
]

const board = SETS.map((s) => {
  const items = CANDIDATES.filter((c) => c.set === s.n)
  const cards = items
    .map(
      (c) => `<section id="${c.id}" class="bd-cand bd-c-${c.id}">
<header class="bd-head"><span class="bd-id">${c.id.toUpperCase()}</span><h3 class="bd-name-h">${c.name}</h3><p class="bd-cap">${c.caption}</p>${c.spec ? `<p class="bd-spec">${c.spec}</p>` : ''}</header>
<div class="bd-panes">${pane(c, 'light')}${pane(c, 'dark')}</div>
</section>`,
    )
    .join('\n')
  return `<h2 id="${s.id}" class="bd-set">${s.label} <span>${items.length} candidates</span></h2>\n${cards}`
}).join('\n')

const bar = `<div class="bd-bar">${SETS.map((s) => {
  const pills = CANDIDATES.filter((c) => c.set === s.n)
    .map((c) => `<a href="#${c.id}" class="bd-jump" title="${c.name}">${c.id.toUpperCase()}</a>`)
    .join('')
  return `<span class="bd-bar__grp"><a href="#${s.id}" class="bd-bar__lab">${s.label}</a>${pills}</span>`
}).join('')}<span class="bd-bar__tools"><a class="bd-tool" href="in-context/">Badges in context</a><button type="button" class="bd-tool" data-bd-toggle="fonts" aria-pressed="false">Fallback fonts</button><button type="button" class="bd-tool" data-bd-toggle="zoom" aria-pressed="false">200%</button></span></div>`
---

<DemoLayout title="Badge demo" description="Kind badge candidates in light and dark." current="/demo/badges/">
  <h1 class="text-3xl font-semibold tracking-tight">Kind badges</h1>
  <p class="mt-2 text-muted">{CANDIDATES.length} candidates, light and dark. Pick a letter.</p>
  <Fragment set:html={bar} />
  <div class="bd-root" data-bd-root>
    <Fragment set:html={board} />
  </div>

  <style is:inline set:html={paletteCss}></style>
</DemoLayout>

<script is:inline>
  document.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('.bd-pane a:not(.bd-perma)')) event.preventDefault()
  })
  // Fallback fonts and 200% zoom, for the case-only pairs and the em-versus-px question.
  const root = document.querySelector('[data-bd-root]')
  const apply = (name, on) => {
    if (!root) return
    if (name === 'fonts') root.dataset.fonts = on ? 'fallback' : ''
    else root.dataset.zoom = on ? '2' : ''
    document.querySelector(`[data-bd-toggle="${name}"]`)?.setAttribute('aria-pressed', String(on))
  }
  for (const button of document.querySelectorAll('[data-bd-toggle]')) {
    button.addEventListener('click', () => apply(button.dataset.bdToggle, button.getAttribute('aria-pressed') !== 'true'))
  }
  const query = new URLSearchParams(location.search)
  if (query.get('fonts') === 'fallback') apply('fonts', true)
  if (query.get('zoom') === '2') apply('zoom', true)
</script>

<style is:global>
  /* Page chrome */
  .bd-bar {
    position: sticky; top: 3.3rem; z-index: 30; display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .9rem;
    margin: 1rem 0 0; padding: .5rem 0; border-bottom: 1px solid var(--color-edge); background: var(--background-color, canvas);
  }
  .bd-bar__grp { display: inline-flex; flex-wrap: wrap; align-items: center; gap: .2rem; }
  .bd-bar__lab { margin-right: .2rem; color: var(--color-muted); font: 600 .625rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; text-decoration: none; }
  .bd-bar__tools { display: inline-flex; gap: .3rem; margin-left: auto; }
  .bd-tool {
    padding: .25rem .5rem; border: 1px solid var(--color-edge); border-radius: .375rem; background: var(--color-surface);
    font: 500 .6875rem/1 var(--font-sans); cursor: pointer;
  }
  .bd-tool[aria-pressed='true'] { background: var(--color-surface-hover); font-weight: 700; }
  a.bd-tool { color: inherit; text-decoration: none; }
  .bd-jump {
    display: inline-grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 .3rem;
    border: 1px solid var(--color-edge); border-radius: .3rem; background: var(--color-surface);
    font: 600 .6875rem/1 var(--font-mono); text-decoration: none; color: inherit;
  }
  .bd-jump:hover { background: var(--color-surface-hover); }
  .bd-set {
    margin: 3rem 0 0; padding-bottom: .5rem; border-bottom: 1px solid var(--color-edge); scroll-margin-top: 7rem;
    font: 700 .8125rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .08em;
  }
  .bd-set span { margin-left: .5rem; color: var(--color-muted); font-weight: 400; letter-spacing: 0; text-transform: none; }
  .bd-root[data-fonts='fallback'] { --font-sans: 'DejaVu Sans', Verdana, sans-serif; --font-mono: 'DejaVu Sans Mono', Menlo, Consolas, monospace; }
  .bd-root[data-zoom='2'] { zoom: 2; }
  .bd-cand { margin-top: 2.5rem; scroll-margin-top: 7rem; }
  .bd-set + .bd-cand { margin-top: 1.5rem; }
  .bd-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem; margin-bottom: .75rem; }
  .bd-id {
    align-self: center; display: inline-grid; place-items: center; min-width: 2rem; height: 2rem; padding: 0 .4rem;
    border-radius: .5rem; background: var(--color-surface-hover); font: 700 1rem/1 var(--font-sans);
  }
  .bd-name-h { margin: 0; font: 600 1.125rem/1.3 var(--font-sans); }
  .bd-cap { flex: 1 1 100%; margin: 0; color: var(--color-muted); font: .75rem/1.4 var(--font-mono); }
  .bd-spec { flex: 1 1 100%; margin: 0; color: var(--color-muted); font: .75rem/1.4 var(--font-sans); }
  .bd-panes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 1rem; }

  /* Panes carry their own scheme */
  .bd-pane {
    position: relative; display: flex; flex-direction: column; gap: 1.1rem; min-width: 0;
    padding: 1.1rem 1.25rem; border: 1px solid var(--bd-edge); border-radius: .5rem;
    background: var(--bd-bg); color: var(--bd-fg);
    --color-edge: var(--bd-edge); --color-muted: var(--bd-muted); --color-surface-hover: var(--bd-hover);
  }
  .bd-pane::before {
    content: attr(data-pane); position: absolute; top: .4rem; right: .6rem;
    color: var(--bd-muted); font: .625rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .06em;
  }
  .bd-pane[data-pane='light'] {
    --bd-bg: #fff; --bd-fg: #1a1c1e; --bd-muted: #6b6f76; --bd-edge: #eeebee; --bd-surface: #f8f9fb;
    --bd-hover: #efeff4; --bd-link: #2757dd; --bd-shade: inset 0 1px 0 rgb(255 255 255 / .2), inset 0 -1px 2px rgb(0 0 0 / .12);
    --ba: 30%; --bd-neutral: #eceef1; --bd-ink: #14161a; --bd-nbg: rgb(0 0 0 / .05);
    color-scheme: light;
  }
  .bd-pane[data-pane='dark'] {
    --bd-bg: #131416; --bd-fg: #cfd0d0; --bd-muted: #81868d; --bd-edge: #303335; --bd-surface: #1a1c1e;
    --bd-hover: #1e2124; --bd-link: #5ca5ff; --bd-shade: inset 0 1px 0 rgb(255 255 255 / .1), inset 0 -1px 2px rgb(0 0 0 / .28);
    --ba: 18%; --bd-neutral: #2b2e33; --bd-ink: #f4f5f6; --bd-nbg: rgb(255 255 255 / .08);
    color-scheme: dark;
  }
  .bd-pane p, .bd-pane h3 { margin: 0; }
  .bd-prose { font: 400 1rem/1.8 var(--font-sans); }
  .bd-pane a { color: var(--bd-link); text-decoration: none; }
  .bd-pane code {
    padding: .05em .3em; border: 1px solid var(--bd-edge); border-radius: .25rem; background: var(--bd-surface);
    font: 400 .875em/1.4 var(--font-mono); color: inherit;
  }
  .bd-name { text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }

  /* A mention is the badge, then the name, centred as the site does it */
  .bd-m { display: inline-flex; align-items: baseline; gap: .25em; max-inline-size: 100%; vertical-align: baseline; }
  .bd-m > .bd-b { align-self: center; }
  .bd-m--plain { display: inline; }

  .bd-marks { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
  .bd-tree { width: min(100%, 17rem); padding: .25rem; border: 1px solid var(--bd-edge); border-radius: .375rem; background: var(--bd-surface); }
  .bd-row { display: flex; align-items: center; gap: .5rem; padding: .3rem .5rem; border-radius: .25rem; font: 400 .875rem/1.3 var(--font-sans); }
  .bd-row--in { padding-left: 1.5rem; }
  .bd-row--on { background: var(--bd-hover); font-weight: 500; }
  .bd-hrow { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.5rem; font: 600 1.375rem/1.3 var(--font-mono); scroll-margin-top: 7rem; }
  .bd-hitem { display: inline-flex; align-items: center; gap: .5rem; }
  .bd-hrow--quiet { font-size: 1.125rem; }

  /* Contexts the specs added: a table cell and a dense signature */
  .bd-table { width: 100%; border-collapse: collapse; font: 400 .8125rem/1.4 var(--font-sans); }
  .bd-table th { padding: .3rem .5rem; border-bottom: 1px solid var(--bd-edge); color: var(--bd-muted); font: 600 .625rem/1 var(--font-mono); text-align: left; text-transform: uppercase; letter-spacing: .06em; }
  .bd-table td { padding: .4rem .5rem; border-bottom: 1px solid var(--bd-edge); }
  .bd-sig { font: 400 .8125rem/2.1 var(--font-mono); overflow-wrap: anywhere; }
  .bd-sig code { padding: 0; border: 0; background: none; font: inherit; }
  .bd-sig .bd-name, .bd-sig .api-symbol-link__name { text-decoration: none; }
  .bd-sig .api-link-kind ~ .api-symbol-link__name { text-decoration-line: none; }
  .bd-legend { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; }
  .bd-legend__n { color: var(--bd-muted); font: .6875rem/1.4 var(--font-mono); }

  /* The candidate badge: every look is a few variables, set per candidate below */
  .bd-b {
    display: inline-grid; place-items: center; flex: none; box-sizing: border-box;
    min-width: var(--w, 20px); height: var(--h, var(--w, 20px)); padding: var(--py, 0) var(--px, 0);
    border: var(--bw, 1px) solid var(--bdv, var(--tbd)); border-radius: var(--r, 4px);
    background: var(--bgv, var(--tbg)); color: var(--fgv, var(--tfg));
    font: var(--fw, 600) var(--fs, 12px)/1 var(--ff, var(--font-sans)); letter-spacing: var(--ls, 0);
    box-shadow: var(--sh, none); white-space: nowrap; user-select: none; text-decoration: none;
  }
  .bd-b[data-x] > .bd-b__l { translate: 0 var(--lift, -.09em); }

  /* B 12px mono, C 13px mono bold, D 12px sans, E 13px sans bold, F wide pill */
  .bd-c-b .bd-b { --w: 20px; --fs: 12px; --fw: 600; --ff: var(--font-mono); --r: 4px; }
  .bd-c-c .bd-b { --w: 22px; --fs: 13px; --fw: 700; --ff: var(--font-mono); --r: 5px; }
  .bd-c-d .bd-b { --w: 20px; --fs: 12px; --fw: 600; --r: 4px; }
  .bd-c-e .bd-b { --w: 22px; --fs: 13px; --fw: 700; --r: 5px; }
  .bd-c-f .bd-b { --w: 28px; --h: 20px; --fs: 12px; --fw: 700; --r: 10px; }

  /* G solid, H soft tint, I libtmux-mcp box */
  .bd-c-g .bd-b, .bd-c-l .bd-b { --w: 22px; --fs: 13px; --fw: 700; --r: 5px; --bgv: var(--sbg); --bdv: var(--sbd); --fgv: #fff; --sh: var(--bd-shade); }
  .bd-c-h .bd-b {
    --w: 22px; --fs: 13px; --fw: 600; --r: 6px; --bw: 0;
    --bgv: color-mix(in srgb, var(--tbd) 20%, var(--bd-bg));
  }
  .bd-c-i .bd-b { --w: 16px; --fs: 10px; --fw: 700; --r: 3px; --bgv: var(--sbg); --bdv: var(--sbd); --fgv: #fff; --sh: var(--bd-shade); }

  /* J and L-in-headings: libtmux-mcp word chip. K: gp-sphinx tinted word chip */
  .bd-c-j .bd-b--word, .bd-c-l .bd-b--word {
    --w: auto; --h: auto; --px: 8.2px; --py: 2.6px; --fs: 11px; --fw: 700; --r: 3.6px; --ls: .01em;
    --bgv: var(--sbg); --bdv: var(--sbd); --fgv: #fff; --sh: var(--bd-shade);
  }
  .bd-c-k .bd-b--word { --w: auto; --h: auto; --px: 8px; --py: 2.6px; --fs: 11px; --fw: 700; --r: 3.5px; --ls: .01em; }
