---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import ApiTree from '../../../../components/api/ApiTree.astro'
import { referenceTree, navTree, apiTreeVersion } from '../../../../lib/api-tree'
import { API_MODELS } from '../../../../lib/api-models'
import { PORT_BY_SLUG, referenceUrl } from '../../../../lib/ports'
import { defaultVersionFor } from '../../../../lib/versions'
import { withRoot } from '../../../../lib/site-root'
import { DEMO_LANGUAGES, sidebarExamples } from '../../../../lib/sidebar-demo'

export function getStaticPaths() { return DEMO_LANGUAGES.map((port) => ({ params: { port } })) }
const port = Astro.params.port!
const inventory = referenceTree(port)
const selected = sidebarExamples(inventory)[0]?.id ?? ''
const version = defaultVersionFor(port)
const base = referenceUrl(PORT_BY_SLUG[port], version)
const src = withRoot(`/demo/sidebar/preview/${port}.json`)
---

<BaseLayout title={`${PORT_BY_SLUG[port].name} sidebar preview`} portSlug={port} noindex searchable={false} bare>
  <div class="sidebar-preview" data-sidebar-preview data-language={port} data-inventory={src}>
    <header class="sidebar-preview__header">
      <a href={withRoot('/demo/sidebar/')} target="_parent">libtmux · sidebar demo</a>
      <span>{PORT_BY_SLUG[port].name} · {version}</span>
      <span data-preview-mode>Outline</span>
    </header>
    <div class="sidebar-preview__mobile">
      <button type="button" data-api-nav-toggle aria-controls="api-nav" aria-expanded="false">Browse API</button>
      <span data-preview-selection></span>
    </div>
    <div class="sidebar-preview__layout">
      <ApiTree referenceBase={base} portName={PORT_BY_SLUG[port].name} tree={[]} members={[]} withMembers={new Set()}
        currentPath="" version={apiTreeVersion(API_MODELS[port], navTree(port))} presentation="outline" inventory={inventory} inventorySrc={src} selectedSymbol={selected} controlled />
      <main class="sidebar-preview__article" id="preview-article" tabindex="-1">
        <nav aria-label="Declaration ancestry" data-preview-ancestry></nav>
        <p class="sidebar-preview__kind" data-preview-kind></p>
        <h1 data-preview-title>{selected}</h1>
        <p data-preview-summary></p>
        <a data-preview-full href={base} target="_blank" rel="noopener">Open full documentation</a>
        <h2 data-preview-members-title>Members</h2>
        <div class="sidebar-preview__members" data-preview-members></div>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  import { initSidebarPreview } from '../../../../components/demo/sidebar-preview'
  import { waitForAppearance } from '../../../../lib/page-readiness'
  waitForAppearance(initSidebarPreview())
</script>

<style is:global>
  .sidebar-preview { --topnav-height: 3rem; --sidebar-width: 296px; height: 100dvh; overflow: hidden; }
  .sidebar-preview__header { height: 3rem; display: flex; align-items: center; gap: 1.5rem; padding: 0 1rem; border-bottom: 1px solid var(--color-edge); font-size: 0.8rem; }
  .sidebar-preview__header > :last-child { margin-left: auto; text-transform: capitalize; color: var(--color-muted); }
  .sidebar-preview__layout { display: grid; grid-template-columns: var(--sidebar-width) minmax(0, 1fr); height: calc(100dvh - 3rem); }
  .sidebar-preview__article { min-width: 0; overflow: auto; padding: 2rem; }
  .sidebar-preview__article h1 { font-size: 1.8rem; margin: 0.5rem 0 1.5rem; overflow-wrap: anywhere; }
  .sidebar-preview__article h2 { font-size: 1.1rem; margin: 2rem 0 0.75rem; }
  .sidebar-preview__article p { margin: 1rem 0; line-height: 1.6; }
  .sidebar-preview__article a { color: var(--color-link); }
  .sidebar-preview__article [data-preview-ancestry] { display: flex; flex-wrap: wrap; gap: 0.6rem; font-size: 0.8rem; }
  .sidebar-preview__kind, .sidebar-preview__note { color: var(--color-muted); font-size: 0.8rem; }
  .sidebar-preview__members { display: grid; gap: 0.35rem; }
  .sidebar-preview__members a { display: flex; align-items: center; gap: 0.75rem; border: 1px solid var(--color-edge); border-radius: 0.3rem; padding: 0.6rem; overflow-wrap: anywhere; }
  .sidebar-preview__members small { margin-left: auto; font-size: 0.7rem; color: var(--color-muted); }
  .sidebar-preview__mobile { display: none; }
  @media (width < 56rem) {
    .sidebar-preview__layout { display: block; height: calc(100dvh - 6rem); }
    .sidebar-preview__mobile { display: flex; align-items: center; gap: 1rem; height: 3rem; padding: 0 1rem; border-bottom: 1px solid var(--color-edge); font-size: 0.8rem; }
    .sidebar-preview__mobile button { flex-shrink: 0; color: var(--color-link); cursor: pointer; }
    .sidebar-preview__mobile span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sidebar-preview__article { height: 100%; padding: 1.25rem; }
    .sidebar-preview__article h1 { font-size: 1.5rem; }
    .sidebar-preview__header { gap: 0.75rem; font-size: 0.7rem; }
    html[data-api-nav] .sidebar-preview .api-nav { width: min(var(--sidebar-width), 88vw); }
  }
</style>
