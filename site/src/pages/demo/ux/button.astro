---
/**
 * The reroll button in every size, with and without a label.
 *
 * Ported from social-embed's button demo.
 */
import RerollButton from '../../../components/RerollButton.astro'
import DemoLayout from '../../../components/demo/DemoLayout.astro'

const SIZES = [
  ['xxs', 20],
  ['xs', 22],
  ['sm', 24],
  ['md', 32],
  ['lg', 36],
  ['xl', 40],
  ['xxl', 44],
  ['xxxl', 48],
] as const

const ANIMATION_CSS = `@keyframes lm-reroll-spin {
  from { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(180deg) scale(1.2); }
  to { transform: rotate(360deg) scale(1); }
}

@keyframes lm-reroll-pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.lm-reroll--rolling { animation: lm-reroll-pop 0.3s ease-out; }
.lm-reroll--rolling .lm-reroll__die { animation: lm-reroll-spin 0.3s ease-out; }`

const heading = 'text-xl font-semibold'
const subheading = 'mb-3 mt-6 text-sm font-medium text-muted'
---

<DemoLayout title="Button demo" description="Reroll button sizes and animation." current="/demo/ux/button/">
  <h1 class="text-3xl font-semibold tracking-tight">Button</h1>
  <p class="mt-2 text-muted">
    <code>&lt;RerollButton&gt;</code> picks something at random. Its die spins each time it is clicked, unless the
    reader has asked for reduced motion. The prompt picker on the home page uses it to choose another task.
  </p>

  <section class="mt-10 border-b border-edge pb-10">
    <h2 class={heading}>Reroll button</h2>
    <h3 class={subheading}>Die only</h3>
    <div class="flex flex-wrap items-end gap-6">
      {
        SIZES.map(([size, px]) => (
          <div class="flex flex-col items-center gap-2">
            <RerollButton size={size} />
            <span class="text-xs text-muted">
              {size} · {px}px
            </span>
          </div>
        ))
      }
    </div>
    <h3 class={subheading}>Die and label</h3>
    <div class="flex flex-wrap items-end gap-6">
      {
        SIZES.map(([size, px]) => (
          <div class="flex flex-col items-center gap-2">
            <RerollButton size={size} label="Reroll" />
            <span class="text-xs text-muted">
              {size} · {px}px
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-b border-edge py-10">
    <h2 class={heading}>Roll on load</h2>
    <p class="mb-4 mt-1 text-sm text-muted">
      With <code>animateOnMount</code>, the second button rolls once when the page loads.
    </p>
    <div class="flex items-center gap-4">
      <RerollButton size="sm" />
      <RerollButton size="sm" animateOnMount />
    </div>
  </section>

  <section class="py-10">
    <h2 class={heading}>Animation CSS</h2>
    <pre class="mt-4 overflow-x-auto rounded-lg bg-surface p-4 text-xs"><code>{ANIMATION_CSS}</code></pre>
  </section>
</DemoLayout>
