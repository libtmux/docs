---
import { DEFAULT_LOCALE, localeSourcePath } from '../../../i18n/locales'
import { buildLocale } from '../../../i18n/resolve'
import type { ApiSymbol } from '@libtmux/api-model'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import SymbolIndex from '../../../components/api/SymbolIndex.astro'
import ApiTree from '../../../components/api/ApiTree.astro'
import PagePortSwitcher from '../../../components/PagePortSwitcher.astro'
import DocumentationContext from '../../../components/docs/DocumentationContext.astro'
import PageEnd from '../../../components/docs/PageEnd.astro'
import { withRoot } from '../../../lib/site-root'
import { API_MODELS, PORT_NAME, referenceHref } from '../../../lib/api-models'
import { referenceColumn } from '../../../lib/api-tree'
import { apiPageEnd } from '../../../lib/page-end'
import { pagePortsFor } from '../../../lib/page-ports-for'
import { sidebarHeadAt } from '../../../lib/sidebar-head'
import { pageBreadcrumbs, type BreadcrumbItem } from '../../../lib/sidebar'
import { coreApiSymbols } from '../../../lib/product-api'
import { PORT_BY_SLUG, referenceUrl } from '../../../lib/ports'
import { buildTarget } from '../../../lib/versions'
import { groupByLetter, letterLabel, summaryLine, type IndexEntry } from '../../../lib/symbol-index'
import '../../../styles/api.css'
import '../../../styles/vendor/gp-sphinx-api.css'

/**
 * Every public symbol, A to Z.
 *
 * The root build lists every port: the per-port index answers "what is in this
 * library", this answers "where does this name live", the question a reader
 * arrives with when they have seen a name in someone else's code and do not
 * know which of the libraries it belongs to, or whether it belongs to more than
 * one. A port's build lists that port alone, at the same route under its
 * reference (`/<port>/<version>/reference/symbols/<letter>/`): an A-Z view for a
 * reader who knows roughly what something is called, with the kind of each name,
 * names many types declare folded into one row, and a filter.
 *
 * One page per initial letter. All eleven thousand on a single page is
 * several megabytes of HTML that no browser is glad to receive, and the
 * alphabet is the split a reader already understands.
 */
export async function getStaticPaths() {
  // Default locale only, for the same reason the reference route itself is
  // gated: the symbol index is the reference's own front door, and the
  // reference is not translated. A Japanese copy would be an English index
  // at a Japanese URL, linking across to /en/ for every row.
  if (buildLocale() !== DEFAULT_LOCALE) return []

  const buildPort = process.env.LIBTMUX_DOCS_PORT
  const version = buildTarget(process.env).version
  const sources: [string, ApiSymbol[]][] = buildPort
    ? API_MODELS[buildPort] ? [[buildPort, coreApiSymbols(API_MODELS[buildPort]!)]] : []
    : (Object.entries(API_MODELS) as [string, { symbols: ApiSymbol[] }][]).map(([port, model]) => [port, model.symbols])

  const entries: IndexEntry[] = []
  for (const [port, symbols] of sources) {
    const names = new Map(symbols.map((symbol) => [symbol.id, symbol.name]))
    for (const symbol of symbols) {
      const id = symbol.publicId ?? symbol.id
      // The index never lists a symbol the reference has no page for.
      const href = referenceHref(port, id, buildPort ? version : undefined)
      if (!href) continue
      entries.push({
        port, name: symbol.name, id, kind: symbol.kind, href,
        owner: symbol.parent ? names.get(symbol.parent) : undefined,
        summary: summaryLine(symbol.doc?.summary),
      })
    }
  }

  const groups = groupByLetter(entries)
  const letters = groups.map((group) => group.letter)
  const portsByName = new Map<string, Set<string>>()
  for (const entry of entries) portsByName.set(entry.name, (portsByName.get(entry.name) ?? new Set()).add(entry.port))
  const shared = [...portsByName].filter(([, ports]) => ports.size > 1).map(([name]) => name)

  return groups.map((group) => ({
    params: { letter: group.letter.toLowerCase() },
    props: { letter: group.letter, letters, entries: group.entries, total: entries.length, shared, port: buildPort },
  }))
}

interface Props {
  letter: string
  letters: string[]
  entries: IndexEntry[]
  total: number
  shared: string[]
  port?: string
}
const { letter, letters, entries, total, shared, port } = Astro.props as Props

const portMeta = port ? PORT_BY_SLUG[port] : undefined
const portName = port ? (PORT_NAME[port] ?? portMeta?.name ?? port) : undefined
const here = (l: string) => withRoot(`/reference/symbols/${l.toLowerCase()}/`)
const version = buildTarget(process.env).version
const referenceRoot = portMeta ? referenceUrl(portMeta, version) : withRoot('/reference/')
const pageTitle = `Symbols: ${letterLabel(letter)}`
// A port's A-Z page is a page of its core reference (record 0021): the breadcrumb names Port / Core Library / API reference
// / page like every other trail, the column opens with the way up, and the page ends on the ladder. The cross-port page is a
// root page with none of that.
const column = port ? referenceColumn(port) : undefined
const breadcrumbs: BreadcrumbItem[] = port
  ? await pageBreadcrumbs(pageTitle, `reference/symbols/${letter.toLowerCase()}`, version, port)
  : [
      { name: 'libtmux', url: withRoot('/') },
      { name: 'Reference', url: withRoot('/reference/') },
      { name: pageTitle, url: here(letter) },
    ]
const end = column ? apiPageEnd({ inventory: column.inventory, selected: '', base: referenceRoot, breadcrumbs }) : undefined
const pagePorts = port ? await pagePortsFor('reference', port, version) : []
const title = port ? `${portName} API index` : 'Symbol index'
---

<BaseLayout
  title={`${title}: ${letterLabel(letter)}`}
  breadcrumbs={breadcrumbs}
  description={`Public ${portName ?? 'libtmux'} symbols beginning with ${letterLabel(letter)}.`}
  pagePath={`reference/symbols/${letter.toLowerCase()}`}
  portSlug={port || undefined}
  version={port ? version : undefined}
  documentationLayout={column ? 'reference' : undefined}
  flush={Boolean(column)}
  inventoryExclude={Boolean(port)}
  noindex={true}
>
  {column && <div slot="header-navigation" class="site-header-language">
    <PagePortSwitcher entries={pagePorts} portSlug={port} reserveLabelWidth />
  </div>}
  {column && <DocumentationContext slot="context" port={port} version={version} locale={buildLocale()}
    sourcePath={localeSourcePath(Astro.url.pathname, buildLocale())} reference>
    <button type="button" class="api-nav-toggle" slot="navigation" data-api-nav-toggle data-pagefind-ignore="all" aria-controls="api-nav" aria-expanded="false">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path stroke-linecap="round" d="M2 4h12M2 8h12M2 12h8" />
      </svg>
      <span class="sr-only">{portName} API contents</span>
    </button>
  </DocumentationContext>}
  {column ? (
    <main class="api-reference-layout grid">
      <ApiTree
        presentation="outline"
        inventory={column.inventory}
        referenceBase={referenceRoot}
        glossaryHref={`${referenceRoot}glossary/`}
        portName={portName!}
        tree={column.tree}
        hrefs={column.hrefs}
        members={[]}
        withMembers={new Set()}
        currentPath={Astro.url.pathname}
        version={column.version}
        head={await sidebarHeadAt(port, version, Astro.url.pathname)}
      />
      <div class="api-reference-content min-w-0 px-4 py-6 lg:px-6">
        <SymbolIndex
          embedded
          title={title}
          letter={letter}
          letters={letters.map((l) => ({ letter: l, href: here(l) }))}
          entries={entries}
          breadcrumbs={breadcrumbs}
          port={port}
          portName={portName}
          total={total}
          shared={new Set(shared)}
        />
        {end && <PageEnd {...end} />}
      </div>
    </main>
  ) : (
    <SymbolIndex
      title={title}
      letter={letter}
      letters={letters.map((l) => ({ letter: l, href: here(l) }))}
      entries={entries}
      breadcrumbs={breadcrumbs}
      port={port}
      portName={portName}
      total={total}
      shared={new Set(shared)}
    />
  )}
</BaseLayout>
