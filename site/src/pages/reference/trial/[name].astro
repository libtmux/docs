---
/**
 * Trial pages for the Go reference: the columns in every variant, and the
 * panel workspace. Nothing links here except the reference's View row, and the
 * build writes them for Go alone.
 */
import ColumnsTrial from '../../../components/api/columns/ColumnsTrial.astro'
import PanelsTrial from '../../../components/api/panels/PanelsTrial.astro'
import { apiColumnsOffered, TRIAL_PAGES } from '../../../lib/columns/trial'
import { DEFAULT_LOCALE } from '../../../i18n/locales'
import { buildLocale } from '../../../i18n/resolve'

export function getStaticPaths() {
  if (buildLocale() !== DEFAULT_LOCALE || !apiColumnsOffered(process.env.LIBTMUX_DOCS_PORT)) return []
  return TRIAL_PAGES.map((trial) => ({ params: { name: trial.slug } }))
}

const { name } = Astro.params
---
{name === 'columns' && <ColumnsTrial />}
{name === 'panels' && <PanelsTrial />}
