---
import { ALL_TRANSLATED } from '../i18n/resolve'
import McpInstall from '../components/widgets/McpInstall.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { PORTS } from '../lib/ports'
import mcpTools from '../data/mcp-tools.json'
import { withPortRoot, withRoot } from '../lib/site-root'

/**
 * The MCP server page.
 *
 * This is an .astro route rather than a Markdown page because the install
 * widget is a component: pages in the `docs` content collection are plain
 * Markdown and cannot import one. The prose lives here alongside it.
 */
// All eight ship a server. The earlier hardcoded six predated checking:
// libtmux-cxx has apps/mcp/ and libtmux-swift has Sources/LibTmuxMCP/, both
// with a registered tool catalog — see /mcp/tools/ for what each registers.
const toolCount = mcpTools.ports as Record<string, { tools: string[] }>
// Read from the generated matrix rather than retyped into the prose: these
// three numbers move whenever any port registers a tool, and a sentence is
// the one place a stale number never surfaces as an error.
const toolUniverse = (mcpTools.universe as string[]).length
const coverage = mcpTools.coverage as Record<string, string[]>
const universalTools = (mcpTools.universe as string[]).filter((t) => coverage[t].length === 8).length
const referenceTools = toolCount.py.tools.length
const mcpPorts = PORTS
---

<BaseLayout
  title="MCP server"
  description="Drive tmux from an AI agent. Install the libtmux MCP server in Claude Code, Claude Desktop, Cursor, VS Code, Codex, Zed, opencode or Windsurf."
  pagePath="mcp"

  localeStatuses={ALL_TRANSLATED}
>
  <main class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">MCP server</h1>
    <p class="mt-3 text-lg">
      The libtmux MCP server exposes tmux to any client that speaks the Model
      Context Protocol, so an agent can create sessions, send keys and read
      pane output without shelling out.
    </p>

    <h2 class="mt-10 text-xl font-semibold">Install</h2>
    <p class="mt-2 text-sm text-muted">
      Choose your client, install method and configuration scope, then run the
      displayed command.
    </p>
    <div class="mt-4">
      <McpInstall />
    </div>

    <h2 class="mt-12 text-xl font-semibold">Configuration scope</h2>
    <p class="mt-3">
      Most clients distinguish a <strong>user</strong> scope, which follows you
      across every project, from a <strong>project</strong> scope committed
      alongside the repository so collaborators get the same server. A tmux
      server is machine-local state, so user scope is usually right; choose
      project scope when the workspace definition itself is part of the repo.
    </p>

    <h2 class="mt-12 text-xl font-semibold">Ports with an MCP server</h2>
    <p class="mt-3">
      Each library below provides an MCP server. Python is the reference
      implementation and registers {referenceTools} tools:
    </p>
    <ul class="mt-4 space-y-1">
      {
        mcpPorts.map((p) => (
          <li>
            <a class="font-medium hover:underline" href={withPortRoot(`/${p.slug}/`)}>
              {p.name}
            </a>
            <span class="ml-2 font-mono text-sm opacity-70">{p.packageName}</span>
            <span class="ml-2 text-sm opacity-60">{toolCount[p.slug]?.tools.length ?? 0} tools</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-sm text-muted">
      Tool availability and names vary by server. There are {toolUniverse}
      distinct names, with {universalTools} registered in every port. Java and
      .NET prefix tool names with <code>tmux_</code>. Check the
      <a class="hover:underline" href={withRoot('/mcp/tools/')}>tool surface</a>
      before configuring an agent. For library API coverage, see
      <a class="hover:underline" href={withRoot('/parity/')}>parity</a>.
    </p>
  </main>
</BaseLayout>
