---
import { ALL_TRANSLATED } from '../../i18n/resolve'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageToolbar from '../../components/PageToolbar.astro'
import { withRoot } from '../../lib/site-root'
import { PORTS, portHomeUrl } from '../../lib/ports'
import { buildRows } from '../../lib/parity-hosts'
import '../../styles/meta.css'
import { defaultVersionFor } from '../../lib/versions'

/**
 * How each port is built: where its reference is hosted, what draws the page
 * and what generates the API model. The rows come from `buildRows`. No port
 * tracks parity with Python libtmux, so the page carries no per-symbol
 * ledger.
 */

const breadcrumbs = [{ name: 'libtmux', url: withRoot('/') }, { name: 'Parity', url: withRoot('/meta/parity/') }]
---

<BaseLayout
  title="Parity"
  breadcrumbs={breadcrumbs}
  description="What each libtmux port is built from."
  localeStatuses={ALL_TRANSLATED}
>
  <main class="meta-page">
    <PageToolbar breadcrumbs={breadcrumbs} />
    <h1>Parity</h1>

    <h2>How each port is built</h2>
    <p class="meta-note">
      Every port's API reference is drawn on libtmux.org from its API model. A package registry's
      own host, where one exists, is an alternative.
    </p>
    <div class="meta-scroll" tabindex="0" role="region" aria-label="How each port is built, scrollable">
      <table>
        <thead>
          <tr>
            <th scope="col">Port</th>
            <th scope="col">Package</th>
            <th scope="col">Reference host</th>
            <th scope="col">Renderer</th>
            <th scope="col">Generator</th>
          </tr>
        </thead>
        <tbody>
          {
            buildRows(PORTS).map((row) => (
              <tr>
                <td>
                  <a class="meta-plain" href={portHomeUrl(PORTS.find((port) => port.slug === row.slug)!, defaultVersionFor(row.slug))}>
                    {row.name}
                  </a>
                </td>
                <td class="meta-mono">{row.packageName}</td>
                <td data-reference-host>{row.host}{row.alsoHost && <>, also <a href={row.alsoHost.url} rel="noopener">{row.alsoHost.name}</a></>}</td>
                <td data-renderer>{row.renderer}</td>
                <td>{row.generator}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </main>
</BaseLayout>
