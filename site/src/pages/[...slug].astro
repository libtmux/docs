---
import { getCollection, type CollectionEntry } from 'astro:content'
import DocPage from '../components/docs/DocPage.astro'
import McpOverview from '../components/mcp/Overview.astro'
import McpTools from '../components/mcp/Tools.astro'
import ProductApiPage from '../components/api/ProductApiPage.astro'
import { API_MODELS } from '../lib/api-models'
import type { ApiModel, ApiSymbol } from '@libtmux/api-model'
import { productApiRoutes } from '../lib/product-api'
import { buildTarget } from '../lib/versions'
import ToolReference from '../components/mcp/ToolReference.astro'
import { mcpReferenceRoutes } from '../lib/mcp-reference'
import { docsEntryAvailable } from '../lib/page-port-links'
import { docsRoutePath } from '../lib/docs-paths'
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales'
import { buildLocale, localeOf, placeholderPairs, sourceIdOf } from '../i18n/resolve'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  const locale = buildLocale()
  const port = process.env.LIBTMUX_DOCS_PORT
  let defaults: Record<string, string> = {}
  try { defaults = JSON.parse(process.env.LIBTMUX_DOCS_PORT_DEFAULTS || '{}') } catch { /* Local defaults are latest. */ }
  const real = entries
    .filter((entry) => localeOf(entry.id) === locale && docsEntryAvailable(entry, port))
    .map((entry) => ({
      params: { slug: docsRoutePath({ ...entry, id: sourceIdOf(entry.id) }, port, defaults) },
      props: { entry, version: entry.data.product && !port ? (defaults[entry.data.port!] ?? 'latest') : undefined },
    }))
  const global = !port ? [
    { params: { slug: 'mcp' }, props: { globalPage: 'mcp' } },
    { params: { slug: 'mcp/tools' }, props: { globalPage: 'tools' } },
  ] : []
  const reference = locale === DEFAULT_LOCALE ? productApiRoutes(API_MODELS, port, defaults, buildTarget(process.env).version)
    .map(({ path, ...props }) => ({ params: { slug: path }, props })) : []
  const protocol = locale === DEFAULT_LOCALE ? mcpReferenceRoutes(port, defaults, buildTarget(process.env).version)
    .map(({ path, port: mcpPort, ...props }) => ({ params: { slug: path }, props: { ...props, mcpPort } })) : []
  if (locale === DEFAULT_LOCALE) return [...real, ...global, ...reference, ...protocol]
  const placeholders = (await placeholderPairs())
    .filter((pair) => pair.locale === locale)
    .map(({ sourceId }) => ({
      params: { slug: sourceId },
      props: { entry: entries.find((entry) => entry.id === sourceId)!, placeholderLocale: locale },
    }))
  return [...real, ...global, ...placeholders]
}

interface Props {
  entry?: CollectionEntry<'docs'>
  placeholderLocale?: Locale
  globalPage?: string
  version?: string
  model?: ApiModel
  symbol?: ApiSymbol
  mcpPort?: string
  toolName?: string
}
const { entry, placeholderLocale, globalPage, version, model, symbol, mcpPort, toolName } = Astro.props
---

{globalPage === 'mcp' ? <McpOverview /> : globalPage === 'tools' ? <McpTools /> : mcpPort ? <ToolReference port={mcpPort} toolName={toolName} version={version!} /> : model && symbol ? <ProductApiPage model={model} symbol={symbol} version={version!} /> : entry && <DocPage entry={entry} version={version} placeholderLocale={placeholderLocale} />}
