---
import { getCollection, type CollectionEntry } from 'astro:content'
import DocPage from '../components/docs/DocPage.astro'
import RedirectPage from '../components/docs/RedirectPage.astro'
import McpTools from '../components/mcp/Tools.astro'
import ProductApiPage from '../components/api/ProductApiPage.astro'
import { API_MODELS } from '../lib/api-models'
import type { ApiModel, ApiSymbol } from '@libtmux/api-model'
import { productApiRedirects, productApiRoutes } from '../lib/product-api'
import { buildTarget } from '../lib/versions'
import ProtocolReference from '../components/mcp/ProtocolReference.astro'
import TmuxOverview from '../components/tmux/Overview.astro'
import { mcpReferenceRoutes, type McpSection } from '../lib/mcp-reference'
import { docsEntriesAvailable } from '../lib/page-port-links'
import { docsRedirects, docsRoutePath, movedPageRedirects, redirectDestination, sourceGuideRedirects, workspaceRedirects } from '../lib/docs-paths'
import { DEFAULT_LOCALE, localeRoot, type Locale } from '../i18n/locales'
import { buildLocale, localeOf, placeholderPairs, sourceIdOf } from '../i18n/resolve'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  const locale = buildLocale()
  const port = process.env.LIBTMUX_DOCS_PORT
  let defaults: Record<string, string> = {}
  try { defaults = JSON.parse(process.env.LIBTMUX_DOCS_PORT_DEFAULTS || '{}') } catch { /* Local defaults are latest. */ }
  const prose = docsEntriesAvailable(entries.filter((entry) => localeOf(entry.id) === locale), port)
  const real = prose
    .map((entry) => ({
      params: { slug: docsRoutePath({ ...entry, id: sourceIdOf(entry.id) }, port, defaults) },
      props: { entry, version: entry.data.port && !port ? (defaults[entry.data.port] ?? 'latest') : undefined },
    }))
  const moved = movedPageRedirects(port).map(({ path, target }) => ({ params: { slug: path }, props: { redirect: target } }))
  const global = !port ? [
    { params: { slug: 'tmux' }, props: { globalPage: 'tmux' } },
    { params: { slug: 'mcp/tools' }, props: { globalPage: 'tools' } },
  ] : []
  const reference = locale === DEFAULT_LOCALE ? productApiRoutes(API_MODELS, port, defaults, buildTarget(process.env).version)
    .map(({ path, ...props }) => ({ params: { slug: path }, props })) : []
  const protocol = locale === DEFAULT_LOCALE ? mcpReferenceRoutes(port, defaults, buildTarget(process.env).version)
    .map(({ path, port: mcpPort, ...props }) => ({ params: { slug: path }, props: { ...props, mcpPort } })) : []
  if (locale === DEFAULT_LOCALE) {
    const reserved = [...global, ...reference, ...protocol].map((route) => route.params.slug)
    const redirects = [
      ...docsRedirects(prose.map((entry) => ({ ...entry, id: sourceIdOf(entry.id) })), port, defaults, reserved),
      ...sourceGuideRedirects(port, defaults),
      ...workspaceRedirects([...real, ...reference].map((route) => route.params.slug)),
      ...productApiRedirects(API_MODELS, port, defaults, buildTarget(process.env).version),
    ]
      .map(({ path, target }) => ({ params: { slug: path }, props: { redirect: target } }))
    const routes = [...real, ...global, ...reference, ...protocol, ...redirects, ...moved]
    const paths = routes.map((route) => route.params.slug)
    const duplicates = paths.filter((path, index) => paths.indexOf(path) !== index)
    if (duplicates.length) throw new Error(`Duplicate generated documentation routes: ${[...new Set(duplicates)].join(', ')}`)
    return routes
  }
  const placeholders = (await placeholderPairs())
    .filter((pair) => pair.locale === locale)
    .map(({ sourceId }) => ({
      params: { slug: docsRoutePath({ ...entries.find((entry) => entry.id === sourceId)!, id: sourceId }, port, defaults) },
      props: { entry: entries.find((entry) => entry.id === sourceId)!, placeholderLocale: locale },
    }))
  return [...real, ...global, ...placeholders, ...moved]
}

interface Props {
  redirect?: string
  entry?: CollectionEntry<'docs'>
  placeholderLocale?: Locale
  globalPage?: string
  version?: string
  model?: ApiModel
  symbol?: ApiSymbol
  mcpPort?: string
  toolName?: string
  section?: McpSection
  itemSlug?: string
}
const { entry, placeholderLocale, globalPage, version, model, symbol, mcpPort, section, itemSlug, redirect } = Astro.props
const destination = globalPage === 'tmux' && buildLocale() !== DEFAULT_LOCALE
  ? `${localeRoot(DEFAULT_LOCALE)}tmux/`
  : redirect !== undefined ? redirectDestination(import.meta.env.BASE_URL, redirect) : undefined
---

{destination ? <RedirectPage destination={destination} title="the documentation" /> : globalPage === 'tmux' ? <TmuxOverview /> : globalPage === 'tools' ? <McpTools /> : mcpPort ? <ProtocolReference port={mcpPort} section={section!} itemSlug={itemSlug} version={version!} /> : model && symbol ? <ProductApiPage model={model} symbol={symbol} version={version!} /> : entry && <DocPage entry={entry} version={version} placeholderLocale={placeholderLocale} />}
