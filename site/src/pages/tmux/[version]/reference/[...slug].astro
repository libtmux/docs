---
import DocsLayout from '../../../../layouts/DocsLayout.astro'
import { Code } from 'astro-expressive-code/components'
import { withRoot } from '../../../../lib/site-root'
import type { SidebarItem } from '../../../../lib/sidebar'
import { TMUX_REPOSITORY, TMUX_VERSIONS, tmuxApiLinks, tmuxCommandNotes, tmuxGuidesFor, tmuxManualHtml, tmuxPageDescription, tmuxPageHeadings, tmuxPageTitle, tmuxReference, tmuxReferenceRoutes, tmuxReferenceUrl } from '../../../../lib/tmux-reference'

export function getStaticPaths() {
  return tmuxReferenceRoutes().map(({ version, slug }) => ({ params: { version, slug } }))
}
const { version = 'latest', slug } = Astro.params
const reference = tmuxReference(version)
const command = reference.commands.find((entry) => entry.name === slug)
const isManual = slug === 'manual'
if (slug && !command && !isManual) throw new Error(`Unknown tmux command: ${slug}`)
const title = tmuxPageTitle(version, slug)
const pagePath = `tmux/${version}/reference${slug ? `/${slug}` : ''}`
const description = tmuxPageDescription(version, slug)
const sections = [...new Set(reference.commands.map((entry) => entry.section))]
const sectionTitle = (section: string) => section[0] + section.slice(1).toLowerCase()
const navigation: SidebarItem[] = [
  { type: 'link', label: 'All commands', href: tmuxReferenceUrl(version) },
  { type: 'link', label: 'Full manual', href: tmuxReferenceUrl(version, 'manual') },
  ...sections.map((section) => ({ type: 'group' as const, label: sectionTitle(section),
    items: reference.commands.filter((entry) => entry.section === section).map((entry) => ({
      type: 'link' as const, label: entry.name, href: tmuxReferenceUrl(version, entry.name),
    })),
  })),
]
const breadcrumbs = [
  { name: 'Documentation', url: withRoot('/') },
  { name: `tmux ${reference.version}`, url: tmuxReferenceUrl(version) },
  ...(slug ? [{ name: command?.name ?? 'Manual', url: tmuxReferenceUrl(version, slug) }] : []),
]
const equivalents = tmuxApiLinks(command?.name ?? '')
const guides = tmuxGuidesFor(command?.name ?? '')
const headings = tmuxPageHeadings(version, slug)
const notes = tmuxCommandNotes(version, slug)
const source = { repo: TMUX_REPOSITORY, path: 'tmux.1', ref: reference.revision }
---

<DocsLayout title={title} description={description} pagePath={pagePath}
  headings={headings} navigation={navigation} breadcrumbs={breadcrumbs} pagePorts={[]}
  pageSource={source} markdownIndex={!slug}
  canonicalOverride={new URL(tmuxReferenceUrl(version, slug), Astro.site).href}
  noindex={version !== 'latest'} searchable={version === 'latest'}>
  <nav class="not-prose tmux-versions" aria-label="tmux version" data-pagefind-ignore="all">
    <span>Version</span>
    {TMUX_VERSIONS.map((entry) => {
      const target = !slug || isManual || tmuxReference(entry).commands.some((item) => item.name === slug) ? slug : undefined
      return <a href={tmuxReferenceUrl(entry, target)} aria-current={entry === version ? 'page' : undefined}>
        {entry === 'latest' ? `Latest (${tmuxReference(entry).version})` : entry}
      </a>
    })}
  </nav>
  {command ? <>
    <p>{command.summary}</p>
    {notes && <>
      <h2 id="examples">Common uses</h2>
      <p>{notes.context}</p>
      {notes.examples.map((example) => <>
        <p class="tmux-example-label">{example.title}</p>
        <Code code={example.code} lang="tmux-shell" wrap />
      </>)}
    </>}
    <h2 id="syntax">Syntax</h2>
    <div class="tmux-syntax"><Code code={`tmux ${command.name}${command.usage ? ` ${command.usage}` : ''}`} lang="tmux-usage" wrap /></div>
    {command.alias && <p>Alias: <code>{command.alias}</code>.</p>}
    {notes ? <>
      <h2 id="behavior">Options</h2>
      {notes.groups.map((group) => <section>
        <h3 id={group.id}>{group.title}</h3>
        <dl class="tmux-option-list">{group.options.map((option) => <div>
          <dt><code>{option.label}</code></dt><dd>{option.text}</dd>
        </div>)}</dl>
      </section>)}
      <details class="tmux-original-manual">
        <summary>Original manual wording</summary>
        <div class="tmux-manual" set:html={tmuxManualHtml(command.html, version)} />
      </details>
    </> : <>
      <h2 id="behavior">Behavior</h2>
      <div class="tmux-manual" set:html={tmuxManualHtml(command.html, version)} />
    </>}
    {guides.length > 0 && <>
      <h2 id="guides">Guides</h2>
      <ul>{guides.map((guide) => <li><a href={guide.href}>{guide.title}</a></li>)}</ul>
    </>}
    {equivalents.length > 0 && <>
      <h2 id="libraries">Use from a library</h2>
      <p>Each API describes its own defaults, errors and execution model.</p>
      <ul>{equivalents.map((entry) => <li><a href={entry.href}>{entry.name}</a></li>)}</ul>
    </>}
  </> : isManual ? <div class="tmux-manual" set:html={tmuxManualHtml(reference.manual, version)} /> : <>
    <p>Look up the flags and behavior supported by tmux {reference.version}. Choose the version installed on your machine with <code>tmux -V</code>.</p>
    <p>Start with the <a href={`${tmuxReferenceUrl(version, 'manual')}#DESCRIPTION`}>global options</a>, <a href={`${tmuxReferenceUrl(version, 'manual')}#COMMANDS`}>target syntax</a>, or <a href={`${tmuxReferenceUrl(version, 'manual')}#FORMATS`}>formats</a>. The <a href={tmuxReferenceUrl(version, 'manual')}>full manual</a> also covers options, hooks and key bindings.</p>
    {sections.map((section) => <section>
      <h2 id={section.toLowerCase().replaceAll(' ', '-')}>{sectionTitle(section)}</h2>
      <dl class="tmux-command-list">{reference.commands.filter((entry) => entry.section === section).map((entry) => <>
        <dt><a href={tmuxReferenceUrl(version, entry.name)}><code>{entry.name}</code></a></dt>
        <dd>{entry.summary}</dd>
      </>)}</dl>
    </section>)}
  </>}
  <details class="mt-8">
    <summary>tmux sources and license</summary>
    <p>Syntax comes from <code>tmux {reference.version} list-commands</code>. See the <a href={`${tmuxReferenceUrl(version, 'manual')}#DESCRIPTION`}>global options</a> for sockets and configuration, and <a href={`${tmuxReferenceUrl(version, 'manual')}#COMMANDS`}>command syntax and targets</a>.</p>
    <p>Behavior is taken from the <a href={`https://github.com/${TMUX_REPOSITORY}/blob/${reference.revision}/tmux.1`}>tmux {reference.version} manual</a>.</p>
    {command && <p><a href={`https://github.com/${TMUX_REPOSITORY}/blob/${reference.revision}/${command.sourceFile}#L${command.sourceLine}`}>Command declaration</a></p>}
    <pre class="tmux-license">{reference.license}</pre>
  </details>
</DocsLayout>

<style>
  .tmux-versions { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin: 0 0 1.5rem; font-size: .875rem; }
  .tmux-versions a { border: 1px solid var(--color-edge); border-radius: .375rem; padding: .25rem .625rem; }
  .tmux-versions a[aria-current] { font-weight: 600; background: var(--color-surface-hover); }
  .tmux-syntax, .tmux-license { white-space: pre-wrap; overflow-wrap: anywhere; }
  .tmux-command-list dt { margin-top: 1rem; }
  .tmux-command-list dd { margin-left: 0; }
  .tmux-example-label { margin-bottom: .5rem; font-weight: 600; }
  .tmux-option-list { margin-block: .5rem 1.5rem; }
  .tmux-option-list > div { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1rem; padding-block: .625rem; border-bottom: 1px solid var(--color-edge); }
  .tmux-option-list :is(dt, dd) { margin: 0; }
  .tmux-option-list code { white-space: nowrap; }
  .tmux-original-manual { margin-block: 1.5rem; }
  .tmux-original-manual summary { cursor: pointer; }
  @media (max-width: 480px) { .tmux-option-list > div { grid-template-columns: 4.75rem minmax(0, 1fr); gap: .75rem; } }
  .tmux-manual :global(pre) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .tmux-manual :global(table) { display: block; overflow-x: auto; }
  .tmux-manual :global(dd) { margin-left: 1rem; }
  .tmux-manual :global(.Pp) { margin-block: 1em; }
</style>
