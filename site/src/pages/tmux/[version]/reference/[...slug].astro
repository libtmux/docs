---
import ApiReference from '../../../../components/api/ApiReference.astro'
import RedirectPage from '../../../../components/docs/RedirectPage.astro'
import { tmuxReferenceContext, tmuxReferenceRoutes } from '../../../../lib/tmux-reference'
import { tmuxManualRoutes, tmuxManualUrl } from '../../../../lib/tmux-manual-data'

export function getStaticPaths() {
  return [
    ...tmuxReferenceRoutes().map(({ version, symbol }) => ({
      params: { version, slug: symbol?.slug }, props: { version, symbol },
    })),
    ...tmuxManualRoutes().filter(({ slug }) => slug).map(({ version, slug }) => ({
      params: { version, slug: slug === 'full' ? 'manual' : slug },
      props: { destination: tmuxManualUrl(version, slug) },
    })),
  ]
}
const { version = 'latest', symbol, destination } = Astro.props
---
{destination ? <RedirectPage destination={destination} title="tmux manual" />
  : <ApiReference source={tmuxReferenceContext(version, symbol)} owner={symbol} searchable={version === 'latest'} />}
