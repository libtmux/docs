---
import { ALL_TRANSLATED, buildLocale } from '../i18n/resolve'
import BaseLayout from '../layouts/BaseLayout.astro'
import DocsLayout from '../layouts/DocsLayout.astro'
import { DOC_PRODUCTS, PORTS, PORT_BY_SLUG, portPageUrl, primaryInstall, productDescription, type DocProduct, referenceUrl } from '../lib/ports'
import PortHero from '../components/PortHero.astro'
import DocCard from '../components/DocCard.astro'
import ApiReferences from '../components/ApiReferences.astro'
import { buildTarget } from '../lib/versions'
import PackageInstall from '../components/widgets/PackageInstall.astro'
import AgentPrompt from '../components/widgets/AgentPrompt.astro'
import { QUICKSTARTS } from '../lib/quickstarts'
import { withPortRoot, withRoot } from '../lib/site-root'
import { localesFor } from '../i18n/resolve'
import { getCollection, render } from 'astro:content'
import { DEFAULT_LOCALE } from '../i18n/locales'
import { CONTRIBUTE_BRANCH, CONTRIBUTE_REPO, repoPath } from '../i18n/contribute'

const explore = [
  {
    href: withRoot('/topics/'),
    label: 'Topics',
    body: 'Architecture, traversal, options and hooks, with examples in each language.',
  },
  {
    href: withRoot('/concepts/'),
    label: 'Concepts',
    body: 'How servers, sessions, windows and panes relate, and how to connect to and query them.',
  },
  {
    href: withRoot('/guides/'),
    label: 'Guides',
    body: 'Install tmux and a libtmux package, then create sessions and control panes.',
  },
  {
    // Composed here rather than at the point of render: the rest of this
    // list is shared prose and lives under this build's own root, while the
    // reference is built in the default locale only. One list, two roots.
    href: withPortRoot('/reference/'),
    label: 'API reference',
    body: 'API signatures and documentation, with links to related guides and corresponding APIs in other languages.',
  },
  {
    href: withRoot('/examples/'),
    label: 'Examples',
    body: 'Programs for creating workspaces, sending keys and capturing output.',
  },
] as const


/**
 * A port+version build mounts this route at /<port>/<version>/, so the site
 * home was being emitted there — /py/stable/ served "libtmux" rather than
 * anything Python. That is a real URL a version switcher lands on, so it
 * renders the version root for that port instead: the same hero and cards as
 * the port home, but scoped to the version actually being built.
 */
const buildPort = process.env.LIBTMUX_DOCS_PORT || undefined
const versionRootPort = buildPort ? PORT_BY_SLUG[buildPort] : undefined
const { version: buildVersion } = buildTarget(process.env)

const versionSections = versionRootPort
  ? [
      { href: portPageUrl(versionRootPort, buildVersion, 'topics'), label: 'Topics', body: `Subject-by-subject, with ${versionRootPort.name} in every code block.` },
      { href: portPageUrl(versionRootPort, buildVersion, 'guides'), label: 'Guides', body: `Task guides for ${versionRootPort.name}.` },
      { href: portPageUrl(versionRootPort, buildVersion, 'examples'), label: 'Examples', body: 'Complete programs, sourced from the code each port tests.' },
      { href: portPageUrl(versionRootPort, buildVersion, 'concepts'), label: 'Concepts', body: 'The domain model every port shares.' },
      ...Object.entries(DOC_PRODUCTS).map(([slug, info]) => ({ href: portPageUrl(versionRootPort, buildVersion, slug), label: info.label, body: productDescription(versionRootPort, slug as DocProduct) })),
    ]
  : []

/**
 * Locales this landing page genuinely exists in.
 *
 * Content pages get this from `DocsLayout`, which knows its own entry. The
 * landing page is a route rather than a collection entry, so it asks for the
 * translations of the site root directly — without it the page emitted no
 * hreflang cluster at all while `/ja/` sat there untagged, which is the one
 * case where a missing alternate is a search engine's problem rather than a
 * reader's.
 *
 * The empty source id is not a typo. Astro's glob loader names an entry after
 * its path without `/index`, so `ja/index.md` is the entry `ja`, and stripping
 * its locale prefix leaves nothing. `'index'` looks like the right argument
 * and silently matches no entry.
 */
const homeLocales = await localesFor('')

/*
 * The landing page a locale has written for itself.
 *
 * This page is a route rather than a collection entry, because English has no
 * `index.md` — the hero below is the English landing page. A locale that does
 * write one (`ja/index.md`) has it shadowed by this route, since a static
 * route wins over `[...slug]`'s empty param, so `/ja/` answered with the
 * English body: the exact duplicate a placeholder exists to avoid, and the
 * only route page in that locale's sitemap.
 *
 * Rendered here rather than left to `[...slug]`, because the shadowing cannot
 * be turned off from a static route.
 */
const locale = buildLocale()
const landingEntry =
  locale === DEFAULT_LOCALE
    ? undefined
    : (await getCollection('docs')).find((e) => e.id === locale)
const LandingContent = landingEntry ? (await render(landingEntry)).Content : undefined

/*
 * A locale with no landing page of its own falls back to the English body, so
 * it is marked noindex for the same reason a placeholder is: one English text
 * indexed at two URLs is worse for both. `<html lang>` says `en` there too —
 * it describes the body, not the prefix it is served under.
 */
const noindexLanding = locale !== DEFAULT_LOCALE && !LandingContent

/*
 * `localeStatuses` is ALL_TRANSLATED here while `locales` stays homeLocales.
 * They answer different questions: `locales` drives the hreflang cluster and
 * must name only real translations, while the switcher is chrome and has to
 * offer every locale this route is generated in — which is all of them, since
 * it is a route rather than a collection entry.
 */

---

{
  versionRootPort ? (
    /*
     * The documentation shell, not the bare one.
     *
     * This is the root of a port's version tree, and every page below it —
     * `/ts/latest/examples/`, `/ts/latest/guides/panes/` — carries the
     * sidebar. Landing on the root was the one place the nav disappeared,
     * which read as leaving the documentation rather than arriving at it.
     *
     * `bare` because the page brings its own hero and card grid: the reading
     * column's prose styles would treat the cards as a document, and its
     * heading would be a second one under `PortHero`'s.
     */
    <DocsLayout
      title={`${versionRootPort.name} ${buildVersion}`}
      description={`libtmux for ${versionRootPort.language}, version ${buildVersion}.`}
      port={versionRootPort.slug}
      version={buildVersion}
      bare
    >
      <PortHero port={versionRootPort} defaultVersion={buildVersion} />
      <p class="mt-4 text-sm text-muted">
        You are reading the <strong>{buildVersion}</strong> documentation. Use
        the version control in the header to move between releases, or the
        port dropdown to find a corresponding page in another language.
      </p>
      {/*
        The install command, on the page a reader actually lands on.

        This is where the port switcher, the version switcher and the sidebar
        all point, and it said what the package was called without saying how
        to get it — the install lived one level up at /<port>/, which is a URL
        nothing in the navigation offers.
      */}
      <section class="mt-10 max-w-3xl">
        <h2 class="text-lg font-semibold">Install</h2>
        <div class="mt-3">
          <PackageInstall ports={[versionRootPort.slug]} />
        </div>
      </section>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {versionSections.map((s) => (
          <DocCard href={s.href} label={s.label} body={s.body} />
        ))}
      </div>
      <ApiReferences port={versionRootPort} version={buildVersion} />
      <p class="mt-8 text-sm">
        <a class="hover:underline" href={withPortRoot(`/${versionRootPort.slug}/`)}>
          All {versionRootPort.name} versions and install instructions
        </a>
      </p>
    </DocsLayout>
  ) : (

<BaseLayout
  title={landingEntry?.data.title ?? 'libtmux'}
  description={landingEntry?.data.description ?? 'Control tmux from Python, TypeScript, Rust, Go, Java, .NET, C++ or Swift. Installation, task guides and API reference.'}
  locale={LandingContent ? locale : DEFAULT_LOCALE}
  locales={homeLocales}
  sourcePath="/"
  localeStatuses={ALL_TRANSLATED}
  noindex={noindexLanding}
  pageSource={landingEntry?.filePath ? { repo: CONTRIBUTE_REPO, path: repoPath(landingEntry.filePath), ref: CONTRIBUTE_BRANCH } : undefined}
  markdown={landingEntry ? 'source' : 'rendered'}
>
  {LandingContent ? (
    <main class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
      <LandingContent />
    </main>
  ) : (
  <main class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
    <!-- Hero -->
    <section class="max-w-3xl">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">libtmux</h1>
      <p class="mt-4 text-xl text-muted">
        Control tmux from your application.
      </p>
      <p class="mt-4 max-w-2xl text-base leading-relaxed opacity-80">
        libtmux provides objects for tmux servers, sessions, windows and panes.
        Use them to create a workspace, send input to a terminal program, or
        capture its output in a test.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={withRoot('/guides/getting-started/')}
          class="rounded bg-theme-primary px-4 py-2 text-sm font-semibold text-white hover:bg-theme-primary/90"
        >
          Get started
        </a>
        <a
          href={withRoot('/topics/')}
          class="rounded border border-edge px-4 py-2 text-sm font-semibold hover:bg-surface-hover"
        >
          Browse topics
        </a>
        <a
          href="https://github.com/libtmux"
          class="rounded border border-edge px-4 py-2 text-sm font-semibold hover:bg-surface-hover"
        >
          GitHub
        </a>
      </div>
    </section>

    <!-- Quickstart -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold">Quickstart</h2>
      <p class="mt-2 max-w-2xl text-sm opacity-80">
        Choose a language to see its install command and opening example. See
        <a class="underline" href={withRoot('/examples/attach-and-send-keys/')}>Attach and send keys</a>
        for examples of creating a session and sending input in each language.
      </p>
      <div class="mt-4 max-w-2xl">
        <PackageInstall snippets={QUICKSTARTS} />
      </div>
    </section>

    <!-- Agent prompt -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold">Start with an agent</h2>
      <p class="mt-2 max-w-2xl text-sm opacity-80">
        Copy this into any coding agent. It installs libtmux in the repository
        you are in, checks the install against a real tmux server, and points
        the agent at this site's
        <a class="underline" href={withRoot('/llms.txt')}>llms.txt</a> and
        <a class="underline" href={withRoot('/docs.json')}>docs.json</a> so it
        reads the API rather than guessing it. Pick a language and a task.
      </p>
      <div class="mt-4 max-w-4xl">
        <AgentPrompt />
      </div>
      <p class="mt-3 text-sm">
        <a class="hover:underline underline" href={withRoot('/prompts/')}>All prompts</a>,
        including a plain-text URL per language and task that an agent can fetch.
      </p>
    </section>

    <!-- Ports -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold">Language libraries</h2>
      <p class="mt-2 max-w-2xl text-sm opacity-80">
        Choose a library for installation instructions and API documentation.
        Each reference includes links to related APIs in other languages.
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          PORTS.map((p) => (
            <article class="flex flex-col rounded border border-edge p-4">
              <h3 class="font-semibold">
                <a class="hover:underline" href={withPortRoot(`/${p.slug}/`)}>
                  {p.name}
                </a>
              </h3>
              <p class="mt-1 font-mono text-xs opacity-70">{p.packageName}</p>
              <pre class="mt-3 overflow-x-auto rounded bg-surface px-2 py-1.5 font-mono text-xs"><code>{primaryInstall(p).code}</code></pre>
              <p class="mt-3 text-sm">
                <a class="hover:underline" href={referenceUrl(p)}>API reference</a>
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Onward -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold">Read the docs</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {
          explore.map((item) => (
            <a
              href={item.href}
              class="block rounded border border-edge p-4 hover:bg-surface-hover"
            >
              <h3 class="font-semibold">{item.label}</h3>
              <p class="mt-1 text-sm opacity-80">{item.body}</p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  )}
</BaseLayout>
  )
}
