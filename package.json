{
  "name": "@libtmux/docs-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @libtmux/site dev",
    "build": "pnpm --filter @libtmux/site build",
    "preview": "pnpm --filter @libtmux/site preview",
    "build:site": "./scripts/build-site.sh",
    "clean": "bash scripts/clean-build.sh",
    "type-check": "pnpm run --recursive type-check && pnpm run type-check:python",
    "type-check:python": "uv run --locked ty check",
    "lint": "pnpm run --recursive lint && oxlint scripts && pnpm run lint:python",
    "lint:python": "uv run --locked ruff check . && uv run --locked ruff format --check .",
    "test": "node scripts/test-loop.mjs outer",
    "test:inner": "node scripts/test-loop.mjs inner",
    "test:medium": "node scripts/test-loop.mjs medium",
    "test:fast": "node scripts/test-loop.mjs medium",
    "test:publication": "./scripts/test-all.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "entities": "catalog:",
    "happy-dom": "catalog:",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-markdown": "2.2.0",
    "oxlint": "catalog:",
    "smol-toml": "1.9.1",
    "typescript": "catalog:"
  }
}
