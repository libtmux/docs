node_modules/
dist/
.astro/
_site/
.build.lock
*.log
.DS_Store
# A staging assembly: `LIBTMUX_DOCS_OUT_DIR=_site.next ./scripts/build-site.sh`
# builds one without churning the tree a reviewer is reading. `_site/` was
# listed twice instead, which left the staging trees people actually make
# untracked-and-addable — 32,721 built files fit in one `git add -A`.
_site.*/

# Reference Markdown staged into the content collection by
# scripts/build-site.sh, then deleted again. Present only mid-build; every
# file in it is regenerated by that port's own generator.
site/src/content/api/


# Content-addressed cache of assembled shell builds (scripts/build-site.sh).
.build-cache/

# `scripts/check-visual.mjs` writes one of these beside a baseline when a
# comparison fails, and never removes it. Committed, they outlive the failure
# they document and read as a difference that is still there.
site/test/baselines/*.diff.png
